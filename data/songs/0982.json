    {
     "lines": [
      {
       "cyr": "Лична Мара меанџика,",
       "lat": "Lična Mara meandžika,",
       "en": "Fair Mara the tavern-keeper,"
      },
      {
       "cyr": "си имала машко дете.",
       "lat": "si imala maško dete.",
       "en": "she had a baby son."
      },
      {
       "cyr": "Си имала машко дете,",
       "lat": "Si imala maško dete,",
       "en": "She had a baby son,"
      },
      {
       "cyr": "машко дете, Костадинче.",
       "lat": "maško dete, Kostadinče.",
       "en": "a baby son, Kostadinche."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нејно момче на туѓина,",
       "lat": "Nejno momče na tuǵina,",
       "en": "Her lad was in a foreign land,"
      },
      {
       "cyr": "на туѓина, на печалба.",
       "lat": "na tuǵina, na pečalba.",
       "en": "in a foreign land, working for wages."
      },
      {
       "cyr": "Па ѝ велат комшиките,",
       "lat": "Pa ì velat komšikite,",
       "en": "And the neighbor women tell her,"
      },
      {
       "cyr": "комшијките, душманките:",
       "lat": "komšijkite, dušmankite:",
       "en": "the neighbor women, the ill-wishers:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Мори Маро, лична Маро,",
       "lat": "- Mori Maro, lična Maro,",
       "en": "- Hey Mara, fair Mara,"
      },
      {
       "cyr": "не си чекај твојто момче.",
       "lat": "ne si čekaj tvojto momče.",
       "en": "don't wait for your lad."
      },
      {
       "cyr": "Твојто момче друга љуби,",
       "lat": "Tvojto momče druga ljubi,",
       "en": "Your lad loves another,"
      },
      {
       "cyr": "друга има во туѓина.",
       "lat": "druga ima vo tuǵina.",
       "en": "he has another in the foreign land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се налути лична Мара,",
       "lat": "Se naluti lična Mara,",
       "en": "Fair Mara grew angry,"
      },
      {
       "cyr": "си заљуби два џелата.",
       "lat": "si zaljubi dva dželata.",
       "en": "she took up with two executioners."
      },
      {
       "cyr": "Си заљуби два џелата,",
       "lat": "Si zaljubi dva dželata,",
       "en": "She took up with two executioners,"
      },
      {
       "cyr": "ѝ заклаја машко дете.",
       "lat": "ì zaklaja maško dete.",
       "en": "they slaughtered her baby son."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мариното лично момче",
       "lat": "Marinoto lično momče",
       "en": "Mara's handsome lad"
      },
      {
       "cyr": "лош сон сони во туѓина.",
       "lat": "loš son soni vo tuǵina.",
       "en": "had a bad dream in the foreign land."
      },
      {
       "cyr": "Го укаса лута змија,",
       "lat": "Go ukasa luta zmija,",
       "en": "A fierce snake bit him,"
      },
      {
       "cyr": "меѓу двете црни очи.",
       "lat": "meǵu dvete crni oči.",
       "en": "between his two black eyes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па им вели на другари:",
       "lat": "Pa im veli na drugari:",
       "en": "And he says to his comrades:"
      },
      {
       "cyr": "- Еј другари, мили браќа,",
       "lat": "- Ej drugari, mili braḱa,",
       "en": "- Hey comrades, dear brothers,"
      },
      {
       "cyr": "лош сон видов пред зората,",
       "lat": "loš son vidov pred zorata,",
       "en": "I saw a bad dream before dawn,"
      },
      {
       "cyr": "ме укаса лута змија.",
       "lat": "me ukasa luta zmija.",
       "en": "a fierce snake bit me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ме укаса лута змија,",
