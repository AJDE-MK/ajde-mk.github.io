   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Заспало моме крај море,",
       "lat": "Zaspalo mome kraj more,",
       "en": "A girl fell asleep by the sea,"
      },
      {
       "cyr": "под една гранка маслинка.",
       "lat": "pod edna granka maslinka.",
       "en": "under an olive branch."
      },
      {
       "cyr": "Дунал ми ветер од море,",
       "lat": "Dunal mi veter od more,",
       "en": "The wind blew from the sea,"
      },
      {
       "cyr": "окршил гранка маслинка,",
       "lat": "okršil granka maslinka,",
       "en": "the olive branch broke,"
      },
      {
       "cyr": "удрил ми моме по лице.",
       "lat": "udril mi mome po lice.",
       "en": "it hit the girl on the face."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тргна се моме, разбуди,",
       "lat": "Trgna se mome, razbudi,",
       "en": "The girl jerked and awoken,"
      },
      {
       "cyr": "луто си ветер проколна:",
       "lat": "luto si veter prokolna:",
       "en": "upset, she damned the wind:"
      },
      {
       "cyr": "- Ај да би ветер недунал,",
       "lat": "- Aj da bi veter nedunal,",
       "en": "- May you never blow again,"
      },
      {
       "cyr": "што бев си слатко заспала,",
       "lat": "što bev si slatko zaspala,",
       "en": "I had such a sweet sleep,"
      },
      {
       "cyr": "шо убав си сон сонуев.",
       "lat": "šo ubav si son sonuev.",
       "en": "how nice of a dream I had dreamt."
      }
     ]
    },
    {
     "lines": [
      {
