   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мајка лежи болна в' постела,",
       "lat": "Majka leži bolna v' postela,",
       "en": "Mother lies sick in bed,"
      },
      {
       "cyr": "а мене браќа на веселба.",
       "lat": "a mene braḱa na veselba.",
       "en": "and I am at a wedding with my brothers."
      },
      {
       "cyr": "- Оди сине, народ развесели",
       "lat": "- Odi sine, narod razveseli",
       "en": "- Go, son, cheer the people up"
      },
      {
       "cyr": "и прозор мој подотвори.",
       "lat": "i prozor moj podotvori.",
       "en": "and open my window a little."
      },
      {
       "cyr": "Песна твоја мајка да слушне",
       "lat": "Pesna tvoja majka da slušne",
       "en": "Let your mother hear your song"
      },
      {
       "cyr": "и од постела тешка да стане.",
       "lat": "i od postela teška da stane.",
       "en": "and rise from her heavy bed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Пеам, пеам мајко мила,",
       "lat": "- Peam, peam majko mila,",
       "en": "- I sing, I sing, dear mother,"
      },
      {
       "cyr": "но во гради болка силна.",
       "lat": "no vo gradi bolka silna.",
       "en": "but there is a strong pain in my chest."
      },
      {
       "cyr": "Слушни ја мајко песнава",
       "lat": "Slušni ja majko pesnava",
       "en": "Listen, mother, to this song,"
      },
      {
       "cyr": "од срце тебе подарена.",
       "lat": "od srce tebe podarena.",
       "en": "given to you from the heart."
      }
     ]
    },
