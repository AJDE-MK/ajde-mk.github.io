   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Нани, нани Димче,",
       "lat": "Nani, nani Dimče,",
       "en": "Sleep, sleep, little Dimche,"
      },
      {
       "cyr": "у шарена лулка,",
       "lat": "u šarena lulka,",
       "en": "in a colorful cradle,"
      },
      {
       "cyr": "у бели пелени.",
       "lat": "u beli peleni.",
       "en": "in white swaddling clothes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Димче ќе ми нани,",
       "lat": "Dimče ḱe mi nani,",
       "en": "Little Dimche will sleep for me,"
      },
      {
       "cyr": "мама ќе го лула,",
       "lat": "mama ḱe go lula,",
       "en": "mother will rock him,"
      },
      {
       "cyr": "голем да порасне.",
       "lat": "golem da porasne.",
       "en": "to grow up big."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Голем да порасне,",
       "lat": "Golem da porasne,",
       "en": "To grow up big,"
      },
      {
       "cyr": "да го ожениме,",
       "lat": "da go oženime,",
       "en": "so that we may marry him,"
      },
      {
       "cyr": "од Солуна града.",
       "lat": "od Soluna grada.",
       "en": "to a girl from the city of Thessaloniki."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дуни, дуни ветре,",
       "lat": "Duni, duni vetre,",
       "en": "Blow, blow, wind,"
      },
      {
       "cyr": "тивко јод морето,",
       "lat": "tivko jod moreto,",
       "en": "softly from the sea,"
      },
      {
       "cyr": "Димче да успиеш,",
       "lat": "Dimče da uspieš,",
       "en": "so that Dimche falls asleep,"
      },
      {
       "cyr": "голем да порасне.",
       "lat": "golem da porasne.",
       "en": "so that he grows up big."
      }
     ]
    }
   ]
