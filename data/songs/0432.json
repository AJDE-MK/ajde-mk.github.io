   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Македонско девојче,",
       "lat": "Makedonsko devojče,",
       "en": "Macedonian girl,"
      },
      {
       "cyr": "китка шарена,",
       "lat": "kitka šarena,",
       "en": "a colorful bouquet,"
      },
      {
       "cyr": "во градина набрана",
       "lat": "vo gradina nabrana",
       "en": "picked up in the garden"
      },
      {
       "cyr": "дар подарена.",
       "lat": "dar podarena.",
       "en": "and presented as a gift."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дали има н' овој бели свет",
       "lat": "Dali ima n' ovoj beli svet",
       "en": "Is there in this world"
      },
      {
       "cyr": "поубаво девојче од Македонче?",
       "lat": "poubavo devojče od Makedonče?",
       "en": "a more beautiful girl than Macedonian?"
      },
      {
       "cyr": "Нема, нема не ќе се роди",
       "lat": "Nema, nema ne ḱe se rodi",
       "en": "No, there isn't, and there won't be born,"
      },
      {
       "cyr": "поубаво девојче од Македонче.",
       "lat": "poubavo devojče od Makedonče.",
       "en": "a more beautiful girl than Macedonian."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нема ѕвезди полични",
       "lat": "Nema dzvezdi polični",
       "en": "There are no stars which are"
      },
      {
       "cyr": "од твојте очи,",
       "lat": "od tvojte oči,",
       "en": "more beautiful than your eyes,"
      },
      {
       "cyr": "да се ноќе на небо,",
       "lat": "da se noḱe na nebo,",
       "en": "if they are in the sky at night"
      },
      {
       "cyr": "ден ќе раздени.",
       "lat": "den ḱe razdeni.",
       "en": "a day will dawn."
      }
     ]
    },
