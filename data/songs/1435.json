   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Озгора гледат леле,",
       "lat": "Ozgora gledat lele,",
       "en": "From high above"
      },
      {
       "cyr": "младо сејменче",
       "lat": "mlado sejmenče",
       "en": "the young policeman"
      },
      {
       "cyr": "право ми тргат леле,",
       "lat": "pravo mi trgat lele,",
       "en": "he's coming straight"
      },
      {
       "cyr": "младо на сред село.",
       "lat": "mlado na sred selo.",
       "en": "to the village square."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На сред село леле,",
       "lat": "Na sred selo lele,",
       "en": "In the village square,"
      },
      {
       "cyr": "младо на бела чешма,",
       "lat": "mlado na bela češma,",
       "en": "by the white fountain"
      },
      {
       "cyr": "тамо ја најде леле,",
       "lat": "tamo ja najde lele,",
       "en": "there he found her,"
      },
      {
       "cyr": "младо бела Румена.",
       "lat": "mlado bela Rumena.",
       "en": "the beautiful young Rumena."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Каде ми полнит леле,",
       "lat": "Kade mi polnit lele,",
       "en": "Where she fills"
      },
      {
       "cyr": "младо вода студена.",
       "lat": "mlado voda studena.",
       "en": "cold spring water."
      },
      {
       "cyr": "- Подај ми вода леле,",
       "lat": "- Podaj mi voda lele,",
       "en": "- Give me water,"
      },
      {
       "cyr": "младо вода студена.",
       "lat": "mlado voda studena.",
       "en": "cold spring water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Уста да исплакнам леле,",
       "lat": "Usta da isplaknam lele,",
       "en": "So I can quench my thirst,"
      },
      {
       "cyr": "младо срце да ладам,",
       "lat": "mlado srce da ladam,",
       "en": "to cool my young heart,"
      },
      {
       "cyr": "севдава мене леле,",
       "lat": "sevdava mene lele,",
       "en": "for my yearnings"
      },
      {
       "cyr": "младо да ми поминит",
       "lat": "mlado da mi pominit",
       "en": "to pass through me"
      },
      {
       "cyr": "и ако умрам леле,",
       "lat": "i ako umram lele,",
       "en": "and if I die,"
      },
      {
       "cyr": "младо ич да не жалам.",
       "lat": "mlado ič da ne žalam.",
       "en": "never to regret anything."
      }
     ]
    }
   ]
  }
 ],
