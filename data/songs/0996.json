      {
       "cyr": "Австралија и Европа",
       "lat": "Avstralija i Evropa",
       "en": "Australia and Europe"
      },
      {
       "cyr": "и цела Канада,",
       "lat": "i cela Kanada,",
       "en": "and all of Canada,"
      },
      {
       "cyr": "тебе ми те жалат Бадев",
