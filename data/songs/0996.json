       "lat": "negovata pesna",
       "en": "his song"
      },
      {
       "cyr": "по цел свет се слуша.",
       "lat": "po cel svet se sluša.",
       "en": "is heard all over the world."
      }
     ]
    },
    {
     "lines": [
      {
