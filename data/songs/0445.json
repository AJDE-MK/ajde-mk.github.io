    {
     "lines": [
      {
       "cyr": "Ајде дали знаеш, паметиш Милице",
       "lat": "Ajde dali znaeš, pametiš Milice",
       "en": "Do you know, do you remember Milica"
      },
      {
       "cyr": "кога си бевме малечки, де",
       "lat": "koga si bevme malečki, de",
       "en": "when we were little"
      },
      {
       "cyr": "кога си бевме малечки Милице",
       "lat": "koga si bevme malečki Milice",
       "en": "when we were little, Milica"
      },
      {
       "cyr": "ај кога се двајцата љубевме.",
       "lat": "aj koga se dvajcata ljubevme.",
       "en": "when we were in love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај кога се двајцата љубевме Милице",
       "lat": "Aj koga se dvajcata ljubevme Milice",
       "en": "When we were in love, Milica"
      },
      {
       "cyr": "во чичовото градинче, де",
       "lat": "vo čičovoto gradinče, de",
       "en": "in my uncle's garden,"
      },
      {
       "cyr": "во чичовото градинче Милице",
       "lat": "vo čičovoto gradinče Milice",
       "en": "in my uncle’s garden, Milica"
      },
      {
       "cyr": "ај кај шарените цвеќиња.",
       "lat": "aj kaj šarenite cveḱinja.",
       "en": "with the colorful flowers."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај кај шарените цвеќиња Милице",
       "lat": "Aj kaj šarenite cveḱinja Milice",
       "en": "With the colorful flowers, Milica"
      },
      {
       "cyr": "трендафил цвеќе цутеше, де",
       "lat": "trendafil cveḱe cuteše, de",
       "en": "there were roses blooming,"
      },
      {
       "cyr": "трендафил цвеќе цутеше Милице",
       "lat": "trendafil cveḱe cuteše Milice",
       "en": "there were roses blooming, Milica"
      },
      {
       "cyr": "ај на скутот ти ми спиеше.",
       "lat": "aj na skutot ti mi spieše.",
       "en": "and you were sleeping on my lap."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај кога те тебе целував Милице",
       "lat": "Aj koga te tebe celuvav Milice",
       "en": "When I kissed you, Milica"
      },
      {
       "cyr": "лице ти беше спотнато, де",
       "lat": "lice ti beše spotnato, de",
       "en": "your face was churned,"
      },
      {
       "cyr": "лице ти беше спотнато Милице",
       "lat": "lice ti beše spotnato Milice",
       "en": "your face was churned, Milica"
      },
      {
       "cyr": "ај од очи оган ти фрлаше.",
       "lat": "aj od oči ogan ti frlaše.",
       "en": "and you blew fire from your eyes."
      }
     ]
    }
