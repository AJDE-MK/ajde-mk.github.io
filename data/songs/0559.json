   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кажи Рајне, кажи душо",
       "lat": "Kaži Rajne, kaži dušo",
       "en": "Tell me, Rajna, tell me, dear,"
      },
      {
       "cyr": "кој ти нишан стори",
       "lat": "koj ti nišan stori",
       "en": "who left you a mark,"
      },
      {
       "cyr": "кој ти нишан стори Рајне",
       "lat": "koj ti nišan stori Rajne",
       "en": "who left you a mark, Rajna,"
      },
      {
       "cyr": "на белото лице.",
       "lat": "na beloto lice.",
       "en": "on your white face."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Штом ме прашаш стара мајко",
       "lat": "Štom me prašaš stara majko",
       "en": "Since you ask me, old mother,"
      },
      {
       "cyr": "право ќе ти кажам",
       "lat": "pravo ḱe ti kažam",
       "en": "I will tell you straight,"
      },
      {
       "cyr": "право ќе ти кажам мајко",
       "lat": "pravo ḱe ti kažam majko",
       "en": "I will tell you straight, mother,"
      },
      {
       "cyr": "без да те излажам.",
       "lat": "bez da te izlažam.",
       "en": "without lying to you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сношти беа стара мајко",
       "lat": "Snošti bea stara majko",
       "en": "Last night, old mother,"
      },
      {
       "cyr": "момци Македонци",
       "lat": "momci Makedonci",
       "en": "there were Macedonian lads,"
      },
      {
       "cyr": "се' на бели коњи мајко",
       "lat": "se' na beli konji majko",
       "en": "all on white horses, mother,"
      },
      {
       "cyr": "ем со жолти узди.",
       "lat": "em so žolti uzdi.",
       "en": "and with yellow bridles."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Главатар им беше мајко",
       "lat": "Glavatar im beše majko",
       "en": "Their leader was, mother,"
      },
      {
       "cyr": "мојто прво либе",
       "lat": "mojto prvo libe",
       "en": "my first love,"
      },
      {
       "cyr": "тој ми нишан стори мајко",
       "lat": "toj mi nišan stori majko",
       "en": "he left me the mark, mother,"
      },
      {
       "cyr": "на белото лице.",
       "lat": "na beloto lice.",
       "en": "on my white face."
      }
     ]
