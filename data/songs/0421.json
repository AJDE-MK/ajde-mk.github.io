   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Дафино вино црвено",
       "lat": "- Dafino vino crveno",
       "en": "Dafina, red wine,",
       "en_mt": false
      },
      {
       "cyr": "момчето ти е заспало.",
       "lat": "momčeto ti e zaspalo.",
       "en": "your boyfriend was asleep.",
       "en_mt": false
      },
      {
       "cyr": "Момчето ти е заспало",
       "lat": "Momčeto ti e zaspalo",
       "en": "Your boyfriend was asleep,",
       "en_mt": false
      },
      {
       "cyr": "на Каракамен планина.",
       "lat": "na Karakamen planina.",
       "en": "on Karakamen mountain.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На Каракамен планина,",
       "lat": "Na Karakamen planina,",
       "en": "On Karakamen mountain,",
       "en_mt": false
      },
      {
       "cyr": "на сува рида без вода.",
       "lat": "na suva rida bez voda.",
       "en": "on a slope without water.",
       "en_mt": false
      },
      {
       "cyr": "Ми поминале ајдути,",
       "lat": "Mi pominale ajduti,",
       "en": "Along came hajduks",
       "en_mt": false
      },
      {
       "cyr": "гунчето му го украле.",
       "lat": "gunčeto mu go ukrale.",
       "en": "and stole his vest.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гунчето му го украле,",
       "lat": "Gunčeto mu go ukrale,",
       "en": "They stole his vest",
       "en_mt": false
      },
      {
       "cyr": "во меана му го продале.",
       "lat": "vo meana mu go prodale.",
       "en": "and sold it in a tavern.",
       "en_mt": false
      },
      {
       "cyr": "Гунчето му го украле,",
       "lat": "Gunčeto mu go ukrale,",
       "en": "They stole his vest",
       "en_mt": false
      },
      {
       "cyr": "во меана му го продале.",
       "lat": "vo meana mu go prodale.",
       "en": "and sold it in a tavern.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во меана му го продале",
       "lat": "Vo meana mu go prodale",
       "en": "Sold it in a tavern,",
       "en_mt": false
      },
      {
       "cyr": "за рујно вино црвено.",
       "lat": "za rujno vino crveno.",
       "en": "exchanged it for red wine,",
       "en_mt": false
      },
      {
       "cyr": "За рујно вино црвено",
       "lat": "Za rujno vino crveno",
       "en": "Exchanged it for red wine,",
       "en_mt": false
      },
      {
       "cyr": "и бела лута ракија.",
       "lat": "i bela luta rakija.",
       "en": "and fine strong rakija.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ако му украле гунчето,",
       "lat": "- Ako mu ukrale gunčeto,",
       "en": "I don't care if they stole his vest,",
       "en_mt": false
      },
      {
       "cyr": "нека ми е живо момчето.",
       "lat": "neka mi e živo momčeto.",
       "en": "as long as my boyfriend is alive.",
       "en_mt": false
      },
      {
       "cyr": "Ако му украле гунчето,",
       "lat": "Ako mu ukrale gunčeto,",
       "en": "I don't care if they stole his vest,",
       "en_mt": false
      },
      {
