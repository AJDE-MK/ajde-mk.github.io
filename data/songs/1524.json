   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Таму в' Егејот, во тој Кукуш град,",
       "lat": "Tamu v' Egejot, vo toj Kukuš grad,",
       "en": "There in the Aegean, in that town of Kukush,"
      },
      {
       "cyr": "таму се роди Делчев, јунак млад,",
       "lat": "tamu se rodi Delčev, junak mlad,",
       "en": "there Delchev was born, a young hero,"
      },
      {
       "cyr": "против тиран клет прв се кренал тој,",
       "lat": "protiv tiran klet prv se krenal toj,",
       "en": "he was the first to rise against the cursed tyrant,"
      },
      {
       "cyr": "да ослободи мачен народ свој.",
       "lat": "da oslobodi mačen narod svoj.",
       "en": "to free his tormented people."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј, Гоце војвода,",
       "lat": "Ej, Goce vojvoda,",
       "en": "Hey, Gotse the voivode,"
      },
      {
       "cyr": "голем јунак наш,",
       "lat": "golem junak naš,",
       "en": "our great hero,"
      },
      {
       "cyr": "син македонски!",
       "lat": "sin makedonski!",
       "en": "Macedonian son!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гоце војвода повел храбар бој,",
       "lat": "Goce vojvoda povel hrabar boj,",
       "en": "Gotse the voivode led a brave fight,"
      },
      {
       "cyr": "срце јуначко в' гради носел тој.",
       "lat": "srce junačko v' gradi nosel toj.",
       "en": "he carried a heroic heart in his chest."
      },
      {
       "cyr": "Против тиран клет храбро кренал глас:",
       "lat": "Protiv tiran klet hrabro krenal glas:",
       "en": "Against the cursed tyrant he bravely raised his voice:"
      },
      {
       "cyr": "- За Македонци - слобода и спас!",
