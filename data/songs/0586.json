 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "До кога браќа, мили Македонци,",
       "lat": "Do koga braḱa, mili Makedonci,",
       "en": "Until when, brothers, dear Macedonians,"
      },
      {
       "cyr": "до кога Грци ќе толчат,",
       "lat": "do koga Grci ḱe tolčat,",
       "en": "until when Greeks will grind,"
      },
      {
       "cyr": "со своето верно духовенство",
       "lat": "so svoeto verno duhovenstvo",
       "en": "with their religious influence"
      },
      {
       "cyr": "милата наша родина?",
       "lat": "milata naša rodina?",
       "en": "our dear fatherland?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зошто вие причина станавте",
       "lat": "Zošto vie pričina stanavte",
       "en": "Why did you become a reason,"
      },
      {
       "cyr": "преди двесте години,",
       "lat": "predi dveste godini,",
       "en": "before two hundred year,"
      },
      {
       "cyr": "народната патријаршија",
       "lat": "narodnata patrijaršija",
       "en": "our people's patriarchy"
      },
      {
       "cyr": "со лаги ни ја презедовте!",
       "lat": "so lagi ni ja prezedovte!",
       "en": "with lies you overtook!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Каде се нашите писатели,",
       "lat": "Kade se našite pisateli,",
       "en": "Where are our writers,"
      },
      {
       "cyr": "каде се нашите списанија?",
       "lat": "kade se našite spisanija?",
       "en": "where are our books?"
      },
      {
       "cyr": "Сè е, сè е прав и пепел станало",
       "lat": "Sè e, sè e prav i pepel stanalo",
       "en": "Everything has become ashes and dust,"
      },
      {
       "cyr": "од грчка фанариотска слова.",
       "lat": "od grčka fanariotska slova.",
       "en": "from Greek Phanariot's letters."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Станете сите браќа Македонци",
       "lat": "Stanete site braḱa Makedonci",
       "en": "Stand up all brothers, Macedonians,"
      },
      {
       "cyr": "од сите македонски градови",
       "lat": "od site makedonski gradovi",
       "en": "from all Macedonian cities,"
      },
      {
       "cyr": "и да викнеме сите со глас голем:",
       "lat": "i da vikneme site so glas golem:",
       "en": "and let's cry out with a loud voice:"
      },
      {
       "cyr": "- Бегајте Грци, не ве сакаме!",
       "lat": "- Begajte Grci, ne ve sakame!",
       "en": "- Go away, Greeks, we don't want you here!"
      }
     ]
    }
   ]
  }
 ],
 "pending_english": false
}