    {
     "lines": [
      {
       "cyr": "Три години сејмен шетав",
       "lat": "Tri godini sejmen šetav",
       "en": "For three years I roamed as a seymen"
      },
      {
       "cyr": "низ вашето пусто село.",
       "lat": "niz vašeto pusto selo.",
       "en": "through your forsaken village."
      },
      {
       "cyr": "Тебе дома не те најдов",
       "lat": "Tebe doma ne te najdov",
       "en": "I did not find you at home"
      },
      {
       "cyr": "да сториме здраво-живо.",
       "lat": "da storime zdravo-živo.",
       "en": "to say farewell."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да је речеш на золва ти",
       "lat": "Da je rečeš na zolva ti",
       "en": "Tell your sister-in-law"
      },
      {
       "cyr": "дал' го чуват аманетот?",
       "lat": "dal' go čuvat amanetot?",
       "en": "whether she keeps the pledge?"
      },
      {
       "cyr": "Аманетот три годишен",
       "lat": "Amanetot tri godišen",
       "en": "The three-year-old pledge,"
      },
      {
       "cyr": "две јаб'лка ѓулави.",
       "lat": "dve jab'lka ǵulavi.",
       "en": "two round apples."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Две јаболка ѓулави",
       "lat": "Dve jabolka ǵulavi",
