   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Капка вода капинаше,",
       "lat": "Kapka voda kapinaše,",
       "en": "A drop of water dripped,"
      },
      {
       "cyr": "сама мома налеваше, ој леле:",
       "lat": "sama moma nalevaše, oj lele:",
       "en": "the girl herself poured, oh wow:"
      },
      {
       "cyr": "- Как' сум бела и црвена,",
       "lat": "- Kak' sum bela i crvena,",
       "en": "- How white and red I am,"
      },
      {
       "cyr": "како роса разлеана, ој леле.",
       "lat": "kako rosa razleana, oj lele.",
       "en": "like dew spilled, oh wow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А мома дума говори:",
       "lat": "A moma duma govori:",
       "en": "And the girl says, speaks:"
      },
      {
       "cyr": "- Уште да сум повисока, ој леле,",
       "lat": "- Ušte da sum povisoka, oj lele,",
       "en": "- If I were even taller, oh wow,"
      },
      {
       "cyr": "би го зела царевото,",
       "lat": "bi go zela carevoto,",
       "en": "I would take the king's,"
      },
      {
       "cyr": "младо лудо меанџиче, ој леле.",
       "lat": "mlado ludo meandžiče, oj lele.",
       "en": "young crazy waiter, oh wow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ој, водо студена,",
       "lat": "Oj, vodo studena,",
       "en": "Oh, cold water,"
      },
      {
       "cyr": "тајна сокриена,",
       "lat": "tajna sokriena,",
       "en": "a secret hidden,"
      },
      {
       "cyr": "срце ми трепери,",
       "lat": "srce mi treperi,",
       "en": "my heart trembles,"
      },
      {
       "cyr": "љубов разбудена.",
       "lat": "ljubov razbudena.",
       "en": "love awakened."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ој, мома убава,",
       "lat": "Oj, moma ubava,",
       "en": "Oh, beautiful girl,"
      },
      {
       "cyr": "како капка жива,",
       "lat": "kako kapka živa,",
       "en": "like a drop of life,"
      },
      {
       "cyr": "каде ќе поминеш,",
       "lat": "kade ḱe pomineš,",
       "en": "wherever you pass,"
      },
      {
       "cyr": "песна се разлива.",
       "lat": "pesna se razliva.",
       "en": "a song spills."
      }
     ]
    },
    {
     "lines": [
