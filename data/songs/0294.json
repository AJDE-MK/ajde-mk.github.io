 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Сношти сакав да ти дојдам",
       "lat": "- Snošti sakav da ti dojdam",
       "en": "- Last night I wanted to visit you,"
      },
      {
       "cyr": "на таа слатка вечера,",
       "lat": "na taa slatka večera,",
       "en": "to eat that sweet dinner,"
      },
      {
       "cyr": "на тоа вино црвено,",
       "lat": "na toa vino crveno,",
       "en": "to drink that red wine,"
      },
      {
       "cyr": "а бре будало.",
       "lat": "a bre budalo.",
       "en": "oh, you fool."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Лошо време ме зафати,",
       "lat": "Lošo vreme me zafati,",
       "en": "But bad weather stopped me,"
      },
      {
       "cyr": "ситна роса зароси,",
       "lat": "sitna rosa zarosi,",
       "en": "a drizzle started to fall,"
      },
      {
       "cyr": "силен ветер задува,",
       "lat": "silen veter zaduva,",
       "en": "a wind started to blow,"
      },
      {
       "cyr": "затоа не дојдов.",
       "lat": "zatoa ne dojdov.",
       "en": "that's why I didn't come."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Каков јунак ти ќе бидеш",
       "lat": "- Kakov junak ti ḱe bideš",
       "en": "- What kind of a hero are you,"
      },
      {
       "cyr": "од роса да се уплашиш,",
       "lat": "od rosa da se uplašiš,",
       "en": "being scared of a drizzle,"
      },
      {
       "cyr": "кај мене да не дојдеш,",
       "lat": "kaj mene da ne dojdeš,",
       "en": "not coming to me,"
      },
      {
       "cyr": "а бре, лудо бре?",
       "lat": "a bre, ludo bre?",
       "en": "hey, you fool?"
      }
     ]
    }
   ]
  }
 ],
