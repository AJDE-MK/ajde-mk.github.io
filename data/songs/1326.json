   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мои пријатели стари,",
       "lat": "Moi prijateli stari,",
       "en": "My old friends,"
      },
      {
       "cyr": "што има ново кај вас?",
       "lat": "što ima novo kaj vas?",
       "en": "what is new with you?"
      },
      {
       "cyr": "Не сме се виделе долго,",
       "lat": "Ne sme se videle dolgo,",
       "en": "We have not seen each other for long,"
      },
      {
       "cyr": "но не ве заборавив.",
       "lat": "no ne ve zaboraviv.",
       "en": "but I have not forgotten you."
      },
      {
       "cyr": "Животот сите нè носи,",
       "lat": "Životot site nè nosi,",
       "en": "Life carries us all,"
      },
      {
       "cyr": "сите на различни страни,",
       "lat": "site na različni strani,",
       "en": "all in different directions,"
      },
      {
       "cyr": "добро е што пак ве сретнав,",
       "lat": "dobro e što pak ve sretnav,",
       "en": "it is good that I met you again,"
      },
      {
       "cyr": "да сте благословени.",
       "lat": "da ste blagosloveni.",
       "en": "may you be blessed."
      }
     ]
    },
    {
