   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Си зедов дама родена,",
       "lat": "Si zedov dama rodena,",
       "en": "I married a real lady,",
       "en_mt": false
      },
      {
       "cyr": "уф, што ми е погодена:",
       "lat": "uf, što mi e pogodena:",
       "en": "ugh, she is right for me:",
       "en_mt": false
      },
      {
       "cyr": "танка е к'о лубеница,",
       "lat": "tanka e k'o lubenica,",
       "en": "thin as a watermelon,",
       "en_mt": false
      },
      {
       "cyr": "тивка е ко воденица.",
       "lat": "tivka e ko vodenica.",
       "en": "quiet as a mill.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Штом ќе ја допре вратата,",
       "lat": "Štom ḱe ja dopre vratata,",
       "en": "As soon as she touches the door,",
       "en_mt": false
      },
      {
       "cyr": "веќе ја нема кваката,",
       "lat": "veḱe ja nema kvakata,",
       "en": "the doorknob is gone,",
       "en_mt": false
      },
      {
       "cyr": "а ако кренам рамења,",
       "lat": "a ako krenam ramenja,",
       "en": "and if I shrug,",
       "en_mt": false
      },
      {
       "cyr": "фрла со дрвја, камења.",
       "lat": "frla so drvja, kamenja.",
       "en": "throws trees and stones at me.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ѕма, ѕма, ѕм, ѕма, ѕма, ѕм,",
       "lat": "Dzma, dzma, dzm, dzma, dzma, dzm,",
       "en": "Dzma, dzma, dzm, dzma, dzma, dzm,",
       "en_mt": false
      },
      {
       "cyr": "ѕма, ѕма, ѕм, ѕм, ѕм.",
       "lat": "dzma, dzma, dzm, dzm, dzm.",
       "en": "dzma, dzma, dzm, dzm, dzm.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Многу ја сака песната,",
       "lat": "Mnogu ja saka pesnata,",
       "en": "She loves the song very much,",
       "en_mt": false
      },
      {
       "cyr": "пее ко страчка збесната,",
       "lat": "pee ko stračka zbesnata,",
       "en": "sings like a mad magpie,",
       "en_mt": false
      },
      {
       "cyr": "штом ќе ја фатат мајките,",
       "lat": "štom ḱe ja fatat majkite,",
       "en": "once she gets excited,",
       "en_mt": false
      },
      {
       "cyr": "сонува принц од бајките.",
       "lat": "sonuva princ od bajkite.",
       "en": "she dreams of a fairy tale prince.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ѕма, ѕма, ѕм, ѕма, ѕма, ѕм,",
