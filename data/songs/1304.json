      {
       "cyr": "Орлови крилја да имам,",
       "lat": "Orlovi krilja da imam,",
       "en": "If only I had eagle's wings,"
      },
      {
       "cyr": "до наши места да летнам,",
       "lat": "do naši mesta da letnam,",
       "en": "to fly to our places,"
