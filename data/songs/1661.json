   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Играј играј, моме ти,",
       "lat": "Igraj igraj, mome ti,",
       "en": "Dance, dance, you girl,"
      },
      {
       "cyr": "земја да се затреси,",
       "lat": "zemja da se zatresi,",
       "en": "let the earth shake,"
      },
      {
       "cyr": "само кога играш ти,",
       "lat": "samo koga igraš ti,",
       "en": "only when you dance,"
      },
      {
       "cyr": "срцево ми трепери.",
       "lat": "srcevo mi treperi.",
       "en": "my heart trembles."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде моме раце давај,",
       "lat": "Ajde mome race davaj,",
       "en": "Come on, girl, give me your hands,"
      },
      {
       "cyr": "ти на чочек заиграј,",
       "lat": "ti na čoček zaigraj,",
       "en": "and dance on the dance floor,"
      },
      {
       "cyr": "рата-та-та-та-та-там,",
       "lat": "rata-ta-ta-ta-ta-tam,",
       "en": "ra-ta-ta-ta-ta-tam,"
      },
      {
       "cyr": "ајде чочек заиграј,",
       "lat": "ajde čoček zaigraj,",
       "en": "come on, dance chochek1,"
      },
      {
       "cyr": "лала-ла-ла-ла-ла-ла,",
       "lat": "lala-la-la-la-la-la,",
       "en": "lala-la-la-la-la-la,"
      },
      {
       "cyr": "голем мерак имам, знај.",
       "lat": "golem merak imam, znaj.",
       "en": "I have a great desire, you know."
      }
     ]
    },
