      {
       "cyr": "Љубеше ме мила мајко убава Елена,",
       "lat": "Ljubeše me mila majko ubava Elena,",
       "en": "You loved me, dear mother, beautiful Elena,"
      },
      {
       "cyr": "три години јас ја сакав,",
       "lat": "tri godini jas ja sakav,",
       "en": "three years I loved her,"
      },
      {
       "cyr": "сè остана празно.",
       "lat": "sè ostana prazno.",
       "en": "everything remained empty."
      },
      {
       "cyr": "Јас ја љубев, мила мајко,",
       "lat": "Jas ja ljubev, mila majko,",
       "en": "I loved her, dear mother,"
      },
      {
       "cyr": "а друг си ја зеде.",
       "lat": "a drug si ja zede.",
       "en": "and another took her."
      }
     ]
    },
    {
     "lines": [
      {
