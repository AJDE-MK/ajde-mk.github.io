      {
       "cyr": "Ори Анче бело и црвено",
       "lat": "Ori Anče belo i crveno",
       "en": "Hey Ance, white and red,"
      },
      {
       "cyr": "ил' мене не ме сакаш, бело Анче,",
       "lat": "il' mene ne me sakaš, belo Anče,",
       "en": "you don't love me, white Ance,"
      },
      {
       "cyr": "ил' мене не ме сакаш, бре.",
       "lat": "il' mene ne me sakaš, bre.",
       "en": "you don't love me, hey."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И тебе те сакам, калеш Димчо",
       "lat": "I tebe te sakam, kaleš Dimčo",
       "en": "I both love you, dear Dimco,"
      },
      {
       "cyr": "и дворовите метам, калеш Димчо",
       "lat": "i dvorovite metam, kaleš Dimčo",
       "en": "and I am sweeping the yard, dear Dimco,"
      },
      {
       "cyr": "и дворовите метам, бре.",
       "lat": "i dvorovite metam, bre.",
       "en": "and I am sweeping the yard, hey."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Лошо сум сонило, калеш Димчо",
       "lat": "Lošo sum sonilo, kaleš Dimčo",
       "en": "I had a bad dream, dear Dimco,"
      },
      {
       "cyr": "звезда вечерница, калеш Димчо",
       "lat": "zvezda večernica, kaleš Dimčo",
       "en": "a night star, dear Dimco,"
      },
      {
       "cyr": "звезда вечерница, бре.",
       "lat": "zvezda večernica, bre.",
       "en": "a night star, hey."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Звезда вечерница, калеш Димчо",
       "lat": "Zvezda večernica, kaleš Dimčo",
       "en": "A night star, dear Dimco,"
      },
      {
       "cyr": "во скут ми паднала, калеш Димчо",
       "lat": "vo skut mi padnala, kaleš Dimčo",
       "en": "fell into my lap, dear Dimco,"
