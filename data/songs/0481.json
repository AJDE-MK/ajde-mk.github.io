      {
       "cyr": "Проклета да е Австралија",
       "lat": "Prokleta da e Avstralija",
       "en": "Cursed be Australia,"
      },
      {
       "cyr": "ми ја запусти фамилијата.",
       "lat": "mi ja zapusti familijata.",
       "en": "it has ruined my family."
      },
      {
       "cyr": "Си ја оставив мојата жена",
       "lat": "Si ja ostaviv mojata žena",
       "en": "I left my wife behind,"
      },
      {
       "cyr": "цвеќе в' градина да ми овене.",
       "lat": "cveḱe v' gradina da mi ovene.",
       "en": "the flower in my garden to wither."
      },
      {
       "cyr": "Е, еј Австралија, ееј земја далечна.",
       "lat": "E, ej Avstralija, eej zemja dalečna.",
       "en": "Hey, hey Australia, hey far-off land."
      }
     ]
    },
    {
     "lines": [
