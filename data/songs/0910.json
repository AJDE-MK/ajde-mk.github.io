 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Јоване море, Јоване",
       "lat": "- Jovane more, Jovane",
       "en": "- Jovan, hey Jovan,"
      },
      {
       "cyr": "чаршија збори за тебе",
       "lat": "čaršija zbori za tebe",
       "en": "the bazaar talks about you,"
      },
      {
       "cyr": "дека си добро мајсторче,",
       "lat": "deka si dobro majstorče,",
       "en": "that you are a good craftsman,"
      },
      {
       "cyr": "мајсторче, добро терзивче.",
       "lat": "majstorče, dobro terzivče.",
       "en": "a craftsman, a good tailor."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еве ти свила коприна,",
       "lat": "Eve ti svila koprina,",
       "en": "Here is silk for you"
      },
      {
       "cyr": "фустанот да ми сошиеш.",
       "lat": "fustanot da mi sošieš.",
       "en": "to sew my dress."
      },
      {
       "cyr": "Ако ми грешиш мерката,",
       "lat": "Ako mi grešiš merkata,",
       "en": "If you get my measurement wrong,"
      },
      {
       "cyr": "дуќанот ќе ти запалам,",
       "lat": "duḱanot ḱe ti zapalam,",
       "en": "I will burn your shop,"
      },
      {
       "cyr": "со него ти да изгориш",
       "lat": "so nego ti da izgoriš",
       "en": "so that you burn with it"
      },
      {
       "cyr": "и твоите лични чираци.",
       "lat": "i tvoite lični čiraci.",
       "en": "and your handsome apprentices."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Коконо, мори коконо,",
       "lat": "- Kokono, mori kokono,",
       "en": "- Lady, hey lady,"
      },
      {
       "cyr": "коконо лична, убава,",
       "lat": "kokono lična, ubava,",
       "en": "handsome, beautiful lady,"
      },
      {
       "cyr": "мерката ти е земена",
       "lat": "merkata ti e zemena",
       "en": "your measurement was taken"
      },
      {
       "cyr": "уште пред две-три недели.",
       "lat": "ušte pred dve-tri nedeli.",
       "en": "already two or three weeks ago."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога од бања идеше,",
       "lat": "Koga od banja ideše,",
       "en": "When you were coming from the bath,"
      },
      {
       "cyr": "сенка во дуќан паѓаше,",
       "lat": "senka vo duḱan paǵaše,",
       "en": "your shadow fell in the shop,"
      },
      {
       "cyr": "тогаш ти мерка зедовме.",
       "lat": "togaš ti merka zedovme.",
       "en": "then we took your measurement."
      }
     ]
    }
   ]
  }
 ],
