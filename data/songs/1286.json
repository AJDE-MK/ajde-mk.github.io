   "stanzas": [
    {
     "lines": [
      {
       "cyr": "И сонцето ко да темне,",
       "lat": "I sonceto ko da temne,",
       "en": "And the sun seems to darken,"
      },
      {
       "cyr": "се скамени лист во гора,",
       "lat": "se skameni list vo gora,",
       "en": "the leaf in the forest turned to stone,"
      },
      {
       "cyr": "а јас и ти земјо неми,",
       "lat": "a jas i ti zemjo nemi,",
       "en": "and I and you, mute land,"
      },
      {
       "cyr": "само љубовта ни збори.",
       "lat": "samo ljubovta ni zbori.",
       "en": "only love speaks to us."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Збогум земјо, убавице,",
       "lat": "Zbogum zemjo, ubavice,",
       "en": "Farewell, land, beautiful one,"
      },
      {
       "cyr": "мојот бисер за на срце,",
       "lat": "mojot biser za na srce,",
       "en": "my pearl for my heart,"
      },
      {
       "cyr": "далеку ме води патот,",
       "lat": "daleku me vodi patot,",
       "en": "the road leads me far away,"
      },
      {
       "cyr": "туѓи луѓе, туѓо јато.",
       "lat": "tuǵi luǵe, tuǵo jato.",
       "en": "among strangers, a foreign flock."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Наведнувам тивко чело,",
       "lat": "Navednuvam tivko čelo,",
       "en": "I bow my head quietly,"
      },
      {
       "cyr": "за разделба стојам простум,",
       "lat": "za razdelba stojam prostum,",
       "en": "I stand simply at the parting,"
      },
      {
       "cyr": "а ти прекрасна и мила,",
       "lat": "a ti prekrasna i mila,",
       "en": "and you, wonderful and dear,"
      },
      {
       "cyr": "ко да чекаш мое „збогум“.",
       "lat": "ko da čekaš moe „zbogum“.",
       "en": "seem to wait for my \"farewell\"."
      }
     ]
    },
