      },
      {
       "cyr": "ни од сонце огреани.",
       "lat": "ni od sonce ogreani.",
       "en": "not warmed by the sun."
      },
      {
       "cyr": "Ни од с'нце огреани,",
       "lat": "Ni od s'nce ogreani,",
       "en": "Not warmed by the sun,"
      },
