 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кинисало малој моме,",
       "lat": "Kinisalo maloj mome,",
       "en": "A young girl went out",
       "en_mt": false
      },
      {
       "cyr": "на горната нива,",
       "lat": "na gornata niva,",
       "en": "up to the field",
       "en_mt": false
      },
      {
       "cyr": "жетва ќе ми жнее, џанам,",
       "lat": "žetva ḱe mi žnee, džanam,",
       "en": "to do the harvesting",
       "en_mt": false
      },
      {
       "cyr": "бела си пченица.",
       "lat": "bela si pčenica.",
       "en": "of beautiful wheat.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Жнеејќи малој моме",
       "lat": "Žneejḱi maloj mome",
       "en": "While she was harvesting",
       "en_mt": false
      },
      {
       "cyr": "бела си пченица,",
       "lat": "bela si pčenica,",
       "en": "that beautiful wheat,",
       "en_mt": false
      },
      {
       "cyr": "од пченица, море џанам,",
       "lat": "od pčenica, more džanam,",
       "en": "from the beautiful wheat,",
       "en_mt": false
      },
      {
       "cyr": "нешто прозборело.",
       "lat": "nešto prozborelo.",
       "en": "something came up,",
       "en_mt": false
      },
      {
       "cyr": "Нешто прозборело, џанам,",
       "lat": "Nešto prozborelo, džanam,",
       "en": "oh yes, something came up,",
       "en_mt": false
      },
      {
       "cyr": "момче неженето.",
       "lat": "momče neženeto.",
       "en": "oh yes, an unmarried boy.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ај остај си, малој моме,",
       "lat": "- Aj ostaj si, maloj mome,",
       "en": "Oh abandon, girl,",
       "en_mt": false
      },
      {
       "cyr": "тоа остро српче,",
       "lat": "toa ostro srpče,",
       "en": "your sharp sickle,",
       "en_mt": false
      },
      {
       "cyr": "да одиме, малој моме,",
       "lat": "da odime, maloj mome,",
       "en": "so we can go",
       "en_mt": false
      },
      {
       "cyr": "при мојата куќа.",
       "lat": "pri mojata kuḱa.",
       "en": "to my house,",
       "en_mt": false
      },
      {
       "cyr": "При мојата куќа, моме,",
       "lat": "Pri mojata kuḱa, mome,",
       "en": "go to my house,",
       "en_mt": false
      },
      {
       "cyr": "невеста да бидеш.",
       "lat": "nevesta da bideš.",
       "en": "so you will be my bride.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стој, почекај, лудо младо,",
       "lat": "- Stoj, počekaj, ludo mlado,",
       "en": "- Stop, wait, you crazy boy,",
       "en_mt": false
      },
      {
       "cyr": "до дома да идам,",
       "lat": "do doma da idam,",
       "en": "so I will go home",
       "en_mt": false
      },
      {
       "cyr": "да ѝ кажам на мајка ми,",
       "lat": "da ì kažam na majka mi,",
       "en": "and talk to my mother,",
       "en_mt": false
      },
      {
       "cyr": "оти ќе се мажам.",
       "lat": "oti ḱe se mažam.",
       "en": "that I am going to marry,",
       "en_mt": false
      },
      {
       "cyr": "Оти ќе се мажам, лудо,",
       "lat": "Oti ḱe se mažam, ludo,",
       "en": "that I am going to marry, crazy lad,",
       "en_mt": false
      },
      {
       "cyr": "за момче богато.",
       "lat": "za momče bogato.",
       "en": "a rich boy.",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
