 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Море на сред село, чешма шарена,",
       "lat": "More na sred selo, češma šarena,",
       "en": "In the middle of the village, a colorful fountain,"
      },
      {
       "cyr": "течеше вода студена.",
       "lat": "tečeše voda studena.",
       "en": "running cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде до чешмата, до две-три моми,",
       "lat": "Ajde do češmata, do dve-tri momi,",
       "en": "Next to the fountain, two or three maids"
      },
      {
       "cyr": "полнеа вода студена.",
       "lat": "polnea voda studena.",
       "en": "were fetching cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде оздол' иде едно лудо младо",
       "lat": "Ajde ozdol' ide edno ludo mlado",
       "en": "From down there here comes a crazy lad"
      },
      {
       "cyr": "на сиво коњче јаваше.",
       "lat": "na sivo konjče javaše.",
       "en": "riding a gray horse."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ај подај ми, моме, едно барде вода",
       "lat": "- Aj podaj mi, mome, edno barde voda",
       "en": "- Hey girl, give me a jug with water"
      },
      {
       "cyr": "во твој'та рака убава.",
       "lat": "vo tvoj'ta raka ubava.",
       "en": "with your pretty hand."
      },
      {
       "cyr": "Ај подај ми, моме, едно барде вода,",
       "lat": "Aj podaj mi, mome, edno barde voda,",
       "en": "Hey, give me, girl, a jug with water,"
      },
      {
       "cyr": "да пијам, да се напијам.",
       "lat": "da pijam, da se napijam.",
       "en": "let me drink and quench my thirst."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре, лудо младо, не си арчи време.",
       "lat": "- A bre, ludo mlado, ne si arči vreme.",
       "en": "- Hey you crazy lad, don't waste your time,"
      },
      {
       "cyr": "либето ми е пред порти,",
       "lat": "libeto mi e pred porti,",
       "en": "my lover is at the gates,"
      },
      {
       "cyr": "ме чека да ме прегрне!",
       "lat": "me čeka da me pregrne!",
       "en": "waiting to put his arms around me!"
      }
     ]
    }
   ]
  }
 ],
