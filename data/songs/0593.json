    {
     "lines": [
      {
       "cyr": "Дафина болна легнала",
       "lat": "Dafina bolna legnala",
       "en": "Dafina lay down sick,"
      },
      {
       "cyr": "над глава до три доктора.",
       "lat": "nad glava do tri doktora.",
       "en": "over her head two or three doctors."
      },
      {
       "cyr": "Болна е, болна ќе умре,",
       "lat": "Bolna e, bolna ḱe umre,",
       "en": "She is sick, sick she will die,"
      },
      {
       "cyr": "ќе умре млада Дафина.",
       "lat": "ḱe umre mlada Dafina.",
       "en": "young Dafina will die."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Мајко ле, стара мајчице",
       "lat": "- Majko le, stara majčice",
       "en": "- Mother, oh, old mother,"
      },
      {
       "cyr": "повикај ми го либето,",
       "lat": "povikaj mi go libeto,",
       "en": "call my sweetheart for me,"
      },
      {
       "cyr": "два збора да му прозборам,",
       "lat": "dva zbora da mu prozboram,",
       "en": "so I can say two words to him,"
      },
      {
       "cyr": "до срце да го изгорам.",
       "lat": "do srce da go izgoram.",
       "en": "to burn his heart through."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дури не мине година,",
       "lat": "Duri ne mine godina,",
       "en": "Until a year has passed,"
      },
      {
       "cyr": "бела руба да не носи.",
       "lat": "bela ruba da ne nosi.",
       "en": "let him not wear white clothes."
      },
      {
       "cyr": "Бела руба да не носи,",
       "lat": "Bela ruba da ne nosi,",
       "en": "Let him not wear white clothes,"
      },
      {
       "cyr": "друго либе да не љуби.",
       "lat": "drugo libe da ne ljubi.",
       "en": "let him not love another sweetheart."
      }
     ]
    }
   ]
