    {
     "lines": [
      {
       "cyr": "Не ме топли ракија,",
       "lat": "Ne me topli rakija,",
       "en": "Rakija doesn't warm me,"
      },
      {
       "cyr": "ниту црно вино,",
       "lat": "nitu crno vino,",
       "en": "nor does red wine,"
      },
      {
       "cyr": "само ти, само ти,",
       "lat": "samo ti, samo ti,",
       "en": "only you, only you,"
      },
      {
       "cyr": "твоите топли прегратки.",
       "lat": "tvoite topli pregratki.",
       "en": "your warm embraces."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да не лажеш, не,",
       "lat": "Da ne lažeš, ne,",
       "en": "Don't lie to me, no,"
      },
