   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Откако те млада заљубив",
       "lat": "Otkako te mlada zaljubiv",
       "en": "Since I fell in love with you since young age"
      },
      {
       "cyr": "и по тебе памет изгубив.",
       "lat": "i po tebe pamet izgubiv.",
       "en": "I lost my mind because of you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нели ти стига мојата младост,",
       "lat": "Neli ti stiga mojata mladost,",
       "en": "Isn't my youth enough for you,"
      },
      {
       "cyr": "кажи ми ти?",
       "lat": "kaži mi ti?",
       "en": "tell me?"
      },
      {
       "cyr": "И на мојте зборој",
       "lat": "I na mojte zboroj",
       "en": "And start believing"
      },
      {
       "cyr": "поверувај ми.",
       "lat": "poveruvaj mi.",
       "en": "in my words."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сè што имав, сè ти подарив,",
       "lat": "Sè što imav, sè ti podariv,",
       "en": "Everything I had, I gave you all,"
      },
      {
       "cyr": "сета младост си ја изгубив.",
       "lat": "seta mladost si ja izgubiv.",
       "en": "I lost all my youth."
      }
     ]
    },
