   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мома оди за вода,",
       "lat": "Moma odi za voda,",
       "en": "A girl fetches water,"
      },
      {
       "cyr": "и беќаро по неа:",
       "lat": "i beḱaro po nea:",
       "en": "and the boy goes after her:"
      },
      {
       "cyr": "- Постој моме, почекај,",
       "lat": "- Postoj mome, počekaj,",
       "en": "- Hold on, girl, wait a second,"
      },
      {
       "cyr": "да ти речам два збора.",
       "lat": "da ti rečam dva zbora.",
       "en": "I want to tell you a word or two."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дејгиди моме убаво,",
       "lat": "Dejgidi mome ubavo,",
       "en": "Hey, beautiful girl,"
      },
      {
       "cyr": "деј гиди севдо голема.",
       "lat": "dej gidi sevdo golema.",
       "en": "hey, my big love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Да ми дадиш тро вода,",
       "lat": "- Da mi dadiš tro voda,",
       "en": "- Give me some water,"
      },
      {
       "cyr": "да улада срцето.",
       "lat": "da ulada srceto.",
       "en": "to cool down my heart."
      },
      {
       "cyr": "Се измами момето,",
       "lat": "Se izmami mometo,",
       "en": "The girl took the bait"
      },
      {
       "cyr": "му подаде стомнето.",
       "lat": "mu podade stomneto.",
       "en": "and gave him the pitcher."
      }
     ]
    },
    {
     "lines": [
