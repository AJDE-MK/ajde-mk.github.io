      {
       "cyr": "- Мариче ле, лично, девојче,",
       "lat": "- Mariče le, lično, devojče,",
       "en": "- Marica, oh, lovely girl,"
      },
      {
       "cyr": "умирам загин'вам за тебе,",
       "lat": "umiram zagin'vam za tebe,",
       "en": "I am dying, perishing for you,"
      },
      {
       "cyr": "оф, аман, аман, аман,",
