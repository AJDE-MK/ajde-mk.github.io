   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мајка сина прашува:",
       "lat": "Majka sina prašuva:",
       "en": "A mother asks her son:"
      },
      {
       "cyr": "- Каде сине по ноќе?",
       "lat": "- Kade sine po noḱe?",
       "en": "- \"Where have you been, son, out in the night?"
      },
      {
       "cyr": "Цел ноќ мајка не спие,",
       "lat": "Cel noḱ majka ne spie,",
       "en": "All night long your mother hasn't slept,"
      },
      {
       "cyr": "тебе чека да дојдеш.",
       "lat": "tebe čeka da dojdeš.",
       "en": "waiting for you to return.\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мајка сина прашува:",
       "lat": "Majka sina prašuva:",
       "en": "A mother asks her son:"
      },
      {
       "cyr": "- Каде сине по ноќе?",
       "lat": "- Kade sine po noḱe?",
       "en": "- \"Where have you been, son, out in the night?"
      },
      {
       "cyr": "Нешто криеш, тагуваш,",
       "lat": "Nešto krieš, taguvaš,",
       "en": "You are hiding something, you are full of sorrow,"
      },
      {
       "cyr": "срце не си отвораш.",
       "lat": "srce ne si otvoraš.",
       "en": "you do not open your heart.\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ах мори мајко, не знаеш,",
       "lat": "- Ah mori majko, ne znaeš,",
       "en": "- \"Oh, Mother, you do not know,"
      },
      {
       "cyr": "срце ми е скршено.",
       "lat": "srce mi e skršeno.",
       "en": "my heart is broken."
      },
      {
       "cyr": "Моме што си заљубив",
       "lat": "Mome što si zaljubiv",
       "en": "The girl I fell in love with"
      },
      {
       "cyr": "за друг ми е ветено.",
       "lat": "za drug mi e veteno.",
       "en": "has been promised to another.\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ах мори мајко, не знаеш,",
       "lat": "Ah mori majko, ne znaeš,",
       "en": "\"Oh, Mother, you do not know,"
      },
      {
       "cyr": "срце ми е скршено.",
       "lat": "srce mi e skršeno.",
       "en": "my heart is broken."
      },
      {
       "cyr": "Мајка ѝ не ја дава,",
       "lat": "Majka ì ne ja dava,",
       "en": "Her mother will not give her to me;"
      },
      {
       "cyr": "сиромав сум за неа.",
       "lat": "siromav sum za nea.",
       "en": "I am too poor for her.\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Немој сине, не знаат,",
       "lat": "- Nemoj sine, ne znaat,",
       "en": "- \"Do not say that, my son, they do not know,"
      },
      {
       "cyr": "ти си ми најбогато.",
       "lat": "ti si mi najbogato.",
       "en": "to me, you are the richest of all."
      },
      {
       "cyr": "Срце ти е планина,",
       "lat": "Srce ti e planina,",
       "en": "Your heart is like a mountain,"
      },
      {
       "cyr": "душа - порта црковна.",
       "lat": "duša - porta crkovna.",
       "en": "your soul is like the gateway to a church."
      },
      {
       "cyr": "Секој внатре штом влезе",
       "lat": "Sekoj vnatre štom vleze",
       "en": "Whoever enters within"
      },
      {
       "cyr": "таму љубов ќе најде.",
       "lat": "tamu ljubov ḱe najde.",
       "en": "will find love waiting there."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море, синко бре!",
       "lat": "More, sinko bre!",
       "en": "Oh, my dear son!\""
      }
     ]
    }
