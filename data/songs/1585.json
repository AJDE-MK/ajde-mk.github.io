   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Запеј песна мори моме,",
       "lat": "- Zapej pesna mori mome,",
       "en": "- Sing a song, hey girl,"
      },
      {
       "cyr": "да се чуе в Ново село,",
       "lat": "da se čue v Novo selo,",
       "en": "so it can be heard in Novo Selo,"
      },
      {
       "cyr": "Ново село кај изворо,",
       "lat": "Novo selo kaj izvoro,",
       "en": "Novo Selo by the spring,"
      },
      {
       "cyr": "кај изворот, кај Л'џите.",
       "lat": "kaj izvorot, kaj L'džite.",
       "en": "by the spring, by L'dzhite."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Каква песна да запеам",
       "lat": "- Kakva pesna da zapeam",
       "en": "- What song shall I sing,"
      },
      {
       "cyr": "море лудо, море младо,",
       "lat": "more ludo, more mlado,",
       "en": "hey lad, hey young one,"
      },
      {
       "cyr": "дал' жалосна ил радосна,",
       "lat": "dal' žalosna il radosna,",
       "en": "sad or joyful,"
      },
      {
       "cyr": "за нашата вечна љубов?",
       "lat": "za našata večna ljubov?",
       "en": "about our eternal love?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дојди моме кај изворо,",
       "lat": "- Dojdi mome kaj izvoro,",
       "en": "- Come, girl, to the spring,"
      },
      {
       "cyr": "кај изворо кај Л'џите.",
       "lat": "kaj izvoro kaj L'džite.",
       "en": "to the spring by L'dzhite."
      },
      {
       "cyr": "Ќе пееме, ќе збориме",
       "lat": "Ḱe peeme, ḱe zborime",
       "en": "We will sing, we will talk"
      },
      {
       "cyr": "за нашата вечна љубов.",
       "lat": "za našata večna ljubov.",
       "en": "about our eternal love."
