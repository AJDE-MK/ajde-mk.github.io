 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Зурли трештат на сред село,",
       "lat": "Zurli treštat na sred selo,",
       "en": "Zurnas are blasting in the middle of the village,"
      },
      {
       "cyr": "тапан бие рум-дум-дум,",
       "lat": "tapan bie rum-dum-dum,",
       "en": "The drum beats rum-dum-dum,"
      },
      {
       "cyr": "млади моми и ергени,",
       "lat": "mladi momi i ergeni,",
       "en": "Young girls and boys"
      },
      {
       "cyr": "до две ора вијат.",
       "lat": "do dve ora vijat.",
       "en": "dance in pairs and swivel."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оздола иде стар бел дедо,",
       "lat": "Ozdola ide star bel dedo,",
       "en": "From below comes an old white-haired grandpa,"
      },
      {
       "cyr": "засукал мустаќи,",
       "lat": "zasukal mustaḱi,",
       "en": "Rolling up his moustache,"
      },
      {
       "cyr": "право трга на орото",
       "lat": "pravo trga na oroto",
       "en": "Heading straight to the dance,"
      },
      {
       "cyr": "и тој да се фати.",
       "lat": "i toj da se fati.",
       "en": "Wanting to join in."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го здогледа баба Неда,",
       "lat": "Go zdogleda baba Neda,",
       "en": "Grandma Neda sees him,"
      },
      {
       "cyr": "за рака го фати:",
       "lat": "za raka go fati:",
       "en": "And grabs him by the hand:"
      },
      {
       "cyr": "- Каде одиш старо-аро,",
       "lat": "- Kade odiš staro-aro,",
       "en": "\"Where are you going, you old goat"
      },
      {
       "cyr": "оро да им грдиш?",
       "lat": "oro da im grdiš?",
       "en": "To spoil their dance?\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стој, почекај баба Недо,",
       "lat": "Stoj, počekaj baba Nedo,",
       "en": "\"Wait, hold on, Grandma Neda,"
      },
      {
       "cyr": "до моми да играм,",
       "lat": "do momi da igram,",
       "en": "I want to join the dance,"
      },
      {
       "cyr": "да се фатам до момите,",
       "lat": "da se fatam do momite,",
       "en": "To catch up with the young girls,"
      },
      {
       "cyr": "срце да разиграм.",
       "lat": "srce da razigram.",
       "en": "And make my heart rejoice.\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Рум-дум-рум-дум-рум-дум-рум,",
       "lat": "Rum-dum-rum-dum-rum-dum-rum,",
       "en": "Rum-dum-rum-dum-rum-dum-rum,"
      },
      {
       "cyr": "рум-дум-рум-дум-рум-дум-дум!",
       "lat": "rum-dum-rum-dum-rum-dum-dum!",
       "en": "Rum-dum-rum-dum-rum-dum-dum!"
      }
     ]
    }
   ]
  }
 ],
