    {
     "lines": [
      {
       "cyr": "Меѓу нас го нема веќе",
       "lat": "Meǵu nas go nema veḱe",
       "en": "He is no longer among us,"
      },
      {
       "cyr": "наш Никола Бадев,",
       "lat": "naš Nikola Badev,",
       "en": "our Nikola Badev,"
      },
      {
       "cyr": "да запее, да засвири,",
       "lat": "da zapee, da zasviri,",
       "en": "to sing, to play,"
      },
      {
       "cyr": "да нè развесели,",
       "lat": "da nè razveseli,",
       "en": "to cheer us up,"
      },
      {
       "cyr": "да засвири на тамбура",
       "lat": "da zasviri na tambura",
       "en": "to play the tambura"
      },
      {
       "cyr": "и да нè весели.",
       "lat": "i da nè veseli.",
       "en": "and to cheer us up."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Со негова песна",
       "lat": "So negova pesna",
       "en": "With his song"
      },
      {
       "cyr": "секој се весели,",
       "lat": "sekoj se veseli,",
       "en": "everyone is merry,"
      },
      {
