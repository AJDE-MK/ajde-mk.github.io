      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Петро ле, пиле шарено,",
       "lat": "- Petro le, pile šareno,",
       "en": "- Petra, colorful bird,",
       "en_mt": false
      },
      {
       "cyr": "Петро ле пиле галено,",
       "lat": "Petro le pile galeno,",
       "en": "Petra, pet bird,",
       "en_mt": false
      },
      {
       "cyr": "а што си толку убава,",
       "lat": "a što si tolku ubava,",
       "en": "How is it you are so beautiful?",
       "en_mt": false
      },
      {
       "cyr": "а што си толку убава?",
       "lat": "a što si tolku ubava?",
       "en": "How is it you are so beautiful?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дал' си од бога паднала,",
       "lat": "Dal' si od boga padnala,",
       "en": "Did you fall from God,",
       "en_mt": false
      },
      {
       "cyr": "дал' си од бога паднала,",
       "lat": "dal' si od boga padnala,",
       "en": "Did you fall from God,",
       "en_mt": false
      },
      {
       "cyr": "или у бавча никнала,",
       "lat": "ili u bavča niknala,",
       "en": "or did you spring from a garden?",
       "en_mt": false
      },
      {
       "cyr": "или у бавча никнала?",
       "lat": "ili u bavča niknala?",
       "en": "or did you spring from a garden?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дејгиди лудо, бре младо,",
       "lat": "- Dejgidi ludo, bre mlado,",
       "en": "- Don't be silly, boy,",
       "en_mt": false
      },
      {
       "cyr": "нит' сум од бога паднала,",
       "lat": "nit' sum od boga padnala,",
       "en": "I didn't fall from God,",
       "en_mt": false
      },
      {
       "cyr": "ниту од бавча никнала,",
       "lat": "nitu od bavča niknala,",
       "en": "nor did I spring from the garden.",
       "en_mt": false
      },
      {
       "cyr": "ниту од бавча никнала.",
       "lat": "nitu od bavča niknala.",
       "en": "nor did I spring from the garden.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И мене мајка родила,",
       "lat": "I mene majka rodila,",
       "en": "My mother bore me,",
       "en_mt": false
      },
      {
       "cyr": "и мене мајка родила,",
       "lat": "i mene majka rodila,",
       "en": "My mother bore me,",
       "en_mt": false
      },
      {
       "cyr": "и мене како и тебе,",
       "lat": "i mene kako i tebe,",
       "en": "just as yours did you.",
       "en_mt": false
      },
      {
       "cyr": "и мене како и тебе.",
       "lat": "i mene kako i tebe.",
       "en": "just as yours did you.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога ме мајка родила,",
       "lat": "Koga me majka rodila,",
       "en": "When my mother bore me,",
       "en_mt": false
      },
      {
       "cyr": "кога ме мајка родила,",
       "lat": "koga me majka rodila,",
       "en": "When my mother bore me,",
       "en_mt": false
      },
      {
       "cyr": "со пресно млеко доила,",
       "lat": "so presno mleko doila,",
       "en": "she nursed me with fresh milk,",
       "en_mt": false
      },
      {
       "cyr": "со рујно вино поила.",
       "lat": "so rujno vino poila.",
       "en": "she washed me with red wine.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
