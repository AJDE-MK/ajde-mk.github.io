   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Од врв Пирин Планина",
       "lat": "Od vrv Pirin Planina",
       "en": "From the peak of Pirin Mountain"
      },
      {
       "cyr": "очаен глас се слуша,",
       "lat": "očaen glas se sluša,",
       "en": "a despairing voice is heard,"
      },
      {
       "cyr": "Македонија плаче.",
       "lat": "Makedonija plače.",
       "en": "Macedonia is weeping."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проклета и триклета",
       "lat": "Prokleta i trikleta",
       "en": "Cursed and thrice-cursed"
      },
      {
       "cyr": "да бидиш ти Европо,",
       "lat": "da bidiš ti Evropo,",
       "en": "may you be, Europe,"
      },
      {
       "cyr": "блуднице вавилонска.",
       "lat": "bludnice vavilonska.",
       "en": "Babylonian harlot."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Французи, Англичани,",
       "lat": "Francuzi, Angličani,",
       "en": "Frenchmen, Englishmen,"
      },
      {
       "cyr": "Италијанци и Немци,",
       "lat": "Italijanci i Nemci,",
       "en": "Italians and Germans,"
      },
      {
       "cyr": "сакаат да сме под ропство.",
       "lat": "sakaat da sme pod ropstvo.",
       "en": "want us to be in bondage."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од рода сум Славјанка,",
       "lat": "Od roda sum Slavjanka,",
       "en": "I am of Slavic stock,"
      },
      {
       "cyr": "земја со злато полна,",
       "lat": "zemja so zlato polna,",
       "en": "a land full of gold,"
      },
      {
       "cyr": "зато завижџет толку.",
       "lat": "zato zaviždžet tolku.",
       "en": "that is why they envy so much."
      }
     ]
    }
   ]
  }
 ],
