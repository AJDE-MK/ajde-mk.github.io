    {
     "lines": [
      {
       "cyr": "Што е чудо станало",
       "lat": "Što e čudo stanalo",
       "en": "What a wonder has happened"
      },
      {
       "cyr": "во таа пуста Гуменџа,",
       "lat": "vo taa pusta Gumendža,",
       "en": "in that deserted Gumendzha,"
      },
      {
       "cyr": "војводите врвеа, калдрми се тресеа,",
       "lat": "vojvodite vrvea, kaldrmi se tresea,",
       "en": "the voivodes were marching, the cobblestones were shaking,"
      },
      {
       "cyr": "војводите врвеа, калдрми се тресеа.",
       "lat": "vojvodite vrvea, kaldrmi se tresea.",
       "en": "the voivodes were marching, the cobblestones were shaking."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Најнапред ми врвеше",
       "lat": "Najnapred mi vrveše",
       "en": "In front of all marched"
      },
      {
       "cyr": "тој ми стари Апостол,",
       "lat": "toj mi stari Apostol,",
       "en": "that old Apostol,"
      },
      {
       "cyr": "и по него врвеше тој Иванчо војвода,",
       "lat": "i po nego vrveše toj Ivančo vojvoda,",
       "en": "and after him marched that voivode Ivancho,"
      },
      {
       "cyr": "и по него врвеше тој Иванчо војвода.",
       "lat": "i po nego vrveše toj Ivančo vojvoda.",
       "en": "and after him marched that voivode Ivancho."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што им вели Апостол:",
       "lat": "Što im veli Apostol:",
       "en": "What Apostol says to them:"
      },
      {
       "cyr": "- Тивко, тивко, момчиња,",
       "lat": "- Tivko, tivko, momčinja,",
       "en": "- Quietly, quietly, lads,"
      },
      {
       "cyr": "да не чујат шпиони, шпиони чорбаџиски,",
       "lat": "da ne čujat špioni, špioni čorbadžiski,",
       "en": "so the spies do not hear, the spies of the wealthy,"
      },
      {
       "cyr": "да фатиме пусија, пусија Гевгелија.",
       "lat": "da fatime pusija, pusija Gevgelija.",
       "en": "so we can catch the ambush, the ambush of Gevgelija."
