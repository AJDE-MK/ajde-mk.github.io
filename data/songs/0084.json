    {
     "lines": [
      {
       "cyr": "Стани, стани, лудо младо,",
       "lat": "Stani, stani, ludo mlado,",
       "en": "Get up, get up, young fool,"
      },
      {
       "cyr": "лудо младо, неженето.",
       "lat": "ludo mlado, neženeto.",
       "en": "young fool, unmarried,"
      }
     ]
    },
    {
     "lines": [
      {
