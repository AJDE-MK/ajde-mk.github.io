   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Цвете мило, кога би знаело,",
       "lat": "Cvete milo, koga bi znaelo,",
       "en": "Dear flower, if you only knew"
      },
      {
       "cyr": "мојте маки на срце.",
       "lat": "mojte maki na srce.",
       "en": "the troubles of my heart."
      },
      {
       "cyr": "Од жалост затреперило",
       "lat": "Od žalost zatreperilo",
       "en": "From sorrow it trembled,"
      },
      {
       "cyr": "мојто ангелско лице.",
       "lat": "mojto angelsko lice.",
       "en": "my angelic face."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На јасната Месечина,",
       "lat": "Na jasnata Mesečina,",
       "en": "In the bright moonlight,"
      },
      {
       "cyr": "кога го чуеш славејот,",
       "lat": "koga go čueš slavejot,",
       "en": "when you hear the nightingale,"
      },
      {
       "cyr": "приспомни си ти за мене,",
       "lat": "prispomni si ti za mene,",
       "en": "remember me,"
      },
      {
       "cyr": "јас за тебе умирам.",
       "lat": "jas za tebe umiram.",
       "en": "I am dying for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако умрам, душо моја,",
       "lat": "Ako umram, dušo moja,",
       "en": "If I die, my soul,"
      },
      {
       "cyr": "носи поздрав ти славен:",
       "lat": "nosi pozdrav ti slaven:",
       "en": "carry this glorious greeting:"
      },
      {
       "cyr": "заспа со мир на душата,",
       "lat": "zaspa so mir na dušata,",
       "en": "he fell asleep with peace in his soul,"
      },
      {
       "cyr": "една солза пророна.",
       "lat": "edna solza prorona.",
       "en": "he shed one tear."
      }
     ]
    }
   ]
  }
