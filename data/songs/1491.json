   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Јас сум пусти бекрија,",
       "lat": "Jas sum pusti bekrija,",
       "en": "I am a desolate drunkard,"
      },
      {
       "cyr": "пијам лута ракија,",
       "lat": "pijam luta rakija,",
       "en": "I drink strong brandy,"
      },
      {
       "cyr": "ајде, изгоре срце рането",
       "lat": "ajde, izgore srce raneto",
       "en": "come on, my wounded heart burned,"
      },
      {
       "cyr": "од болките мачна душа е,",
       "lat": "od bolkite mačna duša e,",
       "en": "from the pains the soul is tormented,"
      },
      {
       "cyr": "за либето на верен побратим.",
       "lat": "za libeto na veren pobratim.",
       "en": "for the beloved of a faithful sworn brother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Меани, црнила, меани проклети,",
       "lat": "Meani, crnila, meani prokleti,",
       "en": "Taverns, blackness, accursed taverns,"
      },
      {
       "cyr": "што ме мене запустивте.",
       "lat": "što me mene zapustivte.",
       "en": "you who have ruined me."
      },
      {
       "cyr": "Меани, црнила, меани проклети,",
       "lat": "Meani, crnila, meani prokleti,",
       "en": "Taverns, blackness, accursed taverns,"
      },
      {
       "cyr": "што ми живот зацрнивте.",
       "lat": "što mi život zacrnivte.",
       "en": "you who have blackened my life."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Љубов моја несреќна,",
       "lat": "Ljubov moja nesreḱna,",
       "en": "My unhappy love,"
      },
      {
       "cyr": "ќе е в' срце оставена,",
       "lat": "ḱe e v' srce ostavena,",
       "en": "it will stay left in my heart,"
      },
      {
       "cyr": "ај, в' очи солзи навираат",
       "lat": "aj, v' oči solzi naviraat",
       "en": "oh, tears well up in my eyes"
      },
      {
       "cyr": "и пред очи ликој гледам јас,",
       "lat": "i pred oči likoj gledam jas,",
       "en": "and I see a face before my eyes,"
      },
      {
       "cyr": "а срцево ќе пукне по тебе.",
       "lat": "a srcevo ḱe pukne po tebe.",
       "en": "and this heart will burst for you."
      }
