     "lines": [
      {
       "cyr": "Сива, сива Василице,",
       "lat": "Siva, siva Vasilice,",
       "en": "Grey, grey Vasilica,"
      },
      {
       "cyr": "каде си се осивила?",
       "lat": "kade si se osivila?",
       "en": "where did you turn grey?"
      },
      {
       "cyr": "- Таму долу, на бел Дунав.",
       "lat": "- Tamu dolu, na bel Dunav.",
       "en": "- Down there, on the white Danube."
      },
      {
       "cyr": "Што имаше, што немаше?",
       "lat": "Što imaše, što nemaše?",
       "en": "What did you have, what didn't you have?"
      },
      {
       "cyr": "- Златна чаша и икона.",
       "lat": "- Zlatna čaša i ikona.",
       "en": "- A golden cup and an icon."
      },
      {
       "cyr": "- Ееј, ОТВОРИ, ДОМАЌИНЕ!",
       "lat": "- Eej, OTVORI, DOMAḰINE!",
       "en": "- Heey, OPEN UP, MASTER OF THE HOUSE!"
      }
     ]
    }
   ]
