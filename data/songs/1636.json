   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ранет ми лежи млад Стојан,",
       "lat": "Ranet mi leži mlad Stojan,",
       "en": "Young Stoyan lies wounded,"
      },
      {
       "cyr": "млад Стојан, млад војвода,",
       "lat": "mlad Stojan, mlad vojvoda,",
       "en": "young Stoyan, young voyvoda,"
      },
      {
       "cyr": "низ таја гора зелена,",
       "lat": "niz taja gora zelena,",
       "en": "through that green mountain,"
      },
      {
       "cyr": "низ таа Пирин планина.",
       "lat": "niz taa Pirin planina.",
       "en": "through that Pirin mountain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Немало никој никаде",
       "lat": "Nemalo nikoj nikade",
       "en": "There was no one anywhere"
      },
      {
       "cyr": "водица да му подаде,",
       "lat": "vodica da mu podade,",
       "en": "to give him water,"
      },
      {
       "cyr": "водица даму подаде,",
       "lat": "vodica damu podade,",
       "en": "to give him some water,"
      },
      {
       "cyr": "сенка да му напрaви.",
       "lat": "senka da mu napravi.",
       "en": "to make him a shadow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Голема гора думаше:",
       "lat": "Golema gora dumaše:",
       "en": "A great mountain was saying:"
      },
      {
       "cyr": "- Капете лисја, капете,",
       "lat": "- Kapete lisja, kapete,",
       "en": "- Drop leaves, drop,"
      },
      {
       "cyr": "капете лисја, капете,",
       "lat": "kapete lisja, kapete,",
       "en": "drop leaves, drop,"
      },
      {
       "cyr": "покријте ми гробот студен.",
       "lat": "pokrijte mi grobot studen.",
       "en": "cover my cold grave."
      }
     ]
    }
   ]
  }
 ],
