   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Брале ми се, се собрале,",
       "lat": "Brale mi se, se sobrale,",
       "en": "Brothers, they gathered together,"
      },
      {
       "cyr": "седнати одбор Македонци,",
       "lat": "sednati odbor Makedonci,",
       "en": "sat down in a council, the Macedonians,"
      },
      {
       "cyr": "Право ми тргаат Кожуф Планина,",
       "lat": "Pravo mi trgaat Kožuf Planina,",
       "en": "they head straight for Kozhuf Mountain,"
      },
      {
       "cyr": "Кожуф Планина, в' темни пештери.",
       "lat": "Kožuf Planina, v' temni pešteri.",
       "en": "Kozhuf Mountain, into dark caves."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дур' ми стигнале, легнале,",
       "lat": "Dur' mi stignale, legnale,",
       "en": "Until they arrived, they lay down,"
      },
      {
       "cyr": "дур' ми легнале, заспале,",
       "lat": "dur' mi legnale, zaspale,",
       "en": "until they lay down, they fell asleep,"
      },
      {
       "cyr": "сон ми сонува Габерот,",
       "lat": "son mi sonuva Gaberot,",
       "en": "Gaber dreams a dream,"
      },
      {
       "cyr": "Габерот, Димче даскалот.",
       "lat": "Gaberot, Dimče daskalot.",
       "en": "Gaber, Dimche the teacher."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Црно ми го куче изело,",
       "lat": "Crno mi go kuče izelo,",
       "en": "A black dog ate"
      },
      {
       "cyr": "во левана страна, срцето,",
       "lat": "vo levana strana, srceto,",
       "en": "his heart on the left side,"
      },
      {
       "cyr": "во деснана нога, колено.",
       "lat": "vo desnana noga, koleno.",
       "en": "his knee in the right leg."
      },
      {
       "cyr": "- Мајко, јаска ќе си умрам",
       "lat": "- Majko, jaska ḱe si umram",
       "en": "- Mother, I will die"
      },
      {
       "cyr": "за наш'та Македонија.",
       "lat": "za naš'ta Makedonija.",
       "en": "for our Macedonia."
      }
     ]
    }
   ]
  }
