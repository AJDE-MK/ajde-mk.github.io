    {
     "lines": [
      {
       "cyr": "(Султана јунак родила)",
       "lat": "(Sultana junak rodila)",
       "en": "(Sultana gave birth to a hero)"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Песни се слушаат весели,",
       "lat": "Pesni se slušaat veseli,",
       "en": "Cheerful songs are heard,"
      },
      {
       "cyr": "Кукуш се крева на гости,",
       "lat": "Kukuš se kreva na gosti,",
       "en": "Kukush rises to be guests,"
      },
      {
       "cyr": "Никола срце разврзал,",
       "lat": "Nikola srce razvrzal,",
       "en": "Nikola unties his heart,"
      },
      {
       "cyr": "Султана јунак родила.",
       "lat": "Sultana junak rodila.",
       "en": "Sultana gave birth to a hero."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пламен е Гоце в пелени,",
       "lat": "Plamen e Goce v peleni,",
       "en": "Goce in swaddling clothes is a flame,"
      },
      {
       "cyr": "сокол му љуља лулката,",
       "lat": "sokol mu ljulja lulkata,",
       "en": "a falcon rocks his cradle,"
      },
      {
       "cyr": "над глава три самовили,",
       "lat": "nad glava tri samovili,",
       "en": "above his head three fairies"
      },
      {
       "cyr": "песни му пеат јуначки.",
       "lat": "pesni mu peat junački.",
       "en": "sing him heroic songs."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Расни ми, Гоце, порасни,",
       "lat": "- Rasni mi, Goce, porasni,",
       "en": "- Grow, Goce, grow up,"
      },
      {
       "cyr": "славен ти јунак да станеш,",
       "lat": "slaven ti junak da staneš,",
       "en": "may you become a famed hero,"
      },
      {
       "cyr": "народот ти да го водиш",
       "lat": "narodot ti da go vodiš",
       "en": "may you lead your people"
      },
      {
       "cyr": "в' борба за света слобода.",
       "lat": "v' borba za sveta sloboda.",
       "en": "in the fight for holy freedom."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Со твојта верна дружина,",
       "lat": "- So tvojta verna družina,",
       "en": "- With your faithful band,"
      },
      {
       "cyr": "со душман ти да се биеш,",
       "lat": "so dušman ti da se bieš,",
       "en": "may you fight the enemy,"
      },
      {
       "cyr": "чумата да ја истераш",
       "lat": "čumata da ja isteraš",
       "en": "may you drive out the plague"
      },
      {
       "cyr": "од жална Македонија.",
       "lat": "od žalna Makedonija.",
       "en": "from sorrowful Macedonia."
      }
     ]
    }
   ]
  }
 ],
