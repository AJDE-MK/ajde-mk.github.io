   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Црно му било пишано",
       "lat": "Crno mu bilo pišano",
       "en": "Black was written for him,"
      },
      {
       "cyr": "на Александро Турунџе,",
       "lat": "na Aleksandro Turundže,",
       "en": "for Aleksandar Turundzhe,"
      },
      {
       "cyr": "шеснајсгодишен војвода,",
       "lat": "šesnajsgodišen vojvoda,",
       "en": "a sixteen-year-old leader,"
      },
      {
       "cyr": "на седумнајста го фатија.",
       "lat": "na sedumnajsta go fatija.",
       "en": "they caught him at seventeen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го турија во зандани,",
       "lat": "Go turija vo zandani,",
       "en": "They threw him in the dungeons,"
      },
      {
       "cyr": "во тие тесни долапи,",
       "lat": "vo tie tesni dolapi,",
       "en": "in those narrow cupboards,"
      },
      {
       "cyr": "чифте белегзии на раце,",
       "lat": "čifte belegzii na race,",
       "en": "a pair of shackles on his hands,"
      },
      {
       "cyr": "и дробен синџир на гуша.",
       "lat": "i droben sindžir na guša.",
       "en": "and a thin chain on his neck."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Телеграм дојде од Стамбол",
       "lat": "Telegram dojde od Stambol",
       "en": "A telegram came from Istanbul"
      },
      {
       "cyr": "за Александар Турунџе,",
       "lat": "za Aleksandar Turundže,",
       "en": "about Aleksandar Turundzhe,"
      },
      {
       "cyr": "да си ја види невестата",
       "lat": "da si ja vidi nevestata",
       "en": "that he may see his bride"
      },
      {
       "cyr": "и својте дробни дечиња.",
       "lat": "i svojte drobni dečinja.",
       "en": "and his little children."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го изведоа на Ат-пазар,",
       "lat": "Go izvedoa na At-pazar,",
       "en": "They led him out to the Horse Market,"
      },
      {
       "cyr": "му ја кажаја бесилката,",
       "lat": "mu ja kažaja besilkata,",
       "en": "they showed him the gallows,"
      },
      {
       "cyr": "цела се Битола расплака,",
       "lat": "cela se Bitola rasplaka,",
       "en": "the whole of Bitola wept"
      },
      {
       "cyr": "за Александро Турунџе.",
       "lat": "za Aleksandro Turundže.",
       "en": "for Aleksandar Turundzhe."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Бог да убие кодошот,",
       "lat": "Bog da ubie kodošot,",
       "en": "May God strike down the informer,"
      },
      {
       "cyr": "кодошот Митре Гинката,",
       "lat": "kodošot Mitre Ginkata,",
       "en": "the informer Mitre Ginkata,"
      },
      {
       "cyr": "што го предаде Турунџе,",
       "lat": "što go predade Turundže,",
       "en": "who betrayed Turundzhe,"
      },
      {
       "cyr": "тој неустрашен бунтовник.",
       "lat": "toj neustrašen buntovnik.",
       "en": "that fearless rebel."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тој го предаде Турунџе,",
       "lat": "Toj go predade Turundže,",
       "en": "He betrayed Turundzhe"
      },
      {
       "cyr": "за сто и пејсет жолтици,",
       "lat": "za sto i pejset žoltici,",
       "en": "for one hundred and sixty gold coins,"
      },
      {
       "cyr": "за сто и пеесет жолтици,",
       "lat": "za sto i peeset žoltici,",
       "en": "for one hundred and fifty gold coins,"
      },
      {
       "cyr": "на тие клети душмани.",
       "lat": "na tie kleti dušmani.",
       "en": "to those accursed enemies."
      }
     ]
    }
   ]
  }
