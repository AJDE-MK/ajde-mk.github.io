       "lat": "Na son mi došle tri ludi:",
       "en": "In my dream came three young men:"
      },
      {
       "cyr": "прво ми даде јаболко.",
       "lat": "prvo mi dade jabolko.",
       "en": "the first one gave me an apple."
      },
      {
       "cyr": "Прво ми даде јаболко,",
       "lat": "Prvo mi dade jabolko,",
       "en": "The first one gave me an apple,"
      },
      {
       "cyr": "второ ми даде злат прстен,",
       "lat": "vtoro mi dade zlat prsten,",
       "en": "the second gave me a gold ring,"
      },
      {
       "cyr": "второ ми даде злат прстен,",
       "lat": "vtoro mi dade zlat prsten,",
       "en": "the second gave me a gold ring,"
      },
      {
       "cyr": "треќо ме мене целива.",
       "lat": "treḱo me mene celiva.",
       "en": "the third one kissed me."
