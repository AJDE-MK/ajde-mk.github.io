   "stanzas": [
    {
     "lines": [
      {
       "cyr": "По поле одат аргати,",
       "lat": "Po pole odat argati,",
       "en": "Field-workers walk across the field,"
      },
      {
       "cyr": "аргати млади невести,",
       "lat": "argati mladi nevesti,",
       "en": "field-workers, young brides,"
      },
      {
       "cyr": "афион ќе ми копаат,",
       "lat": "afion ḱe mi kopaat,",
       "en": "they will dig opium poppies for me,"
      },
      {
       "cyr": "по тие ниви велешки.",
       "lat": "po tie nivi veleški.",
       "en": "on those fields of Veles."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Патот го води Гроздана,",
       "lat": "Patot go vodi Grozdana,",
       "en": "Grozdana leads the way,"
      },
      {
       "cyr": "Гроздана, мома убава",
       "lat": "Grozdana, moma ubava",
       "en": "Grozdana, a beautiful girl,"
      },
      {
       "cyr": "и по неа Невена,",
       "lat": "i po nea Nevena,",
       "en": "and after her Nevena,"
      },
      {
       "cyr": "Невена Георгиева.",
       "lat": "Nevena Georgieva.",
       "en": "Nevena Georgieva."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Песни ми пеат ајдучки,",
       "lat": "Pesni mi peat ajdučki,",
       "en": "They sing haiduk songs to me,"
      },
      {
       "cyr": "ајдучки, ем партизански",
       "lat": "ajdučki, em partizanski",
       "en": "haiduk and also partisan,"
      },
      {
       "cyr": "и во песните зборуваат:",
       "lat": "i vo pesnite zboruvaat:",
       "en": "and in the songs they say:"
      },
      {
       "cyr": "„смрт или слобода“.",
       "lat": "„smrt ili sloboda“.",
       "en": "\"death or freedom\"."
      }
     ]
    }
   ]
  }
