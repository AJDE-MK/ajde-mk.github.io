 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Пуста младост мамо, пуста младост.",
       "lat": "Pusta mladost mamo, pusta mladost.",
       "en": "Futile youth, mother, futile youth,"
      },
      {
       "cyr": "Пуста младост милај мамо, не се стига.",
       "lat": "Pusta mladost milaj mamo, ne se stiga.",
       "en": "futile youth, dear mother, it can't be reached."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не се стига мамо, не се срешча.",
       "lat": "Ne se stiga mamo, ne se srešča.",
       "en": "It can't be reached, mother, it can't be met,"
      },
      {
       "cyr": "Ни се с' пари, милај мамо, не купува.",
       "lat": "Ni se s' pari, milaj mamo, ne kupuva.",
       "en": "even with money, dear mother, it can't be bought."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Младост тече мамо, младост тече.",
       "lat": "Mladost teče mamo, mladost teče.",
       "en": "The youth flows, mother, the youth flows,"
      },
      {
       "cyr": "Младост тече милај мамо като вода.",
       "lat": "Mladost teče milaj mamo kato voda.",
       "en": "the youth flows, dear mother, like water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Старост дебни мамо, старост дебни.",
       "lat": "Starost debni mamo, starost debni.",
       "en": "The old age lurks, mother, the old age lurks,"
      },
      {
       "cyr": "Старост дебни милај мамо като сенка.",
       "lat": "Starost debni milaj mamo kato senka.",
       "en": "the old age lurks, dear mother, like a shadow."
      }
     ]
    }
   ]
  }
 ],
