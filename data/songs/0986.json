   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Не ме жално гледај, мајко",
       "lat": "- Ne me žalno gledaj, majko",
       "en": "- Do not look at me so sadly, mother,"
      },
      {
       "cyr": "и солзи не рони,",
       "lat": "i solzi ne roni,",
       "en": "and do not shed tears,"
      },
      {
       "cyr": "немој мајко ти да плачеш,",
       "lat": "nemoj majko ti da plačeš,",
       "en": "do not you cry, mother,"
      },
      {
       "cyr": "пак ќе ти се вратам.",
       "lat": "pak ḱe ti se vratam.",
       "en": "I will come back to you."
      },
      {
       "cyr": "Твојте солзи, мила мајко ле,",
       "lat": "Tvojte solzi, mila majko le,",
       "en": "Your tears, dear mother,"
      },
      {
       "cyr": "многу ми тежат на срце.",
       "lat": "mnogu mi težat na srce.",
       "en": "weigh heavily on my heart."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Срце ме боли, мајко ле,",
       "lat": "Srce me boli, majko le,",
       "en": "My heart aches, mother,"
      },
      {
       "cyr": "мислам ќе пукне за тебе,",
       "lat": "mislam ḱe pukne za tebe,",
       "en": "I think it will burst for you,"
      },
      {
       "cyr": "срце ме боли, мајко ле,",
       "lat": "srce me boli, majko le,",
       "en": "my heart aches, mother,"
      },
      {
       "cyr": "мислам ќе пукне за тебе.",
       "lat": "mislam ḱe pukne za tebe.",
       "en": "I think it will burst for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Како да не плачам, сине,",
       "lat": "- Kako da ne plačam, sine,",
       "en": "- How should I not cry, son,"
      },
      {
       "cyr": "уште си ми младо,",
       "lat": "ušte si mi mlado,",
       "en": "you are still young,"
      },
      {
       "cyr": "уште радост, мили сине,",
       "lat": "ušte radost, mili sine,",
       "en": "mother has not yet seen, dear son,"
      },
      {
       "cyr": "мајка не видела.",
       "lat": "majka ne videla.",
       "en": "any joy."
      },
      {
       "cyr": "Да ми те, мајка, ожени,",
       "lat": "Da mi te, majka, oženi,",
       "en": "To have your mother marry you off,"
      },
      {
       "cyr": "ожени, сине, одоми.",
       "lat": "oženi, sine, odomi.",
       "en": "marry you off, son, at home."
      }
     ]
    },
    {
     "lines": [
