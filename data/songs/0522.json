    {
     "lines": [
      {
       "cyr": "Стани ми Геле, Ангеле",
       "lat": "Stani mi Gele, Angele",
       "en": "Get up, my Gele, Angel,"
      },
      {
       "cyr": "стани ми сине на мајка,",
       "lat": "stani mi sine na majka,",
       "en": "get up, my son, from your mother,"
      },
      {
       "cyr": "мрачна се зора зазори",
       "lat": "mračna se zora zazori",
       "en": "the dark dawn has broken,"
      },
      {
       "cyr": "во гора сонце огреа.",
       "lat": "vo gora sonce ogrea.",
       "en": "the sun has lit up the forest."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стани ми сине, Ангеле",
       "lat": "Stani mi sine, Angele",
       "en": "Get up, my son, Angel,"
      },
      {
       "cyr": "земи си пушка берданка",
       "lat": "zemi si puška berdanka",
       "en": "take your berdan rifle,"
      },
      {
       "cyr": "накачи горе в' планина,",
       "lat": "nakači gore v' planina,",
       "en": "hang it up there in the mountain,"
      },
      {
       "cyr": "планина Пирин, убава.",
       "lat": "planina Pirin, ubava.",
       "en": "the mountain Pirin, beautiful."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Накачи горе в' Пирина,",
       "lat": "Nakači gore v' Pirina,",
       "en": "Hang it up there in Pirin,"
      },
      {
       "cyr": "таму ќе најдеш дружина,",
       "lat": "tamu ḱe najdeš družina,",
       "en": "there you will find your company,"
      },
      {
       "cyr": "твоите верни другари",
       "lat": "tvoite verni drugari",
       "en": "your faithful comrades"
      },
      {
       "cyr": "крвава борба ти водат.",
       "lat": "krvava borba ti vodat.",
       "en": "are fighting a bloody battle for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "В' крвава борба, нерамна,",
       "lat": "V' krvava borba, neramna,",
       "en": "Into the bloody, uneven battle"
      },
      {
       "cyr": "твоја дружина влегоја,",
       "lat": "tvoja družina vlegoja,",
       "en": "your company has gone in,"
      },
      {
       "cyr": "стани ми сине, стани ми,",
       "lat": "stani mi sine, stani mi,",
       "en": "get up, my son, get up,"
      },
      {
       "cyr": "оди во гора зелена.",
       "lat": "odi vo gora zelena.",
       "en": "go to the green forest."
      }
     ]
    }
   ]
