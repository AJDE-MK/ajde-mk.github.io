   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Крај морето шир, широко",
       "lat": "Kraj moreto šir, široko",
       "en": "By the wide, wide sea"
      },
      {
       "cyr": "многу дрвја маслинови.",
       "lat": "mnogu drvja maslinovi.",
       "en": "there are many olive trees."
      },
      {
       "cyr": "Тргнала ми мома Дана",
       "lat": "Trgnala mi moma Dana",
       "en": "A girl, Dana, set out"
      },
      {
       "cyr": "маслинки да си набере.",
       "lat": "maslinki da si nabere.",
       "en": "to pick olives."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На брег седи лудо младо,",
       "lat": "Na breg sedi ludo mlado,",
       "en": "On the shore sits a young lad,"
      },
      {
       "cyr": "со кавал си потсвирнува.",
       "lat": "so kaval si potsvirnuva.",
       "en": "playing softly on his flute."
      },
      {
       "cyr": "Со кавал си потсвирнува",
       "lat": "So kaval si potsvirnuva",
       "en": "Playing softly on his flute"
      },
      {
       "cyr": "и на моме намигнува.",
       "lat": "i na mome namignuva.",
       "en": "and winking at the girl."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се засрами лично моме",
       "lat": "Se zasrami lično mome",
       "en": "The pretty girl grew shy"
      },
      {
       "cyr": "и избега во маслинки.",
       "lat": "i izbega vo maslinki.",
       "en": "and fled into the olive grove."
      },
      {
       "cyr": "Таму моме прилегнало,",
       "lat": "Tamu mome prilegnalo,",
       "en": "There the girl lay down,"
      },
      {
       "cyr": "прилегнало, па заспало.",
       "lat": "prilegnalo, pa zaspalo.",
       "en": "lay down and fell asleep."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ајде стани лудо, младо,",
       "lat": "- Ajde stani ludo, mlado,",
       "en": "- Come on, get up, young lad,"
      },
      {
       "cyr": "сонце ми те огрејало.",
       "lat": "sonce mi te ogrejalo.",
       "en": "the sun has shone on you."
      },
      {
       "cyr": "Сонце ми те огреало,",
       "lat": "Sonce mi te ogrealo,",
       "en": "The sun has shone on you,"
      },
      {
       "cyr": "ветре ми те поддувнало.",
       "lat": "vetre mi te podduvnalo.",
       "en": "the wind has blown on you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Немој лудо, не ме буди,",
       "lat": "- Nemoj ludo, ne me budi,",
       "en": "- Don't, lad, don't wake me,"
      },
      {
       "cyr": "ништо нека не те чуди.",
       "lat": "ništo neka ne te čudi.",
       "en": "let nothing surprise you."
      },
      {
       "cyr": "Една радост в' срце чувам,",
       "lat": "Edna radost v' srce čuvam,",
       "en": "I keep one joy in my heart,"
      },
      {
       "cyr": "тебе лудо те сонувам.",
       "lat": "tebe ludo te sonuvam.",
       "en": "I dream of you, lad."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од кавал ми срце збори:",
       "lat": "Od kaval mi srce zbori:",
       "en": "My heart speaks through the flute:"
      },
      {
       "cyr": "„дојди лудо до пред зори“,",
       "lat": "„dojdi ludo do pred zori“,",
       "en": "'come, lad, before dawn',"
      },
      {
       "cyr": "кавал свири песна моја,",
       "lat": "kaval sviri pesna moja,",
       "en": "the flute plays my song,"
      },
      {
       "cyr": "дека јас ќе сум ти твоја.",
       "lat": "deka jas ḱe sum ti tvoja.",
       "en": "for I will be yours."
      }
     ]
    }
   ]
  }
 ],
