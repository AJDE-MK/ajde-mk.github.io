   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Лихнида кајче веслаше",
       "lat": "Lihnida kajče veslaše",
       "en": "Lihnida was rowing a boat"
      },
      {
       "cyr": "по Охридското Езеро",
       "lat": "po Ohridskoto Ezero",
       "en": "accross the Lake Ohrid"
      },
      {
       "cyr": "наспроти нејзе рибари, рибари,",
       "lat": "nasproti nejze ribari, ribari,",
       "en": "next to ther are some fishermen,"
      },
      {
       "cyr": "рибари, стари другари.",
       "lat": "ribari, stari drugari.",
       "en": "fishermen, old friends."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Рибари, стари другари,",
       "lat": "- Ribari, stari drugari,",
       "en": "- \"Fishermen, old friends,"
      },
      {
       "cyr": "кротко веслајте кајчето",
       "lat": "krotko veslajte kajčeto",
       "en": "row your boat slowly"
      },
      {
       "cyr": "да не ми прајте бранови, бранови,",
       "lat": "da ne mi prajte branovi, branovi,",
       "en": "so that you don't make waves,"
      },
      {
       "cyr": "рацете да се одморам.",
       "lat": "racete da se odmoram.",
       "en": "I want to rest my hands\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Лихнида кајче веслаше",
       "lat": "Lihnida kajče veslaše",
       "en": "Lihnida was rowing a boat"
      },
      {
       "cyr": "по Охридското Езеро",
       "lat": "po Ohridskoto Ezero",
       "en": "accross the Lake Ohrid"
      },
      {
       "cyr": "тивко си песна пееше:",
       "lat": "tivko si pesna peeše:",
       "en": "she was quietly singing a song:"
      },
      {
       "cyr": "„Билјана платно белеше“.",
       "lat": "„Biljana platno beleše“.",
       "en": "\"Biljana was washing canvas\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Лихнидо, моме Лихнидо,",
       "lat": "- Lihnido, mome Lihnido,",
       "en": "- \"Lihnida, girl, Lihnida,"
      },
      {
       "cyr": "ако ти прајме бранови",
       "lat": "ako ti prajme branovi",
       "en": "if we make waves"
      },
      {
       "cyr": "со весло ќе ги скротиме, скротиме,",
       "lat": "so veslo ḱe gi skrotime, skrotime,",
       "en": "we will calm them down with our paddles"
      },
      {
       "cyr": "со љубов ќе те гледаме.",
       "lat": "so ljubov ḱe te gledame.",
       "en": "we will look at you with love\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не сакам да ги скротите,",
       "lat": "- Ne sakam da gi skrotite,",
       "en": "- \"I don't want you to calm them down,"
      },
      {
       "cyr": "не сакам да ме гледате,",
       "lat": "ne sakam da me gledate,",
       "en": "I don't want you to look at me,"
      },
      {
       "cyr": "јас сакам мирно езеро,",
       "lat": "jas sakam mirno ezero,",
       "en": "I want a calm lake"
      },
      {
       "cyr": "душата да си одморам.",
       "lat": "dušata da si odmoram.",
       "en": "to rest my soul\"."
      }
     ]
    },
    {
