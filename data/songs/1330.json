       "en": "the forest and the mountain"
      },
      {
       "cyr": "и од гората дрвата,",
       "lat": "i od gorata drvata,",
       "en": "and from the forest the trees,"
      },
      {
       "cyr": "и од дрвата лисјата,",
       "lat": "i od drvata lisjata,",
       "en": "and from the trees the leaves,"
      },
