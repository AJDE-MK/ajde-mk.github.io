 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Мамо кој чука на порти?",
       "lat": "- Mamo koj čuka na porti?",
       "en": "Mother, who is knocking on the gate?"
      },
      {
       "cyr": "- Чука, тропа, мила ќерко,",
       "lat": "- Čuka, tropa, mila ḱerko,",
       "en": "- Hitting, knocking, dear daughter,"
      },
      {
       "cyr": "твојто прво либе.",
       "lat": "tvojto prvo libe.",
       "en": "your first love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Мамо дал да му отворам?",
       "lat": "- Mamo dal da mu otvoram?",
       "en": "Mother, should I open?"
      },
      {
       "cyr": "- Немој ќерко, немој душо,",
       "lat": "- Nemoj ḱerko, nemoj dušo,",
       "en": "- Don't, daughter, don't, my soul,"
      },
      {
       "cyr": "вечера немаме.",
       "lat": "večera nemame.",
       "en": "we don't have a dinner."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Мамо, за него вечера,",
       "lat": "- Mamo, za nego večera,",
       "en": "Mother, a dinner for him,"
      },
      {
       "cyr": "мамо, за него вечера,",
       "lat": "mamo, za nego večera,",
       "en": "mother, a dinner for him,"
      },
      {
       "cyr": "за него вечера, мамо",
       "lat": "za nego večera, mamo",
       "en": "for him a dinner, mother,"
      },
      {
       "cyr": "мојте слатки думи.",
       "lat": "mojte slatki dumi.",
       "en": "my sweet words."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мамо дал да му отворам?",
       "lat": "Mamo dal da mu otvoram?",
       "en": "Mother, should I open?"
      },
      {
       "cyr": "- Немој ќерко, немој душо,",
       "lat": "- Nemoj ḱerko, nemoj dušo,",
       "en": "- Do not, daughter, do not, my soul,"
      },
      {
       "cyr": "постела немаме.",
       "lat": "postela nemame.",
       "en": "we don't have a bed."
      }
     ]
    },
    {
     "lines": [
      {
