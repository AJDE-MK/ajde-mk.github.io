     "lines": [
      {
       "cyr": "Прилепските ергени",
       "lat": "Prilepskite ergeni",
       "en": "The bachelors of Prilep,"
      },
      {
       "cyr": "каде одат и пејат,",
       "lat": "kade odat i pejat,",
       "en": "wherever they go, they sing,"
      },
      {
       "cyr": "по момите гледаат,",
       "lat": "po momite gledaat,",
       "en": "they look at the girls,"
      },
      {
       "cyr": "да ги видат, ќе свирнат.",
       "lat": "da gi vidat, ḱe svirnat.",
       "en": "when they see them, they whistle."
      },
      {
       "cyr": "И со око ќе намигнат:",
       "lat": "I so oko ḱe namignat:",
       "en": "And they wink with an eye:"
      },
      {
       "cyr": "- „Леле, леле што се убави“.",
       "lat": "- „Lele, lele što se ubavi“.",
       "en": "- 'Oh my, oh my, how beautiful they are.'"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стар бел дедо прислушнал,",
