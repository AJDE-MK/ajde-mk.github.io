   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Замина без поздрав, мила,",
       "lat": "Zamina bez pozdrav, mila,",
       "en": "You left without saying goodbye, my dear,",
       "en_mt": false
      },
      {
       "cyr": "и не се јави.",
       "lat": "i ne se javi.",
       "en": "and didn't call back.",
       "en_mt": false
      },
      {
       "cyr": "Како можеш среќни деној",
       "lat": "Kako možeš sreḱni denoj",
       "en": "How can you forget",
       "en_mt": false
      },
      {
       "cyr": "да заборавиш?",
       "lat": "da zaboraviš?",
       "en": "the happy days?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, ми се колнеше",
       "lat": "Aj, mi se kolneše",
       "en": "Oh, you swore to me",
       "en_mt": false
      },
      {
       "cyr": "дека прв пат ти си среќна",
       "lat": "deka prv pat ti si sreḱna",
       "en": "that for the first time you were happy",
       "en_mt": false
      },
      {
       "cyr": "само со мене.",
       "lat": "samo so mene.",
       "en": "only with me.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Како снег на сонце, мила,",
       "lat": "Kako sneg na sonce, mila,",
       "en": "Like snow in the sun, my dear,",
       "en_mt": false
      },
      {
       "cyr": "ти се топеше.",
       "lat": "ti se topeše.",
       "en": "you were melting.",
       "en_mt": false
      },
      {
       "cyr": "И со твојте слатки усни",
       "lat": "I so tvojte slatki usni",
       "en": "And with your sweet lips",
       "en_mt": false
      },
      {
       "cyr": "ми шепотеше.",
       "lat": "mi šepoteše.",
       "en": "you whispered to me.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, ми се колнеше",
       "lat": "Aj, mi se kolneše",
       "en": "Oh, you swore to me",
       "en_mt": false
      },
      {
       "cyr": "дека прв пат ти си среќна",
       "lat": "deka prv pat ti si sreḱna",
       "en": "that for the first time you were happy",
       "en_mt": false
      },
      {
       "cyr": "само со мене.",
       "lat": "samo so mene.",
       "en": "only with me.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Знам и сега гориш, мила,",
       "lat": "Znam i sega goriš, mila,",
       "en": "I know you're burning even now, my dear,",
       "en_mt": false
      },
      {
       "cyr": "се измачуваш.",
       "lat": "se izmačuvaš.",
       "en": "you're tormenting yourself.",
       "en_mt": false
      },
      {
       "cyr": "Нема долго јас да чекам,",
       "lat": "Nema dolgo jas da čekam,",
       "en": "I won't have to wait long,",
       "en_mt": false
      },
      {
       "cyr": "ќе ме побараш.",
       "lat": "ḱe me pobaraš.",
       "en": "you'll look for me.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, ми се колнеше",
       "lat": "Aj, mi se kolneše",
       "en": "Oh, you swore to me",
       "en_mt": false
      },
      {
       "cyr": "дека прв пат ти си среќна",
       "lat": "deka prv pat ti si sreḱna",
       "en": "that for the first time you were happy",
       "en_mt": false
      },
      {
       "cyr": "само со мене.",
       "lat": "samo so mene.",
       "en": "only with me.",
