    {
     "lines": [
      {
       "cyr": "Расплети си бујни коси,",
       "lat": "Raspleti si bujni kosi,",
       "en": "Unbraid your dense hair,"
      },
      {
       "cyr": "како браној езероно,",
       "lat": "kako branoj ezerono,",
       "en": "like the waves in the lake,"
      },
      {
       "cyr": "твојта љубов, ѓул трендафил,",
       "lat": "tvojta ljubov, ǵul trendafil,",
       "en": "your love, a rose,"
      },
      {
       "cyr": "ми го плени еј срцево.",
       "lat": "mi go pleni ej srcevo.",
       "en": "captivates my heart."
      }
