   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Тажна Калинка седеше,",
       "lat": "Tažna Kalinka sedeše,",
       "en": "Kalinka was sitting sad,"
      },
      {
       "cyr": "сама себе си зборвеше:",
       "lat": "sama sebe si zborveše:",
       "en": "talking to herself:"
      },
      {
       "cyr": "- „Мили боже ти чудесен,",
       "lat": "- „Mili bože ti čudesen,",
       "en": "- \"Dear God, you wonderful,"
      },
      {
       "cyr": "и јас сум била девојка“.",
       "lat": "i jas sum bila devojka“.",
       "en": "I was also a girl\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И јас сум била девојка",
       "lat": "I jas sum bila devojka",
       "en": "I was also a girl"
      },
      {
       "cyr": "н' овој бели свет лажовен.",
       "lat": "n' ovoj beli svet lažoven.",
       "en": "on this white deceiving world."
      },
      {
       "cyr": "Ме грееше јасно сонце,",
       "lat": "Me greeše jasno sonce,",
       "en": "The bright Sun was warming me,"
      },
      {
       "cyr": "од високо, од далеку.",
       "lat": "od visoko, od daleku.",
       "en": "from high, from far away."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас си имав верно либе",
       "lat": "Jas si imav verno libe",
       "en": "I had my faithful love"
      },
      {
       "cyr": "нег'ва мајка не ме сака.",
       "lat": "neg'va majka ne me saka.",
       "en": "his mother didn't want me."
      },
      {
       "cyr": "Нег'ва мајка не ме сака",
       "lat": "Neg'va majka ne me saka",
       "en": "His mother didn't want me"
      },
      {
       "cyr": "и мој татко не ме дава.",
       "lat": "i moj tatko ne me dava.",
       "en": "my father didn't give me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас си зедов бели ѓумој",
       "lat": "Jas si zedov beli ǵumoj",
       "en": "So I took white canisters,"
      },
      {
       "cyr": "бели ѓумој во рацете.",
       "lat": "beli ǵumoj vo racete.",
       "en": "white canisters in my hands."
      },
      {
       "cyr": "Си поминав кај Ивана,",
       "lat": "Si pominav kaj Ivana,",
       "en": "I went to Ivan's"
      },
      {
       "cyr": "видов голем калабалак.",
       "lat": "vidov golem kalabalak.",
       "en": "where I saw a big crowd."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога Иван ме здогледа,",
       "lat": "Koga Ivan me zdogleda,",
       "en": "When Ivan saw me"
      },
      {
       "cyr": "си извади остро ноже.",
       "lat": "si izvadi ostro nože.",
       "en": "he took a sharp knife."
      },
      {
       "cyr": "Си извади остро ноже,",
       "lat": "Si izvadi ostro nože,",
       "en": "He took a sharp knife"
      },
      {
       "cyr": "си забоди право в срце.",
       "lat": "si zabodi pravo v srce.",
       "en": "and stabbed himself in the heart."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Си оставив бели ѓумој,",
       "lat": "Si ostaviv beli ǵumoj,",
       "en": "I left my white canisters,"
      },
      {
       "cyr": "бели ѓумој на земјата.",
       "lat": "beli ǵumoj na zemjata.",
       "en": "my white canisters on the ground."
      },
      {
       "cyr": "Се наведнав над Ивана",
       "lat": "Se navednav nad Ivana",
       "en": "I bent over Ivan"
      },
      {
       "cyr": "видов, видов, крвој видов.",
       "lat": "vidov, vidov, krvoj vidov.",
       "en": "I saw, I saw, blood I saw."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Та си зедов остро ноже,",
       "lat": "Ta si zedov ostro nože,",
       "en": "So I took the sharp knife,"
      },
      {
       "cyr": "остро ноже во рацете.",
       "lat": "ostro nože vo racete.",
       "en": "the sharp knife in my hands."
      },
      {
       "cyr": "Си забодив својто срце,",
       "lat": "Si zabodiv svojto srce,",
       "en": "I stabbed it in my heart"
      },
      {
       "cyr": "мртва паднав до Ивана.",
       "lat": "mrtva padnav do Ivana.",
       "en": "and fell down dead next to Ivan."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мртва падна, проговара:",
       "lat": "Mrtva padna, progovara:",
       "en": "She fell down dead, speaking:"
      },
      {
       "cyr": "- „Бели свет нека разбери,",
       "lat": "- „Beli svet neka razberi,",
       "en": "- \"May the white world understand,"
      },
      {
       "cyr": "две срца кој што се љубат",
       "lat": "dve srca koj što se ljubat",
       "en": "two hearts that love each other"
      },
      {
       "cyr": "и мртви ќе се прегрнат“.",
       "lat": "i mrtvi ḱe se pregrnat“.",
       "en": "will embrace each other even if they are dead\"."
      }
     ]
    }
   ]
  }
 ],
