 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Што имала к'смет Стамена, Стамена",
       "lat": "Što imala k'smet Stamena, Stamena",
       "en": "Stamena had bad luck,"
      },
      {
       "cyr": "мајка ѝ болна легнала, легнала.",
       "lat": "majka ì bolna legnala, legnala.",
       "en": "her mother was ill and laid on the bed."
      },
      {
       "cyr": "Мајка ѝ болна паднала, паднала",
       "lat": "Majka ì bolna padnala, padnala",
       "en": "Her mother fell sick,"
      },
      {
       "cyr": "побарала вода студена, студена.",
       "lat": "pobarala voda studena, studena.",
       "en": "she asked for some cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стамена ги зеде стомните, стомните",
       "lat": "Stamena gi zede stomnite, stomnite",
       "en": "Stamena took the jugs,"
      },
      {
       "cyr": "отиде на чешма шарена, шарена.",
       "lat": "otide na češma šarena, šarena.",
       "en": "she went to the colorful fountain."
      },
      {
       "cyr": "Отиде на чешма шарена, шарена",
       "lat": "Otide na češma šarena, šarena",
       "en": "She went to the colorful fountain"
      },
      {
       "cyr": "да наполни вода студена, студена.",
       "lat": "da napolni voda studena, studena.",
       "en": "to fill the jugs with cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога се од вода враќаше,",
       "lat": "Koga se od voda vraḱaše,",
       "en": "When she was returning from there,"
      },
      {
       "cyr": "у село оро играја, играја.",
       "lat": "u selo oro igraja, igraja.",
       "en": "she found boys dancing the oro."
      },
      {
       "cyr": "У село оро играја, играја,",
       "lat": "U selo oro igraja, igraja,",
       "en": "The boys were dancing the oro in the village,"
      },
      {
       "cyr": "на танец млади Стојане.",
       "lat": "na tanec mladi Stojane.",
       "en": "Stojan was dancing, too."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стамена ми стомни остави, остави,",
       "lat": "Stamena mi stomni ostavi, ostavi,",
       "en": "Stamena left the jugs on the ground,"
      },
      {
       "cyr": "и до Стојана се фана, да игра.",
       "lat": "i do Stojana se fana, da igra.",
       "en": "and grabbed Stojan’s hand to join the oro."
      },
      {
       "cyr": "Стојан Стамени думаше, думаше:",
       "lat": "Stojan Stameni dumaše, dumaše:",
       "en": "Stojan told Stamena:"
      },
      {
       "cyr": "- Стамено лична, убава.",
       "lat": "- Stameno lična, ubava.",
       "en": "- Beautiful Stamena."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Како што си лична, убава, убава,",
       "lat": "Kako što si lična, ubava, ubava,",
       "en": "If only you were diligent"
      },
      {
       "cyr": "уште така да си работна, работна.",
       "lat": "ušte taka da si rabotna, rabotna.",
       "en": "as much as you are pretty."
      },
      {
       "cyr": "Кога ќе земеш да предеш, да предеш,",
       "lat": "Koga ḱe zemeš da predeš, da predeš,",
       "en": "When you start to spin, to spin"
      },
      {
       "cyr": "со тоа фурче дреново, дреново.",
       "lat": "so toa furče drenovo, drenovo.",
       "en": "that spindle made of dogwood, dogwood."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таман што си жица запрела,",
       "lat": "Taman što si žica zaprela,",
       "en": "Just as soon as you stop weaving the thread,"
      },
      {
       "cyr": "одма те дремка, надоле, надоле.",
       "lat": "odma te dremka, nadole, nadole.",
       "en": "a doze starts to pull you down."
      },
      {
       "cyr": "Ти си легна малку да дремнеш, да дремнеш,",
       "lat": "Ti si legna malku da dremneš, da dremneš,",
       "en": "You lay down to take a nap,"
      },
      {
       "cyr": "мамурлукот да го разбиеш, разбиеш.",
       "lat": "mamurlukot da go razbieš, razbieš.",
       "en": "to break the drowsiness."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стамена на Стојан думаше, думаше:",
       "lat": "Stamena na Stojan dumaše, dumaše:",
       "en": "Stamena told Stojan:"
      },
      {
       "cyr": "- Стојане море Стојане, Стојане.",
       "lat": "- Stojane more Stojane, Stojane.",
       "en": "- Stojan, hey Stojan,"
      },
      {
       "cyr": "Како што си лично, убаво, убаво,",
       "lat": "Kako što si lično, ubavo, ubavo,",
       "en": "if only you were as diligent"
      },
      {
       "cyr": "ама и ти да си работно, работно.",
       "lat": "ama i ti da si rabotno, rabotno.",
       "en": "as you are handsome."
      }
     ]
    }
   ]
  }
 ],
