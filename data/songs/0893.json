   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Славеј пее на трендафил,",
       "lat": "Slavej pee na trendafil,",
       "en": "The nightingale sings on the rose,"
      },
      {
       "cyr": "Донка спие крај пенџере.",
       "lat": "Donka spie kraj pendžere.",
       "en": "Donka sleeps by the window."
      },
      {
       "cyr": "- Немој пиле, не пеј рано,",
       "lat": "- Nemoj pile, ne pej rano,",
       "en": "- Do not, little bird, do not sing so early,"
      },
      {
       "cyr": "тежок сон сум сонувало.",
       "lat": "težok son sum sonuvalo.",
       "en": "I have dreamed a heavy dream."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Јас ти пеам, јас те будам,",
       "lat": "- Jas ti peam, jas te budam,",
       "en": "- I sing to you, I wake you,"
      },
      {
       "cyr": "голем абер јас ти носам,",
       "lat": "golem aber jas ti nosam,",
       "en": "I bring you big news,"
      },
      {
       "cyr": "од туѓина, од јабана,",
       "lat": "od tuǵina, od jabana,",
       "en": "from abroad, from foreign lands,"
      },
      {
       "cyr": "од твоето верно либе.",
       "lat": "od tvoeto verno libe.",
       "en": "from your faithful love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Немој пиле, не ме лажи,",
       "lat": "- Nemoj pile, ne me laži,",
       "en": "- Do not, little bird, do not lie to me,"
      },
      {
       "cyr": "мојто либе не се враќа.",
       "lat": "mojto libe ne se vraḱa.",
       "en": "my love is not coming back."
      },
      {
       "cyr": "Сонот тежок јас го видов",
       "lat": "Sonot težok jas go vidov",
       "en": "I saw the heavy dream"
      },
      {
       "cyr": "дека друга тој си љуби.",
       "lat": "deka druga toj si ljubi.",
       "en": "that he is kissing another."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не верувај, сонот лаже,",
       "lat": "- Ne veruvaj, sonot laže,",
       "en": "- Do not believe it, the dream lies,"
      },
      {
       "cyr": "твојто либе веќе иде,",
       "lat": "tvojto libe veḱe ide,",
       "en": "your love is already coming,"
      },
      {
       "cyr": "да те љуби, да те гушка",
       "lat": "da te ljubi, da te guška",
       "en": "to kiss you, to hold you,"
      },
      {
       "cyr": "и со тебе век векува.",
       "lat": "i so tebe vek vekuva.",
       "en": "and to live with you forever."
      }
     ]
    }
   ]
  }
