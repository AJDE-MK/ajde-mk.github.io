   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ако грб ти сврти животот,",
       "lat": "Ako grb ti svrti životot,",
       "en": "If life turns its back on you,"
      },
      {
       "cyr": "кога нешто не оди,",
       "lat": "koga nešto ne odi,",
       "en": "when something is not going well,"
      },
      {
       "cyr": "застани и насмеј се,",
       "lat": "zastani i nasmej se,",
       "en": "stop and smile,"
      },
      {
       "cyr": "избриши ги солзите.",
       "lat": "izbriši gi solzite.",
       "en": "wipe away your tears."
      },
      {
       "cyr": "Кога иде крај на сè,",
       "lat": "Koga ide kraj na sè,",
       "en": "When the end of everything comes,"
      },
      {
       "cyr": "немаш сили повеќе",
       "lat": "nemaš sili poveḱe",
       "en": "you have no strength left,"
      },
      {
       "cyr": "и тогаш не заборави",
       "lat": "i togaš ne zaboravi",
       "en": "even then do not forget"
      },
      {
       "cyr": "идат добри денови.",
       "lat": "idat dobri denovi.",
       "en": "good days are coming."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Наздрави за љубов,",
       "lat": "Nazdravi za ljubov,",
       "en": "Raise a glass to love,"
      },
      {
       "cyr": "наздрави за среќа,",
       "lat": "nazdravi za sreḱa,",
       "en": "raise a glass to happiness,"
      },
      {
       "cyr": "наздрави за секој ден,",
       "lat": "nazdravi za sekoj den,",
       "en": "raise a glass to every day,"
      },
      {
       "cyr": "животот е еден",
       "lat": "životot e eden",
       "en": "life is one"
      },
      {
       "cyr": "и тој не е вреден",
       "lat": "i toj ne e vreden",
       "en": "and it is not worth anything"
      },
      {
       "cyr": "ако не го живееш.",
       "lat": "ako ne go živeeš.",
       "en": "if you do not live it."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако некој те разочара,",
       "lat": "Ako nekoj te razočara,",
       "en": "If someone disappoints you,"
      },
      {
       "cyr": "пријател ил' роднина,",
       "lat": "prijatel il' rodnina,",
       "en": "a friend or a relative,"
      },
      {
       "cyr": "или те напуштила",
       "lat": "ili te napuštila",
       "en": "or the greatest love"
      },
      {
       "cyr": "љубовта најголема,",
       "lat": "ljubovta najgolema,",
       "en": "has left you,"
      },
      {
       "cyr": "тогаш само помисли",
       "lat": "togaš samo pomisli",
       "en": "then just think"
      },
      {
       "cyr": "и нагоре погледни,",
       "lat": "i nagore pogledni,",
       "en": "and look upward,"
      },
      {
       "cyr": "има господ, гледа сè",
