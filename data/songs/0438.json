 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Антице џанам душице,",
       "lat": "Antice džanam dušice,",
       "en": "Antice poor soul",
       "en_mt": false
      },
      {
       "cyr": "ах што пусти к'смет си немала.",
       "lat": "ah što pusti k'smet si nemala.",
       "en": "Ah, what a damned fate you haven't had.",
       "en_mt": false
      },
      {
       "cyr": "Ти, на твојата убавина",
       "lat": "Ti, na tvojata ubavina",
       "en": "You, with your beauty",
       "en_mt": false
      },
      {
       "cyr": "ти, на твојата личотија.",
       "lat": "ti, na tvojata ličotija.",
       "en": "You, with your grace.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не жали Анте, не плачи",
       "lat": "Ne žali Ante, ne plači",
       "en": "Do not sorrow, Ante, do not cry",
       "en_mt": false
      },
      {
       "cyr": "не рони солзи крвави.",
       "lat": "ne roni solzi krvavi.",
       "en": "Do not weep bloody tears.",
       "en_mt": false
      },
      {
       "cyr": "Не жали Анте, не плачи,",
       "lat": "Ne žali Ante, ne plači,",
       "en": "Do not sorrow, Ante, do not cry",
       "en_mt": false
      },
      {
       "cyr": "не расипуј си го лицето.",
       "lat": "ne rasipuj si go liceto.",
       "en": "Do not ruin your face.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сестра ти мала се омажи,",
       "lat": "Sestra ti mala se omaži,",
       "en": "Your younger sister got married",
       "en_mt": false
      },
      {
       "cyr": "а ти поголема несвршена.",
       "lat": "a ti pogolema nesvršena.",
       "en": "but you older not engaged.",
       "en_mt": false
      },
      {
       "cyr": "Тебе момче стројник ти испрати,",
       "lat": "Tebe momče strojnik ti isprati,",
       "en": "A young man sent a matchmaker to you",
       "en_mt": false
      },
      {
       "cyr": "тебе ми те прво посака.",
       "lat": "tebe mi te prvo posaka.",
       "en": "he asked first for you.",
       "en_mt": false
      },
      {
       "cyr": "На душа ми те зедоја,",
       "lat": "Na duša mi te zedoja,",
       "en": "They made a soulful sin",
       "en_mt": false
      },
      {
       "cyr": "мајка ти, а и татко ти.",
       "lat": "majka ti, a i tatko ti.",
       "en": "Your mother and your father.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не жали Анте, не плачи",
       "lat": "Ne žali Ante, ne plači",
       "en": "Do not sorrow, Ante, do not cry",
       "en_mt": false
      },
      {
       "cyr": "не рони солзи крвави.",
       "lat": "ne roni solzi krvavi.",
       "en": "Do not weep bloody tears.",
       "en_mt": false
      },
      {
       "cyr": "Не жали Анте, не плачи,",
       "lat": "Ne žali Ante, ne plači,",
       "en": "Do not sorrow, Ante, do not cry",
       "en_mt": false
      },
      {
       "cyr": "не расипуј си го лицето.",
       "lat": "ne rasipuj si go liceto.",
       "en": "Do not ruin your face.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На стројникот што му рекоја",
       "lat": "Na strojnikot što mu rekoja",
       "en": "To the matchmaker they said",
       "en_mt": false
      },
      {
       "cyr": "Антица ни је посвршена.",
       "lat": "Antica ni je posvršena.",
       "en": "Our Antica is engaged.",
       "en_mt": false
      },
      {
       "cyr": "Антица ми је посвршена",
       "lat": "Antica mi je posvršena",
       "en": "Our Antica is engaged",
       "en_mt": false
      },
      {
       "cyr": "за Димитрија Робета.",
       "lat": "za Dimitrija Robeta.",
       "en": "to Dimitrija Robeta.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако ја сакаш малата,",
       "lat": "Ako ja sakaš malata,",
       "en": "If you want the younger one",
       "en_mt": false
      },
      {
       "cyr": "малата кира Василикија.",
       "lat": "malata kira Vasilikija.",
       "en": "the younger one Miss Vasilikija.",
       "en_mt": false
      },
      {
       "cyr": "Ако ја сакаш малата,",
       "lat": "Ako ja sakaš malata,",
       "en": "If you want the younger one",
       "en_mt": false
      },
      {
       "cyr": "малата кира Василикија.",
       "lat": "malata kira Vasilikija.",
       "en": "the younger one Miss Vasilikija.",
       "en_mt": false
      }
     ]
    }
