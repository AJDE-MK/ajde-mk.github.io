   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ој Сатеско, реко силна",
       "lat": "Oj Satesko, reko silna",
       "en": "O Satesko, mighty river,"
      },
      {
       "cyr": "на Дебарца мома милна,",
       "lat": "na Debarca moma milna,",
       "en": "dear girl of Debarca,"
      },
      {
       "cyr": "твојта снага ширна и градна",
       "lat": "tvojta snaga širna i gradna",
       "en": "your strength wide and broad-chested,"
      },
      {
       "cyr": "чиста бистра, водо ладна.",
       "lat": "čista bistra, vodo ladna.",
       "en": "clear, bright, cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "В бојот беше силна и храбра",
       "lat": "V bojot beše silna i hrabra",
       "en": "In battle you were strong and brave,"
      },
      {
       "cyr": "мостовита, мрилна и ширна.",
       "lat": "mostovita, mrilna i širna.",
       "en": "bridged, grey?, and wide."
      },
      {
       "cyr": "твојте борци, ведри и силни",
       "lat": "tvojte borci, vedri i silni",
       "en": "Your fighters, bright and strong,"
      },
      {
       "cyr": "те бранеја с' гради силни.",
       "lat": "te braneja s' gradi silni.",
       "en": "defended you with strong chests."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Одред Славеј храбар и жаден",
       "lat": "Odred Slavej hrabar i žaden",
       "en": "The Slavej detachment, brave and eager,"
      },
      {
       "cyr": "со командантот Коста славен,",
       "lat": "so komandantot Kosta slaven,",
       "en": "with the glorious commander Kosta,"
      },
      {
       "cyr": "Ботун тресе бој се водел",
       "lat": "Botun trese boj se vodel",
       "en": "at Botun the ground shook, a battle was fought"
      },
      {
       "cyr": "и победа славна донел.",
       "lat": "i pobeda slavna donel.",
       "en": "and brought a glorious victory."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ој Сатеско, реко силна",
       "lat": "Oj Satesko, reko silna",
       "en": "O Satesko, mighty river,"
      },
      {
       "cyr": "на Дебарца мома милна",
       "lat": "na Debarca moma milna",
       "en": "dear girl of Debarca,"
      },
      {
       "cyr": "под тебе се знамиња вејат",
       "lat": "pod tebe se znaminja vejat",
       "en": "banners wave over you,"
      },
      {
       "cyr": "за слобода пејат.",
       "lat": "za sloboda pejat.",
       "en": "they sing of freedom."
      }
     ]
    }
