   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Деспа ми стои крај Дунава,",
       "lat": "Despa mi stoi kraj Dunava,",
       "en": "Despa stands by the Danube,"
      },
      {
       "cyr": "Деспа си Дунав љуто колнеше:",
       "lat": "Despa si Dunav ljuto kolneše:",
       "en": "Despa was fiercely cursing the Danube:"
      },
      {
       "cyr": "- Дунав, Дунав, аман бел Дунав,",
       "lat": "- Dunav, Dunav, aman bel Dunav,",
       "en": "- Danube, Danube, mercy, white Danube,"
      },
      {
       "cyr": "водите да ти пресушат.",
       "lat": "vodite da ti presušat.",
       "en": "may your waters dry up,"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Водите да ти пресушат,",
       "lat": "Vodite da ti presušat,",
       "en": "may your waters dry up,"
      },
      {
       "cyr": "рибите да ти испукаат,",
       "lat": "ribite da ti ispukaat,",
       "en": "may your fish burst dead,"
      },
      {
       "cyr": "што ми го удави моето братче",
       "lat": "što mi go udavi moeto bratče",
       "en": "you who drowned my little brother"
      },
      {
       "cyr": "со триста души сватови,",
       "lat": "so trista duši svatovi,",
       "en": "with three hundred wedding guests,"
      },
      {
       "cyr": "со девет рала тапани",
       "lat": "so devet rala tapani",
       "en": "with nine ploughs' worth of drums"
      },
      {
       "cyr": "и со девет зурли сребрени?",
       "lat": "i so devet zurli srebreni?",
       "en": "and with nine silver zurlas?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ој Деспо, Деспо, бегај од тука,",
       "lat": "- Oj Despo, Despo, begaj od tuka,",
       "en": "- Oh Despa, Despa, run away from here,"
      },
      {
       "cyr": "да не те удавам, аман и тебе,",
       "lat": "da ne te udavam, aman i tebe,",
       "en": "so that I do not drown you, mercy, you too,"
      },
      {
       "cyr": "водите да те однесат,",
       "lat": "vodite da te odnesat,",
       "en": "the waters would carry you off,"
      },
      {
       "cyr": "да не те удавам, аман и тебе,",
       "lat": "da ne te udavam, aman i tebe,",
       "en": "so that I do not drown you, mercy, you too,"
      },
      {
       "cyr": "како што го удавив твоето братче.",
       "lat": "kako što go udaviv tvoeto bratče.",
       "en": "as I drowned your little brother."
      }
