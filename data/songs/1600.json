 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Домаќине, добри гости ти дојдоа,",
       "lat": "Domaḱine, dobri gosti ti dojdoa,",
       "en": "Host, good guests have come to you,"
      },
      {
       "cyr": "ај, добар абер ти донесоа.",
       "lat": "aj, dobar aber ti donesoa.",
       "en": "ah, they have brought you good news."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стадо ти се, домаќине, објагнало,",
       "lat": "Stado ti se, domaḱine, objagnalo,",
       "en": "Your flock, host, has lambed,"
      },
      {
       "cyr": "ах, половина облизнило.",
       "lat": "ah, polovina obliznilo.",
       "en": "ah, half of them are tweens."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Жена ти се, домаќине, породила,",
       "lat": "Žena ti se, domaḱine, porodila,",
       "en": "Host, your wife has given birth,"
      },
      {
       "cyr": "ај, породила машко дете.",
       "lat": "aj, porodila maško dete.",
       "en": "ah, she has given birth to a son."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Домаќине, денес се јаде и пие,",
       "lat": "Domaḱine, denes se jade i pie,",
       "en": "Host, today we eat and drink,"
      },
      {
       "cyr": "ах, денес се свадба прави.",
       "lat": "ah, denes se svadba pravi.",
       "en": "ah, today we have a wedding."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако спиеш, домаќине разбуди се,",
       "lat": "Ako spieš, domaḱine razbudi se,",
       "en": "If you are sleeping, host, wake up,"
      },
      {
       "cyr": "ако пиеш, домаќине развесели се,",
       "lat": "ako pieš, domaḱine razveseli se,",
       "en": "ah, if you are drinking, host, cheer up,"
      },
      {
       "cyr": "ај, ако пиеш, развесели се.",
       "lat": "aj, ako pieš, razveseli se.",
       "en": "ah, if you are drinking, cheer up."
      }
     ]
    }
   ]
  }
 ],
