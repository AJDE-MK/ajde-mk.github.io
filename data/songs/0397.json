    {
     "lines": [
      {
       "cyr": "(Свирете ми свирачи)",
       "lat": "(Svirete mi svirači)",
       "en": "(Play to me, musicians)"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Денес пејам, се веселам",
       "lat": "Denes pejam, se veselam",
       "en": "Today I sing, I am happy,"
      },
      {
       "cyr": "свадба правам, син женам,",
       "lat": "svadba pravam, sin ženam,",
       "en": "we are at a wedding, my son is getting married,"
      },
      {
       "cyr": "мојата радост е голема,",
       "lat": "mojata radost e golema,",
       "en": "my joy is so big,"
      },
      {
       "cyr": "срце од радост ми плаче.",
       "lat": "srce od radost mi plače.",
       "en": "my heart cries of joy."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Свирете ми свирачи,",
       "lat": "Svirete mi svirači,",
       "en": "Play to me, musicians,"
      },
      {
       "cyr": "свирете ми до зори,",
       "lat": "svirete mi do zori,",
       "en": "play to me until dawn,"
      },
      {
       "cyr": "и јас со вас да пеам",
       "lat": "i jas so vas da peam",
       "en": "and I will sing with you,"
      },
      {
       "cyr": "да се веселам.",
       "lat": "da se veselam.",
       "en": "I'll be happy."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде свате, дигни чаша, да пиеме,",
       "lat": "Ajde svate, digni čaša, da pieme,",
       "en": "Come on, relative, raise your glass, let's drink,"
      },
      {
       "cyr": "за младите да наздравиме,",
       "lat": "za mladite da nazdravime,",
       "en": "let us toast for the young,"
      },
      {
       "cyr": "чедо ваше, чедо наше, се засакале",
       "lat": "čedo vaše, čedo naše, se zasakale",
       "en": "your child, our child, they fell in love,"
      },
      {
       "cyr": "штом се земат, среќни ќе бидат.",
       "lat": "štom se zemat, sreḱni ḱe bidat.",
       "en": "when they marry, they'll be happy."
      }
     ]
    },
    {
     "lines": [
