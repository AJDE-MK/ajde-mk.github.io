 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ах, каде е мојто либе,",
       "lat": "Ah, kade e mojto libe,",
       "en": "Oh, where is my love,"
      },
      {
       "cyr": "дали мисли тој на мене?",
       "lat": "dali misli toj na mene?",
       "en": "does he think about me?"
      },
      {
       "cyr": "Јас за него само венам,",
       "lat": "Jas za nego samo venam,",
       "en": "I keep withering because of him,"
      },
      {
       "cyr": "и за него ќе умрам.",
       "lat": "i za nego ḱe umram.",
       "en": "and I will die because of him."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Коленичев јас пред него,",
       "lat": "Koleničev jas pred nego,",
       "en": "I was on my knees in front of him,"
      },
      {
       "cyr": "ем со солзи на очите:",
       "lat": "em so solzi na očite:",
       "en": "with tears in my eyes:"
      },
      {
       "cyr": "- „Кажи, кажи неверно либе,",
       "lat": "- „Kaži, kaži neverno libe,",
       "en": "- \"Tell me, tell me unfaithful love,"
      },
      {
       "cyr": "која љубиш освен мене“?",
       "lat": "koja ljubiš osven mene“?",
       "en": "do you love someone else beside me\"?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зошто кажа ти пред мама",
       "lat": "Zošto kaža ti pred mama",
       "en": "Why did you tell my mother"
      },
      {
       "cyr": "каде бевме ние двајца?",
       "lat": "kade bevme nie dvajca?",
       "en": "where the two of us were?"
      },
      {
       "cyr": "Ако либе те излажам,",
       "lat": "Ako libe te izlažam,",
       "en": "If I lie to you, love,"
      },
      {
       "cyr": "подобро е јас да умрам.",
       "lat": "podobro e jas da umram.",
       "en": "I should better die."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Блазе оној што си љуби,",
       "lat": "Blaze onoj što si ljubi,",
       "en": "Those that love are blessed,"
      },
      {
       "cyr": "кој што љуби верно либе,",
       "lat": "koj što ljubi verno libe,",
       "en": "those that love a faithful lover,"
      },
      {
       "cyr": "тој бесценет камен носи",
       "lat": "toj bescenet kamen nosi",
       "en": "those have a priceless gem"
      },
      {
       "cyr": "и е верен дур' до гроба.",
       "lat": "i e veren dur' do groba.",
       "en": "and are faithful 'till the grave."
      }
     ]
    }
   ]
  }
 ],
