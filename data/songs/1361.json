    {
     "lines": [
      {
       "cyr": "Јунак свири на тамбура,",
       "lat": "Junak sviri na tambura,",
       "en": "A hero plays the tambura,"
      },
      {
       "cyr": "на тенки гласови.",
       "lat": "na tenki glasovi.",
       "en": "in thin voices."
      },
      {
       "cyr": "Стој, почекај, лудо-младо,",
       "lat": "Stoj, počekaj, ludo-mlado,",
       "en": "Stop, wait, foolish youth,"
      },
      {
       "cyr": "со тебе ќе дојдам.",
       "lat": "so tebe ḱe dojdam.",
       "en": "I will come with you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ај врати се лудо-младо,",
       "lat": "- Aj vrati se ludo-mlado,",
       "en": "- Come back, foolish youth,"
      },
      {
       "cyr": "не мож' да поминеш,",
       "lat": "ne mož' da pomineš,",
       "en": "you cannot pass,"
      },
      {
       "cyr": "на пат има длабока река,",
       "lat": "na pat ima dlaboka reka,",
       "en": "on the road there is a deep river,"
      },
      {
       "cyr": "не мож' да поминеш.",
       "lat": "ne mož' da pomineš.",
       "en": "you cannot pass."
      }
     ]
    },
    {
     "lines": [
      {
