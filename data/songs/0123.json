   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Битка се бие кумановско поле,",
       "lat": "Bitka se bie kumanovsko pole,",
       "en": "A battle is fought on the Kumanovo field,"
      },
      {
       "cyr": "битка нерамна.",
       "lat": "bitka neramna.",
       "en": "an unequal battle."
      },
      {
       "cyr": "Пелинце ми гори, Пчиња жално плаче,",
       "lat": "Pelince mi gori, Pčinja žalno plače,",
       "en": "Pelince burns, Pchinja weeps sadly,"
      },
      {
       "cyr": "матна и крвава.",
       "lat": "matna i krvava.",
       "en": "muddy and bloody."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Карпуш војвода со Димче Еребица,",
       "lat": "Karpuš vojvoda so Dimče Erebica,",
       "en": "Voivode Karpush with Dimche Erebitsa,"
      },
      {
       "cyr": "Менков и Фетакот,",
       "lat": "Menkov i Fetakot,",
       "en": "Menkov and Fetak,"
      },
      {
       "cyr": "собраа дружина, млада убавина,",
       "lat": "sobraa družina, mlada ubavina,",
       "en": "gathered a band, young beauties,"
      },
      {
       "cyr": "душман да истераат.",
       "lat": "dušman da isteraat.",
       "en": "to drive out the enemy."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми згрмеа пушки, ми паднаа мушки,",
       "lat": "Mi zgrmea puški, mi padnaa muški,",
       "en": "Rifles thundered, the men fell,"
      },
      {
       "cyr": "младите херои.",
       "lat": "mladite heroi.",
       "en": "the young heroes."
      },
      {
       "cyr": "Душмани клети покажаа пети,",
       "lat": "Dušmani kleti pokažaa peti,",
       "en": "The cursed enemies showed their heels,"
      },
      {
       "cyr": "дојде красна слобода.",
       "lat": "dojde krasna sloboda.",
       "en": "dear freedom came."
      }
     ]
    }
