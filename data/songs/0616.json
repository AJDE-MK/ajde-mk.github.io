      {
       "cyr": "(Зедов жена мрзелива)",
       "lat": "(Zedov žena mrzeliva)",
       "en": "(I married a lazy woman)"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде станав се оженив",
       "lat": "Ajde stanav se oženiv",
       "en": "I decided to get married,"
      },
      {
       "cyr": "дејгиди де, дејгиди де.",
       "lat": "dejgidi de, dejgidi de.",
       "en": "hey, hey."
      },
      {
       "cyr": "Зедов жена болникава,",
       "lat": "Zedov žena bolnikava,",
       "en": "I married a sick woman,"
      },
      {
       "cyr": "дејгиди де, дејгиди де,",
       "lat": "dejgidi de, dejgidi de,",
       "en": "hey, hey."
      },
      {
       "cyr": "Болникава, мрзелива,",
       "lat": "Bolnikava, mrzeliva,",
       "en": "Sick and lazy,"
      },
      {
       "cyr": "дејгиди де, дејгиди деј.",
       "lat": "dejgidi de, dejgidi dej.",
       "en": "hey, hey."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја однесов кај докторот",
