      {
       "cyr": "Моли бога, сине Стојане",
       "lat": "Moli boga, sine Stojane",
       "en": "Pray to God, my son Stojan,"
      },
      {
       "cyr": "да изумрат беговите.",
       "lat": "da izumrat begovite.",
       "en": "that the beys may perish."
      },
      {
       "cyr": "Да изумрат беговите,",
       "lat": "Da izumrat begovite,",
       "en": "That the beys may perish,"
      },
      {
       "cyr": "да останат анамите.",
       "lat": "da ostanat anamite.",
       "en": "and the hanums1 remain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јашар бег, Осман бег,",
