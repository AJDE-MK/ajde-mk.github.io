   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Откако Ленка остави",
       "lat": "Otkako Lenka ostavi",
       "en": "After Lenka left"
      },
      {
       "cyr": "кошула тенка ленена,",
       "lat": "košula tenka lenena,",
       "en": "her thin linen shirt,"
      },
      {
       "cyr": "кошула тенка ленена,",
       "lat": "košula tenka lenena,",
       "en": "her thin linen shirt,"
      },
      {
       "cyr": "на разбој недовезена",
       "lat": "na razboj nedovezena",
       "en": "unfinished on the loom"
      },
      {
       "cyr": "и на наломи отиде",
       "lat": "i na nalomi otide",
       "en": "and went to the harvest-work"
      },
      {
       "cyr": "тутун да реди в' монопол,",
       "lat": "tutun da redi v' monopol,",
       "en": "to sort tobacco in the monopoly,"
      },
      {
       "cyr": "лицето ѝ се измени,",
       "lat": "liceto ì se izmeni,",
       "en": "her face changed,"
      },
      {
       "cyr": "веѓи ѝ паднаа надолу",
       "lat": "veǵi ì padnaa nadolu",
       "en": "her brows dropped down"
      },
      {
       "cyr": "и усни свија кораво.",
       "lat": "i usni svija koravo.",
       "en": "and her lips set hard."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не беше Ленка родена",
       "lat": "Ne beše Lenka rodena",
       "en": "Lenka was not born"
      },
      {
       "cyr": "за тија пусти тутуни,",
       "lat": "za tija pusti tutuni,",
       "en": "for those bleak tobaccos,"
      },
      {
       "cyr": "тутуни - жолти отрови",
       "lat": "tutuni - žolti otrovi",
       "en": "tobaccos, yellow poisons"
      },
      {
       "cyr": "за гради - китки розови.",
       "lat": "za gradi - kitki rozovi.",
       "en": "for chests, rosy bouquets."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Прва година помина,",
       "lat": "Prva godina pomina,",
       "en": "The first year passed,"
      },
      {
       "cyr": "грутка в' срцето ѝ легна,",
       "lat": "grutka v' srceto ì legna,",
       "en": "a lump settled in her heart,"
      },
      {
       "cyr": "втора година намина,",
       "lat": "vtora godina namina,",
       "en": "the second year came,"
      },
      {
       "cyr": "болест ја в' гради искина.",
       "lat": "bolest ja v' gradi iskina.",
       "en": "illness tore her in the chest."
      },
      {
       "cyr": "Трета година, земјата",
       "lat": "Treta godina, zemjata",
       "en": "The third year, the earth"
      },
      {
       "cyr": "на Ленка покри снагата.",
       "lat": "na Lenka pokri snagata.",
       "en": "covered Lenka's body."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И ноќе кога месечко",
       "lat": "I noḱe koga mesečko",
       "en": "And at night when the moon"
      },
      {
       "cyr": "гроб ѝ со свила виеше,",
       "lat": "grob ì so svila vieše,",
       "en": "wove a silk wreath over her grave,"
      },
      {
       "cyr": "ветeрчок тихо над неа",
       "lat": "veterčok tiho nad nea",
       "en": "a little breeze quietly above her"
      },
      {
       "cyr": "дробна ѝ тага рееше:",
       "lat": "drobna ì taga reeše:",
       "en": "scattered a small sorrow:"
      },
      {
       "cyr": "\"Зошто ми, зошто остана",
       "lat": "\"Zošto mi, zošto ostana",
       "en": "\"Why, why did it remain for me,"
      },
      {
       "cyr": "кошула недоткаена,",
       "lat": "košula nedotkaena,",
       "en": "the shirt not stitched,"
      },
      {
       "cyr": "кошула беше даровна?\"",
       "lat": "košula beše darovna?\"",
       "en": "the shirt was a gift?\""
      }
     ]
    }
