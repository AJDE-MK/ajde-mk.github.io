   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Едно малој моме",
       "lat": "Edno maloj mome",
       "en": "A small young girl"
      },
      {
       "cyr": "без мајка остана.",
       "lat": "bez majka ostana.",
       "en": "did not have a mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Расна, ми порасна",
       "lat": "Rasna, mi porasna",
       "en": "As she grew up"
      },
      {
       "cyr": "и за мајка праша.",
       "lat": "i za majka praša.",
       "en": "she searched for her mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Тате, мили тате,",
       "lat": "- Tate, mili tate,",
       "en": "- Tell me father, dear dad"
      },
      {
       "cyr": "каде е мојата мајка?",
       "lat": "kade e mojata majka?",
       "en": "where is my mother?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Твојта мајка, чедо,",
       "lat": "- Tvojta majka, čedo,",
       "en": "- Your mother, dear child"
      },
      {
       "cyr": "в' црна земја спие.",
       "lat": "v' crna zemja spie.",
       "en": "is sleeping in the dark ground."
      }
     ]
    }
   ]
  }
 ],
