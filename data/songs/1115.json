    {
     "lines": [
      {
       "cyr": "- Ој Јанкула мили синко,",
       "lat": "- Oj Jankula mili sinko,",
       "en": "- Oh Jankula, dear son,"
      },
      {
       "cyr": "малце куќа подрасипа",
       "lat": "malce kuḱa podrasipa",
       "en": "the house was ruined a little"
      },
      {
       "cyr": "од пиење, од јадење",
       "lat": "od pienje, od jadenje",
       "en": "by drinking, by eating"
      },
      {
       "cyr": "и од госје дочеквање,",
       "lat": "i od gosje dočekvanje,",
       "en": "and by receiving guests,"
      },
      {
       "cyr": "сека вечер побратими,",
       "lat": "seka večer pobratimi,",
       "en": "every evening blood-brothers,"
      },
      {
       "cyr": "а наутро посестрими.",
       "lat": "a nautro posestrimi.",
       "en": "and in the morning blood-sisters."
      }
     ]
    },
