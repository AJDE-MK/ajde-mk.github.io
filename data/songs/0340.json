 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Ој овчарче, бре чобанче,",
       "lat": "- Oj ovčarče, bre čobanče,",
       "en": "- Hey young shepherd, hey little herdsman,"
      },
      {
       "cyr": "што си толку развеселен?",
       "lat": "što si tolku razveselen?",
       "en": "why are you so merry?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Фино фесче на страната",
       "lat": "Fino fesče na stranata",
       "en": "A fine fez tilted to the side,"
      },
      {
       "cyr": "стодрам писќуљ над окото.",
       "lat": "stodram pisḱulj nad okoto.",
       "en": "a hundred-dram tassel over the eye."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ој Стојане, мој стопане,",
       "lat": "- Oj Stojane, moj stopane,",
       "en": "- Hey Stojan, my master,"
      },
      {
       "cyr": "как' да не сум развеселен?",
       "lat": "kak' da ne sum razveselen?",
       "en": "how could I not be merry?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Овци ми се објагниле,",
       "lat": "Ovci mi se objagnile,",
       "en": "My ewes have lambed,"
      },
      {
       "cyr": "половина облизниле.",
       "lat": "polovina obliznile.",
       "en": "half have licked (their lambs)."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Жена ми се породила,",
       "lat": "Žena mi se porodila,",
       "en": "My wife has given birth,"
      },
      {
       "cyr": "ми родила машко дете.",
       "lat": "mi rodila maško dete.",
       "en": "she bore a male child."
      }
     ]
    }
   ]
  }
 ],
