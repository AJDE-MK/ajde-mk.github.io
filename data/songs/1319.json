       "en": "I had fallen in love, old mother,"
      },
      {
       "cyr": "две црни очи.",
       "lat": "dve crni oči.",
       "en": "with two black eyes."
      },
      {
       "cyr": "Ама други ги однесе",
       "lat": "Ama drugi gi odnese",
       "en": "But another took away"
      },
      {
       "cyr": "тие две ѕвезди.",
       "lat": "tie dve dzvezdi.",
       "en": "those two stars."
      }
     ]
    },
