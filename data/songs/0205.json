   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Срце ме боли, ќе умрем",
       "lat": "Srce me boli, ḱe umrem",
       "en": "My heart hurts, I will die,"
      },
      {
       "cyr": "јандн аман",
       "lat": "jandn aman",
       "en": "yandn aman,"
      },
      {
       "cyr": "од мерак за Трпана.",
       "lat": "od merak za Trpana.",
       "en": "from longing for Trpana."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Све градови сум шетал",
       "lat": "Sve gradovi sum šetal",
       "en": "I have wandered through all the cities,"
      },
      {
       "cyr": "јандн аман",
       "lat": "jandn aman",
       "en": "yandn aman,"
      },
      {
       "cyr": "како тебе не најдов.",
       "lat": "kako tebe ne najdov.",
       "en": "and found none like you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па се вратив в' Тетово",
       "lat": "Pa se vrativ v' Tetovo",
       "en": "Then I came back to Tetovo,"
      },
      {
       "cyr": "јандн аман",
       "lat": "jandn aman",
       "en": "yandn aman,"
      },
      {
       "cyr": "да га свршим Трпана.",
       "lat": "da ga svršim Trpana.",
       "en": "to have done with Trpana."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако ме сакаш, сакај ме",
       "lat": "Ako me sakaš, sakaj me",
       "en": "If you love me, love me,"
      },
      {
       "cyr": "јандн аман",
       "lat": "jandn aman",
       "en": "yandn aman,"
      },
      {
       "cyr": "аку ме нејќеш кажи ми,",
       "lat": "aku me nejḱeš kaži mi,",
       "en": "if you don't want me, tell me,"
      },
      {
       "cyr": "да си го тражим чарето.",
       "lat": "da si go tražim čareto.",
       "en": "so I can look for my remedy."
      }
     ]
    }
   ]
  }
