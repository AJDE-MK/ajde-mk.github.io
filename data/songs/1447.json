   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кога си бев јас работник,",
       "lat": "Koga si bev jas rabotnik,",
       "en": "When I was a worker,"
      },
      {
       "cyr": "љубев богато девојче,",
       "lat": "ljubev bogato devojče,",
       "en": "I loved a rich girl,"
      },
      {
       "cyr": "ми беше мило, премило,",
       "lat": "mi beše milo, premilo,",
       "en": "she was dear to me, so dear,"
      },
      {
       "cyr": "го љубев страсно, безумно.",
       "lat": "go ljubev strasno, bezumno.",
       "en": "I loved her passionately, madly."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во една мајска си вечер",
       "lat": "Vo edna majska si večer",
       "en": "On one May evening"
      },
      {
       "cyr": "отидов право при неа,",
       "lat": "otidov pravo pri nea,",
       "en": "I went straight to her,"
      },
      {
       "cyr": "јас ѝ побарав раката,",
       "lat": "jas ì pobarav rakata,",
       "en": "I asked her for her hand,"
      },
      {
       "cyr": "та ми затвори вратата.",
       "lat": "ta mi zatvori vratata.",
       "en": "and she shut the door on me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Бегај ти, бегај од тука,",
       "lat": "- Begaj ti, begaj od tuka,",
       "en": "- Get away, get away from here,"
      },
      {
       "cyr": "јас сум богато девојче,",
       "lat": "jas sum bogato devojče,",
       "en": "I am a rich girl,"
      },
      {
       "cyr": "барај си лика, прилика,",
       "lat": "baraj si lika, prilika,",
       "en": "look for your like, your match,"
      },
      {
       "cyr": "ти си за мене одлика.",
       "lat": "ti si za mene odlika.",
       "en": "you are a distinction for me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Отидов право в меана,",
       "lat": "Otidov pravo v meana,",
       "en": "I went straight to the tavern,"
      },
      {
       "cyr": "нарачав шише ракија,",
       "lat": "naračav šiše rakija,",
       "en": "I ordered a bottle of brandy,"
      },
      {
       "cyr": "да пијам, да се опијам,",
       "lat": "da pijam, da se opijam,",
       "en": "to drink, to get drunk,"
      },
      {
       "cyr": "јадови да заборавам.",
       "lat": "jadovi da zaboravam.",
       "en": "to forget my sorrows."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Уште си шише не кренав,",
       "lat": "Ušte si šiše ne krenav,",
       "en": "I had not yet lifted the bottle,"
      },
      {
       "cyr": "некој одзади ме гушна,",
       "lat": "nekoj odzadi me gušna,",
       "en": "someone hugged me from behind,"
      },
      {
