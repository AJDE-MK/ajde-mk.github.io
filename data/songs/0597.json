    {
     "lines": [
      {
       "cyr": "Твојте лисја, горо сестро",
       "lat": "Tvojte lisja, goro sestro",
       "en": "Your leaves, forest sister,"
      },
      {
       "cyr": "пак ќе ти се вратат",
