   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Со години среќа не видов,",
       "lat": "So godini sreḱa ne vidov,",
       "en": "For years I have seen no happiness,"
      },
      {
       "cyr": "пуста младост си заминува.",
       "lat": "pusta mladost si zaminuva.",
       "en": "my empty youth is passing away."
      },
      {
       "cyr": "Чемер носам во душава,",
       "lat": "Čemer nosam vo dušava,",
       "en": "I carry bitterness in this soul,"
      },
      {
       "cyr": "в' срце рана неизлечива.",
       "lat": "v' srce rana neizlečiva.",
       "en": "in my heart an incurable wound."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Само ти, ти ми беше сè,",
       "lat": "Samo ti, ti mi beše sè,",
       "en": "Only you, you were everything to me,"
      },
      {
       "cyr": "сè што имав јас во животов.",
       "lat": "sè što imav jas vo životov.",
       "en": "everything I had in my life."
      },
      {
       "cyr": "Зошто душо, зошто мила ти,",
       "lat": "Zošto dušo, zošto mila ti,",
       "en": "Why, darling, why, my dear,"
      },
      {
       "cyr": "зошто ти ме измами?",
       "lat": "zošto ti me izmami?",
       "en": "why did you deceive me?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Знаеш колку јас те љубев,",
       "lat": "Znaeš kolku jas te ljubev,",
       "en": "You know how much I loved you,"
      },
      {
       "cyr": "ти ја дарив сета младост.",
       "lat": "ti ja dariv seta mladost.",
       "en": "I gave you all my youth."
      },
      {
       "cyr": "Како душа јас да смирам,",
       "lat": "Kako duša jas da smiram,",
       "en": "How am I to calm my soul,"
      },
      {
       "cyr": "кога веќе не те имам?",
       "lat": "koga veḱe ne te imam?",
       "en": "when I no longer have you?"
      }
     ]
    },
