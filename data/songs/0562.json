 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кондисал Ајрадин паша, аман,",
       "lat": "Kondisal Ajradin paša, aman,",
       "en": "Hayreddin Pasha* settled, aman*,"
      },
      {
       "cyr": "кондисал карши Галичник.",
       "lat": "kondisal karši Galičnik.",
       "en": "settled on the opposite side of Galichnik."
      },
      {
       "cyr": "Наличил силни топови, аман,",
       "lat": "Naličil silni topovi, aman,",
       "en": "And pointed strong cannons, aman,"
      },
      {
       "cyr": "да ми го горит Галичник.",
       "lat": "da mi go gorit Galičnik.",
       "en": "to burn down Galichnik."
      },
      {
       "cyr": "Галичник село големо, аман",
       "lat": "Galičnik selo golemo, aman",
       "en": "Galichnik, a village so huge, aman,"
      },
      {
       "cyr": "Стамбол на ќутук пишано.",
       "lat": "Stambol na ḱutuk pišano.",
       "en": "it was written on a log in Stambol*."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Извадил ѓузлум дулбија, аман,",
       "lat": "Izvadil ǵuzlum dulbija, aman,",
       "en": "He took out his spyglass, aman,"
      },
      {
       "cyr": "догледал чешма Упија.",
       "lat": "dogledal češma Upija.",
       "en": "to check at the fountain Upija*."
      },
      {
       "cyr": "На чешмата до две девојки, аман,",
       "lat": "Na češmata do dve devojki, aman,",
       "en": "At the fountain there were two maidens, aman,"
      },
      {
       "cyr": "две девојки и една невеста.",
       "lat": "dve devojki i edna nevesta.",
       "en": "two maidens and one bride."
      },
      {
       "cyr": "Девојки платно белеа, аман,",
       "lat": "Devojki platno belea, aman,",
       "en": "The maidens were bleaching cloth, aman,"
      },
      {
       "cyr": "невеста вода носеше.",
       "lat": "nevesta voda noseše.",
       "en": "the bride was carrying water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Излегол Тодор Томоски, аман,",
       "lat": "Izlegol Todor Tomoski, aman,",
       "en": "Todor Poposki got out, aman,"
      },
      {
       "cyr": "со ќеаите по него.",
       "lat": "so ḱeaite po nego.",
       "en": "accompanied with sheep owners."
      },
      {
       "cyr": "Јагне сугаре носеа, аман,",
       "lat": "Jagne sugare nosea, aman,",
       "en": "Bringing a lamb that was born late, aman,"
      },
      {
       "cyr": "сељам на паша чинејет.",
       "lat": "seljam na paša činejet.",
       "en": "to pay his respects with salaam* to Pasha."
      },
      {
       "cyr": "Сељам на паша чинејет,",
       "lat": "Seljam na paša činejet,",
       "en": "To pay his respects with salaam to Pasha,"
      },
      {
       "cyr": "да не го горит Галичник.",
       "lat": "da ne go gorit Galičnik.",
       "en": "so he won't burn down Galichnik."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Жалба му падна на срце, аман",
       "lat": "Žalba mu padna na srce, aman",
       "en": "Great sorrow fell on Pasha's heart, aman,"
      },
      {
       "cyr": "дигна си силни топови.",
       "lat": "digna si silni topovi.",
       "en": "he picked up his strong cannons."
      },
      {
       "cyr": "Дигна си силни топови, аман,",
       "lat": "Digna si silni topovi, aman,",
       "en": "He picked up his strong cannons, aman,"
      },
      {
       "cyr": "не го запалил Галичник.",
       "lat": "ne go zapalil Galičnik.",
       "en": "didn't burn down Galichnik."
      },
      {
       "cyr": "Галичник, село големо, аман,",
       "lat": "Galičnik, selo golemo, aman,",
       "en": "Galichnik - a village so huge, aman,"
      },
      {
       "cyr": "в Стамбол на ќутук пишано.",
       "lat": "v Stambol na ḱutuk pišano.",
       "en": "it was written on a log in Stambol."
      }
     ]
    }
   ]
  }
 ],
