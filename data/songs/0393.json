      {
       "cyr": "Тргнала ми Рума мома",
       "lat": "Trgnala mi Ruma moma",
       "en": "Ruma the girl set out"
      },
      {
       "cyr": "низ гора зелена,",
       "lat": "niz gora zelena,",
       "en": "through the green forest,"
      },
      {
       "cyr": "и по неа Стојан овчар",
       "lat": "i po nea Stojan ovčar",
       "en": "and after her Stojan the shepherd"
      },
      {
       "cyr": "с' меден кавал свири.",
       "lat": "s' meden kaval sviri.",
       "en": "plays on a honey-sweet flute."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Руме, моме,",
