    {
     "lines": [
      {
       "cyr": "Поминале, стара мајко, тешки години,",
       "lat": "Pominale, stara majko, teški godini,",
       "en": "Hard years have passed, old mother,"
      },
      {
       "cyr": "кога си остави села лерински.",
       "lat": "koga si ostavi sela lerinski.",
       "en": "since you left the villages of Lerin."
      },
      {
       "cyr": "Душа плаче, никој нема да ме разбере,",
       "lat": "Duša plače, nikoj nema da me razbere,",
       "en": "My soul weeps, no one will understand me,"
      },
      {
       "cyr": "никој нема ниту рака да ми подаде.",
       "lat": "nikoj nema nitu raka da mi podade.",
       "en": "no one will even offer me a hand."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Овчарани, Песочница, Арменово,",
