   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Пијан идам од града,",
       "lat": "Pijan idam od grada,",
       "en": "I come drunk from the city,"
      },
      {
       "cyr": "среќа’ам мома в’ ливада.",
       "lat": "sreḱa’am moma v’ livada.",
       "en": "I run into a maiden in the meadows."
      },
      {
       "cyr": "Си заиграм коната,",
       "lat": "Si zaigram konata,",
       "en": "I jump off my horse,"
      },
      {
       "cyr": "да целувам момата.",
       "lat": "da celuvam momata.",
       "en": "so I could kiss the maiden."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Сношти сум бил на васка,",
       "lat": "- Snošti sum bil na vaska,",
       "en": "- Last night I was by your house,"
      },
      {
       "cyr": "и на стол сум седнало.",
       "lat": "i na stol sum sednalo.",
       "en": "and I sat at the table."
      },
      {
       "cyr": "Благо вино сум пило,",
       "lat": "Blago vino sum pilo,",
       "en": "I drank sweet wine,"
      },
      {
       "cyr": "благо вино, ракија.",
       "lat": "blago vino, rakija.",
       "en": "sweet wine, brandy."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе молитвам мајка ти,",
       "lat": "Ḱe molitvam majka ti,",
       "en": "I will pray for your mother,"
      },
      {
       "cyr": "ќе благосвам татка ти.",
       "lat": "ḱe blagosvam tatka ti.",
       "en": "I will bless your dad."
      },
      {
       "cyr": "Пари немам да платам,",
       "lat": "Pari nemam da platam,",
       "en": "I don’t have money to pay,"
      },
      {
       "cyr": "тебе не те оставам.",
       "lat": "tebe ne te ostavam.",
       "en": "but I’m not leaving without you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Почна мома да бега.",
       "lat": "Počna moma da bega.",
       "en": "The maiden began to flee."
      },
      {
       "cyr": "- Чекај моме, не бегај,",
       "lat": "- Čekaj mome, ne begaj,",
       "en": "- Maiden, do not run away,"
      },
      {
       "cyr": "ти си моја па моја!",
       "lat": "ti si moja pa moja!",
       "en": "you are mine, only mine."
      }
     ]
    }
   ]
  }
 ],
