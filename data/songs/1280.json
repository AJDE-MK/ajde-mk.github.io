   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Таму негде леринско,",
       "lat": "Tamu negde lerinsko,",
       "en": "Somewhere there near Lerin1,",
       "en_mt": false
      },
      {
       "cyr": "костурско и воденско,",
       "lat": "kostursko i vodensko,",
       "en": "near Kostur2 and Voden3,",
       "en_mt": false
      },
      {
       "cyr": "каде наши мајки, татковци растеа,",
       "lat": "kade naši majki, tatkovci rastea,",
       "en": "Where our mothers, fathers grew",
       "en_mt": false
      },
      {
       "cyr": "каде први песни егејски пееа,",
       "lat": "kade prvi pesni egejski peea,",
       "en": "Where first Aegean songs they sang",
       "en_mt": false
      },
      {
       "cyr": "први солзи кај што ронеа.",
       "lat": "prvi solzi kaj što ronea.",
       "en": "First tears whence were born.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму сакам јас да заминам,",
       "lat": "Tamu sakam jas da zaminam,",
       "en": "There I want to pass by,",
       "en_mt": false
      },
      {
       "cyr": "убав Егеј да го запрашам",
       "lat": "ubav Egej da go zaprašam",
       "en": "Lovely Aegean I want to ask",
       "en_mt": false
      },
      {
       "cyr": "дали денес в' очи гледа на вистината",
       "lat": "dali denes v' oči gleda na vistinata",
       "en": "Do today eyes see the truth",
       "en_mt": false
      },
      {
       "cyr": "што си има толку чеда во туѓината.",
       "lat": "što si ima tolku čeda vo tuǵinata.",
       "en": "That you have so many children abroad.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму негде солунско,",
       "lat": "Tamu negde solunsko,",
       "en": "Somewhere there near Solun4,",
       "en_mt": false
      },
      {
       "cyr": "таму негде кукушко,",
       "lat": "tamu negde kukuško,",
       "en": "Somewhere there near Kukush5,",
       "en_mt": false
      },
      {
       "cyr": "колку таму кутра земјата видела,",
       "lat": "kolku tamu kutra zemjata videla,",
       "en": "Around there the poor soil saw,",
       "en_mt": false
      },
      {
       "cyr": "толку наши млади фиданки покрила,",
       "lat": "tolku naši mladi fidanki pokrila,",
       "en": "How many of our young covered she saw,",
       "en_mt": false
      },
      {
       "cyr": "колку мајки в' црно завила.",
       "lat": "kolku majki v' crno zavila.",
       "en": "How many mothers in black she clothed.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму сакам јас да заминам,",
       "lat": "Tamu sakam jas da zaminam,",
       "en": "There I want to pass by,",
       "en_mt": false
      },
      {
       "cyr": "убав Егеј да го запрашам",
       "lat": "ubav Egej da go zaprašam",
       "en": "Lovely Aegean I want to ask",
       "en_mt": false
      },
      {
       "cyr": "дали денес в' очи гледа на вистината",
       "lat": "dali denes v' oči gleda na vistinata",
       "en": "Do today eyes see the truth",
       "en_mt": false
      },
      {
       "cyr": "што си има толку чеда во туѓината.",
       "lat": "što si ima tolku čeda vo tuǵinata.",
       "en": "That you have so many children abroad.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сино небо егејско,",
       "lat": "Sino nebo egejsko,",
       "en": "Blue Aegean sky,",
       "en_mt": false
      },
      {
       "cyr": "еј, што не си слободно,",
       "lat": "ej, što ne si slobodno,",
       "en": "Oh but your not free",
       "en_mt": false
      },
      {
       "cyr": "како пиле да те прелетам еден ден,",
       "lat": "kako pile da te preletam eden den,",
       "en": "Like a bird I would fledge you one day,",
       "en_mt": false
      },
      {
       "cyr": "мојта песна да ја запеам за тебе.",
       "lat": "mojta pesna da ja zapeam za tebe.",
       "en": "My song I will sing for you,",
       "en_mt": false
      }
     ]
    },
