   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Зоро моја, Зорице",
       "lat": "- Zoro moja, Zorice",
       "en": "- Zora, my Zora,"
      },
      {
       "cyr": "зборови слушам за тебе",
       "lat": "zborovi slušam za tebe",
       "en": "I hear words about you,"
      },
      {
       "cyr": "кажи ми со кого си",
       "lat": "kaži mi so kogo si",
       "en": "tell me who you are with"
      },
      {
       "cyr": "сем со мене?",
       "lat": "sem so mene?",
       "en": "besides me?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре момче будало,",
       "lat": "- A bre momče budalo,",
       "en": "- Oh, you foolish boy,"
      },
      {
       "cyr": "момче убаво.",
       "lat": "momče ubavo.",
       "en": "you beautiful boy."
      },
      {
       "cyr": "Нели јас те милував,",
       "lat": "Neli jas te miluvav,",
       "en": "Didn't I caress you,"
      },
      {
       "cyr": "љубов дарував?",
       "lat": "ljubov daruvav?",
       "en": "given you love?"
      },
      {
       "cyr": "Што „каде сум“, „со кого сум“,",
       "lat": "Što „kade sum“, „so kogo sum“,",
       "en": "What \"where am I\", \"who am I with\","
      },
      {
       "cyr": "еве твоја пак ти сум.",
       "lat": "eve tvoja pak ti sum.",
       "en": "here, I am yours again."
      }
     ]
    },
    {
