 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Болен ми лежи Миле Поп Јорданов",
       "lat": "Bolen mi leži Mile Pop Jordanov",
       "en": "Sick lies Mile Popjordanov",
       "en_mt": false
      },
      {
       "cyr": "над глава му стои стара му мајка,",
       "lat": "nad glava mu stoi stara mu majka,",
       "en": "by his head stands his old mother,",
       "en_mt": false
      },
      {
       "cyr": "жално го жали, милно го плаче:",
       "lat": "žalno go žali, milno go plače:",
       "en": "sadly grieving him, crying for him:",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стани ми, стани, мое мило чедо,",
       "lat": "- Stani mi, stani, moe milo čedo,",
       "en": "- Get up for me, get up my dear child",
       "en_mt": false
      },
      {
       "cyr": "твојте другари по сокаци одат,",
       "lat": "tvojte drugari po sokaci odat,",
       "en": "your friends go through the streets",
       "en_mt": false
      },
      {
       "cyr": "жални песни пеат, тебе те спомнуват.",
       "lat": "žalni pesni peat, tebe te spomnuvat.",
       "en": "singing sad songs, to remember you.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Бог да го прости Миле Поп Јорданов,",
       "lat": "Bog da go prosti Mile Pop Jordanov,",
       "en": "God forgive Mile Popjordanov,",
       "en_mt": false
      },
      {
       "cyr": "Миле Поп Јорданов за народ загина,",
       "lat": "Mile Pop Jordanov za narod zagina,",
       "en": "Mile Popjordanov for people killed",
       "en_mt": false
      },
      {
       "cyr": "за народ загина, за Македонија.",
       "lat": "za narod zagina, za Makedonija.",
       "en": "for people killed, for Macedonia.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Неговите сестри в' црно облечени,",
       "lat": "Negovite sestri v' crno oblečeni,",
       "en": "His sisters dressed in black,",
       "en_mt": false
      },
      {
       "cyr": "свадба ќе прават, брата ќе женат,",
       "lat": "svadba ḱe pravat, brata ḱe ženat,",
       "en": "to make a wedding, brothers to marry,",
       "en_mt": false
      },
      {
       "cyr": "брата ќе женат за Македонија.",
       "lat": "brata ḱe ženat za Makedonija.",
       "en": "brothers to marry for Macedonia.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Неговата мајка в' црно облечена,",
       "lat": "Negovata majka v' crno oblečena,",
       "en": "His mother dressed in black,",
       "en_mt": false
      },
      {
       "cyr": "свадба ќе прави, сина ќе жени,",
       "lat": "svadba ḱe pravi, sina ḱe ženi,",
       "en": "to make a wedding, the son to marry",
       "en_mt": false
      },
      {
       "cyr": "сина ќе жени за Македонија.",
       "lat": "sina ḱe ženi za Makedonija.",
       "en": "the son to marry for Macedonia.",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
