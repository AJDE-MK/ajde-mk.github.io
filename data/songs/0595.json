   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Цветините очи черешови",
       "lat": "Cvetinite oči čerešovi",
       "en": "Cveta's eyes like cherries,"
      },
      {
       "cyr": "сношти ги видов расплакани.",
       "lat": "snošti gi vidov rasplakani.",
       "en": "last night I saw them in tears."
      },
      {
       "cyr": "- Цветано моме убаво,",
       "lat": "- Cvetano mome ubavo,",
       "en": "- Cveta, pretty girl,"
      },
      {
       "cyr": "што си ми Цвете нажалена,",
       "lat": "što si mi Cvete nažalena,",
       "en": "why are you Cveta sad,"
      },
      {
       "cyr": "нажалена, расплакана?",
       "lat": "nažalena, rasplakana?",
       "en": "sad and crying?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дали ти е мајка умрела",
       "lat": "- Dali ti e majka umrela",
       "en": "Did your mother die,"
      },
      {
       "cyr": "или е болен татко ти,",
       "lat": "ili e bolen tatko ti,",
       "en": "or is your father sick,"
      },
      {
       "cyr": "или те тебе посвршија",
       "lat": "ili te tebe posvršija",
       "en": "or are you engaged to be married"
      },
      {
       "cyr": "за друго либе што не сакаш?",
       "lat": "za drugo libe što ne sakaš?",
       "en": "to another bachelor that you don't love?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ниту ми е мајка умрела,",
       "lat": "- Nitu mi e majka umrela,",
       "en": "- Neither my mother is dead,"
      },
      {
       "cyr": "ниту е болен татко ми,",
       "lat": "nitu e bolen tatko mi,",
       "en": "not my father is sick."
      },
      {
       "cyr": "либето војник ми замина",
       "lat": "libeto vojnik mi zamina",
       "en": "My love went to the army"
      },
      {
       "cyr": "во таа града Битола.",
       "lat": "vo taa grada Bitola.",
       "en": "in the city of Bitola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од него писмо јас немам,",
       "lat": "Od nego pismo jas nemam,",
       "en": "I don't have a letter from him,"
      },
      {
       "cyr": "зато сум толку нажалена,",
       "lat": "zato sum tolku nažalena,",
       "en": "that's why I am so sad,"
      },
      {
       "cyr": "затој сум толку нажалена,",
       "lat": "zatoj sum tolku nažalena,",
       "en": "that's why I am so sad,"
      },
      {
       "cyr": "нажалена, расплакана.",
       "lat": "nažalena, rasplakana.",
       "en": "sad and in tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не плачи, Цвете, не жали,",
       "lat": "- Ne plači, Cvete, ne žali,",
       "en": "- Don't cry Cveta, don't be sad,"
      },
      {
       "cyr": "либето писмо испрати,",
       "lat": "libeto pismo isprati,",
       "en": "your love sent a letter,"
      },
      {
       "cyr": "либето писмо испрати,",
       "lat": "libeto pismo isprati,",
       "en": "your love sent a letter"
      },
      {
       "cyr": "до твојта верна другарка.",
       "lat": "do tvojta verna drugarka.",
       "en": "to your dear girlfriend."
      }
     ]
    }
   ]
  }
