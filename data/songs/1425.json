   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Умреја батко Ѓорѓија, мори бабо,",
       "lat": "Umreja batko Ǵorǵija, mori babo,",
       "en": "Big brother George died, grandma,"
      },
      {
       "cyr": "за едну чашу ракија.",
       "lat": "za ednu čašu rakija.",
       "en": "for one glass of rakija*."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не је умреја од болест, мори бабо",
       "lat": "Ne je umreja od bolest, mori babo",
       "en": "He did not die of a disease, grandma,"
      },
      {
       "cyr": "тук је умреја од лудост.",
       "lat": "tuk je umreja od ludost.",
       "en": "but died of madness."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Све што видеја убаво, мори бабо",
       "lat": "Sve što videja ubavo, mori babo",
       "en": "Everything beautiful that he saw, grandma,"
      },
      {
       "cyr": "све сакат да је његово.",
       "lat": "sve sakat da je njegovo.",
       "en": "he wanted it to be his."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Видеја арни волови, мори бабо",
       "lat": "Videja arni volovi, mori babo",
       "en": "He saw nice oxen, grandma,"
      },
      {
       "cyr": "па сакат да се његови.",
       "lat": "pa sakat da se njegovi.",
       "en": "so he wanted them to be his."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Видеја младу невесту, мори бабо",
       "lat": "Videja mladu nevestu, mori babo",
       "en": "He saw a young bride, grandma,"
      },
      {
       "cyr": "па сакат да је његова.",
       "lat": "pa sakat da je njegova.",
       "en": "so he wanted her to be his."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не је умреја од болест, мори бабо",
       "lat": "Ne je umreja od bolest, mori babo",
       "en": "He did not die of a disease, grandma,"
      },
      {
       "cyr": "тук је умреја од лудост.",
       "lat": "tuk je umreja od ludost.",
       "en": "but died of madness."
      }
     ]
    }
   ]
