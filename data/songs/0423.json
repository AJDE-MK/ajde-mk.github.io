 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Еееј, учи ме мајко, карај ме",
       "lat": "Eeej, uči me majko, karaj me",
       "en": "Hey, teach me mother, guide me"
      },
      {
       "cyr": "како да ја земам Лилјана",
       "lat": "kako da ja zemam Liljana",
       "en": "how to win Liljana"
      },
      {
       "cyr": "Лилјана мома убава",
       "lat": "Liljana moma ubava",
       "en": "Liljana, pretty girl"
      },
      {
       "cyr": "Лилјана тенка висока",
       "lat": "Liljana tenka visoka",
       "en": "Liljana, skinny, tall"
      },
      {
       "cyr": "Лилјана бела црвена",
       "lat": "Liljana bela crvena",
       "en": "Liljana, white, red"
      },
      {
       "cyr": "Лилјана ситен босилок",
       "lat": "Liljana siten bosilok",
       "en": "Liljana, tiny basil"
      },
      {
       "cyr": "Лилјана една на мајка.",
       "lat": "Liljana edna na majka.",
       "en": "Liljana, her mother’s only child."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Учам те синко карам те",
       "lat": "Učam te sinko karam te",
       "en": "I teach you, my son, I guide you"
      },
      {
       "cyr": "како да ја земиш Лилјана",
       "lat": "kako da ja zemiš Liljana",
       "en": "how to win Liljana’s heart"
      },
      {
       "cyr": "повикај триста мајстори",
       "lat": "povikaj trista majstori",
       "en": "call three hundred masons"
      },
      {
       "cyr": "направи чешма шарена",
       "lat": "napravi češma šarena",
       "en": "make a colorful fountain"
      },
      {
       "cyr": "наврати вода студена",
       "lat": "navrati voda studena",
       "en": "direct cold water into it"
      },
      {
       "cyr": "сите селани ќе дојдат",
       "lat": "site selani ḱe dojdat",
       "en": "all the villagers will come"
      },
      {
       "cyr": "и Лилјанини другарки",
       "lat": "i Liljanini drugarki",
       "en": "and Liljana’s friends, too"
      },
      {
       "cyr": "ем сите калеш невести",
       "lat": "em site kaleš nevesti",
       "en": "and all the dark-haired brides"
      },
      {
       "cyr": "белким Лилјана ќе дојде.",
       "lat": "belkim Liljana ḱe dojde.",
       "en": "hopefully Liljana will come."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Послуша Стојан мајка си",
       "lat": "Posluša Stojan majka si",
       "en": "Stojan listened to his mother"
      },
      {
       "cyr": "повика триста мајстори",
       "lat": "povika trista majstori",
       "en": "he called three hundred masons"
      },
      {
       "cyr": "направи чешма шарена",
       "lat": "napravi češma šarena",
       "en": "he made a colorful fountain"
      },
      {
       "cyr": "наврати вода студена",
       "lat": "navrati voda studena",
       "en": "he directed cold water into it"
      },
      {
       "cyr": "сите селани дојдоа",
       "lat": "site selani dojdoa",
       "en": "all the villagers came"
      },
      {
       "cyr": "и Лилјанини другарки",
       "lat": "i Liljanini drugarki",
       "en": "and Liljana’s friends"
      },
      {
       "cyr": "ем сите калеш невести",
       "lat": "em site kaleš nevesti",
       "en": "and all the dark-haired brides"
      },
      {
       "cyr": "кучка Лилјана не дојде.",
       "lat": "kučka Liljana ne dojde.",
       "en": "damn Liljana for not coming."
      }
     ]
    }
   ]
  }
 ],
