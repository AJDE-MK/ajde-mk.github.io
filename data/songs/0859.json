   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Што си налутено либе,",
       "lat": "Što si naluteno libe,",
       "en": "Why are you angry, my love,"
      },
      {
       "cyr": "што си нажалено?",
       "lat": "što si nažaleno?",
       "en": "why are you grieved?"
      },
      {
       "cyr": "Што ти потемнело, либе,",
       "lat": "Što ti potemnelo, libe,",
       "en": "Why has your white face,"
      },
      {
       "cyr": "белото ти лице?",
       "lat": "beloto ti lice?",
       "en": "my love, grown dark?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што ти црни очи, либе,",
       "lat": "Što ti crni oči, libe,",
       "en": "Why do your black eyes, my love,"
      },
      {
       "cyr": "пливаат во солзи,",
       "lat": "plivaat vo solzi,",
       "en": "swim in tears,"
      },
      {
       "cyr": "ти очи си бришеш, либе",
       "lat": "ti oči si brišeš, libe",
       "en": "you wipe your eyes, my love,"
      },
      {
       "cyr": "с' долгата ти коса?",
       "lat": "s' dolgata ti kosa?",
       "en": "with your long hair?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дали знаеш, мило либе,",
       "lat": "- Dali znaeš, milo libe,",
       "en": "- Do you know, dear love,"
      },
      {
       "cyr": "колку се години",
       "lat": "kolku se godini",
       "en": "how many years it is"
      },
      {
       "cyr": "што те тајно љубам, либе,",
       "lat": "što te tajno ljubam, libe,",
       "en": "that I have loved you in secret, my love,"
      },
      {
       "cyr": "без да ме узнаеш?",
       "lat": "bez da me uznaeš?",
       "en": "without you finding out?"
      }
     ]
    }
   ]
  }
