   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Катуше, пусто Катуше,",
       "lat": "Katuše, pusto Katuše,",
       "en": "Katushe, poor Katushe,"
      },
      {
       "cyr": "што ти е било писано.",
       "lat": "što ti e bilo pisano.",
       "en": "what destiny was written for you."
      },
      {
       "cyr": "Оф, леле, леле Катуше,",
       "lat": "Of, lele, lele Katuše,",
       "en": "Oh, dear Katushe,"
      },
      {
       "cyr": "изгорев јагне по тебе.",
       "lat": "izgorev jagne po tebe.",
       "en": "I am burning, my lamb, for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Маж пијаница да земеш,",
       "lat": "Maž pijanica da zemeš,",
       "en": "You married a drunkard,"
      },
      {
       "cyr": "Никола од Коцарета.",
       "lat": "Nikola od Kocareta.",
       "en": "Nikola from the Kocare family."
      },
      {
       "cyr": "Оф, леле, леле Катуше,",
       "lat": "Of, lele, lele Katuše,",
       "en": "Oh, dear Katushe,"
      },
      {
       "cyr": "изгорев јагне по тебе.",
       "lat": "izgorev jagne po tebe.",
       "en": "I am burning, my lamb, for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите момчиња на пазар,",
       "lat": "Site momčinja na pazar,",
       "en": "All the boys are at the market,"
      },
      {
       "cyr": "твоето момче крај бочва.",
       "lat": "tvoeto momče kraj bočva.",
       "en": "your boy is by the barrel."
      },
      {
       "cyr": "Оф, леле, леле Катуше,",
       "lat": "Of, lele, lele Katuše,",
       "en": "Oh, dear Katushe,"
      },
      {
       "cyr": "изгорев јагне по тебе.",
       "lat": "izgorev jagne po tebe.",
       "en": "I am burning, my lamb, for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите момчиња на гурбет,",
