   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Низ Петлец идат трима војводи",
       "lat": "Niz Petlec idat trima vojvodi",
       "en": "Three voivodes are going through Petlec,"
      },
      {
       "cyr": "идат и питат за Русиново.",
       "lat": "idat i pitat za Rusinovo.",
       "en": "they go and ask about Rusinovo."
      },
      {
       "cyr": "Првиот беше тој Дамјан Груев,",
       "lat": "Prviot beše toj Damjan Gruev,",
       "en": "The first was that Damjan Gruev,"
      },
      {
       "cyr": "вториот беше Атанас Карчев,",
       "lat": "vtoriot beše Atanas Karčev,",
       "en": "the second was Atanas Karchev,"
      },
      {
       "cyr": "третиот беше Сандо Китанов,",
       "lat": "tretiot beše Sando Kitanov,",
       "en": "the third was Sando Kitanov,"
      },
      {
       "cyr": "идат и теглат за Русиново.",
       "lat": "idat i teglat za Rusinovo.",
       "en": "they go and trudge toward Rusinovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Куга спандаха во Русиново,",
       "lat": "Kuga spandaha vo Rusinovo,",
       "en": "When they reached Rusinovo,"
      },
      {
       "cyr": "там ѝ дочека Коле Чукаров.",
       "lat": "tam ì dočeka Kole Čukarov.",
       "en": "Kole Chukarov met them there."
      },
      {
       "cyr": "Ка ѝ дочека, они питаха",
       "lat": "Ka ì dočeka, oni pitaha",
       "en": "When he had met them, they asked"
      },
      {
       "cyr": "за чорбаџи Димо Алаџозов,",
       "lat": "za čorbadži Dimo Aladžozov,",
       "en": "about the rich man Dimo Aladzhozov,"
      },
      {
       "cyr": "Алаџозов, прочут чорбаџија.",
       "lat": "Aladžozov, pročut čorbadžija.",
       "en": "Aladzhozov, a famous rich man."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Куга четата ја разместиха,",
       "lat": "Kuga četata ja razmestiha,",
       "en": "When they had settled the band,"
      },
      {
       "cyr": "војводите у Димо хојдоха.",
       "lat": "vojvodite u Dimo hojdoha.",
       "en": "the voivodes went to Dimo's house."
      },
      {
       "cyr": "Бог да убие наште ишпиони,",
       "lat": "Bog da ubie našte išpioni,",
       "en": "May God strike down our spies,"
      },
      {
       "cyr": "што предадоха славната чета,",
       "lat": "što predadoha slavnata četa,",
       "en": "who betrayed the glorious band,"
      },
      {
       "cyr": "славната чета, чујен војвода,",
       "lat": "slavnata četa, čujen vojvoda,",
       "en": "the glorious band, the renowned voivode,"
      },
      {
       "cyr": "чуен војвода - Дамјан Груев!",
       "lat": "čuen vojvoda - Damjan Gruev!",
       "en": "the renowned voivode, Damjan Gruev!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Турци дојдоха, село заградиха,",
       "lat": "Turci dojdoha, selo zagradiha,",
       "en": "The Turks came, they fenced in the village,"
      },
      {
       "cyr": "Турци дојдоха, село опсадиха.",
       "lat": "Turci dojdoha, selo opsadiha.",
       "en": "the Turks came, they besieged the village."
      },
      {
       "cyr": "Догледала ѝ првата стража,",
       "lat": "Dogledala ì prvata straža,",
       "en": "The first guard saw them,"
      },
      {
       "cyr": "првата стража од бела скала,",
       "lat": "prvata straža od bela skala,",
       "en": "the first guard from the white rock,"
      },
      {
       "cyr": "па си соопшчава на војводата:",
       "lat": "pa si soopščava na vojvodata:",
       "en": "and reports to the voivode:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ајде војводо, ајде Дамјане,",
       "lat": "- Ajde vojvodo, ajde Damjane,",
       "en": "- Come on, voivode, come on, Damjan,"
      },
      {
       "cyr": "Русиново здраво опсадено,",
       "lat": "Rusinovo zdravo opsadeno,",
       "en": "Rusinovo is completely besieged,"
      },
      {
       "cyr": "здраво опсадено од Турците,",
       "lat": "zdravo opsadeno od Turcite,",
       "en": "completely besieged by the Turks."
      },
      {
       "cyr": "Дамјан се спрема, хладно говори:",
       "lat": "Damjan se sprema, hladno govori:",
       "en": "Damjan gets ready, speaks coldly:"
      },
      {
       "cyr": "- Ајде другари, ајде четници,",
       "lat": "- Ajde drugari, ajde četnici,",
       "en": "- Come on, comrades, come on, fighters,"
      },
      {
       "cyr": "дојде време борба ќе водиме,",
       "lat": "dojde vreme borba ḱe vodime,",
       "en": "the time has come, we will fight,"
      },
      {
       "cyr": "борба ќе водиме в Русиново.",
       "lat": "borba ḱe vodime v Rusinovo.",
       "en": "we will fight in Rusinovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дедо Димо вратата отвори,",
       "lat": "Dedo Dimo vratata otvori,",
       "en": "Grandfather Dimo opened the door,"
      },
      {
       "cyr": "ка врата отвори, пушка пукна,",
       "lat": "ka vrata otvori, puška pukna,",
       "en": "as he opened the door, a rifle shot rang out,"
      },
      {
       "cyr": "пушка пукна - Димо мртов падна!",
       "lat": "puška pukna - Dimo mrtov padna!",
       "en": "a rifle shot rang out, Dimo fell dead!"
      },
      {
       "cyr": "Димо падна, бабата му рипна,",
       "lat": "Dimo padna, babata mu ripna,",
       "en": "Dimo fell, his old wife leapt up,"
      },
      {
       "cyr": "бабата рипна и мртва падна,",
       "lat": "babata ripna i mrtva padna,",
       "en": "the old wife leapt up and fell dead,"
      },
      {
       "cyr": "Дамјан се реши, пушката зема:",
       "lat": "Damjan se reši, puškata zema:",
       "en": "Damjan made up his mind, took his rifle:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ај со мене, ништо не чекајте!",
       "lat": "- Aj so mene, ništo ne čekajte!",
       "en": "- Come with me, wait for nothing!"
      },
      {
       "cyr": "Борба се почна, село се дими,",
       "lat": "Borba se počna, selo se dimi,",
       "en": "The fight began, the village is smoking,"
      },
      {
       "cyr": "село се дими, децата пискат",
       "lat": "selo se dimi, decata piskat",
       "en": "the village is smoking, the children shriek,"
      },
      {
       "cyr": "децата пискат, мајките плачат,",
       "lat": "decata piskat, majkite plačat,",
       "en": "the children shriek, the mothers weep,"
      },
      {
       "cyr": "четници излагат, кај ка може,",
       "lat": "četnici izlagat, kaj ka može,",
       "en": "the fighters get out, wherever they can,"
      },
      {
       "cyr": "четници излават, се спасават.",
       "lat": "četnici izlavat, se spasavat.",
       "en": "the fighters get out, they save themselves."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ка прирапаја прво ја паднал,",
       "lat": "Ka prirapaja prvo ja padnal,",
       "en": "When they rushed out, first fell,"
      },
      {
       "cyr": "прво ја паднал Сандо Китанов,",
       "lat": "prvo ja padnal Sando Kitanov,",
       "en": "first fell Sando Kitanov,"
      },
      {
       "cyr": "Сандо Китанов прва жртва бил,",
       "lat": "Sando Kitanov prva žrtva bil,",
       "en": "Sando Kitanov was the first victim,"
      },
      {
       "cyr": "Атанас Карчев напред си врви",
       "lat": "Atanas Karčev napred si vrvi",
       "en": "Atanas Karchev walks ahead"
      },
      {
       "cyr": "и след него иде Дамјан Груев,",
       "lat": "i sled nego ide Damjan Gruev,",
       "en": "and after him comes Damjan Gruev,"
      },
      {
       "cyr": "Дамјан ранија, на Карчев дума:",
       "lat": "Damjan ranija, na Karčev duma:",
       "en": "Damjan wounded, says to Karchev:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Оди Атанасе, спасавај се!",
       "lat": "- Odi Atanase, spasavaj se!",
       "en": "- Go, Atanas, save yourself!"
      },
      {
       "cyr": "Спасавај се, кој како знае!",
       "lat": "Spasavaj se, koj kako znae!",
       "en": "Save yourself, each as he knows how!"
      },
      {
       "cyr": "Карчев му вели, вели говори:",
       "lat": "Karčev mu veli, veli govori:",
       "en": "Karchev tells him, he says, he speaks:"
      },
      {
       "cyr": "- Крачка не тргам јазе од тебе!",
       "lat": "- Kračka ne trgam jaze od tebe!",
       "en": "- I will not move a step away from you!"
      },
      {
       "cyr": "Карчев говори на Мирчо Чопов:",
       "lat": "Karčev govori na Mirčo Čopov:",
       "en": "Karchev speaks to Mircho Chopov:"
      },
      {
       "cyr": "- Ти го знаеш, Мирчо, зборниот пункт,",
       "lat": "- Ti go znaeš, Mirčo, zborniot punkt,",
       "en": "- You know the assembly point,"
      },
      {
       "cyr": "не ме чекај, Дамјан не оставам.",
       "lat": "ne me čekaj, Damjan ne ostavam.",
       "en": "do not wait for me, I am not leaving Damjan."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Куга четниците излегоха,",
       "lat": "Kuga četnicite izlegoha,",
       "en": "When the fighters had got out,"
      },
      {
       "cyr": "Дамјан и Атанас останаха,",
       "lat": "Damjan i Atanas ostanaha,",
       "en": "Damjan and Atanas remained,"
      },
      {
       "cyr": "двата останаха дор погинаха,",
       "lat": "dvata ostanaha dor poginaha,",
       "en": "the two remained until they fell,"
      },
      {
       "cyr": "Турци ѝ гонат, свето се памети!",
       "lat": "Turci ì gonat, sveto se pameti!",
       "en": "the Turks chase them, may their memory be holy!"
      },
      {
       "cyr": "Зачекала и онаја војска",
       "lat": "Začekala i onaja vojska",
       "en": "The army was waiting for them too,"
      },
      {
       "cyr": "турската војска од Безгашчево.",
       "lat": "turskata vojska od Bezgaščevo.",
       "en": "the Turkish army from Bezgashtevo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И они не се могли да идат,",
       "lat": "I oni ne se mogli da idat,",
       "en": "And they could not go on,"
      },
      {
       "cyr": "они са душа они оставили",
       "lat": "oni sa duša oni ostavili",
       "en": "they gave up their souls"
      },
      {
       "cyr": "на Трнков преслав, при таја чешма.",
       "lat": "na Trnkov preslav, pri taja češma.",
       "en": "at Trnkov pass, by that fountain."
      }
     ]
    }
   ]
  }
 ],
