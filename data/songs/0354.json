   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Што ми е мило ем драго,",
       "lat": "Što mi e milo em drago,",
       "en": "I would like so much"
      },
      {
       "cyr": "на Струга дуќан да имам.",
       "lat": "na Struga duḱan da imam.",
       "en": "to have a store in Struga."
      },
      {
       "cyr": "ОФ леле, леле либе ле",
       "lat": "OF lele, lele libe le",
       "en": "Oh hey, my dear love,"
      },
      {
       "cyr": "срцево ми го џанам изгоре.",
       "lat": "srcevo mi go džanam izgore.",
       "en": "you make my heart burn."
      }
     ]
    },
    {
