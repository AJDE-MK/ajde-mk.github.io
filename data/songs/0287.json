      {
       "cyr": "Што ми е мило мамо",
       "lat": "Što mi e milo mamo",
       "en": "What is dear to me, mother,"
      },
      {
       "cyr": "мило ем драго,",
       "lat": "milo em drago,",
       "en": "dear and precious,"
      },
      {
       "cyr": "сејмен да шетам мамо",
       "lat": "sejmen da šetam mamo",
       "en": "to stroll as a guard (sejmen), mother,"
      },
      {
       "cyr": "низ Бузаана.",
       "lat": "niz Buzaana.",
       "en": "through Buzaana."
      },
      {
       "cyr": "Па да видам мамо",
       "lat": "Pa da vidam mamo",
       "en": "And to see, mother,"
      },
      {
