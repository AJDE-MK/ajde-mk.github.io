   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Мајко, татко, благословете,",
       "lat": "- Majko, tatko, blagoslovete,",
       "en": "- Mother, father, bless me,"
      },
      {
       "cyr": "војник заминувам",
       "lat": "vojnik zaminuvam",
       "en": "I am leaving as a soldier"
      },
      {
       "cyr": "да бранам земја македонска.",
       "lat": "da branam zemja makedonska.",
       "en": "to defend the Macedonian land."
      },
      {
       "cyr": "Светот знае, помни,",
       "lat": "Svetot znae, pomni,",
       "en": "The world knows, remembers,"
      },
      {
       "cyr": "силни фаланги,",
       "lat": "silni falangi,",
       "en": "mighty phalanxes,"
