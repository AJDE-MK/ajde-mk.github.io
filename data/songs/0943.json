   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Таму крај Вардар, неготинско поле,",
       "lat": "Tamu kraj Vardar, negotinsko pole,",
       "en": "There by the Vardar, the Negotino plain,"
      },
      {
       "cyr": "бој се започна, бој нерамен,",
       "lat": "boj se započna, boj neramen,",
       "en": "a battle began, an uneven battle,"
      },
      {
       "cyr": "германци бегаат, возови палат,",
       "lat": "germanci begaat, vozovi palat,",
       "en": "the Germans flee, trains burn,"
      },
      {
       "cyr": "пламен се дига дури до небо.",
       "lat": "plamen se diga duri do nebo.",
       "en": "flames rise all the way to the sky."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во манастирот Св. Ѓорѓија,",
       "lat": "Vo manastirot Sv. Ǵorǵija,",
       "en": "In the monastery of St. George,"
      },
      {
       "cyr": "ги затвориле партизаните",
       "lat": "gi zatvorile partizanite",
       "en": "the partisans were locked in,"
      },
      {
       "cyr": "и така нешто на германски јазик,",
       "lat": "i taka nešto na germanski jazik,",
       "en": "and something in the German language,"
      },
      {
       "cyr": "тие збореја да ги запалат.",
       "lat": "tie zboreja da gi zapalat.",
       "en": "they said, they would set them on fire."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тоа го слушна бабата Митра",
       "lat": "Toa go slušna babata Mitra",
       "en": "Grandma Mitra heard that"
      },
      {
       "cyr": "и скришум пошла кај партизаните,",
       "lat": "i skrišum pošla kaj partizanite,",
       "en": "and went secretly to the partisans,"
      },
      {
       "cyr": "порти отворила со двете крила:",
       "lat": "porti otvorila so dvete krila:",
       "en": "she opened the gates with both wings:"
      },
      {
       "cyr": "- Бегајте пилци в' гора зелена.",
       "lat": "- Begajte pilci v' gora zelena.",
       "en": "- Flee, chicks, to the green forest."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Клетите фашисти бензин фрлија",
       "lat": "Kletite fašisti benzin frlija",
       "en": "The damned fascists threw petrol"
      },
      {
       "cyr": "и зрно кибрит на старата,",
       "lat": "i zrno kibrit na starata,",
       "en": "and a grain of matchfire on the old woman,"
      },
      {
       "cyr": "пламен се дига, баба Митра гори,",
       "lat": "plamen se diga, baba Mitra gori,",
       "en": "the flame rises, Grandma Mitra burns,"
      },
      {
       "cyr": "на место дваесет партизани.",
       "lat": "na mesto dvaeset partizani.",
       "en": "and twenty partisans are saved on the spot."
      }
     ]
    }
   ]
