   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Ој зелено, Зеленико,",
       "lat": "- Oj zeleno, Zeleniko,",
       "en": "- Oh green one, Green Plant,"
      },
      {
       "cyr": "што си толку овенала?",
       "lat": "što si tolku ovenala?",
       "en": "why have you wilted so much?"
      },
      {
       "cyr": "Дали те слана осланила",
       "lat": "Dali te slana oslanila",
       "en": "Did the frost frost you"
      },
      {
       "cyr": "или те роса оросила?",
       "lat": "ili te rosa orosila?",
       "en": "or did the dew wet you?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ниту ме слана осланила,",
       "lat": "- Nitu me slana oslanila,",
       "en": "- Neither did the frost frost me,"
      },
      {
       "cyr": "ниту ме роса оросила,",
       "lat": "nitu me rosa orosila,",
       "en": "nor did the dew wet me,"
      },
      {
       "cyr": "туку ме мајка армасала",
       "lat": "tuku me majka armasala",
       "en": "but my mother betrothed me"
      },
      {
       "cyr": "за едно момче што не го љубам.",
       "lat": "za edno momče što ne go ljubam.",
       "en": "to a boy whom I do not love."
      }
     ]
    }
   ]
  }
