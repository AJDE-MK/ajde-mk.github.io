      {
       "cyr": "Среде Скопје Вардар врви,",
       "lat": "Srede Skopje Vardar vrvi,",
       "en": "Midst of Skopje, Vardar flows,"
      },
      {
       "cyr": "Вардар река распеана.",
       "lat": "Vardar reka raspeana.",
       "en": "Vardar, the singing river."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ој, Вардаре македонски",
       "lat": "Oj, Vardare makedonski",
       "en": "Oh, Macedonian Vardar,"
      },
      {
       "cyr": "од извора дур' до Солуна.",
       "lat": "od izvora dur' do Soluna.",
       "en": "From its source to Thessaloniki."
      },
      {
       "cyr": "Ој, Вардаре македонски,",
       "lat": "Oj, Vardare makedonski,",
       "en": "Oh, Macedonian Vardar,"
      },
      {
       "cyr": "ти ја красиш Македонија.",
       "lat": "ti ja krasiš Makedonija.",
       "en": "You adorn Macedonia."
      }
