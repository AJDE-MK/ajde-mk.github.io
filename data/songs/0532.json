   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ој љубов, љубов, љубов безнадежна,",
       "lat": "Oj ljubov, ljubov, ljubov beznadežna,",
       "en": "Oh, love, love, hopeless love."
      },
      {
       "cyr": "ој љубов, љубов, љубов безнадежна.",
       "lat": "oj ljubov, ljubov, ljubov beznadežna.",
       "en": "Oh, love, love, hopeless love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја стани, стани прва веренице,",
       "lat": "Ja stani, stani prva verenice,",
       "en": "Come on, get up, get up my fiancé,"
      },
      {
       "cyr": "да те прегрнам за последен пат.",
       "lat": "da te pregrnam za posleden pat.",
       "en": "let me hold you for the last time."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не можам либе, не можам да станам,",
       "lat": "Ne možam libe, ne možam da stanam,",
       "en": "I can't, dear, I can't get up,"
      },
      {
       "cyr": "црната земја голема тежина.",
       "lat": "crnata zemja golema težina.",
       "en": "the black earth weighs heavily."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Црните очи змија ги испила,",
       "lat": "Crnite oči zmija gi ispila,",
       "en": "A snake drunk my black eyes,"
      },
      {
       "cyr": "в' русата коса гнездо направила.",
       "lat": "v' rusata kosa gnezdo napravila.",
       "en": "and made a nest in my golden hair."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја стани, стани, прва веренице",
       "lat": "Ja stani, stani, prva verenice",
       "en": "Come on, get up, get up my fiancé,"
      },
      {
       "cyr": "да те прегрнам за последен п'т.",
       "lat": "da te pregrnam za posleden p't.",
       "en": "let me hold you for the last time."
      }
     ]
    }
   ]
  }
