   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Леонид со мајка вечера",
       "lat": "Leonid so majka večera",
       "en": "Leonid has supper with his mother,"
      },
      {
       "cyr": "пресна риба дојранска,",
       "lat": "presna riba dojranska,",
       "en": "fresh Dojran fish,"
      },
      {
       "cyr": "бела си струмичка погача,",
       "lat": "bela si strumička pogača,",
       "en": "white Strumica loaf,"
      },
      {
       "cyr": "Леонид не вечера.",
       "lat": "Leonid ne večera.",
       "en": "Leonid does not eat."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Како мале да вечерам,",
       "lat": "- Kako male da večeram,",
       "en": "- How can I eat supper, mother,"
      },
      {
       "cyr": "пелин ми е вечера",
       "lat": "pelin mi e večera",
       "en": "wormwood is my supper"
      },
      {
       "cyr": "кога нема валандовчанка",
       "lat": "koga nema valandovčanka",
       "en": "when there is no Valandovo woman"
      },
      {
       "cyr": "да ми зготви вечера.",
       "lat": "da mi zgotvi večera.",
       "en": "to cook my supper."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Леониде, сине на мајка,",
       "lat": "- Leonide, sine na majka,",
       "en": "- Leonid, son of your mother,"
      },
      {
       "cyr": "зошто сине не јадеш?",
       "lat": "zošto sine ne jadeš?",
       "en": "why, son, do you not eat?"
      },
      {
       "cyr": "Дали риба не е пресна, еј,",
       "lat": "Dali riba ne e presna, ej,",
       "en": "Is the fish not fresh, hey,"
      },
      {
       "cyr": "ил' погача не е слатка?",
       "lat": "il' pogača ne e slatka?",
       "en": "or is the loaf not sweet?"
      }
