   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Замеси Велој дадо, замеси,",
       "lat": "Zamesi Veloj dado, zamesi,",
       "en": "Knead, Velа sister, knead,"
      },
      {
       "cyr": "замеси мори девет погачи,",
       "lat": "zamesi mori devet pogači,",
       "en": "knead nine loaves,"
      },
      {
       "cyr": "усукај мори девет баници.",
       "lat": "usukaj mori devet banici.",
       "en": "twist nine pies."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе дојдат Велој дадо, ќе дојдат,",
       "lat": "Ḱe dojdat Veloj dado, ḱe dojdat,",
       "en": "They will come, Velа sister, they'll come,"
      },
      {
       "cyr": "ќе дојдат селските сејмени1.",
       "lat": "ḱe dojdat selskite sejmeni1.",
       "en": "the village policemen will come,"
      },
      {
       "cyr": "на сите коња мори да фанеш.",
       "lat": "na site konja mori da faneš.",
       "en": "you must take all their horses."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Асану Велој дадо, Асану,",
       "lat": "Asanu Veloj dado, Asanu,",
       "en": "But Asan's, Velа sister, Asan's,"
      },
      {
       "cyr": "Асану, мори коња не факај,",
       "lat": "Asanu, mori konja ne fakaj,",
       "en": "Asan's horse, don't take it."
      },
      {
       "cyr": "Асан ти брата мори убило.",
       "lat": "Asan ti brata mori ubilo.",
       "en": "Asan, he killed your brother."
      }
     ]
    }
   ]
  }
