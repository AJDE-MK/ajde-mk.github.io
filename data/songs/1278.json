   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- А бре чичо, остарен,",
       "lat": "- A bre čičo, ostaren,",
       "en": "- Hey uncle, you've grown old,"
      },
      {
       "cyr": "што си толку замислен?",
       "lat": "što si tolku zamislen?",
       "en": "why are you so lost in thought?"
      },
      {
       "cyr": "Баба дал' те остави,",
       "lat": "Baba dal' te ostavi,",
       "en": "Did your old woman leave you,"
      },
      {
       "cyr": "или те заборави?",
       "lat": "ili te zaboravi?",
       "en": "or forget you?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Чујте ме, бре ергени,",
       "lat": "- Čujte me, bre ergeni,",
       "en": "- Listen to me, bachelors,"
      },
      {
       "cyr": "да ви кажам маката:",
       "lat": "da vi kažam makata:",
       "en": "let me tell you my trouble:"
      },
      {
       "cyr": "момиче си заљубив,",
       "lat": "momiče si zaljubiv,",
       "en": "I fell in love with a young girl,"
      },
      {
       "cyr": "не ја сакам бабата!",
       "lat": "ne ja sakam babata!",
       "en": "I don't want the old woman!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Секој сака мома убава,",
