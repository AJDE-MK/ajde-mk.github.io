       "lat": "Goce Delčev mlad Makedonec,",
       "en": "Goce Delchev, young Macedonian,"
      },
      {
       "cyr": "тој бестрашен јунак за слобода,",
       "lat": "toj bestrašen junak za sloboda,",
       "en": "he a fearless hero for freedom,"
      },
      {
       "cyr": "црна земја рано го покрила,",
