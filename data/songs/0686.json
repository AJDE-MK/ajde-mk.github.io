 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ленче болно лежи",
       "lat": "Lenče bolno leži",
       "en": "Lenche lies sick"
      },
      {
       "cyr": "време три години",
       "lat": "vreme tri godini",
       "en": "for three years"
      },
      {
       "cyr": "и девет месеци.",
       "lat": "i devet meseci.",
       "en": "and nine months."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Над глава ѝ стои",
       "lat": "Nad glava ì stoi",
       "en": "Above her stands"
      },
      {
       "cyr": "нејна стара мајка",
       "lat": "nejna stara majka",
       "en": "her old mother"
      },
      {
       "cyr": "и на Ленче збори:",
       "lat": "i na Lenče zbori:",
       "en": "and speaks to Lenche:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стани Ленче, стани",
       "lat": "- Stani Lenče, stani",
       "en": "- Get up, Lenche, get up"
      },
      {
       "cyr": "стројници ти дошле",
       "lat": "strojnici ti došle",
       "en": "the matchmakers have come for you"
      },
      {
       "cyr": "стројници скопјани.",
       "lat": "strojnici skopjani.",
       "en": "the matchmakers from Skopje."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Како дошле мамо",
       "lat": "- Kako došle mamo",
       "en": "- As they have come, mother,"
      },
      {
       "cyr": "така да си одат.",
       "lat": "taka da si odat.",
       "en": "so let them leave."
      },
      {
       "cyr": "Јас си имам мајко",
       "lat": "Jas si imam majko",
       "en": "I already have, mother"
      },
      {
       "cyr": "либе струмичанче.",
       "lat": "libe strumičanče.",
       "en": "a love from Strumica."
      }
     ]
    }
   ]
  }
 ],
