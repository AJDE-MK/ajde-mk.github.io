 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кога тргнав Цвето за туѓина,",
       "lat": "Koga trgnav Cveto za tuǵina,",
       "en": "When I left, Cveta, for foreign lands,"
      },
      {
       "cyr": "дробни солзи ти ронеше,",
       "lat": "drobni solzi ti roneše,",
       "en": "You shed bitter tears,"
      },
      {
       "cyr": "дробни солзи Цвето ти ронеше",
       "lat": "drobni solzi Cveto ti roneše",
       "en": "Bitter tears, Cveta, you shed,"
      },
      {
       "cyr": "и во Бога се колнеше.",
       "lat": "i vo Boga se kolneše.",
       "en": "And swore to God."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дека верна Цвето ќе ми бидеш,",
       "lat": "Deka verna Cveto ḱe mi bideš,",
       "en": "That you would be faithful, Cveta,"
      },
      {
       "cyr": "куќа, деца ќе ми гледаш,",
       "lat": "kuḱa, deca ḱe mi gledaš,",
       "en": "Take care of the house and children,"
      },
      {
       "cyr": "но јас Цвето мори верба немав,",
       "lat": "no jas Cveto mori verba nemav,",
       "en": "But I, Cveta, had no faith,"
      },
      {
       "cyr": "бргу назад јас се вратив.",
       "lat": "brgu nazad jas se vrativ.",
       "en": "So I quickly returned."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Наш'то порте Цвето затворено,",
       "lat": "Naš'to porte Cveto zatvoreno,",
       "en": "Our gate, Cveta, was closed,"
      },
      {
       "cyr": "а децата позаспани.",
       "lat": "a decata pozaspani.",
       "en": "The children fast asleep,"
      },
      {
       "cyr": "Ламбичето подзапрено,",
       "lat": "Lambičeto podzapreno,",
       "en": "The little lamp was dimmed,"
      },
      {
       "cyr": "а ти Цвето во комшии.",
       "lat": "a ti Cveto vo komšii.",
       "en": "And you, Cveta, at the neighbour’s house."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А ти Цвето во комшии,",
       "lat": "A ti Cveto vo komšii,",
       "en": "And you, Cveta, at the neighbour’s,"
      },
      {
       "cyr": "црно кафе си пиеше,",
       "lat": "crno kafe si pieše,",
       "en": "Drinking black coffee,"
      },
      {
       "cyr": "црно кафе Цвето си пиеше,",
       "lat": "crno kafe Cveto si pieše,",
       "en": "Drinking black coffee, Cveta,"
      },
      {
       "cyr": "благ муабет си правеше.",
       "lat": "blag muabet si praveše.",
       "en": "Having a pleasant chat."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Како знаеш Цвето, така прави",
       "lat": "Kako znaeš Cveto, taka pravi",
       "en": "As you wish, Cveta, so you act,"
      },
      {
       "cyr": "ти на мене да не мислиш.",
       "lat": "ti na mene da ne misliš.",
       "en": "Not thinking of me."
      }
     ]
    }
   ]
  }
 ],
