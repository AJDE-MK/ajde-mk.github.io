   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Жени се сине, ожени се,",
       "lat": "- Ženi se sine, oženi se,",
       "en": "- Marry, son, get married,"
      },
      {
       "cyr": "додека оште сине јас можам",
       "lat": "dodeka ošte sine jas možam",
       "en": "while I, son, can still"
      },
      {
       "cyr": "да ти изгледам, сине, дечиња,",
       "lat": "da ti izgledam, sine, dečinja,",
       "en": "look after your children, son,"
      },
      {
       "cyr": "да се израдувам на внучиња.",
       "lat": "da se izraduvam na vnučinja.",
       "en": "and rejoice over grandchildren."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не ми збори, мајко, не ме кори,",
