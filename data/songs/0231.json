 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Лилјано моме убаво,",
       "lat": "Liljano mome ubavo,",
       "en": "Beautiful maiden Liljana,"
      },
      {
       "cyr": "Лилјано пиле калешо,",
       "lat": "Liljano pile kalešo,",
       "en": "Liljana, my fine young bird,"
      },
      {
       "cyr": "уште ли мома ќе одиш,",
       "lat": "ušte li moma ḱe odiš,",
       "en": "will you still go about as a maiden,"
      },
      {
       "cyr": "уште ли светот ќе гориш?",
       "lat": "ušte li svetot ḱe goriš?",
       "en": "will you still set the world on fire?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На стари баби внучиња,",
       "lat": "Na stari babi vnučinja,",
       "en": "Grandchildren for old grandmothers,"
      },
      {
       "cyr": "на млади невести момчиња,",
       "lat": "na mladi nevesti momčinja,",
       "en": "sons for young brides,"
      },
      {
       "cyr": "жена и деца оставам,",
       "lat": "žena i deca ostavam,",
       "en": "I leave wife and children"
      },
      {
       "cyr": "тебе Лилјано да земам.",
       "lat": "tebe Liljano da zemam.",
       "en": "to take you, Liljana."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Немој, Лилјано, не чини,",
       "lat": "Nemoj, Liljano, ne čini,",
       "en": "Don't, Liljana, don't do it,"
      },
      {
       "cyr": "не оставај рана на срце,",
       "lat": "ne ostavaj rana na srce,",
       "en": "don't leave a wound on my heart,"
      },
      {
       "cyr": "цел век јас ќе ти слугувам,",
       "lat": "cel vek jas ḱe ti sluguvam,",
       "en": "all my life I will serve you,"
      },
      {
       "cyr": "тебе Лилјано да земам.",
       "lat": "tebe Liljano da zemam.",
       "en": "to take you, Liljana."
      }
     ]
    }
   ]
  }
 ],
