    {
     "lines": [
      {
       "cyr": "Песна ви пеам Македонци",
       "lat": "Pesna vi peam Makedonci",
       "en": "I sing you a song, Macedonians,"
      },
      {
       "cyr": "со зборој нашински.",
       "lat": "so zboroj našinski.",
       "en": "in our own words."
      },
      {
       "cyr": "Песна за егејско чедо",
       "lat": "Pesna za egejsko čedo",
       "en": "A song for the Aegean child"
      },
      {
       "cyr": "на Македонија.",
       "lat": "na Makedonija.",
       "en": "of Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Македонка мајка ме роди",
       "lat": "Makedonka majka me rodi",
       "en": "A Macedonian mother bore me,"
      },
      {
       "cyr": "клетва ми остави:",
       "lat": "kletva mi ostavi:",
       "en": "left me a curse:"
      },
      {
       "cyr": "- Расти и бори се чедо",
       "lat": "- Rasti i bori se čedo",
       "en": "- Grow and fight, child,"
      },
      {
       "cyr": "за Македонија!",
       "lat": "za Makedonija!",
       "en": "for Macedonia!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Родена сум во Кукуш,",
       "lat": "Rodena sum vo Kukuš,",
       "en": "I was born in Kukush,"
      },
      {
       "cyr": "тирански мачена,",
       "lat": "tiranski mačena,",
       "en": "tortured by tyrants,"
      },
      {
       "cyr": "нога и рака исековте,",
       "lat": "noga i raka isekovte,",
       "en": "you cut off my leg and arm,"
      },
      {
       "cyr": "очи извадовте.",
       "lat": "oči izvadovte.",
       "en": "you took out my eyes."
      }
     ]
    },
