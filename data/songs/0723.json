   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Ќе одам, ќе одам, стара мајко, ќе одам,",
       "lat": "- Ḱe odam, ḱe odam, stara majko, ḱe odam,",
       "en": "- I will go, I will go, old mother, I will go,",
       "en_mt": false
      },
      {
       "cyr": "во таја пуста мајко планина,",
       "lat": "vo taja pusta majko planina,",
       "en": "to that damned, mother, mountain,",
       "en_mt": false
      },
      {
       "cyr": "во таја пуста мајко корија.",
       "lat": "vo taja pusta majko korija.",
       "en": "into that damned, mother, forest.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не оди, сине море, не оди,",
       "lat": "- Ne odi, sine more, ne odi,",
       "en": "- Do not go, my son, do not go,",
       "en_mt": false
      },
      {
       "cyr": "лошо те сине мајка сонила,",
       "lat": "lošo te sine majka sonila,",
       "en": "mother had a bad dream about you,",
       "en_mt": false
      },
      {
       "cyr": "лошо те сине мајка сонила.",
       "lat": "lošo te sine majka sonila.",
       "en": "mother had a bad dream about you.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кавалот шарен сине, свиреше,",
       "lat": "Kavalot šaren sine, svireše,",
       "en": "The colorful flute, my son, was playing,",
       "en_mt": false
      },
      {
       "cyr": "и тебе матна вода носеше,",
       "lat": "i tebe matna voda noseše,",
       "en": "and muddy water was carrying you,",
       "en_mt": false
      },
      {
       "cyr": "мајка те жално сине плачеше.",
       "lat": "majka te žalno sine plačeše.",
       "en": "mother was crying, my son, in grief for you.",
       "en_mt": false
      }
     ]
    }
   ]
