   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кога си болна, Дано, легнала,",
       "lat": "Koga si bolna, Dano, legnala,",
       "en": "When you laid down, Dana,"
      },
      {
       "cyr": "што не си абер, Дано, сторила?",
       "lat": "što ne si aber, Dano, storila?",
       "en": "why didn't you tell me, Dano?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Понуда да ти, Дано, донесам,",
       "lat": "Ponuda da ti, Dano, donesam,",
       "en": "I offer to bring to you"
      },
      {
       "cyr": "тетовско, Дано моме, јаболко.",
       "lat": "tetovsko, Dano mome, jabolko.",
       "en": "an apple from Tetovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На врв на гранка, Дано, раснато,",
       "lat": "Na vrv na granka, Dano, rasnato,",
       "en": "That was grown at the top of a branch,"
      },
      {
       "cyr": "по месечина, Дано, крадено,",
       "lat": "po mesečina, Dano, kradeno,",
       "en": "that was stolen by moonlight,"
      },
      {
       "cyr": "в' пазуви мои, Дано, носено.",
       "lat": "v' pazuvi moi, Dano, noseno.",
       "en": "carried into my bosom, Dana."
      }
     ]
    }
   ]
  }
 ],
