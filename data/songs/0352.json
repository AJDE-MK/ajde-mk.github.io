   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Не лажете се другарки",
       "lat": "Ne lažete se drugarki",
       "en": "Do not deceive yourselves, girlfriends,"
      },
      {
       "cyr": "љубов да водите,",
       "lat": "ljubov da vodite,",
       "en": "thinking you can carry on a love affair,"
      },
      {
       "cyr": "љубовта е отровна",
       "lat": "ljubovta e otrovna",
       "en": "love is poisonous,"
      },
      {
       "cyr": "отровен беше и тој.",
       "lat": "otroven beše i toj.",
       "en": "and he was poisonous too."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На улицата го сретнав,",
       "lat": "Na ulicata go sretnav,",
       "en": "I met him in the street,"
      },
      {
       "cyr": "со друга стоеше",
       "lat": "so druga stoeše",
       "en": "he was standing with another girl,"
      },
      {
       "cyr": "со грбот ми се обрна",
       "lat": "so grbot mi se obrna",
       "en": "he turned his back to me"
      },
      {
       "cyr": "и тивко ми рече.",
       "lat": "i tivko mi reče.",
       "en": "and said quietly:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас си заљубив друго,",
       "lat": "Jas si zaljubiv drugo,",
       "en": "I have fallen in love with another,"
      },
      {
       "cyr": "заљуби си и ти.",
       "lat": "zaljubi si i ti.",
       "en": "fall in love with someone else too."
      },
      {
       "cyr": "Писмата твои ги изгорев,",
       "lat": "Pismata tvoi gi izgorev,",
       "en": "I burned your letters,"
      },
      {
       "cyr": "изгори ги и ти.",
       "lat": "izgori gi i ti.",
       "en": "burn mine too."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од тука право си дома",
       "lat": "Od tuka pravo si doma",
       "en": "From there I went straight home"
      },
      {
       "cyr": "на мама ѝ кажав.",
       "lat": "na mama ì kažav.",
       "en": "and told my mother."
      },
      {
       "cyr": "Запалив силен оган",
       "lat": "Zapaliv silen ogan",
       "en": "I lit a strong fire"
      },
      {
       "cyr": "писмата ги изгорив.",
       "lat": "pismata gi izgoriv.",
       "en": "and burned the letters."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од дома право си тргнав",
       "lat": "Od doma pravo si trgnav",
       "en": "From home I set off straight"
      },
      {
       "cyr": "во Рилскиот манастир.",
       "lat": "vo Rilskiot manastir.",
       "en": "to the Rila Monastery."
      },
      {
       "cyr": "Облеков црната руба",
       "lat": "Oblekov crnata ruba",
       "en": "I put on the black robe,"
      },
      {
       "cyr": "до црната земја.",
       "lat": "do crnata zemja.",
       "en": "down to the black earth."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Излегов да се прошетам",
       "lat": "Izlegov da se prošetam",
       "en": "I went out for a walk"
      },
      {
       "cyr": "и него го видов,",
       "lat": "i nego go vidov,",
       "en": "and saw him,"
      },
      {
       "cyr": "со грбот му се обрнав",
       "lat": "so grbot mu se obrnav",
       "en": "I turned my back to him"
      },
      {
       "cyr": "и тивко му реков.",
       "lat": "i tivko mu rekov.",
       "en": "and said quietly:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Познаваш ли ме познаваш",
       "lat": "Poznavaš li me poznavaš",
       "en": "Do you recognise me, do you know"
      },
      {
       "cyr": "која калуѓерка сум?",
       "lat": "koja kaluǵerka sum?",
       "en": "which nun I am?"
      },
      {
       "cyr": "Јас сум калуѓерката",
       "lat": "Jas sum kaluǵerkata",
       "en": "I am the nun"
      },
      {
       "cyr": "што верно те љубеше.",
       "lat": "što verno te ljubeše.",
       "en": "who loved you faithfully."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тогај се земја затресе",
       "lat": "Togaj se zemja zatrese",
       "en": "Then the earth shook"
      },
      {
       "cyr": "и небо загрми,",
       "lat": "i nebo zagrmi,",
       "en": "and the sky thundered,"
      },
      {
       "cyr": "двајца се прегрнавме",
       "lat": "dvajca se pregrnavme",
       "en": "the two of us embraced"
      },
      {
       "cyr": "и мртви паднавме.",
       "lat": "i mrtvi padnavme.",
       "en": "and fell down dead."
      }
     ]
    }
   ]
  }
