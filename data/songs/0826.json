   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Невесто црвен трендафил, џанам,",
       "lat": "- Nevesto crven trendafil, džanam,",
       "en": "My wife, red rose, dearest,"
      },
      {
       "cyr": "сега си дојдов од гурбет.",
       "lat": "sega si dojdov od gurbet.",
       "en": "I have just returned from working abroad."
      },
      {
       "cyr": "Што ти е соба послана, џанам,",
       "lat": "Što ti e soba poslana, džanam,",
       "en": "Why is the table laid,"
      },
      {
       "cyr": "што ти е шише ракија?",
       "lat": "što ti e šiše rakija?",
       "en": "why is there a bottle of rakija (brandy)?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стојане море, стопане, џанам,",
       "lat": "- Stojane more, stopane, džanam,",
       "en": "Dear Stojan, head of the family, dearest,"
      },
      {
       "cyr": "в село се Турци на гости.",
       "lat": "v selo se Turci na gosti.",
       "en": "the Turks are visiting the village."
      },
      {
       "cyr": "Затој ми соба послана, џанам,",
       "lat": "Zatoj mi soba poslana, džanam,",
       "en": "That’s why the table is laid,"
      },
      {
       "cyr": "затуј ми шише ракија.",
       "lat": "zatuj mi šiše rakija.",
       "en": "that's why there is a bottle of rakija."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Невесто црвен трендафил, џанам,",
       "lat": "- Nevesto crven trendafil, džanam,",
       "en": "My wife, red rose, dearest,"
      },
      {
       "cyr": "и тоа да ти верувам?",
       "lat": "i toa da ti veruvam?",
       "en": "and I am supposed to believe this?"
      },
      {
       "cyr": "Што ти е коса бушава, џанам,",
       "lat": "Što ti e kosa bušava, džanam,",
       "en": "Why is your hair tousled,"
      },
      {
       "cyr": "што ти е елек раскопчан?",
       "lat": "što ti e elek raskopčan?",
       "en": "why is your vest unbuttoned?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стојане море, стопане, џанам,",
       "lat": "- Stojane more, stopane, džanam,",
       "en": "Dear Stojan, head of the family, dearest,"
      },
      {
       "cyr": "децата ми се малечки.",
       "lat": "decata mi se malečki.",
       "en": "my children are small."
      },
      {
       "cyr": "Затој ми коса бушава, џанам,",
       "lat": "Zatoj mi kosa bušava, džanam,",
       "en": "That’s why my hair is tousled,"
      },
      {
       "cyr": "затој ми елек раскопчан!",
       "lat": "zatoj mi elek raskopčan!",
       "en": "that's why my vest is unbuttoned."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Невесто црвен трендафил, џанам,",
       "lat": "- Nevesto crven trendafil, džanam,",
       "en": "My wife, red rose, dearest,"
      },
      {
       "cyr": "што ти е она зад врата?",
       "lat": "što ti e ona zad vrata?",
       "en": "what (who) is that behind the door?"
      },
      {
       "cyr": "Со сиво сако наметнат, џанам,",
       "lat": "So sivo sako nametnat, džanam,",
       "en": "With a gray jacket put on,"
      },
      {
       "cyr": "со тенка пушка на рамо?",
       "lat": "so tenka puška na ramo?",
       "en": "with a slender rifle slung over his shoulder."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стојане море, стопане, џанам,",
       "lat": "- Stojane more, stopane, džanam,",
       "en": "Dear Stojan, head of the family, dearest,"
      },
      {
       "cyr": "лагите ми се свршија.",
       "lat": "lagite mi se svršija.",
       "en": "my lies are at an end."
      },
      {
       "cyr": "Прво ме мене убоди, џанам,",
       "lat": "Prvo me mene ubodi, džanam,",
       "en": "First you stab me, dearest,"
      },
      {
       "cyr": "после го него улови.",
       "lat": "posle go nego ulovi.",
       "en": "and then hunt him down."
      }
     ]
    }
