       "cyr": "на таа куќа чуена,",
       "lat": "na taa kuḱa čuena,",
       "en": "into that famous house,"
      },
      {
       "cyr": "малечко момче убаво,",
       "lat": "malečko momče ubavo,",
       "en": "a little handsome lad,"
      },
      {
       "cyr": "малечко момче убаво,",
