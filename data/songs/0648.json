   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Покрај Егеј, Македонци,",
       "lat": "Pokraj Egej, Makedonci,",
       "en": "By the Aegean, Macedonians,"
      },
      {
       "cyr": "покрај Вардар, Македонци",
       "lat": "pokraj Vardar, Makedonci",
       "en": "by the Vardar, Macedonians"
      },
      {
       "cyr": "и под Пирин, Македонци",
       "lat": "i pod Pirin, Makedonci",
       "en": "and below Pirin, Macedonians"
      },
      {
       "cyr": "славно име, непокорно.",
       "lat": "slavno ime, nepokorno.",
       "en": "a glorious name, defiant."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Едно име имаме",
       "lat": "Edno ime imame",
       "en": "We have one name"
      },
      {
       "cyr": "во душата го носиме,",
       "lat": "vo dušata go nosime,",
       "en": "in our soul we keep it"
      },
      {
       "cyr": "за тебе живот даваме",
       "lat": "za tebe život davame",
       "en": "we give our lives for you,"
      },
      {
       "cyr": "о, Македонијо!",
       "lat": "o, Makedonijo!",
       "en": "Macedonia!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Како килим полиња,",
       "lat": "Kako kilim polinja,",
       "en": "As a carpet, fields,"
      },
      {
       "cyr": "а до небо планини,",
       "lat": "a do nebo planini,",
       "en": "and mountains stretching to the sky,"
      },
      {
       "cyr": "реките златоносни,",
       "lat": "rekite zlatonosni,",
       "en": "golden rivers,"
      },
      {
       "cyr": "а езера, бисери.",
       "lat": "a ezera, biseri.",
       "en": "and lakes, pearls."
      }
     ]
    },
    {
