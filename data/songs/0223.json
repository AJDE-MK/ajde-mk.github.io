   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Доста време ерген одев,",
       "lat": "Dosta vreme ergen odev,",
       "en": "I’ve been single for a long time,",
       "en_mt": false
      },
      {
       "cyr": "доста лични моми водев.",
       "lat": "dosta lični momi vodev.",
       "en": "I’ve dated many beautiful girls.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дојде време да се женам,",
       "lat": "Dojde vreme da se ženam,",
       "en": "It’s about the time for me to get married,",
       "en_mt": false
      },
      {
       "cyr": "овој живот да го сменам.",
       "lat": "ovoj život da go smenam.",
       "en": "to change this kind of life.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, нек' се пее, нек' се пие,",
       "lat": "Aj, nek' se pee, nek' se pie,",
       "en": "Let’s sing, let’s drink,",
       "en_mt": false
      },
      {
       "cyr": "тешко оро нек' се вие.",
       "lat": "teško oro nek' se vie.",
       "en": "may the oro begin to curl.",
       "en_mt": false
      },
      {
       "cyr": "Нек' се пеје нек' се пие,",
       "lat": "Nek' se peje nek' se pie,",
       "en": "Let’s sing, let’s drink,",
       "en_mt": false
      },
      {
       "cyr": "машко оро нек' се вие.",
       "lat": "maško oro nek' se vie.",
       "en": "may the oro of men begin to curl.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стара мајко сватој кани,",
       "lat": "Stara majko svatoj kani,",
       "en": "My old mother, invite the wedding guests,",
       "en_mt": false
      },
      {
       "cyr": "викни зурли и тапани.",
       "lat": "vikni zurli i tapani.",
       "en": "bring zurla players and drummers.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нека бидат сè одбрани,",
       "lat": "Neka bidat sè odbrani,",
       "en": "May they be merry and cheerful,",
       "en_mt": false
      },
      {
       "cyr": "стара мајко оро фани.",
       "lat": "stara majko oro fani.",
       "en": "join the oro, old mother.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, нек' се пее, нек' се пие,",
       "lat": "Aj, nek' se pee, nek' se pie,",
       "en": "Let’s sing, let’s drink,",
       "en_mt": false
      },
      {
       "cyr": "тешко оро нек' се вие.",
       "lat": "teško oro nek' se vie.",
       "en": "may the oro begin to curl.",
       "en_mt": false
      },
      {
       "cyr": "Нек' се пеје нек' се пие,",
       "lat": "Nek' se peje nek' se pie,",
       "en": "Let’s sing, let’s drink,",
       "en_mt": false
      },
      {
       "cyr": "машко оро нек' се вие.",
       "lat": "maško oro nek' se vie.",
       "en": "may the oro of men begin to curl.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Спремај мајко бочви вино,",
       "lat": "Spremaj majko bočvi vino,",
       "en": "Bring barrels of wine, mother,",
       "en_mt": false
      },
      {
       "cyr": "и ракија бардаклија.",
       "lat": "i rakija bardaklija.",
       "en": "and jugs of rakija.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сè ти мајко за три сина,",
       "lat": "Sè ti majko za tri sina,",
       "en": "You raised three sons, mother,",
       "en_mt": false
      },
      {
       "cyr": "ти ми мајко тешко мина.",
       "lat": "ti mi majko teško mina.",
       "en": "it was a tough life for you.",
       "en_mt": false
      }
     ]
