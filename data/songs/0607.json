    {
     "lines": [
      {
       "cyr": "Битола, мој роден крај",
       "lat": "Bitola, moj roden kraj",
       "en": "Bitola, the city I was born in,"
      },
      {
       "cyr": "во тебе сум роден",
       "lat": "vo tebe sum roden",
       "en": "I was born in you,"
      },
      {
       "cyr": "за мене си рај.",
       "lat": "za mene si raj.",
       "en": "for me, you are Paradise."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Битола, мој роден крај,",
       "lat": "Bitola, moj roden kraj,",
       "en": "Bitola, the city I was born in"
      },
      {
       "cyr": "јас те сакам од срце знај.",
       "lat": "jas te sakam od srce znaj.",
       "en": "I love you from my heart."
      },
      {
       "cyr": "Битола мој роден крај,",
       "lat": "Bitola moj roden kraj,",
       "en": "Bitola, the city I was born in"
      },
      {
       "cyr": "јас те сакам, за тебе пеам.",
       "lat": "jas te sakam, za tebe peam.",
       "en": "I love you, I sing for you."
      }
     ]
    },
    {
