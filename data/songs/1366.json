 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Лудо оде со дружина,",
       "lat": "Ludo ode so družina,",
       "en": "The lad went with his friends,"
      },
      {
       "cyr": "на дружина говореше:",
       "lat": "na družina govoreše:",
       "en": "to his friends he spoke:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дење гледам малка мома,",
       "lat": "- Denje gledam malka moma,",
       "en": "- In the daytime I see a young maiden,"
      },
      {
       "cyr": "дење гледам, в’ ноќе сонвам.",
       "lat": "denje gledam, v’ noḱe sonvam.",
       "en": "in the daytime I see, at night I dream."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ноќе м’ иде близо, близо,",
       "lat": "Noḱe m’ ide blizo, blizo,",
       "en": "At night she comes near, near,"
      },
      {
       "cyr": "близо, близо дур до мене.",
       "lat": "blizo, blizo dur do mene.",
       "en": "near, near, almost next to me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми легнува на раката,",
       "lat": "Mi legnuva na rakata,",
       "en": "She lies on my arm,"
      },
      {
       "cyr": "на раката, на ракавот.",
       "lat": "na rakata, na rakavot.",
       "en": "on my arm, on my hand."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А от сонот кад да станам,",
       "lat": "A ot sonot kad da stanam,",
       "en": "But when I wake from my dream,"
      },
      {
       "cyr": "барам мома, мома немат!",
       "lat": "baram moma, moma nemat!",
       "en": "I look for the maiden, the maiden isn’t there!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј дружина мили брате,",
       "lat": "Ej družina mili brate,",
       "en": "Hey my friends, my dear brothers"
      },
      {
       "cyr": "сакам нешто да те питам,",
       "lat": "sakam nešto da te pitam,",
       "en": "I want to ask you something,"
      },
      {
       "cyr": "право сакам да ми кажиш.",
       "lat": "pravo sakam da mi kažiš.",
       "en": "I want you to tell me the truth."
      }
     ]
    }
   ]
  }
 ],
