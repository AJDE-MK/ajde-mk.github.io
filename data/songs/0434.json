       "cyr": "Јано, Јанке Кумановке",
       "lat": "Jano, Janke Kumanovke",
       "en": "Jana, little Jana from Kumanovo,"
      },
      {
       "cyr": "запали ме изгоре ме.",
       "lat": "zapali me izgore me.",
       "en": "ignite me, burn me."
      },
      {
       "cyr": "Јано, Јанке мори, Кумановке, леле,",
       "lat": "Jano, Janke mori, Kumanovke, lele,",
       "en": "Jana, little Jana from Kumanovo,"
      },
      {
       "cyr": "Јано, Јанке мори, ти душманке.",
       "lat": "Jano, Janke mori, ti dušmanke.",
       "en": "Jana, little Jana, you enemy."
      }
     ]
    },
    {
