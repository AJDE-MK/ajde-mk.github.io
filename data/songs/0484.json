 "versions": [
  {
   "label": "",
   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "(Налеј, Налеј)",
       "lat": "(Nalej, Nalej)",
       "en": "(Pour, pour)",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И ние сме деца на мајката земја",
       "lat": "I nie sme deca na majkata zemja",
       "en": "We are children of the motherland,",
       "en_mt": false
      },
      {
       "cyr": "на мајката земја, на Македонија.",
       "lat": "na majkata zemja, na Makedonija.",
       "en": "the motherland, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "На нашата земја, на Македонија.",
       "lat": "Na našata zemja, na Makedonija.",
       "en": "of our land, Macedonia.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И ние имаме право да живејме,",
       "lat": "I nie imame pravo da živejme,",
       "en": "We also have the right to live,",
       "en_mt": false
      },
      {
       "cyr": "како и другите живот што живеат.",
       "lat": "kako i drugite život što živeat.",
       "en": "like others that have this right.",
       "en_mt": false
      },
      {
       "cyr": "А ние страдавме, гладни умиравме.",
       "lat": "A nie stradavme, gladni umiravme.",
       "en": "Yet we suffered, we died of hunger.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Слобода немавме, правдини никакви,",
       "lat": "Sloboda nemavme, pravdini nikakvi,",
       "en": "We didn't have freedom, no justice,",
       "en_mt": false
      },
      {
       "cyr": "кога ги баравме, в затвор се најдовме.",
       "lat": "koga gi baravme, v zatvor se najdovme.",
       "en": "when we asked for them, we were inprisoned,",
       "en_mt": false
      },
      {
       "cyr": "Во фурни не ставаат за да не изгорат.",
       "lat": "Vo furni ne stavaat za da ne izgorat.",
       "en": "we were burned to death.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Коските ни кршат и крвта ни пијат",
       "lat": "Koskite ni kršat i krvta ni pijat",
       "en": "They broke our bones, they drunk our blood,",
       "en_mt": false
      },
      {
       "cyr": "а ние смели сме, горди умиравме.",
       "lat": "a nie smeli sme, gordi umiravme.",
       "en": "but we are brave, we died proudly.",
       "en_mt": false
      },
      {
       "cyr": "Горди умиравме, не се предававме.",
       "lat": "Gordi umiravme, ne se predavavme.",
       "en": "We died proudly, we did not surrender.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Живот не жалевме, младост си дававме",
       "lat": "Život ne žalevme, mladost si davavme",
       "en": "We didn't regret our lives, we gave our youth,",
       "en_mt": false
      },
      {
       "cyr": "за наши правдини, смели умиравме.",
       "lat": "za naši pravdini, smeli umiravme.",
       "en": "for our justice, we died bravely.",
       "en_mt": false
      },
      {
       "cyr": "Парола имавме: Смрт или Слобода!",
       "lat": "Parola imavme: Smrt ili Sloboda!",
       "en": "We had a slogan: Death or Freedom!",
       "en_mt": false
      },
      {
       "cyr": "Смрт или Слобода за Македонија,",
       "lat": "Smrt ili Sloboda za Makedonija,",
       "en": "Death or Freedom for Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "за Македонија, земја поробена.",
       "lat": "za Makedonija, zemja porobena.",
       "en": "for Macedonia, a country enslaved.",
       "en_mt": false
      }
     ]
    }
   ]
  }
