   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ситна ми роса зароси",
       "lat": "Sitna mi rosa zarosi",
       "en": "Fine dew has settled"
      },
      {
       "cyr": "горе Селечка Планина",
       "lat": "gore Selečka Planina",
       "en": "up on Selechka Mountain,"
      },
      {
       "cyr": "падна ми јунак прободен",
       "lat": "padna mi junak proboden",
       "en": "a hero has fallen, pierced"
      },
      {
       "cyr": "со лута рана на срце.",
       "lat": "so luta rana na srce.",
       "en": "with a fierce wound to the heart."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Роса му рана миеше",
       "lat": "Rosa mu rana mieše",
       "en": "The dew washes his wound,"
      },
      {
       "cyr": "лице му тага криеше.",
       "lat": "lice mu taga krieše.",
       "en": "sorrow hides his face."
      },
      {
       "cyr": "Над него стои овчарче,",
       "lat": "Nad nego stoi ovčarče,",
       "en": "A shepherd boy stands over him,"
      },
      {
       "cyr": "овчарче, младо чобанче.",
       "lat": "ovčarče, mlado čobanče.",
       "en": "a young little shepherd."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јунак му вели, говори:",
       "lat": "Junak mu veli, govori:",
       "en": "The hero says to him, speaks:"
      },
      {
       "cyr": "- Овчарче, младо чобанче,",
       "lat": "- Ovčarče, mlado čobanče,",
       "en": "- Shepherd boy, young little shepherd,"
      },
      {
       "cyr": "ај слези долу во село",
       "lat": "aj slezi dolu vo selo",
       "en": "come down to the village"
      },
      {
       "cyr": "абер на мајка да носиш.",
       "lat": "aber na majka da nosiš.",
       "en": "and carry word to my mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Роднини да ми покани",
       "lat": "Rodnini da mi pokani",
       "en": "Let her invite my relatives"
      },
      {
       "cyr": "дарови за свадба да спремат,",
       "lat": "darovi za svadba da spremat,",
       "en": "to prepare gifts for the wedding,"
      },
      {
       "cyr": "оти се младо оженив",
       "lat": "oti se mlado oženiv",
       "en": "for I have married young"
      },
      {
       "cyr": "за земја Македонија.",
       "lat": "za zemja Makedonija.",
       "en": "to the land of Macedonia."
      }
     ]
    }
   ]
  }
 ],
