   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сестра моли брата за вечера",
       "lat": "Sestra moli brata za večera",
       "en": "The sister begs her brother to have supper,"
      },
      {
       "cyr": "ајде, ајде брате да вечераме.",
       "lat": "ajde, ajde brate da večerame.",
       "en": "come, come, brother, let us have supper."
      },
      {
       "cyr": "Вечерајте сестро не чекајте ме",
       "lat": "Večerajte sestro ne čekajte me",
       "en": "Eat, sister, do not wait for me,"
      },
      {
       "cyr": "јас сум било сестро у меана.",
       "lat": "jas sum bilo sestro u meana.",
       "en": "I have been, sister, in the tavern."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јало, пило сестро, сум се опило",
       "lat": "Jalo, pilo sestro, sum se opilo",
       "en": "I ate, I drank, sister, I got drunk,"
      },
      {
       "cyr": "голем зулум сестро сум направило.",
       "lat": "golem zulum sestro sum napravilo.",
       "en": "I did a great wrong, sister."
      },
      {
       "cyr": "Сум заклало еден син на мајка",
       "lat": "Sum zaklalo eden sin na majka",
       "en": "I slaughtered a mother's son,"
      },
      {
       "cyr": "сега они барат крвнината.",
       "lat": "sega oni barat krvninata.",
       "en": "now they demand the blood money."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде, ајде брате да вечераме,",
       "lat": "Ajde, ajde brate da večerame,",
       "en": "Come, come, brother, let us have supper,"
      },
      {
       "cyr": "за крвнина брате колај бива.",
       "lat": "za krvnina brate kolaj biva.",
       "en": "for blood money, brother, it is easy."
      },
      {
       "cyr": "Сестра има брате девет сина,",
       "lat": "Sestra ima brate devet sina,",
       "en": "Sister has, brother, nine sons,"
      },
      {
       "cyr": "едно сине мајка ќе прежали.",
       "lat": "edno sine majka ḱe prežali.",
       "en": "a mother will give up one son."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Цел' ноќ седи мајка, солзи рони",
       "lat": "Cel' noḱ sedi majka, solzi roni",
       "en": "All night the mother sits, shedding tears,"
      },
      {
       "cyr": "кое сине мајка да прежали.",
       "lat": "koe sine majka da prežali.",
       "en": "which son should the mother give up."
      },
      {
       "cyr": "Прежалила мајка најмалото,",
       "lat": "Prežalila majka najmaloto,",
       "en": "The mother gave up the youngest,"
      },
      {
       "cyr": "најмалото, мајка, најубавото.",
       "lat": "najmaloto, majka, najubavoto.",
       "en": "the youngest, mother, the most handsome."
      }
     ]
    }
   ]
  }
