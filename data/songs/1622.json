   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Еј Душанке, ти битушанке,",
       "lat": "Ej Dušanke, ti bitušanke,",
       "en": "Hey Dushanka from Bitushe,"
      },
      {
       "cyr": "дал' ти дојде ергенчето?",
       "lat": "dal' ti dojde ergenčeto?",
       "en": "has your bachelor come yet?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дојде, дојде, да не доет,",
       "lat": "- Dojde, dojde, da ne doet,",
       "en": "- He came, he came, may he didn't come,"
      },
      {
       "cyr": "коња гловет пак да одет.",
       "lat": "konja glovet pak da odet.",
       "en": "he is preparing the horse to go away again."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја му веља - земај мене,",
       "lat": "Ja mu velja - zemaj mene,",
       "en": "I tell him - take me with you,"
      },
      {
       "cyr": "тој ми велет - не те зема.",
       "lat": "toj mi velet - ne te zema.",
       "en": "he tells me - I won't take you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тој ми велет - не те зема,",
       "lat": "Toj mi velet - ne te zema,",
       "en": "He tells me - I won't take you,"
      },
      {
       "cyr": "лоша ми је дружината,",
       "lat": "loša mi je družinata,",
       "en": "my company is bad,"
      },
      {
       "cyr": "мене ќа ме отепает,",
       "lat": "mene ḱa me otepaet,",
       "en": "they'll kill me and"
      },
      {
       "cyr": "тебе млада ќа те земет.",
       "lat": "tebe mlada ḱa te zemet.",
       "en": "they'll take you 'cause you are young."
      }
     ]
    }
   ]
  }
