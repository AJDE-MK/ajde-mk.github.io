 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сношти минав покрај вази,",
       "lat": "Snošti minav pokraj vazi,",
       "en": "Last night I passed by yours,"
      },
      {
       "cyr": "тебе моме не те најдов,",
       "lat": "tebe mome ne te najdov,",
       "en": "I did not find you, girl,"
      },
      {
       "cyr": "срце ми се растрепери,",
       "lat": "srce mi se rastreperi,",
       "en": "my heart began to tremble,"
      },
      {
       "cyr": "почнав солзи да ронам.",
       "lat": "počnav solzi da ronam.",
       "en": "I began to shed tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сечи моме руси коси,",
       "lat": "Seči mome rusi kosi,",
       "en": "Cut your blond hair, girl,"
      },
      {
       "cyr": "прави скала да се качам,",
       "lat": "pravi skala da se kačam,",
       "en": "make a ladder for me to climb,"
      },
      {
       "cyr": "да ти видам бело лице,",
       "lat": "da ti vidam belo lice,",
       "en": "to see your white face,"
      },
      {
       "cyr": "ем рудото ти грло.",
       "lat": "em rudoto ti grlo.",
       "en": "and your ruddy throat."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кажи моме вистината,",
       "lat": "Kaži mome vistinata,",
       "en": "Tell the truth, girl,"
      },
      {
       "cyr": "љубиш ли ме, мамиш ли ме,",
       "lat": "ljubiš li me, mamiš li me,",
       "en": "do you love me, or are you deceiving me,"
      },
      {
       "cyr": "ил сос' мен' се подигруваш,",
       "lat": "il sos' men' se podigruvaš,",
       "en": "or are you just teasing me,"
      },
      {
       "cyr": "да ти мине времето.",
       "lat": "da ti mine vremeto.",
       "en": "to pass your time?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ах да можам да разберам,",
       "lat": "Ah da možam da razberam,",
       "en": "Ah, if only I could find out,"
      },
      {
       "cyr": "була ли си, ил' Гркиња?",
       "lat": "bula li si, il' Grkinja?",
       "en": "are you a married woman, or a Greek?"
      },
      {
       "cyr": "Ил' си моме Македонка,",
       "lat": "Il' si mome Makedonka,",
       "en": "Or are you a Macedonian girl,"
      },
      {
       "cyr": "што си толку убава?",
       "lat": "što si tolku ubava?",
       "en": "that you are so beautiful?"
      }
     ]
    }
   ]
  }
 ],
