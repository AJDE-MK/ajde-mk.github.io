    {
     "lines": [
      {
       "cyr": "Збогум мила дојде време",
       "lat": "Zbogum mila dojde vreme",
       "en": "Farewell, my dear, the time has come"
      },
      {
       "cyr": "јас од тебе да се разделам.",
       "lat": "jas od tebe da se razdelam.",
       "en": "for me to part from you."
      },
      {
       "cyr": "Јас пак беден роден сум без к'смет",
       "lat": "Jas pak beden roden sum bez k'smet",
       "en": "And I was born poor, without luck,"
      },
      {
       "cyr": "сè со мака, тага голема.",
       "lat": "sè so maka, taga golema.",
       "en": "everything with hardship, great sorrow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тешка беше нашата разделба,",
       "lat": "Teška beše našata razdelba,",
       "en": "Our parting was hard,"
      },
      {
       "cyr": "кога тргнав од својот роден крај.",
       "lat": "koga trgnav od svojot roden kraj.",
       "en": "when I set out from my native land."
      },
      {
       "cyr": "Мојте солзи патот го топеа,",
       "lat": "Mojte solzi patot go topea,",
       "en": "My tears melted the road,"
      },
      {
       "cyr": "по патот за непознат крај.",
       "lat": "po patot za nepoznat kraj.",
       "en": "the road to an unknown land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дојдов тука како јабанџија,",
       "lat": "Dojdov tuka kako jabandžija,",
       "en": "I came here like a stranger,"
      },
      {
       "cyr": "далеку од својот роден крај.",
       "lat": "daleku od svojot roden kraj.",
       "en": "far from my native land."
      },
      {
       "cyr": "Срце плаче нигде среќа нема,",
       "lat": "Srce plače nigde sreḱa nema,",
       "en": "My heart weeps, there is no happiness anywhere,"
      },
      {
       "cyr": "тежок гурбет тага голема.",
       "lat": "težok gurbet taga golema.",
       "en": "hard gurbet, great sorrow."
      },
      {
       "cyr": "Срце плачи нигде среќа нема,",
       "lat": "Srce plači nigde sreḱa nema,",
       "en": "My heart weeps, there is no happiness anywhere,"
      },
      {
       "cyr": "тежок гурбет в' туѓа туѓина.",
       "lat": "težok gurbet v' tuǵa tuǵina.",
       "en": "hard gurbet in a foreign land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако бог дај јас да се вратам",
       "lat": "Ako bog daj jas da se vratam",
       "en": "If God grants it, I will return,"
      },
      {
       "cyr": "тебе Стојне да те прегрнам.",
       "lat": "tebe Stojne da te pregrnam.",
       "en": "Stojna, to embrace you."
      },
      {
       "cyr": "Да ти кажам мојте маки,",
       "lat": "Da ti kažam mojte maki,",
       "en": "To tell you my troubles,"
      },
      {
       "cyr": "мојте маки, таги големи.",
       "lat": "mojte maki, tagi golemi.",
       "en": "my troubles, my great sorrows."
      }
     ]
    }
   ]
