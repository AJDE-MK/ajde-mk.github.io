   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Штом те видам, памет лета,",
       "lat": "Štom te vidam, pamet leta,",
       "en": "The moment I see you, I lose my head,"
      },
      {
       "cyr": "зошто мила да се чека,",
       "lat": "zošto mila da se čeka,",
       "en": "why wait, my dear?"
      },
      {
       "cyr": "ајде да се зграбиме,",
       "lat": "ajde da se zgrabime,",
       "en": "Let’s seize the moment,"
      },
      {
       "cyr": "нешто да направиме.",
       "lat": "nešto da napravime.",
       "en": "let’s make something happen."
      },
      {
       "cyr": "Пари, злато, нова кола,",
       "lat": "Pari, zlato, nova kola,",
       "en": "Money, gold, a new car,"
      },
      {
       "cyr": "сè што сакаш, мила моја.",
       "lat": "sè što sakaš, mila moja.",
       "en": "whatever you want, my dear."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да се љубиме, да излудиме,",
       "lat": "Da se ljubime, da izludime,",
       "en": "Let’s make love, let’s go wild,"
      },
      {
       "cyr": "зошто во нас оган гори,",
       "lat": "zošto vo nas ogan gori,",
       "en": "for a fire burns within us,"
      },
      {
       "cyr": "ќе изгориме.",
       "lat": "ḱe izgorime.",
       "en": "we’ll burn up."
      },
      {
       "cyr": "Ќе остариме, па ќе жалиме,",
       "lat": "Ḱe ostarime, pa ḱe žalime,",
       "en": "We’ll grow old and then regret it,"
      },
      {
       "cyr": "зошто тогаш ништо нема",
       "lat": "zošto togaš ništo nema",
       "en": "because by then, there’ll be nothing left"
      },
      {
       "cyr": "да направиме.",
       "lat": "da napravime.",
       "en": "for us to do."
      }
     ]
    },
    {
     "lines": [
