   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Јаничари одат, мамо",
       "lat": "Janičari odat, mamo",
       "en": "The Janissaries are coming, mother,"
      },
      {
       "cyr": "од село во село,",
       "lat": "od selo vo selo,",
       "en": "from village to village,"
      },
      {
       "cyr": "голем зулум прават,",
       "lat": "golem zulum pravat,",
       "en": "they commit great oppression,"
      },
      {
       "cyr": "машки деца земаат мамо,",
       "lat": "maški deca zemaat mamo,",
       "en": "they take boy children, mother,"
      },
      {
       "cyr": "земаат, потурчуваат,",
       "lat": "zemaat, poturčuvaat,",
       "en": "they take them, convert them to Islam,"
      },
      {
       "cyr": "млади моми, грабаат мамо,",
       "lat": "mladi momi, grabaat mamo,",
       "en": "they seize young girls, mother,"
      },
      {
       "cyr": "анами ги прават.",
       "lat": "anami gi pravat.",
       "en": "they make them anami."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зеле ми го, зеле мамо,",
       "lat": "Zele mi go, zele mamo,",
       "en": "They took him, took him, mother,"
      },
      {
       "cyr": "Стојана на мајка,",
       "lat": "Stojana na majka,",
       "en": "Stojan from his mother,"
      },
      {
       "cyr": "зеле и одвеле,",
       "lat": "zele i odvele,",
       "en": "they took him and led him away,"
      },
      {
       "cyr": "а Стојан ми беше, мамо,",
       "lat": "a Stojan mi beše, mamo,",
       "en": "and Stojan was, mother,"
      },
      {
       "cyr": "единец на мајка.",
       "lat": "edinec na majka.",
       "en": "his mother's only child."
      },
      {
       "cyr": "А Стојан ми беше, мамо,",
       "lat": "A Stojan mi beše, mamo,",
       "en": "And Stojan was, mother,"
      },
      {
       "cyr": "единец на мајка.",
