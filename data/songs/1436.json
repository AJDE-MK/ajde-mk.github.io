   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кога јас тебе те видов,",
       "lat": "Koga jas tebe te vidov,",
       "en": "When I saw you,"
      },
      {
       "cyr": "сонце огреа,",
       "lat": "sonce ogrea,",
       "en": "the sun shone,"
      },
      {
       "cyr": "сонце ми огреа, џанам,",
       "lat": "sonce mi ogrea, džanam,",
       "en": "the sun shone on me, my dear,"
      },
      {
       "cyr": "душа заигра.",
       "lat": "duša zaigra.",
       "en": "my soul began to dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Играј ти со мојто срце,",
       "lat": "Igraj ti so mojto srce,",
       "en": "Play with my heart,"
      },
      {
       "cyr": "душо најмила,",
       "lat": "dušo najmila,",
       "en": "my dearest soul,"
      },
      {
       "cyr": "само тебе јас те љубам,",
       "lat": "samo tebe jas te ljubam,",
       "en": "only you do I love,"
      },
      {
       "cyr": "без тебе не можам.",
       "lat": "bez tebe ne možam.",
       "en": "I cannot live without you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Везден до мене да седиш,",
       "lat": "Vezden do mene da sediš,",
       "en": "Embroidered one, sit next to me,"
      },
      {
       "cyr": "срце да ми греиш,",
       "lat": "srce da mi greiš,",
       "en": "warm my heart,"
      },
      {
       "cyr": "јас те љубам, ти ме љубиш,",
       "lat": "jas te ljubam, ti me ljubiš,",
       "en": "I love you, you love me,"
      },
      {
       "cyr": "да се земиме.",
       "lat": "da se zemime.",
       "en": "let us marry."
