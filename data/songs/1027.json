      {
       "cyr": "Буките развиваат браќа,",
       "lat": "Bukite razvivaat braḱa,",
       "en": "The beech turn green, brothers,"
      },
      {
       "cyr": "горе в' планина,",
       "lat": "gore v' planina,",
       "en": "up there in the mountain,"
      },
      {
       "cyr": "горе в' планина ле браќа,",
       "lat": "gore v' planina le braḱa,",
       "en": "up there in the mountain, brothers,"
      },
      {
       "cyr": "в' Македонија.",
       "lat": "v' Makedonija.",
       "en": "in Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пусии ставија браќа,",
       "lat": "Pusii stavija braḱa,",
       "en": "They made traps, brothers,"
      },
      {
       "cyr": "млади војводи,",
       "lat": "mladi vojvodi,",
       "en": "young voivodas,"
      },
      {
       "cyr": "млади војводи ле браќа,",
       "lat": "mladi vojvodi le braḱa,",
       "en": "young voivodas, brothers,"
      },
      {
       "cyr": "сè Македонци.",
       "lat": "sè Makedonci.",
       "en": "all Macedonians."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пусии ставија браќа,",
