      {
       "cyr": "моите звучни акорди.",
       "lat": "moite zvučni akordi.",
       "en": "How much I love (you)."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оваа моја серенада",
       "lat": "Ovaa moja serenada",
       "en": "This my serenade,"
      },
      {
       "cyr": "тебе ти ја дарувам,",
       "lat": "tebe ti ja daruvam,",
       "en": "I give it to you,"
      },
      {
       "cyr": "мирен сон и добра ноќ",
       "lat": "miren son i dobra noḱ",
       "en": "A calm dream and a good night,"
      },
      {
       "cyr": "мила ти пожелувам.",
       "lat": "mila ti poželuvam.",
       "en": "I wish you, dear."
      }
     ]
    },
