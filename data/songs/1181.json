   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сторив ниет, мила мајко,",
       "lat": "Storiv niet, mila majko,",
       "en": "I made up my mind, dear mother,"
      },
      {
       "cyr": "јас да се оженам,",
       "lat": "jas da se oženam,",
       "en": "to get married,"
      },
      {
       "cyr": "си отидов на гурбетлак,",
       "lat": "si otidov na gurbetlak,",
       "en": "so I went off to work abroad,"
      },
      {
       "cyr": "пари да спечалам,",
       "lat": "pari da spečalam,",
       "en": "to earn money,"
      },
      {
       "cyr": "па спечалив, мила мајко,",
       "lat": "pa spečaliv, mila majko,",
       "en": "and I earned, dear mother,"
      },
      {
       "cyr": "девет коњи свила.",
       "lat": "devet konji svila.",
       "en": "nine horses of silk."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па си тргнав по друмови,",
       "lat": "Pa si trgnav po drumovi,",
       "en": "Then I set off along the roads,"
      },
      {
       "cyr": "в' това бело Скопје,",
       "lat": "v' tova belo Skopje,",
       "en": "to this white Skopje,"
      },
      {
       "cyr": "свила да продадам, мајко,",
       "lat": "svila da prodadam, majko,",
       "en": "to sell the silk, mother,"
      },
      {
       "cyr": "снаа да доведам.",
       "lat": "snaa da dovedam.",
       "en": "and bring home a bride."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што е пусто Скопје, мајко,",
       "lat": "Što e pusto Skopje, majko,",
       "en": "Why is Skopje empty, mother,"
      },
      {
       "cyr": "пусто останало,",
       "lat": "pusto ostanalo,",
       "en": "left deserted,"
      },
      {
       "cyr": "ниту човек има, мајко,",
       "lat": "nitu čovek ima, majko,",
       "en": "there is no person, mother,"
      },
      {
       "cyr": "ниту пиле да помине?",
       "lat": "nitu pile da pomine?",
       "en": "not even a bird passing by?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па се вратив по друмови,",
       "lat": "Pa se vrativ po drumovi,",
       "en": "Then I turned back along the roads,"
      },
      {
       "cyr": "три дни и три ноќи,",
       "lat": "tri dni i tri noḱi,",
       "en": "three days and three nights,"
      },
      {
       "cyr": "на пат сретнав, мила мајко,",
       "lat": "na pat sretnav, mila majko,",
       "en": "on the way I met, dear mother,"
      },
      {
       "cyr": "една стара баба,",
       "lat": "edna stara baba,",
       "en": "an old woman,"
      },
      {
       "cyr": "па ја прашав, мила мајко:",
       "lat": "pa ja prašav, mila majko:",
       "en": "and I asked her, dear mother:"
      },
      {
       "cyr": "- Што е Скопје пусто?",
       "lat": "- Što e Skopje pusto?",
       "en": "- Why is Skopje empty?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не сум Тоде стара баба,",
       "lat": "- Ne sum Tode stara baba,",
       "en": "- I am not an old woman, Tode,"
      },
      {
       "cyr": "тук' сум стара чума,",
       "lat": "tuk' sum stara čuma,",
       "en": "I am the old plague,"
      },
      {
       "cyr": "сум тепала три години,",
       "lat": "sum tepala tri godini,",
       "en": "I have been striking for three years,"
      },
      {
       "cyr": "на тебе е редот,",
       "lat": "na tebe e redot,",
       "en": "it is your turn now,"
      },
      {
       "cyr": "мајка нема да те види,",
       "lat": "majka nema da te vidi,",
       "en": "your mother will not see you,"
      },
      {
       "cyr": "па и ти ќе умреш.",
       "lat": "pa i ti ḱe umreš.",
       "en": "and you too will die."
      }
     ]
    }
   ]
