      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Охридско езеро, убаво, убаво,",
       "lat": "Ohridsko ezero, ubavo, ubavo,",
       "en": "Ohrid lake, beautiful, beautiful,"
      },
      {
       "cyr": "Пирин планина, висока.",
       "lat": "Pirin planina, visoka.",
       "en": "Pirin mountain, high."
      },
      {
       "cyr": "Реката Вардар, крвава, крвава",
       "lat": "Rekata Vardar, krvava, krvava",
       "en": "The river Vardar, bloody, bloody"
      },
      {
       "cyr": "и Бело море, бескрајно.",
       "lat": "i Belo more, beskrajno.",
       "en": "and the White Sea, endless."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ти раѓаш само синои герои,",
       "lat": "Ti raǵaš samo sinoi geroi,",
       "en": "You bear only hero sons,"
      },
      {
       "cyr": "храбри Mакедонци.",
       "lat": "hrabri Makedonci.",
       "en": "brave Macedonians."
      },
      {
       "cyr": "Вечно се поробени и разделени,",
       "lat": "Večno se porobeni i razdeleni,",
       "en": "Forever enslaved and divided,"
      },
      {
       "cyr": "никогаш непокорени.",
       "lat": "nikogaš nepokoreni.",
       "en": "never subdued."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Болен си лежам в' туѓина, в' туѓина",
       "lat": "Bolen si ležam v' tuǵina, v' tuǵina",
       "en": "Sick I lie in a foreign land, a foreign land,"
      },
      {
       "cyr": "и тамо јас ќе си умрам.",
       "lat": "i tamo jas ḱe si umram.",
       "en": "and there I will die."
      },
      {
       "cyr": "Последна желба си имам, си имам,",
       "lat": "Posledna želba si imam, si imam,",
