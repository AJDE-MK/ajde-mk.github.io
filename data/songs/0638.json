      {
       "cyr": "во славна Дебарца, Балкан,",
       "lat": "vo slavna Debarca, Balkan,",
       "en": "in glorious Debarca, the Balkan,"
      },
      {
       "cyr": "село Арбиново.",
       "lat": "selo Arbinovo.",
       "en": "the village of Arbinovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стари Дејан свадба прави,",
       "lat": "Stari Dejan svadba pravi,",
       "en": "Old Dejan holds a wedding,"
      },
      {
       "cyr": "свадба прави со ѕверови.",
       "lat": "svadba pravi so dzverovi.",
       "en": "holds a wedding with beasts."
      },
      {
       "cyr": "Од никаде помош нема,",
       "lat": "Od nikade pomoš nema,",
       "en": "From nowhere is there help,"
      },
      {
       "cyr": "само Ѓурчин од Слатино.",
       "lat": "samo Ǵurčin od Slatino.",
       "en": "only Gjurchin from Slatino."
      }
     ]
    },
