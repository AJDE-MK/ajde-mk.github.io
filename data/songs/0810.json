     ]
    },
    {
     "lines": [
      {
       "cyr": "Да дојде, Гујго, да дојде, ле,",
       "lat": "Da dojde, Gujgo, da dojde, le,",
       "en": "To come, Gujgo, to come,"
      },
      {
       "cyr": "в' тетино село големо.",
       "lat": "v' tetino selo golemo.",
       "en": "into his aunt's big village."
      },
      {
       "cyr": "Мома му сам аресала, ле,",
       "lat": "Moma mu sam aresala, le,",
       "en": "I found a girl for him,"
      },
      {
       "cyr": "аресала, бендисала.",
       "lat": "aresala, bendisala.",
       "en": "I found her and liked her."
      },
      {
       "cyr": "Гујго, ле Гујго јуначе,",
       "lat": "Gujgo, le Gujgo junače,",
       "en": "Hey, Gujgo, the hero,"
      },
      {
       "cyr": "аресала, бендисала.",
       "lat": "aresala, bendisala.",
       "en": "I found her and liked her."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мајка му руба збираше, ле,",
       "lat": "Majka mu ruba zbiraše, le,",
       "en": "His mother adjusts his clothes,"
      },
      {
       "cyr": "брате му коњче стегаа.",
       "lat": "brate mu konjče stegaa.",
       "en": "the brother saddles the horse."
      },
      {
       "cyr": "Сестри му перче решеа, ле,",
       "lat": "Sestri mu perče rešea, le,",
       "en": "His sisters comb his lock of hair,"
      },
      {
       "cyr": "ќе иде Гујгу, не иде.",
       "lat": "ḱe ide Gujgu, ne ide.",
       "en": "will Gujgo go, or won't he."
      },
      {
       "cyr": "Гујго ле, Гујго јуначе, ле,",
       "lat": "Gujgo le, Gujgo junače, le,",
