 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Тргнало ми лудо младо",
       "lat": "Trgnalo mi ludo mlado",
       "en": "A young man is about to go"
      },
      {
       "cyr": "за солунски пазар",
       "lat": "za solunski pazar",
       "en": "to the market in Solun"
      },
      {
       "cyr": "и на моме проговара",
       "lat": "i na mome progovara",
       "en": "so he asks his girlfriend"
      },
      {
       "cyr": "рачај, порачувај.",
       "lat": "račaj, poračuvaj.",
       "en": "to make an order."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Рачај порачувај моме",
       "lat": "Račaj poračuvaj mome",
       "en": "Tell me girl, order,"
      },
      {
       "cyr": "што да ти донесам",
       "lat": "što da ti donesam",
       "en": "what do you want me to bring to you,"
      },
      {
       "cyr": "срмено елече моме",
       "lat": "srmeno eleče mome",
       "en": "a silver bodice, girl,"
      },
      {
       "cyr": "или ѓерданче.",
       "lat": "ili ǵerdanče.",
       "en": "or a necklace?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Купи лудо, купи младо",
       "lat": "Kupi ludo, kupi mlado",
       "en": "Buy dear, buy honey,"
      },
      {
       "cyr": "што ти срце сака",
       "lat": "što ti srce saka",
       "en": "whatever your heart wants"
      },
      {
       "cyr": "што ти срце сака лудо",
       "lat": "što ti srce saka ludo",
       "en": "whatever your heart wants, dear,"
      },
      {
       "cyr": "што го нема тука.",
       "lat": "što go nema tuka.",
       "en": "as long as we don't have it here."
      }
     ]
    }
   ]
  }
 ],
