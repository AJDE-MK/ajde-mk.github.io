      {
       "cyr": "Славеј пее на трендафил,",
       "lat": "Slavej pee na trendafil,",
       "en": "The nightingale sings on the rose,"
      },
      {
       "cyr": "моме седи на пенџере,",
       "lat": "mome sedi na pendžere,",
       "en": "the girl sits at the window,"
      },
      {
       "cyr": "нажалено, насрдено,",
       "lat": "nažaleno, nasrdeno,",
       "en": "grieved, angry,"
      },
      {
       "cyr": "ем со солзи на очите.",
       "lat": "em so solzi na očite.",
       "en": "and with tears in her eyes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Бог да бие мојта мајка,",
       "lat": "- Bog da bie mojta majka,",
       "en": "- God strike my mother,"
      },
      {
       "cyr": "што ме даде надалеку,",
       "lat": "što me dade nadaleku,",
       "en": "who gave me away far off,"
      },
      {
       "cyr": "да не можам да се видам,",
       "lat": "da ne možam da se vidam,",
       "en": "so that I cannot see"
      },
      {
       "cyr": "ни со мајка, ни со татко.",
       "lat": "ni so majka, ni so tatko.",
       "en": "either mother or father."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ни со мајка, ни со татко,",
       "lat": "Ni so majka, ni so tatko,",
       "en": "Neither mother nor father,"
      },
      {
       "cyr": "ни со мојте мили сестри,",
       "lat": "ni so mojte mili sestri,",
       "en": "nor my dear sisters,"
      },
      {
       "cyr": "ни со моите мили браќа,",
       "lat": "ni so moite mili braḱa,",
       "en": "nor my dear brothers,"
      },
      {
