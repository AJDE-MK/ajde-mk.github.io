      {
       "cyr": "крај градинчето:",
       "lat": "kraj gradinčeto:",
       "en": "along the little garden:"
      },
      {
       "cyr": "- Стани, стани малој моме",
       "lat": "- Stani, stani maloj mome",
       "en": "- Get up, get up, little girl,"
      },
      {
       "cyr": "цвеќе ти овена.",
       "lat": "cveḱe ti ovena.",
       "en": "your flowers have wilted."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ако вене, нек' се суши",
       "lat": "- Ako vene, nek' se suši",
       "en": "- If they wilt, let them dry,"
      },
      {
       "cyr": "друго ќе зберам.",
       "lat": "drugo ḱe zberam.",
       "en": "I will gather others."
      },
      {
       "cyr": "- Стани, стани малој моме",
       "lat": "- Stani, stani maloj mome",
       "en": "- Get up, get up, little girl,"
      },
      {
       "cyr": "момче се армаса.",
       "lat": "momče se armasa.",
       "en": "the lad is getting engaged."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Нек' се врши, нек' се жени",
       "lat": "- Nek' se vrši, nek' se ženi",
