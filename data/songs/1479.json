   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Поленка чукај на порти,",
       "lat": "Polenka čukaj na porti,",
       "en": "Polenka, knock at the gate,"
      },
      {
       "cyr": "достум тривели,",
       "lat": "dostum triveli,",
       "en": "dostum triveli (refrain),"
      },
      {
       "cyr": "да не те чујат комшиите,",
       "lat": "da ne te čujat komšiite,",
       "en": "so the neighbours don't hear you,"
      },
      {
       "cyr": "јагне галено.",
       "lat": "jagne galeno.",
       "en": "my pampered lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Комшии ми са бабите,",
       "lat": "Komšii mi sa babite,",
       "en": "The neighbours are the grandmothers,"
      },
      {
       "cyr": "достум тривели,",
       "lat": "dostum triveli,",
       "en": "dostum triveli (refrain),"
      },
      {
       "cyr": "бабите, мојте душманки,",
       "lat": "babite, mojte dušmanki,",
       "en": "the grannies, my enemies,"
      },
      {
       "cyr": "јагне галено.",
       "lat": "jagne galeno.",
       "en": "my pampered lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Они ќе кажат на мама,",
       "lat": "Oni ḱe kažat na mama,",
       "en": "They will tell mother,"
      },
      {
       "cyr": "достум тривели,",
       "lat": "dostum triveli,",
       "en": "dostum triveli (refrain),"
      },
      {
       "cyr": "мама ќе каже на тате,",
       "lat": "mama ḱe kaže na tate,",
       "en": "mother will tell father,"
      },
      {
       "cyr": "јагне галено.",
       "lat": "jagne galeno.",
       "en": "my pampered lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Та ќе ме младо ј'ожени",
       "lat": "Ta ḱe me mlado j'oženi",
       "en": "And they will marry me off young,"
      },
      {
       "cyr": "достум тривели,",
       "lat": "dostum triveli,",
       "en": "dostum triveli (refrain),"
      },
      {
       "cyr": "та ќе ме даде далеко,",
       "lat": "ta ḱe me dade daleko,",
       "en": "and give me away far off,"
      },
      {
       "cyr": "јагне галено.",
       "lat": "jagne galeno.",
       "en": "my pampered lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Далеко, село Чифлико,",
       "lat": "Daleko, selo Čifliko,",
       "en": "Far away, the village of Chifliko,"
      },
      {
       "cyr": "достум тривели,",
       "lat": "dostum triveli,",
       "en": "dostum triveli (refrain),"
      },
      {
       "cyr": "да не мож' да се виждаме,",
       "lat": "da ne mož' da se viždame,",
       "en": "so that we cannot see each other,"
      },
      {
       "cyr": "јагне галено.",
       "lat": "jagne galeno.",
       "en": "my pampered lamb."
      }
     ]
    }
