       "lat": "Ne raǵaj ḱerki ubavi.",
       "en": "Don't give birth to beautiful daughters."
      },
      {
       "cyr": "Твоите ќерки, мајко Македонијо,",
       "lat": "Tvoite ḱerki, majko Makedonijo,",
       "en": "Your daughters, mother Macedonia,"
      },
      {
       "cyr": "Тиран ти граба на сила.",
       "lat": "Tiran ti graba na sila.",
       "en": "the tyrant seizes by force."
