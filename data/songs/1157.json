    {
     "lines": [
      {
       "cyr": "Мили боже, дал' ослепе,",
       "lat": "Mili bože, dal' oslepe,",
       "en": "Dear God, did you go blind,"
      },
      {
       "cyr": "тоа чудо да не видеш,",
       "lat": "toa čudo da ne videš,",
       "en": "that you do not see this wonder,"
      },
      {
       "cyr": "как' ја мачат таа жена,",
       "lat": "kak' ja mačat taa žena,",
       "en": "how they torment that woman,"
      },
      {
       "cyr": "как' ѝ вадат нежна душа?",
       "lat": "kak' ì vadat nežna duša?",
       "en": "how they pull out her tender soul?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мирка, мајко, на Гинови,",
       "lat": "Mirka, majko, na Ginovi,",
       "en": "Mirka, mother, of the Ginovs,"
      },
      {
       "cyr": "роса в' темна зандана,",
       "lat": "rosa v' temna zandana,",
       "en": "dew in a dark dungeon,"
      },
      {
       "cyr": "рано очи ѝ затворија,",
       "lat": "rano oči ì zatvorija,",
       "en": "they closed her eyes early,"
      },
      {
       "cyr": "руба, мајко, ѝ запалија.",
       "lat": "ruba, majko, ì zapalija.",
       "en": "they burned her clothes, mother."
      }
     ]
    },
    {
     "lines": [
