   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мили чеда на мајка разделени,",
       "lat": "Mili čeda na majka razdeleni,",
       "en": "Dear children of the divided mother",
       "en_mt": false
      },
      {
       "cyr": "тешка рана на срце, а и на гради.",
       "lat": "teška rana na srce, a i na gradi.",
       "en": "a hard pain on the heart, and the shoulders.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Вардаре, Пирин кај ти е,",
       "lat": "Vardare, Pirin kaj ti e,",
       "en": "Vardar, where is your Pirin?",
       "en_mt": false
      },
      {
       "cyr": "Вардаре, Егеј кај ти е?",
       "lat": "Vardare, Egej kaj ti e?",
       "en": "Vardar, where is your Aegean?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мајко Македонијо, ајде не плачи,",
       "lat": "Majko Makedonijo, ajde ne plači,",
       "en": "Mother Macedonia, don't cry!",
       "en_mt": false
      },
      {
       "cyr": "ден ќе дојде, ќе ги гушнеш Пирин планини.",
       "lat": "den ḱe dojde, ḱe gi gušneš Pirin planini.",
       "en": "The day will come, you'll hug the Pirin Mountains.",
       "en_mt": false
      },
      {
       "cyr": "Мајко Македонијо, ајде запеј ти,",
       "lat": "Majko Makedonijo, ajde zapej ti,",
       "en": "Mother Macedonia, sing!",
       "en_mt": false
      },
      {
       "cyr": "ден ќе дојде, ќе те носат води егејски.",
       "lat": "den ḱe dojde, ḱe te nosat vodi egejski.",
       "en": "The day will come, you'll be carried by the Aegean waters.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Вардаре, Пирин кај ти е,",
       "lat": "Vardare, Pirin kaj ti e,",
       "en": "Vardar, where is your Pirin?",
       "en_mt": false
      },
      {
       "cyr": "Вардаре, Егеј кај ти е?",
       "lat": "Vardare, Egej kaj ti e?",
       "en": "Vardar, where is your Aegean?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Солзи течат мајчински, македонски,",
       "lat": "Solzi tečat majčinski, makedonski,",
       "en": "Tears are flowing from mother Macedonia",
       "en_mt": false
      },
      {
       "cyr": "тешки како што ни се, еј, векови.",
       "lat": "teški kako što ni se, ej, vekovi.",
       "en": "Difficult, like how the centuries have been.",
       "en_mt": false
      }
     ]
    },
