   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Жалај Ѓурго да жалиме,",
       "lat": "- Žalaj Ǵurgo da žalime,",
       "en": "- Grieve, Georgia, let’s mourn,"
      },
      {
       "cyr": "како ќе се разделиме,",
       "lat": "kako ḱe se razdelime,",
       "en": "how will we part ways,"
      },
      {
       "cyr": "ти од мене, јас од тебе.",
       "lat": "ti od mene, jas od tebe.",
       "en": "you from me and me from you."
      },
      {
       "cyr": "Ја качи се в' одајата,",
       "lat": "Ja kači se v' odajata,",
       "en": "Climb into my room,"
      },
      {
       "cyr": "та подај ми тамбурата,",
       "lat": "ta podaj mi tamburata,",
       "en": "give me the tambourine,"
      },
      {
       "cyr": "јас да свирам, ти да играш.",
       "lat": "jas da sviram, ti da igraš.",
       "en": "for me to play, for you to dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја седи ми на колено,",
       "lat": "Ja sedi mi na koleno,",
       "en": "Sit on my knee,"
      },
      {
       "cyr": "да отпетлиш ред петлици,",
       "lat": "da otpetliš red petlici,",
       "en": "to unfasten the row of buttons,"
      },
      {
       "cyr": "да ми видиш кошулата.",
       "lat": "da mi vidiš košulata.",
       "en": "so you can see my shirt."
      },
      {
       "cyr": "Неиспрана три години,",
       "lat": "Neisprana tri godini,",
       "en": "Unwashed for three years,"
      },
      {
       "cyr": "кошулата кир фатила,",
       "lat": "košulata kir fatila,",
       "en": "the shirt, soiled and filthy,"
      },
      {
       "cyr": "ја земи ја, испери ја.",
       "lat": "ja zemi ja, isperi ja.",
       "en": "take it and wash it."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Му говоре калеш Ѓурѓа:",
       "lat": "Mu govore kaleš Ǵurǵa:",
       "en": "Brunette Georgia said to him:"
      },
      {
       "cyr": "- Ој ти лудо, лудо младо,",
       "lat": "- Oj ti ludo, ludo mlado,",
       "en": "- Hey you foolish, foolish lad,"
      },
      {
       "cyr": "немам вода да исперам.",
       "lat": "nemam voda da isperam.",
       "en": "I don’t have water to wash it."
      },
      {
       "cyr": "Изговоре лудо младо:",
       "lat": "Izgovore ludo mlado:",
       "en": "The foolish young lad replied:"
      },
      {
       "cyr": "- Твојте очи, два кладенца,",
       "lat": "- Tvojte oči, dva kladenca,",
       "en": "- Your eyes are two wells,"
      },
      {
       "cyr": "еден студен, други топол.",
       "lat": "eden studen, drugi topol.",
       "en": "one cold and the other warm."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Изговоре калеш Ѓурѓа:",
       "lat": "Izgovore kaleš Ǵurǵa:",
       "en": "The brunette Georgia answered:"
      },
      {
       "cyr": "- Ој ти лудо, лудо младо,",
       "lat": "- Oj ti ludo, ludo mlado,",
       "en": "- Hey you foolish, foolish lad,"
      },
      {
       "cyr": "немам сапун да исперам.",
       "lat": "nemam sapun da isperam.",
       "en": "I don’t have soap to wash."
      },
      {
       "cyr": "Изговоре лудо младо:",
       "lat": "Izgovore ludo mlado:",
       "en": "The foolish young lad replied:"
      },
      {
       "cyr": "- Твојте раце, два калупа,",
       "lat": "- Tvojte race, dva kalupa,",
       "en": "- Your hands are two bars,"
      },
      {
       "cyr": "два калупа гирит сапун.",
       "lat": "dva kalupa girit sapun.",
       "en": "two bars of grit soap."
