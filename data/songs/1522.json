   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Колку е мачно, ем жално,",
       "lat": "Kolku e mačno, em žalno,",
       "en": "How hard and sad it is,"
      },
      {
       "cyr": "кој љуби, мамо, две моми,",
       "lat": "koj ljubi, mamo, dve momi,",
       "en": "for him who loves, mother, two girls,"
      },
      {
       "cyr": "од една аир да нема.",
       "lat": "od edna air da nema.",
       "en": "to have no joy from either one."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ојдов си, мамо, во Јана",
       "lat": "Ojdov si, mamo, vo Jana",
       "en": "I went, mother, to Jana,"
      },
      {
       "cyr": "во јанените дворови,",
       "lat": "vo janenite dvorovi,",
       "en": "to Jana's courtyards,"
      },
      {
       "cyr": "на јанините вратички.",
       "lat": "na janinite vratički.",
       "en": "to Jana's little gate."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Отвори Јано вратичка,",
       "lat": "- Otvori Jano vratička,",
       "en": "- Open the little gate, Jana,"
      },
      {
       "cyr": "цигара да си запалам,",
       "lat": "cigara da si zapalam,",
       "en": "so I can light a cigarette,"
      },
      {
       "cyr": "два збора да ти презборам.",
       "lat": "dva zbora da ti prezboram.",
       "en": "so I can say two words to you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не можам, Стојан, да станам,",
       "lat": "- Ne možam, Stojan, da stanam,",
       "en": "- I cannot get up, Stojan,"
      },
      {
       "cyr": "везден сум лозје копала,",
       "lat": "vezden sum lozje kopala,",
       "en": "all day I have been digging the vineyard,"
      },
      {
       "cyr": "тешка мотика дигала.",
       "lat": "teška motika digala.",
       "en": "lifting a heavy hoe."
      }
     ]
    }
   ]
