   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сеј со здравје, севдо моја",
       "lat": "Sej so zdravje, sevdo moja",
       "en": "Farewell, my love,"
      },
      {
       "cyr": "пушчи ме да си одам.",
       "lat": "pušči me da si odam.",
       "en": "let me go on my way."
      },
      {
       "cyr": "Сета работа си ја оставив,",
       "lat": "Seta rabota si ja ostaviv,",
       "en": "I left all my work"
      },
      {
       "cyr": "со тебе да се коноштисам.",
       "lat": "so tebe da se konoštisam.",
       "en": "to stay the night with you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Подари ми твојта слатка уста",
       "lat": "Podari mi tvojta slatka usta",
       "en": "Give me your sweet mouth"
      },
      {
       "cyr": "за да си позборвиме.",
       "lat": "za da si pozborvime.",
       "en": "so that we can talk."
      },
      {
       "cyr": "Подари ми твојте црни очи",
       "lat": "Podari mi tvojte crni oči",
       "en": "Give me your dark eyes"
      },
      {
       "cyr": "за да се погледаме.",
       "lat": "za da se pogledame.",
       "en": "so that we can look at each other."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не вени ми, мое лице бело",
       "lat": "Ne veni mi, moe lice belo",
       "en": "Do not wither, my white face,"
      },
      {
       "cyr": "денеска си го љубело.",
       "lat": "deneska si go ljubelo.",
       "en": "today you kissed him."
      },
      {
       "cyr": "Не плачете, мои очи црни,",
       "lat": "Ne plačete, moi oči crni,",
       "en": "Do not weep, my dark eyes,"
      },
      {
       "cyr": "до сега бевте со него.",
       "lat": "do sega bevte so nego.",
       "en": "until now you were with him."
      }
     ]
    }
   ]
