   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Таму ле мајко, близу Битола,",
       "lat": "Tamu le majko, blizu Bitola,",
       "en": "There, mother, near Bitola,"
      },
      {
       "cyr": "во ореовската густа корија,",
       "lat": "vo oreovskata gusta korija,",
       "en": "in the thick Oreovo forest,"
      },
      {
       "cyr": "Таки Даскалот смело загина",
       "lat": "Taki Daskalot smelo zagina",
       "en": "Taki the Teacher boldly fell"
      },
      {
       "cyr": "со неговата верна дружина,",
       "lat": "so negovata verna družina,",
       "en": "with his loyal band,"
      },
      {
       "cyr": "со нив загина смела девојка,",
       "lat": "so niv zagina smela devojka,",
       "en": "with them fell a brave girl,"
      },
      {
       "cyr": "млада Елпида Карамандова.",
       "lat": "mlada Elpida Karamandova.",
       "en": "young Elpida Karamandova."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Предадени од клети шпиуни,",
       "lat": "Predadeni od kleti špiuni,",
       "en": "Betrayed by accursed spies,"
      },
      {
       "cyr": "ги сардисаа од сите страни,",
       "lat": "gi sardisaa od site strani,",
       "en": "they were surrounded from all sides,"
      },
      {
       "cyr": "пушки згрмеа, бомби трештеа,",
       "lat": "puški zgrmea, bombi treštea,",
       "en": "rifles thundered, bombs crashed,"
      },
      {
       "cyr": "крвава почна борба нерамна.",
       "lat": "krvava počna borba neramna.",
       "en": "a bloody, unequal battle began."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тогај извика Таки Даскалот",
       "lat": "Togaj izvika Taki Daskalot",
       "en": "Then Taki the Teacher cried out"
      },
      {
       "cyr": "на неговата верна дружина:",
       "lat": "na negovata verna družina:",
       "en": "to his loyal band:"
      },
      {
       "cyr": "- Фрлајте бомби, тиран сотрете,",
       "lat": "- Frlajte bombi, tiran sotrete,",
       "en": "- Throw bombs, crush the tyrant,"
      },
      {
       "cyr": "живи во рака не се давајте.",
       "lat": "živi vo raka ne se davajte.",
       "en": "do not give yourselves up alive."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Клети тирани во борба нерамна",
       "lat": "Kleti tirani vo borba neramna",
       "en": "The accursed tyrants, in an unequal battle,"
      },
      {
       "cyr": "сета дружина му ја убија,",
       "lat": "seta družina mu ja ubija,",
       "en": "killed his whole band,"
      },
      {
       "cyr": "Таки Даскалот жив не се даде,",
       "lat": "Taki Daskalot živ ne se dade,",
       "en": "Taki the Teacher did not give himself up alive,"
      },
      {
       "cyr": "откачи бомба, над неа легна,",
       "lat": "otkači bomba, nad nea legna,",
       "en": "he unhooked a bomb and lay down over it,"
      },
      {
       "cyr": "самиот крвта си ја пролеа,",
       "lat": "samiot krvta si ja prolea,",
       "en": "he spilled his own blood"
      },
      {
       "cyr": "за слободата на Македонија.",
       "lat": "za slobodata na Makedonija.",
       "en": "for the freedom of Macedonia."
      }
     ]
    }
