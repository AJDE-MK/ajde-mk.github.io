   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Играле, играле девојчиња,",
       "lat": "Igrale, igrale devojčinja,",
       "en": "They danced, the girls danced,"
      },
      {
       "cyr": "играле, играле, до темници,",
       "lat": "igrale, igrale, do temnici,",
       "en": "they danced, they danced until dusk,"
      },
      {
       "cyr": "сите си, сите си дома пошле,",
       "lat": "site si, site si doma pošle,",
       "en": "all of them, all of them went home,"
      },
      {
       "cyr": "само си едно не пошло.",
       "lat": "samo si edno ne pošlo.",
       "en": "only one did not go."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Цело се село собрало",
       "lat": "Celo se selo sobralo",
       "en": "The whole village gathered"
      },
      {
       "cyr": "момето да ми го бараат,",
       "lat": "mometo da mi go baraat,",
       "en": "to look for the girl,"
      },
      {
       "cyr": "нашле го, нашле го во една куќа,",
       "lat": "našle go, našle go vo edna kuḱa,",
       "en": "they found her, they found her in a house,"
      },
      {
       "cyr": "во една куќа, кај лудо.",
       "lat": "vo edna kuḱa, kaj ludo.",
       "en": "in a house, with her sweetheart."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ајде бре, ајде бре моме,",
       "lat": "- Ajde bre, ajde bre mome,",
       "en": "- Come on, hey, come on girl,"
      },
      {
       "cyr": "ајде бре моме ти дома!",
       "lat": "ajde bre mome ti doma!",
       "en": "come on, girl, you go home!"
      },
      {
       "cyr": "- Нејќам бре луѓе, не идам,",
       "lat": "- Nejḱam bre luǵe, ne idam,",
       "en": "- I do not want to, folks, I am not going,"
