   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Лежал е Стојан, лежал е де,",
       "lat": "Ležal e Stojan, ležal e de,",
       "en": "Stojan lay ill, he lay ill, hey,"
      },
      {
       "cyr": "цели ми девет години, ајде,",
       "lat": "celi mi devet godini, ajde,",
       "en": "all of nine years, come on,"
      },
      {
       "cyr": "сменил е девет постели.",
       "lat": "smenil e devet posteli.",
       "en": "he changed nine beds."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На маќеа му се додеало, де",
       "lat": "Na maḱea mu se dodealo, de",
       "en": "His stepmother got fed up, hey,"
      },
      {
       "cyr": "та си на Стојан думаше, ајде:",
       "lat": "ta si na Stojan dumaše, ajde:",
       "en": "and said to Stojan, come on:"
      },
      {
       "cyr": "- Кажи си, сине, греове.",
       "lat": "- Kaži si, sine, greove.",
       "en": "- Tell your sins, son."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стојан на маќеа проговара:",
       "lat": "Stojan na maḱea progovara:",
       "en": "Stojan answers his stepmother:"
      },
      {
       "cyr": "- Греове ми са големи, ајде,",
       "lat": "- Greove mi sa golemi, ajde,",
       "en": "- My sins are great, come on,"
      },
      {
       "cyr": "големи, мале, длабоки.",
       "lat": "golemi, male, dlaboki.",
       "en": "great, mother, and deep."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ка бевме луди и млади, де,",
       "lat": "Ka bevme ludi i mladi, de,",
       "en": "When we were wild and young, hey,"
      },
      {
       "cyr": "таму в' гората одевме, ајде,",
       "lat": "tamu v' gorata odevme, ajde,",
       "en": "we went there into the forest, come on,"
      },
      {
       "cyr": "сретнавме до три клошари,",
       "lat": "sretnavme do tri klošari,",
       "en": "we met up to three vagrants,"
      },
      {
       "cyr": "арајме, та ги исклајме,",
       "lat": "arajme, ta gi isklajme,",
       "en": "we pounced and we slaughtered them,"
      },
      {
       "cyr": "исклајме, мале, всичките.",
       "lat": "isklajme, male, vsičkite.",
       "en": "we slaughtered them, mother, every one."
      }
     ]
    }
   ]
  }
 ],
