   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Море абер дојде,",
       "lat": "More aber dojde,",
       "en": "There is a note,"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe hey,"
      },
      {
       "cyr": "јас аскер да одам,",
       "lat": "jas asker da odam,",
       "en": "I should go to the army,"
      },
      {
       "cyr": "Ајше, до девет години.",
       "lat": "Ajše, do devet godini.",
       "en": "Ajshe, up to nine years."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море ти да станеш,",
       "lat": "More ti da staneš,",
       "en": "You should get up"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe hey,"
      },
      {
       "cyr": "рано ем порано,",
       "lat": "rano em porano,",
       "en": "very early"
      },
      {
       "cyr": "ајде во понеделник.",
       "lat": "ajde vo ponedelnik.",
       "en": "on Monday."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море да облечеш,",
       "lat": "More da oblečeš,",
       "en": "You should wear,"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe hey,"
      },
      {
       "cyr": "руба неносена,",
       "lat": "ruba nenosena,",
       "en": "brand new clothes,"
      },
      {
       "cyr": "ајде руво неносено.",
       "lat": "ajde ruvo nenoseno.",
       "en": "new clothes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ти да ме испратиш,",
       "lat": "Ti da me ispratiš,",
       "en": "You should walk me,"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe hey,"
      },
      {
       "cyr": "долу до јурија,",
       "lat": "dolu do jurija,",
       "en": "down to the meadow,"
      },
      {
       "cyr": "ајде долу до јурија.",
       "lat": "ajde dolu do jurija.",
       "en": "to the meadow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море изим давам,",
       "lat": "More izim davam,",
       "en": "I am giving you a permission,"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe hey,"
      },
      {
       "cyr": "ти да ме дочекаш,",
       "lat": "ti da me dočekaš,",
       "en": "for you to wait for me,"
      },
      {
       "cyr": "Ајше, до девет години.",
       "lat": "Ajše, do devet godini.",
       "en": "Ajshe, up to nine years."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море на десетта,",
       "lat": "More na desetta,",
       "en": "In the tenth year,"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe, hey,"
      },
      {
       "cyr": "ако ме дочекаш,",
       "lat": "ako me dočekaš,",
       "en": "if you still wait for me,"
      },
      {
       "cyr": "ајде, јас да си дојдам.",
       "lat": "ajde, jas da si dojdam.",
       "en": "I will come back."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас ќе ти донесам,",
       "lat": "Jas ḱe ti donesam,",
       "en": "I will give you,"
      },
      {
       "cyr": "Ајше ле мори,",
       "lat": "Ajše le mori,",
       "en": "Ajshe hey,"
      },
      {
       "cyr": "тебе голем бакшиш,",
       "lat": "tebe golem bakšiš,",
       "en": "a big fortune,"
      },
      {
       "cyr": "Ајше срмено елече.",
       "lat": "Ajše srmeno eleče.",
       "en": "Ajshe, a silver-embroidered vest."
      }
     ]
    }
   ]
