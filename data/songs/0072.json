      {
       "cyr": "Черешна се од корен корнеше,",
       "lat": "Čerešna se od koren korneše,",
       "en": "The cherry tree was pulled up by the root,"
      },
      {
       "cyr": "мома се од мајка делеше.",
       "lat": "moma se od majka deleše.",
       "en": "the girl was parting from her mother."
      },
      {
       "cyr": "Проштевај мајко, проштевај,",
       "lat": "Proštevaj majko, proštevaj,",
       "en": "Farewell, mother, farewell,"
      },
      {
       "cyr": "проштевајте мили роднини.",
       "lat": "proštevajte mili rodnini.",
       "en": "farewell, dear relatives."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Досега сум мајка слушала,",
       "lat": "Dosega sum majka slušala,",
       "en": "Until now I have listened to my mother,"
      },
      {
       "cyr": "отсега ќе слушам свекрва.",
       "lat": "otsega ḱe slušam svekrva.",
       "en": "from now on I will listen to my mother-in-law."
