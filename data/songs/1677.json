       "cyr": "денес-утре мамиш ме,",
       "lat": "denes-utre mamiš me,",
       "en": "stringing me along day after day,"
      },
      {
       "cyr": "ајде да се љубиме,",
       "lat": "ajde da se ljubime,",
       "en": "let's make love,"
      },
      {
