   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ноќта се гушка со зората",
       "lat": "Noḱta se guška so zorata",
       "en": "The night cuddles with the dawn"
      },
      {
       "cyr": "ние вино уште пиеме.",
       "lat": "nie vino ušte pieme.",
       "en": "we are still drinking wine."
      },
      {
       "cyr": "Кој ќе не види, ќе завиди",
       "lat": "Koj ḱe ne vidi, ḱe zavidi",
       "en": "Whoever sees us will envy us"
      },
      {
       "cyr": "ќе се празнат сите улици.",
       "lat": "ḱe se praznat site ulici.",
       "en": "all the streets will empty."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Остави грижи ти пред вратата",
       "lat": "Ostavi griži ti pred vratata",
       "en": "Leave your worries before the door,"
      },
      {
       "cyr": "тука важат само мераци.",
       "lat": "tuka važat samo meraci.",
       "en": "here only good cheer counts."
      },
      {
       "cyr": "Остави грижи ти пред вратата",
       "lat": "Ostavi griži ti pred vratata",
       "en": "Leave your worries before the door,"
      },
      {
       "cyr": "тука важат само мераци.",
       "lat": "tuka važat samo meraci.",
       "en": "here only good cheer counts."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Отворете душа другари,",
       "lat": "Otvorete duša drugari,",
       "en": "Open your soul, friends,"
      },
      {
       "cyr": "викнете песна бекриска",
       "lat": "viknete pesna bekriska",
       "en": "call out a bohemian song"
      },
      {
       "cyr": "само вино е вистината",
       "lat": "samo vino e vistinata",
       "en": "only wine is the truth"
      },
      {
       "cyr": "што ни може нас судбината?",
       "lat": "što ni može nas sudbinata?",
       "en": "what can fate do to us?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Затворете ладна меана",
       "lat": "Zatvorete ladna meana",
       "en": "Close the cold tavern"
      },
      {
       "cyr": "свири ја само нашата",
       "lat": "sviri ja samo našata",
       "en": "play only ours,"
      },
      {
       "cyr": "тој што не сака да биде сам",
       "lat": "toj što ne saka da bide sam",
       "en": "he who does not want to be alone"
      },
      {
       "cyr": "бара другар и во чашата.",
       "lat": "bara drugar i vo čašata.",
       "en": "seeks a friend even in the glass."
      }
     ]
    },
