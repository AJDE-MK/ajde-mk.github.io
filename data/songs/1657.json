 "versions": [
  {
   "label": "",
   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сношти си видов, мила мале,",
       "lat": "Snošti si vidov, mila male,",
       "en": "Last night I saw, my dear,",
       "en_mt": false
      },
      {
       "cyr": "белото Мариче,",
       "lat": "beloto Mariče,",
       "en": "white Maria,",
       "en_mt": false
      },
      {
       "cyr": "белото Мариче мале,",
       "lat": "beloto Mariče male,",
       "en": "white Maria, dear,",
       "en_mt": false
      },
      {
       "cyr": "нашето комшиче.",
       "lat": "našeto komšiče.",
       "en": "our neighbor.",
       "en_mt": false
      },
      {
       "cyr": "Тргнало е за водица, за водица,",
       "lat": "Trgnalo e za vodica, za vodica,",
       "en": "She has gone for water, for water,",
       "en_mt": false
      },
      {
       "cyr": "за студена.",
       "lat": "za studena.",
       "en": "for a cold one.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "С' нејни друшки, мила мале,",
       "lat": "S' nejni druški, mila male,",
       "en": "With her friends, my dear little one,",
       "en_mt": false
      },
      {
       "cyr": "друшки, убавици,",
       "lat": "druški, ubavici,",
       "en": "friends, beauties.",
       "en_mt": false
      },
      {
       "cyr": "Сè се моми, мила мале,",
       "lat": "Sè se momi, mila male,",
       "en": "All are maidens, my dear,",
       "en_mt": false
      },
      {
       "cyr": "моми над момите.",
       "lat": "momi nad momite.",
       "en": "maidens above maidens.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Штом ја видов, мила мале,",
       "lat": "Štom ja vidov, mila male,",
       "en": "As soon as I saw her, my dear,",
       "en_mt": false
      },
      {
       "cyr": "изгорев по неа.",
       "lat": "izgorev po nea.",
       "en": "my heart started burning for her.",
       "en_mt": false
      },
      {
       "cyr": "Најубава, мила мале,",
       "lat": "Najubava, mila male,",
       "en": "The most beautiful, my dear,",
       "en_mt": false
      },
      {
       "cyr": "сред момите најгиздава.",
       "lat": "sred momite najgizdava.",
       "en": "among maidens, the most flashy.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Лицето ѝ, мила мале,",
       "lat": "Liceto ì, mila male,",
       "en": "Her face, my dear,",
       "en_mt": false
      },
      {
       "cyr": "лично огледало.",
       "lat": "lično ogledalo.",
       "en": "is pretty as a mirror.",
       "en_mt": false
      },
      {
       "cyr": "Очите ѝ, мила мале,",
       "lat": "Očite ì, mila male,",
       "en": "Her eyes, my dear,",
       "en_mt": false
      },
      {
       "cyr": "црни черешови.",
       "lat": "crni čerešovi.",
       "en": "are like black cherries.",
       "en_mt": false
      },
      {
       "cyr": "Снагата ѝ, мила мале,",
       "lat": "Snagata ì, mila male,",
       "en": "Her body, my dear,",
       "en_mt": false
      },
      {
       "cyr": "т'нка, тополова.",
       "lat": "t'nka, topolova.",
       "en": "are thin as a poplar.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Иди ми побарај мале, белото Мариче,",
       "lat": "Idi mi pobaraj male, beloto Mariče,",
       "en": "Go and ask her for me, my dear,",
       "en_mt": false
      },
      {
       "cyr": "белото Мариче, мале, нашето комшиче.",
       "lat": "beloto Mariče, male, našeto komšiče.",
       "en": "white Maria, my neighbor.",
       "en_mt": false
      },
      {
       "cyr": "Ако не ми ја дадат, мале,",
       "lat": "Ako ne mi ja dadat, male,",
       "en": "If they don't give her to me, my dear,",
       "en_mt": false
      },
      {
       "cyr": "ќе јумрам за неа,",
       "lat": "ḱe jumram za nea,",
       "en": "I will die for her,",
       "en_mt": false
      },
      {
       "cyr": "ќе умрам за неја, мале,",
       "lat": "ḱe umram za neja, male,",
       "en": "I will die for her, my dear,",
       "en_mt": false
      },
      {
       "cyr": "гинеам по неа.",
       "lat": "gineam po nea.",
       "en": "I am wasting away for her.",
       "en_mt": true
      }
     ]
    }
   ]
  }
 ],
 "pending_english": false
}