 "versions": [
  {
   "label": "Version 1",
   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ветер да подујне",
       "lat": "Veter da podujne",
       "en": "Let the wind blow",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Помолила бога Маца, помолила бога,",
       "lat": "Pomolila boga Maca, pomolila boga,",
       "en": "Maca prayed to God, prayed to God:",
       "en_mt": false
      },
      {
       "cyr": "есен да ми дојде мамо, роса да зароси,",
       "lat": "esen da mi dojde mamo, rosa da zarosi,",
       "en": "Let autumn come, mother, let dew sprinkle,",
       "en_mt": false
      },
      {
       "cyr": "роса да зароси мамо, ветер да подувне.",
       "lat": "rosa da zarosi mamo, veter da poduvne.",
       "en": "let dew sprinkle, mother, let the wind blow,",
       "en_mt": false
      },
      {
       "cyr": "Ветер да подувне мамо, гранки да искрши,",
       "lat": "Veter da poduvne mamo, granki da iskrši,",
       "en": "let the wind blow, mother, to break the branches.",
       "en_mt": false
      },
      {
       "cyr": "гранки да искрши мамо, Вардар да препиши,",
       "lat": "granki da iskrši mamo, Vardar da prepiši,",
       "en": "To break the branches, mother, so that Vardar can transfer them,",
       "en_mt": false
      },
      {
       "cyr": "гранки да искрши мамо, Вардар да препиши.",
       "lat": "granki da iskrši mamo, Vardar da prepiši.",
       "en": "to break the branches, mother, so that Vardar can transfer them.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во Вардарот има мамо шарено сандаче,",
       "lat": "Vo Vardarot ima mamo šareno sandače,",
       "en": "In Vardar there is, mother, a colourful casket,",
       "en_mt": false
      },
      {
       "cyr": "во сандаче има мамо, рака од јунака,",
       "lat": "vo sandače ima mamo, raka od junaka,",
       "en": "inside the casket there is, mother, a hero's hand,",
       "en_mt": false
      },
      {
       "cyr": "на раката, мила мамо, бурма позлатена.",
       "lat": "na rakata, mila mamo, burma pozlatena.",
       "en": "on the hand, dear mother, a gilded wedding ring.",
       "en_mt": false
      },
      {
       "cyr": "На бурмата пишуваше име Димитрија,",
       "lat": "Na burmata pišuvaše ime Dimitrija,",
       "en": "On the ring it reads the name \"Dimitrija\",",
       "en_mt": false
      },
      {
       "cyr": "име Димитрија мамо, јунак македонски,",
       "lat": "ime Dimitrija mamo, junak makedonski,",
       "en": "the name Dimitrija, mother, a Macedonian hero,",
       "en_mt": false
      },
      {
       "cyr": "име Димитрија мамо, јунак македонски.",
       "lat": "ime Dimitrija mamo, junak makedonski.",
       "en": "the name Dimitrija, mother, a Macedonian hero.",
       "en_mt": false
      }
     ]
    }
   ]
  },
  {
   "label": "Version 2",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
