   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Синоќа дојдов од гурбет, џанам,",
       "lat": "Sinoḱa dojdov od gurbet, džanam,",
       "en": "Last night I came home from gurbet,",
       "en_mt": false
      },
      {
       "cyr": "змија ми влезе в' пазува.",
       "lat": "zmija mi vleze v' pazuva.",
       "en": "and a snake crawled into my bosom.",
       "en_mt": false
      },
      {
       "cyr": "- Подај ја, жено, раката, џанум,",
       "lat": "- Podaj ja, ženo, rakata, džanum,",
       "en": "- Put your arm in there, my wife,",
       "en_mt": false
      },
      {
       "cyr": "да ми извадиш змијата!",
       "lat": "da mi izvadiš zmijata!",
       "en": "and pull out the snake!",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Без рака не останувам, мажу,",
       "lat": "- Bez raka ne ostanuvam, mažu,",
       "en": "- I wouldn't lose my arm, my husband,",
       "en_mt": false
      },
      {
       "cyr": "без тебе ќе си останам,",
       "lat": "bez tebe ḱe si ostanam,",
       "en": "I would rather lose you,",
       "en_mt": false
      },
      {
       "cyr": "без рака не останувам, мажу,",
