   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Еве денес свадба правам,",
       "lat": "Eve denes svadba pravam,",
       "en": "Here today I am holding a wedding,"
      },
      {
       "cyr": "невеста ќе земам,",
       "lat": "nevesta ḱe zemam,",
       "en": "I will take a bride,"
      },
      {
       "cyr": "запеј, мила мајко,",
       "lat": "zapej, mila majko,",
       "en": "start singing, dear mother,"
      },
      {
       "cyr": "пејте мили сватови,",
       "lat": "pejte mili svatovi,",
       "en": "sing, dear wedding guests,"
      },
      {
       "cyr": "песна, мила мајко,",
       "lat": "pesna, mila majko,",
       "en": "a song, dear mother,"
      },
      {
       "cyr": "весела, мераклиска.",
       "lat": "vesela, merakliska.",
       "en": "cheerful, full of zest."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Весело да биде мајко,",
