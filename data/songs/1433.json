      {
       "cyr": "- Немој мајко, не колни ме",
       "lat": "- Nemoj majko, ne kolni me",
       "en": "- Mother, don’t curse me,"
      },
      {
       "cyr": "оти сум си млад спаија.",
       "lat": "oti sum si mlad spaija.",
       "en": "because I’m a young cavalryman."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Седумдесет села шетам,",
       "lat": "Sedumdeset sela šetam,",
       "en": "I’ve wandered through seventy villages,"
      },
      {
       "cyr": "осумдесет моми љубам,",
       "lat": "osumdeset momi ljubam,",
       "en": "I’ve loved eighty girls,"
      },
      {
       "cyr": "деведесет киски носам,",
       "lat": "devedeset kiski nosam,",
       "en": "I wear ninety bouquets,"
      },
      {
       "cyr": "сите киски повенале.",
       "lat": "site kiski povenale.",
       "en": "all the bouquets have withered."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Емен една ми останал,",
       "lat": "Emen edna mi ostanal,",
       "en": "Only one remained,"
      },
      {
       "cyr": "за сите си жалба немам,",
       "lat": "za site si žalba nemam,",
       "en": "for the others I feel no sadness,"
