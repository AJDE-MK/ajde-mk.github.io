   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Пукнала мајко мори, треснала,",
       "lat": "Puknala majko mori, tresnala,",
       "en": "May you be damned, mother,"
      },
      {
       "cyr": "зошто ме роди, мамо, сиромав?",
       "lat": "zošto me rodi, mamo, siromav?",
       "en": "why did you give birth to me poor, Mother?"
      },
      {
       "cyr": "Зошто ме роди, мамо, сиромав,",
       "lat": "Zošto me rodi, mamo, siromav,",
       "en": "Why did you give birth to me poor, Mother,"
      },
      {
       "cyr": "без пари, та и, мамо, без к'смет.",
       "lat": "bez pari, ta i, mamo, bez k'smet.",
       "en": "without money, and, mother, without luck?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па ме испрати Австралија,",
       "lat": "Pa me isprati Avstralija,",
       "en": "Then you sent me to Australia,"
      },
      {
       "cyr": "во славна града, мамо, Сиднеја.",
       "lat": "vo slavna grada, mamo, Sidneja.",
       "en": "to the famous city of Sydney, mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Излегов да се, мамо, прошетам,",
       "lat": "Izlegov da se, mamo, prošetam,",
       "en": "I went out for a walk, Mother,"
      },
      {
       "cyr": "низ сиднејските, мамо, сокаци.",
       "lat": "niz sidnejskite, mamo, sokaci.",
       "en": "through the streets of Sydney, mother."
      },
      {
       "cyr": "Там' сретнав двајца непознати,",
       "lat": "Tam' sretnav dvajca nepoznati,",
       "en": "There I met two strangers,"
      },
      {
       "cyr": "зборваја, мамо, македонски.",
       "lat": "zborvaja, mamo, makedonski.",
       "en": "they were speaking Macedonian, mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зборваја, мамо, македонски,",
       "lat": "Zborvaja, mamo, makedonski,",
       "en": "They were speaking Macedonian, mother,"
      },
      {
       "cyr": "љуто си мајки, леле, колнеа.",
       "lat": "ljuto si majki, lele, kolnea.",
       "en": "and bitterly cursing their mothers, oh my."
      },
      {
       "cyr": "Луто си мајки, леле, колнеа,",
       "lat": "Luto si majki, lele, kolnea,",
       "en": "Bitterly cursing their mothers, oh my,"
      },
      {
       "cyr": "крвави солзи, мамо, ронеа.",
       "lat": "krvavi solzi, mamo, ronea.",
       "en": "shedding bloody tears, mother."
      }
     ]
    },
    {
     "lines": [
