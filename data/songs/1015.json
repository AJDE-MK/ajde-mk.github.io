       "cyr": "Успала ми се Света Недела",
       "lat": "Uspala mi se Sveta Nedela",
       "en": "Holy Sunday fell asleep on me"
      },
      {
       "cyr": "меѓу два друма, два манастира.",
       "lat": "meǵu dva druma, dva manastira.",
       "en": "between two roads, two monasteries."
      },
      {
       "cyr": "Секој помина и ја буди,",
       "lat": "Sekoj pomina i ja budi,",
       "en": "Everyone passes and wakes her,"
      },
      {
       "cyr": "никој не моит да ја пробудит.",
       "lat": "nikoj ne moit da ja probudit.",
       "en": "no one can wake her."
