   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Зошто либе ме остави,",
       "lat": "Zošto libe me ostavi,",
       "en": "Why did you leave me, love,"
      },
      {
       "cyr": "друго момче си заљуби?",
       "lat": "drugo momče si zaljubi?",
       "en": "and fall in love with another boy?"
      },
      {
       "cyr": "Среќа, радост ми зеде,",
       "lat": "Sreḱa, radost mi zede,",
       "en": "You took my happiness, my joy,"
      },
      {
       "cyr": "мене младо заборави?",
       "lat": "mene mlado zaboravi?",
       "en": "and forgot me, so young?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Земи оган запали ме",
       "lat": "Zemi ogan zapali me",
       "en": "Take fire and set me alight"
      },
      {
       "cyr": "да се сторам пепел,",
       "lat": "da se storam pepel,",
       "en": "to turn me into ash,"
      },
      {
       "cyr": "не можам без тебе да живеам.",
       "lat": "ne možam bez tebe da živeam.",
       "en": "I cannot live without you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Многу ноќи не заспивам,",
       "lat": "Mnogu noḱi ne zaspivam,",
       "en": "Many nights I can't fall asleep,"
      },
      {
       "cyr": "спокој в' душа јас немам,",
       "lat": "spokoj v' duša jas nemam,",
       "en": "I have no peace in my soul,"
      },
      {
       "cyr": "со уста те колнам,",
       "lat": "so usta te kolnam,",
       "en": "with my mouth I curse you,"
      },
      {
       "cyr": "а во срце пак те љубам.",
       "lat": "a vo srce pak te ljubam.",
       "en": "and in my heart I still love you."
      }
     ]
    },
    {
