       "en": "Pray and beg, mother,",
       "en_mt": false
      },
      {
       "cyr": "моли се помоли.",
       "lat": "moli se pomoli.",
       "en": "pray and beg.",
       "en_mt": false
      },
      {
       "cyr": "Ветер да подујне, мајко мори,",
       "lat": "Veter da podujne, majko mori,",
       "en": "So that the wind blows, dear mother,",
       "en_mt": false
      },
      {
       "cyr": "магли да расече.",
       "lat": "magli da raseče.",
       "en": "to cut through the fogs.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
