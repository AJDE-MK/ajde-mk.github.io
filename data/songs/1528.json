   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Тапан чука, мила мамо,",
       "lat": "- Tapan čuka, mila mamo,",
       "en": "- The drum is beating, dear mother,"
      },
      {
       "cyr": "голем празник е, Илинден.",
       "lat": "golem praznik e, Ilinden.",
       "en": "it is a great feast, Ilinden."
      },
      {
       "cyr": "Кажи, кажи мила мамо,",
       "lat": "Kaži, kaži mila mamo,",
       "en": "Tell me, tell me, dear mother,"
      },
      {
       "cyr": "која руба да облечам?",
       "lat": "koja ruba da oblečam?",
       "en": "which clothes should I put on?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Облечи си, мила ќерко,",
       "lat": "- Obleči si, mila ḱerko,",
       "en": "- Put on, dear daughter,"
      },
      {
       "cyr": "бела свилена промена,",
       "lat": "bela svilena promena,",
       "en": "a white silk change of clothes,"
      },
      {
       "cyr": "престегни си, мила ќерко,",
       "lat": "prestegni si, mila ḱerko,",
       "en": "tighten, dear daughter,"
      },
      {
       "cyr": "твоја рамна половина.",
       "lat": "tvoja ramna polovina.",
       "en": "your slender waist."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Исчешлај си руса коса,",
       "lat": "Isčešlaj si rusa kosa,",
       "en": "Comb your fair hair,"
      },
      {
       "cyr": "набели си бело лице,",
       "lat": "nabeli si belo lice,",
       "en": "whiten your white face,"
      },
      {
       "cyr": "па си оди, мила ќерко,",
       "lat": "pa si odi, mila ḱerko,",
       "en": "and go, dear daughter,"
      },
      {
       "cyr": "среде село на орото.",
       "lat": "srede selo na oroto.",
       "en": "to the middle of the village to the dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да се фатиш, мила ќерко,",
       "lat": "Da se fatiš, mila ḱerko,",
       "en": "Join in, dear daughter,"
      },
      {
       "cyr": "на орото до момите,",
       "lat": "na oroto do momite,",
       "en": "the dance beside the girls,"
      },
      {
       "cyr": "па да гледаат ергените",
       "lat": "pa da gledaat ergenite",
       "en": "so that the bachelors look"
      },
      {
       "cyr": "и да пукат душманите.",
       "lat": "i da pukat dušmanite.",
       "en": "and the enemies burst with envy."
      }
     ]
    }
   ]
