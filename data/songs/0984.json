   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Стојане, луда делијо,",
       "lat": "Stojane, luda delijo,",
       "en": "Stojan, mad hero,"
      },
      {
       "cyr": "накачи гора зелена,",
       "lat": "nakači gora zelena,",
       "en": "climb the green mountain,"
      },
      {
       "cyr": "у гора село малечко,",
       "lat": "u gora selo malečko,",
       "en": "in the mountain there is a little village,"
      },
      {
       "cyr": "у село оро големо.",
       "lat": "u selo oro golemo.",
       "en": "in the village a big dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таа што играше на танец",
       "lat": "Taa što igraše na tanec",
       "en": "The one who danced in the dance"
      },
      {
       "cyr": "убава е, и не толку,",
       "lat": "ubava e, i ne tolku,",
       "en": "is beautiful, though not so very,"
      },
      {
       "cyr": "таа што играше до неја,",
       "lat": "taa što igraše do neja,",
       "en": "the one who danced next to her,"
      },
      {
       "cyr": "она ме мене изгоре.",
       "lat": "ona me mene izgore.",
       "en": "she is the one who burned me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Она ме мене разболе,",
       "lat": "Ona me mene razbole,",
       "en": "She made me ill,"
      },
      {
       "cyr": "срцето ми го попари,",
       "lat": "srceto mi go popari,",
       "en": "she scalded my heart,"
      },
      {
       "cyr": "фрли му китки прибере,",
       "lat": "frli mu kitki pribere,",
       "en": "she threw him a bouquet, he gathered it,"
      },
      {
       "cyr": "фрли му прстен не зема.",
       "lat": "frli mu prsten ne zema.",
       "en": "she threw him a ring, he did not take it."
      }
     ]
    }
   ]
