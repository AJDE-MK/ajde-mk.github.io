   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Тешка е била борба за слобода,",
       "lat": "Teška e bila borba za sloboda,",
       "en": "Hard was the struggle for freedom,"
      },
      {
       "cyr": "борба за слобода, за Македонија.",
       "lat": "borba za sloboda, za Makedonija.",
       "en": "the struggle for freedom, for Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми го нападнаа градот Кратово,",
       "lat": "Mi go napadnaa gradot Kratovo,",
       "en": "They attacked the town of Kratovo,"
      },
      {
       "cyr": "градот Кратово, село Шлегово.",
       "lat": "gradot Kratovo, selo Šlegovo.",
       "en": "the town of Kratovo, the village of Shlegovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па ми отворија оган и пламен,",
       "lat": "Pa mi otvorija ogan i plamen,",
       "en": "And they opened fire and flame,"
      },
      {
       "cyr": "оган и пламен над Здравчин Камен.",
       "lat": "ogan i plamen nad Zdravčin Kamen.",
       "en": "fire and flame above Zdravchin Kamen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму загинаа двајца другари,",
       "lat": "Tamu zaginaa dvajca drugari,",
       "en": "There two comrades fell,"
      },
      {
       "cyr": "двајца другари од Шопско Рударе.",
       "lat": "dvajca drugari od Šopsko Rudare.",
       "en": "two comrades from Shopsko Rudare."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога загинаа, тие извикнаа:",
       "lat": "Koga zaginaa, tie izviknaa:",
       "en": "When they fell, they cried out:"
      },
      {
       "cyr": "- ние загинавме за Македонија.",
       "lat": "- nie zaginavme za Makedonija.",
       "en": "- we died for Macedonia."
      }
     ]
    }
   ]
