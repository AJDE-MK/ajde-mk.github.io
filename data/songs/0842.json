 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Судбо моја, судбино",
       "lat": "Sudbo moja, sudbino",
       "en": "My fate, fate,"
      },
      {
       "cyr": "судбо, ти невернице,",
       "lat": "sudbo, ti nevernice,",
       "en": "fate, you unfaithful,"
      },
      {
       "cyr": "што си судбо ме однела",
       "lat": "što si sudbo me odnela",
       "en": "because you fate took me"
      },
      {
       "cyr": "земја непозната.",
       "lat": "zemja nepoznata.",
       "en": "to an unknown country."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Земја непозната, судбо,",
       "lat": "Zemja nepoznata, sudbo,",
       "en": "Unknown country, fate,"
      },
      {
       "cyr": "при луѓе - нелуѓе,",
       "lat": "pri luǵe - neluǵe,",
       "en": "next to people - bad people,"
      },
      {
       "cyr": "ни сонцето, ни месецот",
       "lat": "ni sonceto, ni mesecot",
       "en": "neighter the Sun, nor the Moon"
      },
      {
       "cyr": "не ми се познати.",
       "lat": "ne mi se poznati.",
       "en": "are known to me here."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Земи судбо, однеси ме",
       "lat": "Zemi sudbo, odnesi me",
       "en": "Come on fate, take me"
      },
      {
       "cyr": "при мојата мајка,",
       "lat": "pri mojata majka,",
       "en": "to see my mother"
      },
      {
       "cyr": "да ја прашам, судбо клета",
       "lat": "da ja prašam, sudbo kleta",
       "en": "and ask her, damned fate,"
      },
      {
       "cyr": "што сум ѝ згрешила,",
       "lat": "što sum ì zgrešila,",
       "en": "what did I do wrong to her,"
      },
      {
       "cyr": "та што ме омажи, судбо,",
       "lat": "ta što me omaži, sudbo,",
       "en": "so she married me, fate,"
      },
      {
       "cyr": "земја непозната?",
       "lat": "zemja nepoznata?",
       "en": "into an unknown land?"
      }
     ]
    }
   ]
  }
 ],
