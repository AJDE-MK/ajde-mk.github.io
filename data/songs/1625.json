   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Во поле зелено, кај што Вардар тече,",
       "lat": "Vo pole zeleno, kaj što Vardar teče,",
       "en": "In the green field, where the Vardar flows,"
      },
      {
       "cyr": "песна се слуша од утро до вечер.",
       "lat": "pesna se sluša od utro do večer.",
       "en": "a song is heard from morning till evening."
      },
      {
       "cyr": "Таму пее девојче,",
       "lat": "Tamu pee devojče,",
       "en": "There a girl is singing,"
      },
      {
       "cyr": "девојче Македонче,",
       "lat": "devojče Makedonče,",
       "en": "a little Macedonian girl,"
      },
      {
       "cyr": "чисто како роса,",
       "lat": "čisto kako rosa,",
       "en": "pure as dew,"
      },
      {
       "cyr": "со црна долга коса.",
       "lat": "so crna dolga kosa.",
       "en": "with long black hair."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ој убава Македонко,",
       "lat": "Oj ubava Makedonko,",
       "en": "Oh beautiful Macedonian girl,"
      },
      {
       "cyr": "црно око, алтан мој,",
       "lat": "crno oko, altan moj,",
       "en": "black eye, my gold,"
      },
      {
       "cyr": "срце ти ми зеде, мори,",
       "lat": "srce ti mi zede, mori,",
       "en": "you took my heart, hey,"
      },
      {
       "cyr": "со погледот твој.",
       "lat": "so pogledot tvoj.",
       "en": "with your gaze."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во коса венче од босилче,",
       "lat": "Vo kosa venče od bosilče,",
       "en": "In her hair a wreath of basil,"
      },
      {
       "cyr": "во рака - китка бело цвеќе.",
       "lat": "vo raka - kitka belo cveḱe.",
       "en": "in her hand a bunch of white flowers."
      },
      {
       "cyr": "Ѝ понудив скапа свила,",
       "lat": "Ì ponudiv skapa svila,",
       "en": "I offered her precious silk,"
      },
      {
       "cyr": "вели: „Јас сум чесна,",
       "lat": "veli: „Jas sum česna,",
       "en": "she says: \"I am honest,"
      },
      {
       "cyr": "мајка, татко имам јас.",
       "lat": "majka, tatko imam jas.",
       "en": "I have a mother and a father."
      },
      {
       "cyr": "Ќе дојдеш од нив да ме земеш,",
       "lat": "Ḱe dojdeš od niv da me zemeš,",
       "en": "You will come to take me from them,"
      },
      {
       "cyr": "тоа адет е кај нас.“",
       "lat": "toa adet e kaj nas.“",
       "en": "that is the custom with us.\""
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ој убава Македонко,",
       "lat": "Oj ubava Makedonko,",
       "en": "Oh beautiful Macedonian girl,"
      },
      {
       "cyr": "божји ти си дар,",
       "lat": "božji ti si dar,",
       "en": "you are God's gift,"
      },
      {
       "cyr": "кое момче ќе те земе,",
       "lat": "koe momče ḱe te zeme,",
       "en": "the boy who takes you,"
      },
      {
       "cyr": "тоа ќе е цар.",
       "lat": "toa ḱe e car.",
       "en": "he will be a king."
      }
     ]
    }
