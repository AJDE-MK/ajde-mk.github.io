   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Јовано, Јованке",
       "lat": "Jovano, Jovanke",
       "en": "Jovano, Jovanke"
      },
      {
       "cyr": "крај Вардарот седиш, мори",
       "lat": "kraj Vardarot sediš, mori",
       "en": "you are sitting by the River Vardar,"
      },
      {
       "cyr": "бело платно белиш",
       "lat": "belo platno beliš",
       "en": "washing the white linens"
      },
      {
       "cyr": "бело платно белиш, душо",
       "lat": "belo platno beliš, dušo",
       "en": "washing the white linens, dear"
      },
      {
       "cyr": "сè нагоре гледаш.",
       "lat": "sè nagore gledaš.",
       "en": "and looking up all the time."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јовано, Јованке",
       "lat": "Jovano, Jovanke",
       "en": "Jovano, Jovanke"
      },
      {
       "cyr": "јас те тебе чекам, мори",
       "lat": "jas te tebe čekam, mori",
       "en": "I am waiting for you"
      },
      {
       "cyr": "дома да ми дојдеш",
       "lat": "doma da mi dojdeš",
       "en": "to come to my home"
      },
      {
       "cyr": "а ти не доаѓаш, душо",
       "lat": "a ti ne doaǵaš, dušo",
       "en": "but you are not coming, dear"
      },
      {
       "cyr": "срце мое Јовано.",
       "lat": "srce moe Jovano.",
       "en": "my heart, Jovano."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јовано, Јованке",
       "lat": "Jovano, Jovanke",
       "en": "Jovano, Jovanke"
      },
      {
       "cyr": "твојата мајка, мори",
       "lat": "tvojata majka, mori",
       "en": "your mother"
      },
      {
       "cyr": "тебе не те пушта",
       "lat": "tebe ne te pušta",
       "en": "is not letting you"
      },
      {
       "cyr": "кај мене да дојдиш, душо",
       "lat": "kaj mene da dojdiš, dušo",
       "en": "to come to me, dear"
      },
      {
       "cyr": "срце мое Јовано.",
       "lat": "srce moe Jovano.",
       "en": "my heart, Jovano."
      }
     ]
    }
   ]
  }
 ],
