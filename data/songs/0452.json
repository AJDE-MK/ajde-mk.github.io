   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Зајди, зајди јасно сонце,",
       "lat": "Zajdi, zajdi jasno sonce,",
       "en": "Set, set, clear Sun,"
      },
      {
       "cyr": "зајди помрачи се,",
       "lat": "zajdi pomrači se,",
       "en": "set to dim"
      },
      {
       "cyr": "и ти јасна ле месечино,",
       "lat": "i ti jasna le mesečino,",
       "en": "and you bright Moon,"
      },
      {
       "cyr": "бегај удави се.",
       "lat": "begaj udavi se.",
       "en": "begone, drown yourself."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Црнеј горо, црнеј сестро,",
       "lat": "Crnej goro, crnej sestro,",
       "en": "Blacken forest, blacken sister,"
      },
      {
       "cyr": "двата да црнејме,",
       "lat": "dvata da crnejme,",
       "en": "let's both blacken."
      },
      {
       "cyr": "ти за твојте лисја ле горо,",
       "lat": "ti za tvojte lisja le goro,",
       "en": "You, for your leaves, forest,"
      },
      {
       "cyr": "јас за мојта младост.",
       "lat": "jas za mojta mladost.",
       "en": "I, for my youth."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Твојте лисја горо сестро,",
       "lat": "Tvojte lisja goro sestro,",
       "en": "Your leaves, forest, sister,"
      },
      {
       "cyr": "пак ќе ти се вратат,",
       "lat": "pak ḱe ti se vratat,",
       "en": "will come back again."
      },
      {
       "cyr": "а мојата младост ле горо,",
       "lat": "a mojata mladost le goro,",
       "en": "My youth, forest, sister"
      },
      {
       "cyr": "нема да се врати.",
       "lat": "nema da se vrati.",
       "en": "will not come back."
      }
     ]
    }
   ]
  }
 ],
