   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Излегол Селман, прошетал џанам",
       "lat": "Izlegol Selman, prošetal džanam",
       "en": "Selman went out, strolled, my dear,"
      },
      {
       "cyr": "низ едно село море, каурско.",
       "lat": "niz edno selo more, kaursko.",
       "en": "through a village, hey, of the infidels."
      },
      {
       "cyr": "Одвел си Селман, одвел си џанам",
       "lat": "Odvel si Selman, odvel si džanam",
       "en": "Selman took away, took away, my dear,"
      },
      {
       "cyr": "до девет бели море, анами.",
       "lat": "do devet beli more, anami.",
       "en": "up to nine white, hey, ladies."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите ги Селман даваше џанам",
       "lat": "Site gi Selman davaše džanam",
       "en": "Selman gave them all away, my dear,"
      },
      {
       "cyr": "за една бела море каурка.",
       "lat": "za edna bela more kaurka.",
       "en": "for one white, hey, infidel girl."
      },
      {
       "cyr": "Мајка си Селман караше џанам:",
       "lat": "Majka si Selman karaše džanam:",
       "en": "Selman's mother scolded him, my dear:"
      },
      {
       "cyr": "- Дејгиди Селман море, будала!",
       "lat": "- Dejgidi Selman more, budala!",
       "en": "- Shame on you, Selman, hey, you fool!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дејгиди Селман, будала џанам,",
       "lat": "Dejgidi Selman, budala džanam,",
       "en": "Shame on you, Selman, you fool, my dear,"
      },
      {
       "cyr": "дека се чуло Селман, видело",
