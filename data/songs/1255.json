      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Фабриките високи, модерни,",
       "lat": "Fabrikite visoki, moderni,",
       "en": "Tall, modern factories,",
       "en_mt": false
      },
      {
       "cyr": "улиците долги, ем големи,",
       "lat": "ulicite dolgi, em golemi,",
       "en": "long, wide streets,",
       "en_mt": false
      },
      {
       "cyr": "парковите широки, зелени,",
       "lat": "parkovite široki, zeleni,",
       "en": "large green parks,",
       "en_mt": false
      },
      {
       "cyr": "ѓул трендафил куќички шарени.",
       "lat": "ǵul trendafil kuḱički šareni.",
       "en": "colorful houses with rose gardens.",
       "en_mt": false
      },
      {
       "cyr": "Кочанското поле вода пие,",
       "lat": "Kočanskoto pole voda pie,",
       "en": "The valley drinks the water",
       "en_mt": false
      },
      {
       "cyr": "езерото Гратче што му лие.",
       "lat": "ezeroto Gratče što mu lie.",
       "en": "pouring from the Lake Gratche.",
       "en_mt": false
      }
     ]
    },
