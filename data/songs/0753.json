   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Во старата кафеана",
       "lat": "Vo starata kafeana",
       "en": "In the old tavern"
      },
      {
       "cyr": "само ние гости сме.",
       "lat": "samo nie gosti sme.",
       "en": "we are the only guests."
      },
      {
       "cyr": "Мала маса, интимна,",
       "lat": "Mala masa, intimna,",
       "en": "A small, intimate table,"
      },
      {
       "cyr": "а на маса рози две.",
       "lat": "a na masa rozi dve.",
       "en": "and on the table two roses."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Музиканти тивко свират",
       "lat": "Muzikanti tivko svirat",
       "en": "Musicians play softly,"
      },
      {
       "cyr": "бавно гори свеќата,",
       "lat": "bavno gori sveḱata,",
       "en": "the candle burns slowly,"
      },
      {
       "cyr": "вљубено се гледаме,",
       "lat": "vljubeno se gledame,",
       "en": "we gaze at each other in love,"
      },
      {
       "cyr": "не се крие среќата.",
       "lat": "ne se krie sreḱata.",
       "en": "happiness is not hidden."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Виното е опојно,",
       "lat": "Vinoto e opojno,",
       "en": "The wine is intoxicating,"
      },
      {
       "cyr": "песната е певлива,",
       "lat": "pesnata e pevliva,",
       "en": "the song is singable,"
      },
      {
       "cyr": "но да згрее срца две",
       "lat": "no da zgree srca dve",
       "en": "but to warm two hearts"
      },
      {
       "cyr": "може само љубовта.",
