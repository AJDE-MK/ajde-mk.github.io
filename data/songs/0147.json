   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Река газит малој моме,",
       "lat": "Reka gazit maloj mome,",
       "en": "A young girl wades through the river,"
      },
      {
       "cyr": "бели му се нози,",
       "lat": "beli mu se nozi,",
       "en": "Her legs are white,"
      },
      {
       "cyr": "в' роци носит кошничица",
       "lat": "v' roci nosit košničica",
       "en": "In her hands, she carries a basket"
      },
      {
       "cyr": "полна с' љубичица.",
       "lat": "polna s' ljubičica.",
       "en": "Full of violets."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се с'рефије мома и момче,",
       "lat": "Se s'refije moma i momče,",
       "en": "A girl and a boy meet"
      },
      {
       "cyr": "во тесно сокаче.",
       "lat": "vo tesno sokače.",
       "en": "In a narrow alley."
      },
      {
       "cyr": "Проговара младој моме,",
       "lat": "Progovara mladoj mome,",
       "en": "The young girl speaks"
      },
      {
       "cyr": "на младо јуначе:",
       "lat": "na mlado junače:",
       "en": "to the young lad:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- „Дал' на војска одиш лудо,",
       "lat": "- „Dal' na vojska odiš ludo,",
       "en": "- “Are you going to the army, crazy one,"
      },
      {
       "cyr": "ил' од војска идеш“?",
       "lat": "il' od vojska ideš“?",
       "en": "Or are you coming back from the army?”"
      },
      {
       "cyr": "- „Нит' на војска одам, лудо,",
       "lat": "- „Nit' na vojska odam, ludo,",
       "en": "- “Neither am I going to the army, crazy one,"
      },
      {
       "cyr": "ни од војска идам,",
       "lat": "ni od vojska idam,",
       "en": "Nor am I coming back from the army,"
      },
      {
       "cyr": "тук' сум било на ат-пазар",
       "lat": "tuk' sum bilo na at-pazar",
       "en": "I was just at the horse market"
      },
      {
       "cyr": "коња да си купам“.",
       "lat": "konja da si kupam“.",
       "en": "To buy a horse.”"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пружи рока, лудој младо,",
       "lat": "Pruži roka, ludoj mlado,",
       "en": "Give me your hand, foolish young one"
      },
      {
       "cyr": "качи ме на коња.",
       "lat": "kači me na konja.",
       "en": "Lift me onto the horse."
      },
      {
       "cyr": "Качи ме на коња лудо,",
       "lat": "Kači me na konja ludo,",
       "en": "Lift me onto the horse, foolish young one,"
      },
      {
       "cyr": "однеси ме дома.",
       "lat": "odnesi me doma.",
       "en": "And take me home."
      },
      {
       "cyr": "Однеси ме дома, лудо,",
       "lat": "Odnesi me doma, ludo,",
       "en": "Take me home, foolish one,"
      },
      {
       "cyr": "в' шарена одаја.",
       "lat": "v' šarena odaja.",
       "en": "To a colorful room."
      },
      {
       "cyr": "В' шарена одаја, лудо,",
       "lat": "V' šarena odaja, ludo,",
       "en": "To a colorful room, foolish one,"
      },
      {
       "cyr": "на мека постела.",
       "lat": "na meka postela.",
       "en": "To a soft bed."
      },
      {
       "cyr": "Татко вети променица1,",
