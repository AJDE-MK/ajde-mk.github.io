      {
       "cyr": "Таму далеку",
       "lat": "Tamu daleku",
       "en": "Far away there"
      },
      {
       "cyr": "вода ми дотече, од бунарот,",
       "lat": "voda mi doteče, od bunarot,",
       "en": "the water came flowing, from the well,"
      },
      {
       "cyr": "и на бунарот,",
       "lat": "i na bunarot,",
       "en": "and at the well"
      },
      {
       "cyr": "анамче ми седи, платно ми бели.",
       "lat": "anamče mi sedi, platno mi beli.",
       "en": "a mother sits, bleaching linen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оздола иде",
       "lat": "Ozdola ide",
       "en": "From below comes"
      },
      {
       "cyr": "едно лудо, младо, неженето,",
       "lat": "edno ludo, mlado, neženeto,",
       "en": "a young fellow, unmarried,"
      },
      {
       "cyr": "и на анамче,",
       "lat": "i na anamče,",
       "en": "and to the mother"
      },
      {
       "cyr": "вели ем говори: - Аман, анамче.",
       "lat": "veli em govori: - Aman, anamče.",
       "en": "he says and speaks: - Mercy, mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дали го даваш,",
