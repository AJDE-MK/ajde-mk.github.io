   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Биљана оро водеше,",
       "lat": "Biljana oro vodeše,",
       "en": "Biljana led the dance,"
      },
      {
       "cyr": "Никола с’камен фрлаше.",
       "lat": "Nikola s’kamen frlaše.",
       "en": "Nikola was casting stones,"
      },
      {
       "cyr": "Биљана што му збореше:",
       "lat": "Biljana što mu zboreše:",
       "en": "for what Biljana was saying to him:"
      },
      {
       "cyr": "- Еј, море Никола.",
       "lat": "- Ej, more Nikola.",
       "en": "- Hey, Nikola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тук' да си зе'иш вдо'ица,",
       "lat": "Tuk' da si ze'iš vdo'ica,",
       "en": "You shall marry a widow"
      },
      {
       "cyr": "со дванадесет сираци,",
       "lat": "so dvanadeset siraci,",
       "en": "with twelve orphans,"
      },
      {
       "cyr": "со тринадесет чифлици,",
       "lat": "so trinadeset čiflici,",
       "en": "with thirteen farmsteads,"
      },
      {
       "cyr": "еј, море Никола.",
       "lat": "ej, more Nikola.",
       "en": "hey, Nikola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Како Биљана му рече,",
       "lat": "Kako Biljana mu reče,",
       "en": "As Biljana talked to him,"
      },
      {
       "cyr": "Никола ми се наљути,",
       "lat": "Nikola mi se naljuti,",
       "en": "Nikola got mad,"
      },
      {
       "cyr": "изшетал што ми прошетал,",
       "lat": "izšetal što mi prošetal,",
       "en": "he traveled and explored,"
      },
      {
       "cyr": "еј, море Никола.",
       "lat": "ej, more Nikola.",
       "en": "hey, Nikola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Триес' девет бели градови,",
       "lat": "Tries' devet beli gradovi,",
       "en": "Thirty nine famed cities,"
      },
      {
       "cyr": "да барат лепа девојка.",
       "lat": "da barat lepa devojka.",
       "en": "to find a beautiful girl."
      },
      {
       "cyr": "Нигде девојка не најде,",
       "lat": "Nigde devojka ne najde,",
       "en": "Nowhere did he find such a girl,"
      },
      {
       "cyr": "еј, море Никола.",
       "lat": "ej, more Nikola.",
       "en": "hey, Nikola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Туку си најде вдо'ице",
       "lat": "Tuku si najde vdo'ice",
       "en": "Rather he found a widow"
      },
      {
       "cyr": "со дванадесет сираци,",
       "lat": "so dvanadeset siraci,",
       "en": "with twelve orphans,"
      },
      {
       "cyr": "со тринадесет чифлици,",
       "lat": "so trinadeset čiflici,",
       "en": "with thirteen farmsteads,"
      },
      {
       "cyr": "еј, море Никола.",
       "lat": "ej, more Nikola.",
       "en": "hey, Nikola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Никола, море Никола,",
       "lat": "Nikola, more Nikola,",
       "en": "Nikola, hey, Nikola,"
      },
      {
       "cyr": "фрлија си камен, не фрљаш",
       "lat": "frlija si kamen, ne frljaš",
       "en": "cast a stone, or don’t,"
      },
      {
       "cyr": "ти со Биљана не с' земаш.",
       "lat": "ti so Biljana ne s' zemaš.",
       "en": "you’ll never marry Biljana."
      }
     ]
    }
   ]
