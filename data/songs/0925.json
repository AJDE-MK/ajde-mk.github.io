   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Девојче, море девојче",
       "lat": "- Devojče, more devojče",
       "en": "- Girl, hey girl,"
      },
      {
       "cyr": "не стој доцна на порте.",
       "lat": "ne stoj docna na porte.",
       "en": "don't stand late at the gate."
      },
      {
       "cyr": "Не стој доцна на порте,",
       "lat": "Ne stoj docna na porte,",
       "en": "Don't stand late at the gate,"
      },
      {
       "cyr": "не пребирај ергене.",
       "lat": "ne prebiraj ergene.",
       "en": "don't pick over the bachelors."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе излезне мајка ти,",
       "lat": "Ḱe izlezne majka ti,",
       "en": "Your mother will come out,"
      },
      {
       "cyr": "мајка ти, лудо, татко ти.",
       "lat": "majka ti, ludo, tatko ti.",
       "en": "your mother, silly, your father."
      },
      {
       "cyr": "Мајка ти ќе те повика,",
       "lat": "Majka ti ḱe te povika,",
       "en": "Your mother will call you in,"
      },
      {
       "cyr": "татко ти ќе те натепа.",
       "lat": "tatko ti ḱe te natepa.",
       "en": "your father will beat you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Еј море момче, будало,",
       "lat": "- Ej more momče, budalo,",
       "en": "- Hey boy, you fool,"
      },
      {
       "cyr": "мене не ме караја,",
       "lat": "mene ne me karaja,",
       "en": "don't scold me,"
      },
      {
       "cyr": "оти сум си навреме,",
       "lat": "oti sum si navreme,",
       "en": "for I am in good time,"
      },
      {
       "cyr": "навреме мома за женење.",
       "lat": "navreme moma za ženenje.",
       "en": "in good time, a girl ready for marrying."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Кога си моме за женење,",
