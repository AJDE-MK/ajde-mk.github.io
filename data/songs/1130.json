       "en": "it has ripened, it has lain down low,"
      },
      {
       "cyr": "ај жетвари да жнееме,",
       "lat": "aj žetvari da žneeme,",
       "en": "come, reapers, let us reap,"
      },
      {
       "cyr": "да жнееме, да береме.",
       "lat": "da žneeme, da bereme.",
       "en": "let us reap, let us gather."
      }
