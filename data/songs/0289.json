   "stanzas": [
    {
     "lines": [
      {
       "cyr": "(Кандисуј бре лудо младо)",
       "lat": "(Kandisuj bre ludo mlado)",
       "en": "(Agree, crazy young lad)"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Голем мерак мила мајко,",
       "lat": "Golem merak mila majko,",
       "en": "A big desire, dear mother,"
      },
      {
       "cyr": "скоро јас ќе умрам,",
       "lat": "skoro jas ḱe umram,",
       "en": "I'll almost die,"
      },
      {
       "cyr": "два мерака, два севдаха,",
       "lat": "dva meraka, dva sevdaha,",
       "en": "two desires, two sorrows,"
      },
      {
       "cyr": "скоро одат во гроба.",
       "lat": "skoro odat vo groba.",
       "en": "will soon go to the grave."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што да правам, што да чинам",
       "lat": "Što da pravam, što da činam",
       "en": "What should I do,"
      },
      {
       "cyr": "кога е лоша мајка ми?",
       "lat": "koga e loša majka mi?",
       "en": "when my mother is evil,"
      },
      {
       "cyr": "Не ми дава да заљубам",
       "lat": "Ne mi dava da zaljubam",
       "en": "she won't let me love"
      },
      {
       "cyr": "од личните ергени.",
       "lat": "od ličnite ergeni.",
       "en": "those handsome unmarried young men."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кандисуј бре лудо младо",
       "lat": "Kandisuj bre ludo mlado",
       "en": "Agree, hey crazy young lad,"
      },
      {
       "cyr": "што ти дава мајка ми.",
       "lat": "što ti dava majka mi.",
       "en": "to whatever my mother offers to you,"
      },
      {
       "cyr": "Мама дава, лудо младо,",
       "lat": "Mama dava, ludo mlado,",
       "en": "she offers, crazy lad,"
      },
      {
       "cyr": "три санд'ка бовчалок.",
       "lat": "tri sand'ka bovčalok.",
       "en": "three cases of dowry."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кандисуј бре лудо младо",
       "lat": "Kandisuj bre ludo mlado",
       "en": "Agree, hey crazy lad,"
      },
      {
       "cyr": "што ти дава татко ми.",
       "lat": "što ti dava tatko mi.",
       "en": "to whatever my father offers to you,"
      },
      {
       "cyr": "Тато дава, лудо младо,",
       "lat": "Tato dava, ludo mlado,",
       "en": "my father offers, crazy lad,"
      },
      {
       "cyr": "триста лири жолтици.",
       "lat": "trista liri žoltici.",
       "en": "three hundred gold liras."
      }
     ]
    },
    {
     "lines": [
