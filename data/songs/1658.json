 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Јано мори, меанџике,",
       "lat": "- Jano mori, meandžike,",
       "en": "- Jana, dear innkeeper,"
      },
      {
       "cyr": "голем мерак имам, Јано,",
       "lat": "golem merak imam, Jano,",
       "en": "I have a great desire, Jana,"
      },
      {
       "cyr": "тебе да те гледам",
       "lat": "tebe da te gledam",
       "en": "to look at you"
      },
      {
       "cyr": "како служиш Јано, рујно вино",
       "lat": "kako služiš Jano, rujno vino",
       "en": "serving Jana, some red wine"
      },
      {
       "cyr": "со твоите Јано, бели раце.",
       "lat": "so tvoite Jano, beli race.",
       "en": "with your Jana, white hands."
      },
      {
       "cyr": "Ти си кршиш, Јано, рамна снага,",
       "lat": "Ti si kršiš, Jano, ramna snaga,",
       "en": "You are moving graciously, Jana, your tall body,"
      },
      {
       "cyr": "бело лице, Јано, насмеано.",
       "lat": "belo lice, Jano, nasmeano.",
       "en": "and your white face, Jana, smiling."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Млад Ѓорѓија море, мераклија,",
       "lat": "- Mlad Ǵorǵija more, meraklija,",
       "en": "- Young Gjorgji, bon vivant,"
      },
      {
       "cyr": "ти што пиеш рујно вино",
       "lat": "ti što pieš rujno vino",
       "en": "you who drink red wine"
      },
      {
       "cyr": "стани да си одиш.",
       "lat": "stani da si odiš.",
       "en": "get up and go."
      },
      {
       "cyr": "Од гледање Ѓорѓи фајде нема,",
       "lat": "Od gledanje Ǵorǵi fajde nema,",
       "en": "There is no benefit from looking at me Gjorgji,"
      },
      {
       "cyr": "од мераци Ѓорѓи празни раце,",
       "lat": "od meraci Ǵorǵi prazni race,",
       "en": "from that desire, Gjorgji, you'll be empty-handed,"
      },
      {
       "cyr": "јазе сум си, Ѓорѓи, посвршена,",
       "lat": "jaze sum si, Ǵorǵi, posvršena,",
       "en": "I am already, Gjorgji, engaged,"
      },
      {
       "cyr": "две години среќно омажена.",
       "lat": "dve godini sreḱno omažena.",
       "en": "and happily married for two years."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Јано мори, меанџике,",
       "lat": "- Jano mori, meandžike,",
       "en": "- Jana, dear innkeeper,"
      },
      {
       "cyr": "дај донеси уште една,",
       "lat": "daj donesi ušte edna,",
       "en": "bring me another one,"
      },
      {
       "cyr": "отров стави, отрови ме.",
       "lat": "otrov stavi, otrovi me.",
       "en": "put some poison in it, poison me."
      },
      {
       "cyr": "Да не одам Јано во меана,",
       "lat": "Da ne odam Jano vo meana,",
       "en": "So that I don't go to the tavern,"
      },
      {
       "cyr": "да не гледам твоја рамна снага,",
       "lat": "da ne gledam tvoja ramna snaga,",
       "en": "so that I don't see your tall body,"
      },
      {
       "cyr": "да не горам Јано од мераци,",
       "lat": "da ne goram Jano od meraci,",
       "en": "so that I don't burn Jana from desire,"
      },
      {
       "cyr": "да си умрам Јано, не ме мачи.",
       "lat": "da si umram Jano, ne me mači.",
       "en": "so that I die, Jana, don't torment me."
      }
     ]
    }
   ]
  }
 ],
