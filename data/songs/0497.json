 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Ацано млада невесто,",
       "lat": "- Acano mlada nevesto,",
       "en": "- Acana, young bride,"
      },
      {
       "cyr": "што доцкан седиш на порта,",
       "lat": "što dockan sediš na porta,",
       "en": "why do you sit late at the gate,"
      },
      {
       "cyr": "нели те тебе срамота?",
       "lat": "neli te tebe sramota?",
       "en": "are you not ashamed?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми поминуваат еснафи,",
       "lat": "Mi pominuvaat esnafi,",
       "en": "Guild craftsmen pass by me,"
      },
      {
       "cyr": "ем тија пусти лебари,",
       "lat": "em tija pusti lebari,",
       "en": "and those wretched bakers,"
      },
      {
       "cyr": "ем тија чапкан касапи.",
       "lat": "em tija čapkan kasapi.",
       "en": "and those butchers too."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Со око ти намигнуваат,",
       "lat": "So oko ti namignuvaat,",
       "en": "They wink at you with their eyes,"
      },
      {
       "cyr": "со глава ти навртуваат,",
       "lat": "so glava ti navrtuvaat,",
       "en": "they turn their heads toward you,"
      },
      {
       "cyr": "ќе ми те тебе прелажат.",
       "lat": "ḱe mi te tebe prelažat.",
       "en": "they will deceive you for me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дејгиди, Ѓорѓи будала,",
       "lat": "- Dejgidi, Ǵorǵi budala,",
       "en": "- Hey, Gjorgji, you fool,"
      },
      {
       "cyr": "што ако с' око намигнуват,",
       "lat": "što ako s' oko namignuvat,",
       "en": "what if they wink with their eyes,"
      },
      {
       "cyr": "нели те тебе пречекувам?",
       "lat": "neli te tebe prečekuvam?",
       "en": "am I not waiting for you?"
      },
      {
       "cyr": "Што ако с' глава навртуват,",
       "lat": "Što ako s' glava navrtuvat,",
       "en": "What if they turn their heads,"
      },
      {
       "cyr": "нели те тебе пречекувам?",
       "lat": "neli te tebe prečekuvam?",
       "en": "am I not waiting for you?"
      }
     ]
    }
   ]
  }
