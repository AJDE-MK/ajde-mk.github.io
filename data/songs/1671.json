   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сам си крив бре комшија",
       "lat": "Sam si kriv bre komšija",
       "en": "It's your own fault, neighbor"
      },
      {
       "cyr": "што ти е жена меракливка.",
       "lat": "što ti e žena meraklivka.",
       "en": "that your wife is a needy woman."
      },
      {
       "cyr": "Пусти пари печалиш,",
       "lat": "Pusti pari pečališ,",
       "en": "You're just making money,"
      },
      {
       "cyr": "своја жена не љубиш.",
       "lat": "svoja žena ne ljubiš.",
       "en": "you don't love your wife."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не е сè во пари проклети",
       "lat": "Ne e sè vo pari prokleti",
       "en": "It's not all about damn money"
      },
      {
       "cyr": "и во бели куќи високи.",
       "lat": "i vo beli kuḱi visoki.",
       "en": "and tall white houses."
      },
      {
       "cyr": "Море, млада жена убава,",
       "lat": "More, mlada žena ubava,",
       "en": "Oh, a beautiful young woman,"
      },
      {
       "cyr": "треба да се гали, милува,",
       "lat": "treba da se gali, miluva,",
       "en": "needs to be caressed, loved,"
      },
      {
       "cyr": "море млада жена, убава,",
       "lat": "more mlada žena, ubava,",
       "en": "a young woman, beautiful,"
      },
      {
       "cyr": "треба да се дрма, комшија.",
       "lat": "treba da se drma, komšija.",
       "en": "needs to be shaken, neighbor."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Биди среќен, комшија,",
       "lat": "Bidi sreḱen, komšija,",
       "en": "Be happy, neighbor,"
      },
      {
       "cyr": "што си имаш одмена.",
       "lat": "što si imaš odmena.",
       "en": "that you have a replacement."
      },
      {
       "cyr": "Не е тоа, знаеш ти,",
       "lat": "Ne e toa, znaeš ti,",
       "en": "That's not, you know,"
      },
      {
       "cyr": "сапун да се потроши.",
       "lat": "sapun da se potroši.",
       "en": "a piece of soap, to become depleted."
      }
     ]
    },
