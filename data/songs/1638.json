    {
     "lines": [
      {
       "cyr": "- Тешко ми е, мајко моја,",
       "lat": "- Teško mi e, majko moja,",
       "en": "- It's hard for me, my mother,"
      },
      {
       "cyr": "ноќта паѓа, тој не доаѓа.",
       "lat": "noḱta paǵa, toj ne doaǵa.",
       "en": "the night is falling, he's not coming."
      },
      {
       "cyr": "Толку ноќи не сум спана,",
       "lat": "Tolku noḱi ne sum spana,",
       "en": "I haven't slept for so many nights,"
      },
      {
       "cyr": "тој си седи в' ладна меана.",
       "lat": "toj si sedi v' ladna meana.",
       "en": "he's sitting in a cold tavern."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Трај душо, трај,",
