   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Весели другари,",
       "lat": "Veseli drugari,",
       "en": "Merry friends,"
      },
      {
       "cyr": "душава ми посака",
       "lat": "dušava mi posaka",
       "en": "my soul wished"
      },
      {
       "cyr": "вино да се напијам,",
       "lat": "vino da se napijam,",
       "en": "to drink wine,"
      },
      {
       "cyr": "песна да си запеам.",
       "lat": "pesna da si zapeam.",
       "en": "to sing a song."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Виното и песната, лек на душата.",
       "lat": "Vinoto i pesnata, lek na dušata.",
       "en": "Wine and song, medicine for the soul."
      },
      {
       "cyr": "Кој песна пее, среќно живее.",
       "lat": "Koj pesna pee, sreḱno živee.",
       "en": "Whoever sings a song lives happily."
      },
      {
       "cyr": "Еднаш се живее, еднаш умира",
       "lat": "Ednaš se živee, ednaš umira",
       "en": "You live once, you die once,"
      },
      {
       "cyr": "времето минува, не се запира.",
       "lat": "vremeto minuva, ne se zapira.",
       "en": "time passes, it does not stop."
      }
     ]
    },
    {
     "lines": [
