   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "На срце ми лежи мила мамо",
       "lat": "Na srce mi leži mila mamo",
       "en": "On my heart is lying, mother dear,"
      },
      {
       "cyr": "на срце ли лежи,",
       "lat": "na srce li leži,",
       "en": "on my heart is lying,"
      },
      {
       "cyr": "ај на срце ми лежи, мила мамо",
       "lat": "aj na srce mi leži, mila mamo",
       "en": "Ay! On my heart is lying, mother dear,"
      },
      {
       "cyr": "една лута змија.",
       "lat": "edna luta zmija.",
       "en": "a poisonous snake."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не ми била змија мила мамо",
       "lat": "Ne mi bila zmija mila mamo",
       "en": "It was not a snake, mother dear,"
      },
      {
       "cyr": "не ми била змија,",
       "lat": "ne mi bila zmija,",
       "en": "it was not a snake."
      },
      {
       "cyr": "ај не ми била змија, мила мамо",
       "lat": "aj ne mi bila zmija, mila mamo",
       "en": "Ay! It was not a snake, mother dear,"
      },
      {
       "cyr": "тук' е кара Севда.",
       "lat": "tuk' e kara Sevda.",
       "en": "here was dark Sevda."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Севдините очи, мила мамо",
       "lat": "Sevdinite oči, mila mamo",
       "en": "Sevda's eyes, mother dear,"
      },
      {
       "cyr": "Севдините очи,",
       "lat": "Sevdinite oči,",
       "en": "Sevda's eyes,"
      },
      {
       "cyr": "ај Севдините очи, мила мамо",
       "lat": "aj Sevdinite oči, mila mamo",
       "en": "Ay! Sevda's eyes, mother dear,"
      },
      {
       "cyr": "црни черешови.",
       "lat": "crni čerešovi.",
       "en": "are black cherries."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Севдините веѓи мила мамо",
       "lat": "Sevdinite veǵi mila mamo",
       "en": "Sevda's eyebrows, mother dear,"
      },
      {
       "cyr": "Севдините веѓи,",
       "lat": "Sevdinite veǵi,",
       "en": "Sevda's eyebrows,"
      },
      {
       "cyr": "ај Севдините веѓи мила мамо",
       "lat": "aj Sevdinite veǵi mila mamo",
       "en": "Ay! Sevda's eyebrows, mother dear,"
      },
      {
       "cyr": "морски пијавици.",
       "lat": "morski pijavici.",
       "en": "are sea leeches."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Севдината снага мила мамо",
       "lat": "Sevdinata snaga mila mamo",
       "en": "Sevda's figure, mother dear,"
      },
      {
       "cyr": "Севдината снага,",
       "lat": "Sevdinata snaga,",
       "en": "Sevda's figure,"
      },
      {
       "cyr": "ај Севдината снага мила мамо",
       "lat": "aj Sevdinata snaga mila mamo",
       "en": "Ay! Sevda's figure, mother dear"
      },
      {
       "cyr": "тенка ем висока.",
       "lat": "tenka em visoka.",
       "en": "is slender and tall."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оди посакај ја, мила мамо",
       "lat": "Odi posakaj ja, mila mamo",
       "en": "Go and ask for her, mother dear."
      },
      {
       "cyr": "оди посакај ја,",
       "lat": "odi posakaj ja,",
       "en": "Go and ask for her."
      },
      {
       "cyr": "ај ако ти ја дадат, мила мамо",
       "lat": "aj ako ti ja dadat, mila mamo",
       "en": "Ay! and if they give her, mother dear."
      },
      {
       "cyr": "в' пајтон донеси ја.",
       "lat": "v' pajton donesi ja.",
       "en": "bring her in a carriage (for a wedding)."
      },
      {
       "cyr": "Ај ако не ја дадат, мила мамо",
       "lat": "Aj ako ne ja dadat, mila mamo",
       "en": "Ay! and if they don't give her, mother dear,"
      },
      {
       "cyr": "постој, погледај ја.",
       "lat": "postoj, pogledaj ja.",
       "en": "remain watching her."
      }
     ]
    }
   ]
  }
