   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Славен Пирин недогледен,",
       "lat": "Slaven Pirin nedogleden,",
       "en": "Glorious Pirin, endless to the eye,"
      },
      {
       "cyr": "с' врвој небо допира,",
       "lat": "s' vrvoj nebo dopira,",
       "en": "with its peak it touches the sky,"
      },
      {
       "cyr": "там' се роди цар Пирински,",
       "lat": "tam' se rodi car Pirinski,",
       "en": "there was born the Pirin tsar,"
      },
      {
       "cyr": "славен Јане Сандански.",
       "lat": "slaven Jane Sandanski.",
       "en": "glorious Jane Sandanski."
      },
      {
       "cyr": "Страв и трепет за душмани,",
       "lat": "Strav i trepet za dušmani,",
       "en": "Fear and trembling for the enemies,"
      },
      {
       "cyr": "в борба народ поведе,",
       "lat": "v borba narod povede,",
       "en": "he led the people into battle,"
      },
      {
       "cyr": "река од крв се пролеа,",
       "lat": "reka od krv se prolea,",
       "en": "a river of blood was spilled,"
      },
      {
       "cyr": "в' таа Пирин планина,",
       "lat": "v' taa Pirin planina,",
       "en": "in that Pirin mountain,"
      },
      {
       "cyr": "душман нигде не се сврте,",
       "lat": "dušman nigde ne se svrte,",
       "en": "the enemy turned back nowhere,"
      },
      {
       "cyr": "в' таа Пирин планина.",
       "lat": "v' taa Pirin planina.",
       "en": "in that Pirin mountain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Може браќа да загинам",
       "lat": "- Može braḱa da zaginam",
       "en": "- It may be, brothers, that I perish"
      },
      {
       "cyr": "в' борба с' тиран проклетен,",
       "lat": "v' borba s' tiran prokleten,",
       "en": "in battle with the accursed tyrant,"
      },
      {
       "cyr": "гробот да ми направите",
       "lat": "grobot da mi napravite",
       "en": "make my grave"
      },
      {
       "cyr": "на врв Пирин планина,",
       "lat": "na vrv Pirin planina,",
       "en": "on the top of Pirin mountain,"
      },
      {
       "cyr": "аа да можам да ги гледам",
       "lat": "aa da možam da gi gledam",
       "en": "so that I may see"
      },
      {
       "cyr": "Вардар, Пирин и Егеј,",
       "lat": "Vardar, Pirin i Egej,",
       "en": "Vardar, Pirin and the Aegean,"
      },
      {
       "cyr": "да си видам сонце над нив,",
       "lat": "da si vidam sonce nad niv,",
       "en": "so that I may see the sun above them,"
      },
      {
       "cyr": "мирно да си почивам,",
       "lat": "mirno da si počivam,",
       "en": "and rest in peace,"
      },
      {
       "cyr": "за да можам да ја гледам",
       "lat": "za da možam da ja gledam",
       "en": "so that I may look upon"
      },
      {
       "cyr": "цела Македонија.",
       "lat": "cela Makedonija.",
       "en": "all of Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гората ми за час молкна,",
       "lat": "Gorata mi za čas molkna,",
       "en": "The forest fell silent for an hour,"
      },
      {
       "cyr": "Пирин в' тага ми се сви,",
       "lat": "Pirin v' taga mi se svi,",
       "en": "Pirin shrank in sorrow,"
      },
      {
       "cyr": "славеј песна од страв запре,",
       "lat": "slavej pesna od strav zapre,",
       "en": "the nightingale stopped its song from fear,"
      },
      {
       "cyr": "в' борба, Јане, загина.",
       "lat": "v' borba, Jane, zagina.",
       "en": "in battle, Jane, he fell."
      },
      {
       "cyr": "Гробот му го направија",
       "lat": "Grobot mu go napravija",
       "en": "They made his grave"
      },
      {
       "cyr": "на врв Пирин планина",
       "lat": "na vrv Pirin planina",
       "en": "on the top of Pirin mountain"
      },
      {
       "cyr": "за да може да ја гледа",
       "lat": "za da može da ja gleda",
       "en": "so that he could see"
      },
      {
       "cyr": "цела Македонија,",
       "lat": "cela Makedonija,",
       "en": "all of Macedonia,"
      },
      {
       "cyr": "за да може да ја гледа",
       "lat": "za da može da ja gleda",
       "en": "so that he could see"
      },
      {
       "cyr": "наша Македонија.",
       "lat": "naša Makedonija.",
       "en": "our Macedonia."
      }
     ]
    }
   ]
  }
