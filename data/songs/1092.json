   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мари Димано, џан Димано,",
       "lat": "Mari Dimano, džan Dimano,",
       "en": "Hey Dimana, dear Dimana,"
      },
      {
       "cyr": "како ј'одиш по сокаци,",
       "lat": "kako j'odiš po sokaci,",
       "en": "how you walk along the lanes,"
      },
      {
       "cyr": "ј'обрни се, џан Димано,",
       "lat": "j'obrni se, džan Dimano,",
       "en": "turn around, dear Dimana,"
      },
      {
       "cyr": "заврти се покрај мене.",
       "lat": "zavrti se pokraj mene.",
       "en": "spin around next to me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да ти видам џан Димано,",
       "lat": "Da ti vidam džan Dimano,",
       "en": "Let me see, dear Dimana,"
      },
      {
       "cyr": "црни очи дафинови,",
       "lat": "crni oči dafinovi,",
       "en": "your black bay-laurel eyes,"
      },
      {
       "cyr": "бело лице негалено,",
       "lat": "belo lice negaleno,",
       "en": "your white, pampered face,"
      },
      {
       "cyr": "танка снага, мермер нозе.",
       "lat": "tanka snaga, mermer noze.",
       "en": "your slim figure, marble legs."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нели дума си думаја,",
       "lat": "Neli duma si dumaja,",
       "en": "Isn't it what they are saying,"
      },
      {
       "cyr": "твојо башча, моја мајка,",
       "lat": "tvojo bašča, moja majka,",
       "en": "your father and my mother,"
      },
      {
       "cyr": "да те дадат, џан Димано,",
       "lat": "da te dadat, džan Dimano,",
       "en": "that they will give you away, dear Dimana,"
      },
      {
       "cyr": "сакаат тебе ошче мене?",
       "lat": "sakaat tebe ošče mene?",
       "en": "are they wanting you, or me as well?"
      }
     ]
    }
   ]
  }
