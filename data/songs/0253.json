      {
       "cyr": "Среќна љубов имавме",
       "lat": "Sreḱna ljubov imavme",
       "en": "We had a happy love,"
      },
      {
       "cyr": "живот, песни сакавме",
       "lat": "život, pesni sakavme",
       "en": "we wanted life, songs,"
      },
      {
       "cyr": "но за наша несреќа",
       "lat": "no za naša nesreḱa",
       "en": "but to our misfortune"
      },
      {
       "cyr": "останав јас без неа.",
       "lat": "ostanav jas bez nea.",
       "en": "I was left without her."
      }
     ]
    },
    {
     "lines": [
      {
