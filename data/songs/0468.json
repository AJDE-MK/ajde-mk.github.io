   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- А бре воденичаре, баш пријателе,",
       "lat": "- A bre vodeničare, baš prijatele,",
       "en": "- Hey you, miller, my friend"
      },
      {
       "cyr": "море мојте очи твои нека бидат,",
       "lat": "more mojte oči tvoi neka bidat,",
       "en": "may my eyes be yours,"
      },
      {
       "cyr": "сомели ми житото.",
       "lat": "someli mi žitoto.",
       "en": "grind my grain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Воденицата вода ми нема,",
