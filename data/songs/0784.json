      {
       "cyr": "Развивај горо зелена,",
       "lat": "Razvivaj goro zelena,",
       "en": "Unfurl, green forest,"
      },
      {
       "cyr": "развивај Малеш планино, Македонијо,",
       "lat": "razvivaj Maleš planino, Makedonijo,",
       "en": "unfurl, Malesh mountain, Macedonia,"
      },
      {
       "cyr": "тука е Делчев војвода.",
       "lat": "tuka e Delčev vojvoda.",
       "en": "here is the voivode Delchev."
      },
      {
       "cyr": "Оддолу иде бегчето",
       "lat": "Oddolu ide begčeto",
       "en": "From below comes the young bey"
      },
      {
       "cyr": "со четворица сејмени, Македонијо,",
       "lat": "so četvorica sejmeni, Makedonijo,",
       "en": "with four seymen, Macedonia,"
      },
      {
       "cyr": "со четворица сејмени.",
       "lat": "so četvorica sejmeni.",
       "en": "with four seymen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Делчев ми викна, довикна:",
       "lat": "Delčev mi vikna, dovikna:",
       "en": "Delchev called out to me:"
      },
      {
       "cyr": "- Бегчето живо фатете, Македонијо,",
       "lat": "- Begčeto živo fatete, Makedonijo,",
       "en": "- Catch the young bey alive, Macedonia,"
      },
      {
       "cyr": "бегчето живо фатете!",
       "lat": "begčeto živo fatete!",
       "en": "catch the young bey alive!"
      },
      {
       "cyr": "Бегчето Делчев замоли:",
       "lat": "Begčeto Delčev zamoli:",
       "en": "The young bey begged Delchev:"
      },
      {
       "cyr": "- Немој ме младо погубвај, Македонијо,",
       "lat": "- Nemoj me mlado pogubvaj, Makedonijo,",
       "en": "- Do not kill me young, Macedonia,"
      },
      {
       "cyr": "комити нема да гонам.",
       "lat": "komiti nema da gonam.",
       "en": "I will not hunt the komitas."
