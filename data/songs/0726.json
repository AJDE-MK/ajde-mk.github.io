   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Слага се с'лнце да зајде",
       "lat": "Slaga se s'lnce da zajde",
       "en": "The sun is about to set"
      },
      {
       "cyr": "Божано, бела мори, црвена.",
       "lat": "Božano, bela mori, crvena.",
       "en": "Bozhano, white, hey, and red."
      },
      {
       "cyr": "Преко ридине, падине,",
       "lat": "Preko ridine, padine,",
       "en": "Over the hills, the slopes,"
      },
      {
       "cyr": "Божано, т'нка мори, висока.",
       "lat": "Božano, t'nka mori, visoka.",
       "en": "Bozhano, slender, hey, and tall."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И во планине, бор дрво,",
       "lat": "I vo planine, bor drvo,",
       "en": "And in the mountains, a pine tree,"
      },
      {
       "cyr": "Божано, бела мори, црвена.",
       "lat": "Božano, bela mori, crvena.",
       "en": "Bozhano, white, hey, and red."
      },
      {
       "cyr": "А до бор дрво, кладенче,",
       "lat": "A do bor drvo, kladenče,",
       "en": "And beside the pine tree, a little spring,"
      },
      {
       "cyr": "Божано, т'нка мори, висока.",
       "lat": "Božano, t'nka mori, visoka.",
       "en": "Bozhano, slender, hey, and tall."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А до кладенче, косачи,",
       "lat": "A do kladenče, kosači,",
       "en": "And beside the spring, mowers,"
      },
      {
       "cyr": "Божано, бела мори, црвена.",
       "lat": "Božano, bela mori, crvena.",
       "en": "Bozhano, white, hey, and red."
      },
      {
       "cyr": "опкладиле се косачи,",
       "lat": "opkladile se kosači,",
       "en": "the mowers made a wager,"
      },
      {
       "cyr": "Божано, т'нка мори, висока.",
       "lat": "Božano, t'nka mori, visoka.",
       "en": "Bozhano, slender, hey, and tall."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кој ќе префрли бор дрво,",
       "lat": "Koj ḱe prefrli bor drvo,",
       "en": "Whoever throws over the pine tree,"
      },
      {
       "cyr": "тој ќе ја земе, мори, Калина.",
       "lat": "toj ḱe ja zeme, mori, Kalina.",
       "en": "will take Kalina, hey."
      },
      {
       "cyr": "Префрлил беќар, не могал,",
       "lat": "Prefrlil beḱar, ne mogal,",
       "en": "The bachelor threw, he could not,"
      },
      {
       "cyr": "префрлил вдовац мори, не могал.",
       "lat": "prefrlil vdovac mori, ne mogal.",
       "en": "the widower threw, hey, he could not."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стар дедо фрлил, префрлил,",
       "lat": "Star dedo frlil, prefrlil,",
       "en": "The old grandfather threw, and threw it over,"
      },
      {
       "cyr": "узнаја момо мори, Калино.",
       "lat": "uznaja momo mori, Kalino.",
       "en": "he won the girl, hey, Kalina."
      },
      {
       "cyr": "Викна Калина да плаче:",
       "lat": "Vikna Kalina da plače:",
       "en": "Kalina cried out in tears:"
      },
      {
       "cyr": "- Оф леле, Боже, до Бога!",
       "lat": "- Of lele, Bože, do Boga!",
       "en": "- Oh woe, God, oh God!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што ми е Господ судија,",
       "lat": "Što mi e Gospod sudija,",
       "en": "Why is the Lord my judge,"
      },
      {
       "cyr": "стар дедо момче да ми е?",
       "lat": "star dedo momče da mi e?",
       "en": "that an old grandfather should be my young man?"
