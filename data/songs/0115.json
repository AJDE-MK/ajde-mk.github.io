    },
    {
     "lines": [
      {
       "cyr": "Дојде пролет, на бистра планина,",
       "lat": "Dojde prolet, na bistra planina,",
       "en": "Spring came to the clear mountain,"
      },
      {
       "cyr": "заблејале, стада неброени.",
       "lat": "zablejale, stada nebroeni.",
       "en": "the countless flocks bleated."
      },
      {
       "cyr": "Во љиваѓе, ладен извор има,",
       "lat": "Vo ljivaǵe, laden izvor ima,",
       "en": "In the meadows there is a cold spring,"
      },
      {
       "cyr": "крај изворот, трева зелена.",
       "lat": "kraj izvorot, treva zelena.",
       "en": "beside the spring, green grass."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Развивај горо зелена,",
       "lat": "Razvivaj goro zelena,",
       "en": "Unfurl, green forest,"
      },
      {
       "cyr": "разграни гранки широко,",
       "lat": "razgrani granki široko,",
       "en": "spread your branches wide,"
      },
      {
       "cyr": "направи сенки ладовни,",
       "lat": "napravi senki ladovni,",
       "en": "make cool shade,"
      },
      {
       "cyr": "стадото да ми пладнува.",
       "lat": "stadoto da mi pladnuva.",
       "en": "for my flock to rest at noon."
      },
      {
       "cyr": "Цветајте росни ливаѓе,",
       "lat": "Cvetajte rosni livaǵe,",
       "en": "Bloom, dewy meadows,"
      },
      {
       "cyr": "околу Лазарополе,",
       "lat": "okolu Lazaropole,",
       "en": "around Lazaropole,"
      },
      {
       "cyr": "таму ми срце остана,",
       "lat": "tamu mi srce ostana,",
       "en": "there my heart stayed,"
      },
      {
       "cyr": "планино, моја рудино.",
       "lat": "planino, moja rudino.",
       "en": "mountain, my pasture."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во тревата, листе папирово,",
       "lat": "Vo trevata, liste papirovo,",
       "en": "In the grass, a paper leaf,"
      },
      {
       "cyr": "во листето, ситно напишано:",
       "lat": "vo listeto, sitno napišano:",
       "en": "on the leaf, finely written:"
      },
      {
       "cyr": "- Кој се сака и да си се земе,",
       "lat": "- Koj se saka i da si se zeme,",
       "en": "- Let those who love each other take each other,"
      },
      {
       "cyr": "голем грев е млади да разделиш.",
