   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Шетал Стојан, прошетал,",
       "lat": "Šetal Stojan, prošetal,",
       "en": "Stojan walked, walked,"
      },
      {
       "cyr": "многу села, градови,",
       "lat": "mnogu sela, gradovi,",
       "en": "many villages, cities,"
      },
      {
       "cyr": "барал мома убава,",
       "lat": "baral moma ubava,",
       "en": "he looked for a beautiful girl,"
      },
      {
       "cyr": "решил да се ожени.",
       "lat": "rešil da se oženi.",
       "en": "he decided to get married."
      },
      {
       "cyr": "Дома да се прибери,",
       "lat": "Doma da se priberi,",
       "en": "To settle down at home,"
      },
      {
       "cyr": "да се одоми,",
       "lat": "da se odomi,",
       "en": "to settle down,"
      },
      {
       "cyr": "како сите еснафи,",
       "lat": "kako site esnafi,",
       "en": "like all good young men,"
      },
      {
       "cyr": "чоек да стани.",
       "lat": "čoek da stani.",
       "en": "to become a man."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Земал жена убава,",
       "lat": "Zemal žena ubava,",
       "en": "He took a beautiful wife,"
      },
      {
       "cyr": "ама многу мрзлива,",
       "lat": "ama mnogu mrzliva,",
       "en": "but very lazy,"
      },
      {
       "cyr": "само се излежува",
       "lat": "samo se izležuva",
       "en": "she just lies around"
      },
      {
       "cyr": "и за сѐ наредува,",
       "lat": "i za sè nareduva,",
       "en": "and gives orders about everything,"
      },
      {
       "cyr": "само се дотерува",
       "lat": "samo se doteruva",
       "en": "she just dresses up"
      },
      {
       "cyr": "и потпевнува,",
       "lat": "i potpevnuva,",
       "en": "and hums,"
      },
      {
       "cyr": "чека да се раздени",
       "lat": "čeka da se razdeni",
       "en": "waits for dawn"
      },
      {
       "cyr": "и ја здувнува.",
       "lat": "i ja zduvnuva.",
       "en": "and takes off (goes out)."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Денес, утре, секој ден,",
       "lat": "Denes, utre, sekoj den,",
       "en": "Today, tomorrow, every day,"
      },
      {
       "cyr": "јаден Стојан побелел,",
       "lat": "jaden Stojan pobelel,",
       "en": "poor Stojan turned white,"
      },
      {
       "cyr": "почнал Стојан да пие,",
       "lat": "počnal Stojan da pie,",
       "en": "Stojan started drinking,"
      },
      {
       "cyr": "пијан дома да иде:",
       "lat": "pijan doma da ide:",
       "en": "started to come home drunk:"
      },
      {
       "cyr": "- Кој ме ѓавол натера",
       "lat": "- Koj me ǵavol natera",
       "en": "- What devil made me"
      },
      {
       "cyr": "да се оженам,",
       "lat": "da se oženam,",
       "en": "to get married,"
      },
      {
       "cyr": "ваква чума голема",
       "lat": "vakva čuma golema",
       "en": "to bring such a big plague"
      },
      {
       "cyr": "дома доведам?",
       "lat": "doma dovedam?",
       "en": "in my home?"
      }
     ]
    }
   ]
  }
 ],
