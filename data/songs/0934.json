   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мори баби сакаат гнили круши,",
       "lat": "Mori babi sakaat gnili kruši,",
       "en": "Old women like overripe pears,"
      },
      {
       "cyr": "за срамота, ама срамота.",
       "lat": "za sramota, ama sramota.",
       "en": "such a shame, such a shame."
      },
      {
       "cyr": "Море да завлажат стари души,",
       "lat": "More da zavlažat stari duši,",
       "en": "They want to moisten their old souls,"
      },
      {
       "cyr": "за резил бре, аман резил бре.",
       "lat": "za rezil bre, aman rezil bre.",
       "en": "so embarrassing, so embarrasing."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гнили круши, лапни-голтни,",
       "lat": "Gnili kruši, lapni-goltni,",
       "en": "Overripe pears, chew-suck,"
      },
      {
       "cyr": "еден касај, една круша.",
       "lat": "eden kasaj, edna kruša.",
       "en": "one bite, one pear."
      },
      {
       "cyr": "- Кој има заби, тој ќе џвака,",
       "lat": "- Koj ima zabi, toj ḱe džvaka,",
       "en": "- Those with teeth, they should chew,"
      },
      {
       "cyr": "а кој нема, ќе лапа!",
       "lat": "a koj nema, ḱe lapa!",
       "en": "and those without, they should suck!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море баба Ката круши грабна,",
       "lat": "More baba Kata kruši grabna,",
       "en": "Grannie Kata grabbed some pears,"
      },
      {
       "cyr": "за срамота, аман срамота.",
       "lat": "za sramota, aman sramota.",
       "en": "such a shame, such a shame."
      },
      {
       "cyr": "Море круши грабна и побегна,",
       "lat": "More kruši grabna i pobegna,",
       "en": "She grabbed the pears and rаn away,"
      },
      {
       "cyr": "за резил бре, аман резил бре.",
       "lat": "za rezil bre, aman rezil bre.",
       "en": "so embarrassing, so embarrasing."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите баби клетви колнат,",
       "lat": "Site babi kletvi kolnat,",
       "en": "All the old women curse her,"
      },
      {
       "cyr": "солзи ронат, ми говорат:",
       "lat": "solzi ronat, mi govorat:",
       "en": "shed tears and say:"
      },
      {
       "cyr": "- Бабо Като, немаш жал,",
       "lat": "- Babo Kato, nemaš žal,",
       "en": "- Grannie Kata, you are shameless,"
      },
      {
       "cyr": "е бабо Като, бабо Като!",
       "lat": "e babo Kato, babo Kato!",
       "en": "hey grannie Kata, grannie Kata!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море запри, Като, каде бегаш,",
       "lat": "More zapri, Kato, kade begaš,",
       "en": "Hey, stop, Kata, where are you running,"
      },
      {
       "cyr": "за срамота, аман срамота.",
       "lat": "za sramota, aman sramota.",
       "en": "such a shame, such a shame."
      },
      {
       "cyr": "Море двете круши ќе ги згмечиш",
       "lat": "More dvete kruši ḱe gi zgmečiš",
       "en": "You will crush both pears,"
      },
      {
       "cyr": "за резил бре, аман резил бре.",
       "lat": "za rezil bre, aman rezil bre.",
       "en": "so embarrassing, so embarrasing."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Изеди ги двете круши,",
       "lat": "Izedi gi dvete kruši,",
       "en": "Better eat both pears,"
      },
      {
       "cyr": "не ги мачи стари души,",
       "lat": "ne gi mači stari duši,",
       "en": "don't bother the old souls,"
      },
      {
       "cyr": "двете круши ќе ги изедеш,",
       "lat": "dvete kruši ḱe gi izedeš,",
       "en": "you can eat both pears,"
      },
      {
       "cyr": "стара баба ќе си останеш.",
       "lat": "stara baba ḱe si ostaneš.",
       "en": "but still stay an old woman."
      }
     ]
    }
   ]
  }
 ],
