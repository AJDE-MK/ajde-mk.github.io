   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Без тебе јас заспан шетам,",
       "lat": "Bez tebe jas zaspan šetam,",
       "en": "Without you I walk about asleep,"
      },
      {
       "cyr": "како матна вода,",
       "lat": "kako matna voda,",
       "en": "like muddy water,"
      },
      {
       "cyr": "не знам кај да здивнам, душо,",
       "lat": "ne znam kaj da zdivnam, dušo,",
       "en": "I do not know where to draw breath, darling,"
      },
      {
       "cyr": "каде ли да одам.",
       "lat": "kade li da odam.",
       "en": "where to go."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јано, јагне, бело сугаре,",
       "lat": "Jano, jagne, belo sugare,",
       "en": "Jana, lamb, white late-born lamb,"
      },
      {
       "cyr": "Јано, јанѕо што ме изгоре.",
       "lat": "Jano, jandzo što me izgore.",
       "en": "Jana, janza, you who burned me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Без тебе јас буден сонувам,",
       "lat": "Bez tebe jas buden sonuvam,",
       "en": "Without you I dream awake,"
      },
      {
       "cyr": "ти си вечна мора,",
       "lat": "ti si večna mora,",
       "en": "you are my eternal nightmare,"
      },
      {
       "cyr": "дење-ноќе сал си темнам,",
       "lat": "denje-noḱe sal si temnam,",
       "en": "day and night I only grow dark,"
      },
      {
       "cyr": "ко темна гора.",
       "lat": "ko temna gora.",
       "en": "like a dark forest."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јано, јагне, бело сугаре,",
