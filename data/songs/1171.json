   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мори Вано, лична ќерко,",
       "lat": "Mori Vano, lična ḱerko,",
       "en": "Hey Vana, lovely daughter,"
      },
      {
       "cyr": "што те мајка лична роди,",
       "lat": "što te majka lična rodi,",
       "en": "that your mother bore so lovely,"
      },
      {
       "cyr": "лична роди, ем промени.",
       "lat": "lična rodi, em promeni.",
       "en": "bore lovely, and changed you too."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па те прати в' пусто Скопје,",
       "lat": "Pa te prati v' pusto Skopje,",
       "en": "Then she sent you to wretched Skopje,"
      },
      {
       "cyr": "пусто Скопје, скопска бања,",
       "lat": "pusto Skopje, skopska banja,",
       "en": "wretched Skopje, the Skopje bath,"
      },
      {
       "cyr": "скопска бања, Катланово.",
       "lat": "skopska banja, Katlanovo.",
       "en": "the Skopje bath, Katlanovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму има многу Турци,",
       "lat": "Tamu ima mnogu Turci,",
       "en": "There are many Turks there,"
      },
      {
       "cyr": "нит' се бањат, нит' излагат,",
       "lat": "nit' se banjat, nit' izlagat,",
       "en": "they neither bathe nor leave,"
      },
      {
       "cyr": "тук' ја чекаат лична Вана,",
       "lat": "tuk' ja čekaat lična Vana,",
       "en": "but wait for lovely Vana,"
      },
      {
       "cyr": "лична Вана да ја турчат.",
       "lat": "lična Vana da ja turčat.",
       "en": "to turn lovely Vana Turkish."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проговара лична Вана:",
       "lat": "Progovara lična Vana:",
       "en": "Lovely Vana speaks up:"
      },
      {
       "cyr": "- Море Турци, анадолци,",
       "lat": "- More Turci, anadolci,",
       "en": "- Hey Turks, Anatolians,"
      },
      {
       "cyr": "глава давам, не се турчам!",
       "lat": "glava davam, ne se turčam!",
       "en": "I give my head, I will not turn Turk!"
