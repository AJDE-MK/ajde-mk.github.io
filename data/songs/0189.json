      {
       "cyr": "со румен пламен небо покри.",
       "lat": "so rumen plamen nebo pokri.",
       "en": "with red flame it covers the sky."
      },
      {
       "cyr": "Топови грмат, татнит земјата,",
       "lat": "Topovi grmat, tatnit zemjata,",
       "en": "Cannons thunder, the earth rumbles,"
      },
      {
       "cyr": "Смилево славно в' огон горит.",
       "lat": "Smilevo slavno v' ogon gorit.",
       "en": "glorious Smilevo burns in fire."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Жените плачат, пиштат децата,",
       "lat": "Ženite plačat, pištat decata,",
       "en": "Women weep, children scream,"
      },
      {
       "cyr": "моми се кријат во беспокој.",
