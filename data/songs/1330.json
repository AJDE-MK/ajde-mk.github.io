      {
       "cyr": "од таја гора зелена:",
       "lat": "od taja gora zelena:",
       "en": "from that green forest:"
      },
      {
       "cyr": "- Почекај, горо зелена,",
       "lat": "- Počekaj, goro zelena,",
       "en": "- Wait, green forest,"
      },
      {
       "cyr": "ете го Инџе к'ј идет,",
       "lat": "ete go Indže k'j idet,",
       "en": "behold, Indje is coming,"
      },
      {
       "cyr": "с' ајдуци ќе се обидит.",
