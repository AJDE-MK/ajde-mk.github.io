    {
     "lines": [
      {
       "cyr": "Капитан болен лежи,",
       "lat": "Kapitan bolen leži,",
       "en": "The captain lies ill,"
      },
      {
       "cyr": "постела му росна трева.",
       "lat": "postela mu rosna treva.",
       "en": "his bed is dewy grass."
      },
      {
       "cyr": "Завивка му сино небо,",
       "lat": "Zavivka mu sino nebo,",
       "en": "His blanket is the blue sky,"
      },
      {
       "cyr": "уз глава му тенка пушка.",
       "lat": "uz glava mu tenka puška.",
       "en": "by his head a slender rifle."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На дружина говореше:",
       "lat": "Na družina govoreše:",
       "en": "He spoke to his company:"
      },
      {
       "cyr": "- Ојте вази мои другари,",
       "lat": "- Ojte vazi moi drugari,",
       "en": "- Hey, you, my comrades,"
      },
      {
       "cyr": "писмо си ми напишете,",
       "lat": "pismo si mi napišete,",
       "en": "write a letter for me,"
      },
      {
       "cyr": "на моето прво либе,",
       "lat": "na moeto prvo libe,",
       "en": "to my first love,"
      },
      {
       "cyr": "дек' сум јас тук' загинал.",
       "lat": "dek' sum jas tuk' zaginal.",
       "en": "where I have fallen here (my reading)."
      }
     ]
    }
   ]
  }
