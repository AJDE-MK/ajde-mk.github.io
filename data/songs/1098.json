   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Си прошетав, мила мамо,",
       "lat": "Si prošetav, mila mamo,",
       "en": "I strolled, dear mother,"
      },
      {
       "cyr": "леринските села.",
       "lat": "lerinskite sela.",
       "en": "through the villages of Lerin."
      },
      {
       "cyr": "Си застанав во Овчарани,",
       "lat": "Si zastanav vo Ovčarani,",
       "en": "I stopped in Ovcharani,"
      },
      {
       "cyr": "крај црквата бела.",
       "lat": "kraj crkvata bela.",
       "en": "by the white church."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму си најдов Македонци,",
       "lat": "Tamu si najdov Makedonci,",
       "en": "There I found Macedonians,"
      },
      {
       "cyr": "стари и млади овчаранци,",
       "lat": "stari i mladi ovčaranci,",
       "en": "old and young people of Ovcharani,"
      },
      {
       "cyr": "комитски песни пееа,",
       "lat": "komitski pesni peea,",
       "en": "they sang rebel songs,"
      },
      {
       "cyr": "пуштено оро играа,",
       "lat": "pušteno oro igraa,",
       "en": "they danced the pushteno oro,"
      },
      {
       "cyr": "Илинден, мајко, славеа",
       "lat": "Ilinden, majko, slavea",
       "en": "they celebrated Ilinden, mother,"
      },
      {
       "cyr": "и од радост солзи ронеа.",
       "lat": "i od radost solzi ronea.",
       "en": "and shed tears of joy."
      }
     ]
    },
    {
     "lines": [
      {
