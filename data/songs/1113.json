    {
     "lines": [
      {
       "cyr": "Паднало моме од бога",
       "lat": "Padnalo mome od boga",
       "en": "A girl fell from God"
      },
      {
       "cyr": "во среде бавча градина.",
       "lat": "vo srede bavča gradina.",
       "en": "in the middle of a garden orchard."
      },
      {
       "cyr": "- Марике, бела Марике,",
       "lat": "- Marike, bela Marike,",
       "en": "- Marika, white Marika,"
      },
      {
       "cyr": "ал' си од бога падната,",
       "lat": "al' si od boga padnata,",
       "en": "were you fallen from God,"
      },
      {
       "cyr": "или од земја никната?",
       "lat": "ili od zemja niknata?",
       "en": "or sprouted from the earth?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- He сум од бога падната,",
       "lat": "- He sum od boga padnata,",
       "en": "- I am not fallen from God,"
      },
      {
       "cyr": "нити од земја никната,",
       "lat": "niti od zemja niknata,",
       "en": "nor sprouted from the earth,"
      },
      {
       "cyr": "милна ме мајка родила,",
       "lat": "milna me majka rodila,",
       "en": "my dear mother bore me,"
      },
      {
       "cyr": "мирно ме масло мачкала",
       "lat": "mirno me maslo mačkala",
       "en": "calmly she rubbed me with oil,"
      },
      {
       "cyr": "со благо млеко доила,",
       "lat": "so blago mleko doila,",
       "en": "nursed me with gentle milk,"
      },
      {
       "cyr": "под трендафилот лулала.",
       "lat": "pod trendafilot lulala.",
       "en": "rocked me under the rose bush."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На Велигден сум родена,",
       "lat": "Na Veligden sum rodena,",
       "en": "I was born on Easter,"
      },
      {
       "cyr": "а крстена на Ѓурѓовден,",
       "lat": "a krstena na Ǵurǵovden,",
       "en": "and baptized on St George's Day,"
      },
      {
       "cyr": "лично ми име туриле,",
       "lat": "lično mi ime turile,",
       "en": "they gave me a fine name,"
      },
      {
       "cyr": "лично бре име Марика.",
       "lat": "lično bre ime Marika.",
       "en": "a fine name, hey, Marika."
      }
