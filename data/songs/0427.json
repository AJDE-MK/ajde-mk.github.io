       "en": "My steam boat is coming in,"
      },
      {
       "cyr": "збогум либе подај рака",
       "lat": "zbogum libe podaj raka",
       "en": "give me your hand to say good-bye."
      },
      {
       "cyr": "не плачи мило либе, не жалај",
       "lat": "ne plači milo libe, ne žalaj",
       "en": "Don’t cry, my love, don’t be sad,"
      },
      {
       "cyr": "јас пак ќе се вратам.",
       "lat": "jas pak ḱe se vratam.",
       "en": "I shall come back again."
      }
