   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Чедо си ми, мило си ми,",
       "lat": "Čedo si mi, milo si mi,",
       "en": "You are my child, you are dear to me,"
      },
      {
       "cyr": "лично, младо сега си ми,",
       "lat": "lično, mlado sega si mi,",
       "en": "handsome and young you are to me now,"
      },
      {
       "cyr": "мајка сине послушај ја,",
       "lat": "majka sine poslušaj ja,",
       "en": "mother's son, listen to me,"
      },
      {
       "cyr": "време бргу си минува.",
       "lat": "vreme brgu si minuva.",
       "en": "time passes quickly."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Една желба јас си имам,",
       "lat": "Edna želba jas si imam,",
       "en": "I have one wish,"
      },
      {
       "cyr": "тебе женет да те видам,",
       "lat": "tebe ženet da te vidam,",
       "en": "to see you married,"
      },
      {
       "cyr": "в' куќи снаа да пречекам,",
       "lat": "v' kuḱi snaa da prečekam,",
       "en": "to welcome a daughter-in-law into the house,"
      },
      {
       "cyr": "од вас рожба да дочекам.",
       "lat": "od vas rožba da dočekam.",
       "en": "to await a child from the two of you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Татко сирак те остави,",
       "lat": "Tatko sirak te ostavi,",
       "en": "Your father left you an orphan,"
      },
      {
       "cyr": "мене проблем ми направи,",
       "lat": "mene problem mi napravi,",
       "en": "he made trouble for me,"
      },
      {
       "cyr": "сета младост ми помина,",
       "lat": "seta mladost mi pomina,",
       "en": "all my youth has passed,"
      },
      {
       "cyr": "само сине ти остана.",
       "lat": "samo sine ti ostana.",
       "en": "only you, son, remained."
      }
     ]
