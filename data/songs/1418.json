    {
     "lines": [
      {
       "cyr": "Сонцето трепи, разгрева,",
       "lat": "Sonceto trepi, razgreva,",
       "en": "The sun trembles, warms up,"
      },
      {
       "cyr": "Стеван ми лежи во окопи.",
       "lat": "Stevan mi leži vo okopi.",
       "en": "My Stevan lies in the trenches."
      },
      {
       "cyr": "Ете ги идат другари",
       "lat": "Ete gi idat drugari",
       "en": "Look, his comrades are coming"
      },
      {
       "cyr": "и на Стевана говорат:",
       "lat": "i na Stevana govorat:",
       "en": "and they say to Stevan:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Стани ми, стани Стеване,",
       "lat": "- Stani mi, stani Stevane,",
       "en": "- Get up, get up, Stevan,"
      },
      {
       "cyr": "да си дома одиме.",
       "lat": "da si doma odime.",
       "en": "let us go home."
      },
      {
       "cyr": "Кај наш'те мајки, татковци,",
       "lat": "Kaj naš'te majki, tatkovci,",
       "en": "To our mothers, fathers,"
      },
      {
       "cyr": "жени со машки дечиња.",
       "lat": "ženi so maški dečinja.",
       "en": "wives with boy children."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ајте со здравје другари,",
       "lat": "- Ajte so zdravje drugari,",
       "en": "- Go in health, comrades,"
      },
      {
       "cyr": "мајка и татка поздравете.",
       "lat": "majka i tatka pozdravete.",
       "en": "greet my mother and father."
      },
      {
       "cyr": "Мајка и татка поздравете:",
       "lat": "Majka i tatka pozdravete:",
       "en": "Greet my mother and father:"
      },
      {
       "cyr": "„Стеван го оженивме“.",
       "lat": "„Stevan go oženivme“.",
       "en": "'We have married Stevan off'."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стеван го оженивме",
       "lat": "Stevan go oženivme",
       "en": "We have married Stevan off"
      },
      {
       "cyr": "за една млада девојка.",
