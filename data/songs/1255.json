   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кочани, Кочани, роден крај,",
       "lat": "Kočani, Kočani, roden kraj,",
       "en": "Kochani, Kochani, my place of birth,",
       "en_mt": false
      },
      {
       "cyr": "убав си ми, убав си, како рај.",
       "lat": "ubav si mi, ubav si, kako raj.",
       "en": "you are pretty to me, you are pretty, like paradise.",
       "en_mt": false
      },
      {
       "cyr": "Кочани, Кочани, гратче мило,",
       "lat": "Kočani, Kočani, gratče milo,",
       "en": "Kochani, Kochani, dear little town,",
       "en_mt": false
      },
      {
       "cyr": "не си тажно како што било.",
       "lat": "ne si tažno kako što bilo.",
       "en": "you are not sad as you once were.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нема више воденички песни,",
       "lat": "Nema više vodenički pesni,",
       "en": "No more songs near the watermills,",
       "en_mt": false
      },
      {
       "cyr": "нит' калдрма, нит' сокаци тесни,",
       "lat": "nit' kaldrma, nit' sokaci tesni,",
       "en": "no more cobblestones, no more narrow alleys,",
       "en_mt": false
      },
      {
       "cyr": "нема више кал до колена,",
       "lat": "nema više kal do kolena,",
       "en": "no more knee-deep mud,",
       "en_mt": false
      },
      {
       "cyr": "нема више самар на рамена.",
       "lat": "nema više samar na ramena.",
       "en": "no more saddle on the shoulder.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кочани, Кочани, роден крај,",
       "lat": "Kočani, Kočani, roden kraj,",
