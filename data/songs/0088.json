   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Што ќе правиме, чиниме,",
       "lat": "Što ḱe pravime, činime,",
       "en": "What shall we do, what shall we make,"
      },
      {
       "cyr": "со вој мерак ш'о го имаме,",
       "lat": "so voj merak š'o go imame,",
       "en": "with this longing that we have,"
      },
      {
       "cyr": "ниту јадиме, пиеме,",
       "lat": "nitu jadime, pieme,",
       "en": "we neither eat nor drink,"
      },
      {
       "cyr": "ниту слободно спиеме.",
       "lat": "nitu slobodno spieme.",
       "en": "nor do we sleep in peace."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сношти помина покрај вас,",
       "lat": "Snošti pomina pokraj vas,",
       "en": "Last night I passed by your house,"
      },
      {
       "cyr": "тамо ти ја најдо мајка ти.",
       "lat": "tamo ti ja najdo majka ti.",
       "en": "there I found your mother."
      },
      {
       "cyr": "- Добро вечер, стара бабо.",
       "lat": "- Dobro večer, stara babo.",
       "en": "- Good evening, old granny."
      },
      {
       "cyr": "- Дал ти Бог добро, јуначе.",
       "lat": "- Dal ti Bog dobro, junače.",
       "en": "- God give you good, hero."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А што ми рече два збора,",
       "lat": "A što mi reče dva zbora,",
       "en": "And what she said to me, two words,"
      },
      {
       "cyr": "два збора, до два изгора.",
       "lat": "dva zbora, do dva izgora.",
       "en": "two words, burned me like two coals."
      },
      {
       "cyr": "- Деј, море лудо и младо,",
       "lat": "- Dej, more ludo i mlado,",
       "en": "- Hey, you foolish young man,"
      },
      {
       "cyr": "не си го губи времето.",
       "lat": "ne si go gubi vremeto.",
       "en": "do not waste your time."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Момето ми е свршено,",
       "lat": "Mometo mi e svršeno,",
       "en": "The girl is engaged,"
      },
      {
       "cyr": "за друго лудо, порусо,",
       "lat": "za drugo ludo, poruso,",
       "en": "to another young man, a blond one,"
      },
      {
       "cyr": "за друго лудо, порусо,",
       "lat": "za drugo ludo, poruso,",
       "en": "to another young man, a blond one,"
      },
      {
       "cyr": "од тебе ногу, ногу полично.",
       "lat": "od tebe nogu, nogu polično.",
       "en": "much more handsome than you."
      }
     ]
    }
   ]
  }
 ],
