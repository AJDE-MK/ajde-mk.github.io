   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Го пратиле дедо на Ат-пазар,",
       "lat": "Go pratile dedo na At-pazar,",
       "en": "They sent grandpa to the Horse Market,"
      },
      {
       "cyr": "да си купи коњче азганче,",
       "lat": "da si kupi konjče azganče,",
       "en": "to buy a little horse, an azganche,"
      },
      {
       "cyr": "да не оди пеш по планина.",
       "lat": "da ne odi peš po planina.",
       "en": "so that he would not walk over the mountain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не ми пошол дедо на Ат-пазар,",
       "lat": "Ne mi pošol dedo na At-pazar,",
       "en": "Grandpa did not go to the Horse Market,"
      },
      {
       "cyr": "тук' ми пошол в' ладна меана,",
       "lat": "tuk' mi pošol v' ladna meana,",
       "en": "he went into a cold tavern,"
      },
      {
       "cyr": "си нарачал лута ракија.",
       "lat": "si naračal luta rakija.",
       "en": "and ordered strong rakija."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј море дедо, мераклија,",
       "lat": "Ej more dedo, meraklija,",
       "en": "Hey, old grandpa, a reveller,"
      },
      {
       "cyr": "еј море дедо, мајтапчија.",
       "lat": "ej more dedo, majtapčija.",
       "en": "hey, old grandpa, a joker."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го пратиле дедо на бербер,",
       "lat": "Go pratile dedo na berber,",
       "en": "They sent grandpa to the barber,"
      },
      {
       "cyr": "брадата да му ја избричат,",
       "lat": "bradata da mu ja izbričat,",
       "en": "to have his beard shaved,"
