    },
    {
     "lines": [
      {
       "cyr": "Поздрав да и' носиш на мајка ми",
       "lat": "Pozdrav da i' nosiš na majka mi",
       "en": "Carry greetings to my mother,"
      },
      {
       "cyr": "на мајка ми на жената ми",
