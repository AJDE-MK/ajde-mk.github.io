   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Море дојде време да си одам",
       "lat": "More dojde vreme da si odam",
       "en": "Hey, the time has come for me to go"
      },
      {
       "cyr": "да си одам, да се разделам",
       "lat": "da si odam, da se razdelam",
       "en": "to go, to part"
      },
      {
       "cyr": "од другари и другарки",
       "lat": "od drugari i drugarki",
       "en": "from comrades, male and female,"
      },
      {
       "cyr": "партизани, партизани.",
       "lat": "partizani, partizani.",
       "en": "partisans, partisans."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море ќе ме носат Горна Џумаја",
       "lat": "More ḱe me nosat Gorna Džumaja",
       "en": "Hey, they will take me to Gorna Dzhumaya"
      },
      {
       "cyr": "да ме мачат тираните,",
       "lat": "da me mačat tiranite,",
       "en": "where the tyrants will torture me,"
      },
      {
       "cyr": "тираните, фашистите.",
       "lat": "tiranite, fašistite.",
       "en": "the tyrants, the fascists."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако имам к'смет жив да се вратам,",
       "lat": "Ako imam k'smet živ da se vratam,",
       "en": "If I have the luck to return alive,"
      },
      {
       "cyr": "да раскажам мојве маки",
       "lat": "da raskažam mojve maki",
       "en": "I will tell about my sufferings"
      },
      {
       "cyr": "на другари и другарки.",
       "lat": "na drugari i drugarki.",
       "en": "to comrades, male and female."
      }
     ]
    }
   ]
  }
