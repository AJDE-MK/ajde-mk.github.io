   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сабота навечер",
       "lat": "Sabota navečer",
       "en": "Saturday evening"
      },
      {
       "cyr": "друштвото се собра пак.",
       "lat": "društvoto se sobra pak.",
       "en": "the company has gathered again."
      },
      {
       "cyr": "Мојата гитара",
       "lat": "Mojata gitara",
       "en": "My guitar"
      },
      {
       "cyr": "немо молчи и тагува.",
       "lat": "nemo molči i taguva.",
       "en": "silently keeps quiet and grieves."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "За сите наши вечери,",
       "lat": "Za site naši večeri,",
       "en": "For all our evenings,"
      },
      {
       "cyr": "тие песни до зори",
       "lat": "tie pesni do zori",
       "en": "those songs until dawn"
      },
      {
       "cyr": "и за сите среќни денови.",
       "lat": "i za site sreḱni denovi.",
       "en": "and for all the happy days."
      },
      {
       "cyr": "Исти моми љубевме,",
       "lat": "Isti momi ljubevme,",
       "en": "We loved the same girls,"
      },
      {
       "cyr": "тага, радост делевме,",
       "lat": "taga, radost delevme,",
       "en": "we shared sorrow and joy,"
      },
      {
       "cyr": "животот нас нè раздели,",
       "lat": "životot nas nè razdeli,",
       "en": "life parted us,"
      },
      {
       "cyr": "болка ни остави.",
       "lat": "bolka ni ostavi.",
       "en": "it left us pain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Свирете ми, свирете ми, еј другари",
       "lat": "Svirete mi, svirete mi, ej drugari",
       "en": "Play for me, play for me, hey friends,"
      },
      {
       "cyr": "свирете ми сè од срце.",
       "lat": "svirete mi sè od srce.",
       "en": "play for me everything from the heart."
      },
      {
       "cyr": "Таква песна, мелем песна,",
       "lat": "Takva pesna, melem pesna,",
       "en": "Such a song, a balm song,"
      },
      {
       "cyr": "мојта душа да ја лечи,",
       "lat": "mojta duša da ja leči,",
       "en": "to heal my soul,"
      },
      {
       "cyr": "свирете ми, еј другари.",
       "lat": "svirete mi, ej drugari.",
       "en": "play for me, hey friends."
      }
     ]
    },
    {
