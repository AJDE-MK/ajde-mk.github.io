   "stanzas": [
    {
     "lines": [
      {
       "cyr": "(Химна на Република Македонија)",
       "lat": "(Himna na Republika Makedonija)",
       "en": "(Anthem of the Republic of Macedonia)",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Денес над Македонија се раѓа",
       "lat": "Denes nad Makedonija se raǵa",
       "en": "Today over Macedonia is born",
       "en_mt": false
      },
      {
       "cyr": "ново сонце на слободата.",
       "lat": "novo sonce na slobodata.",
       "en": "the new sun of liberty.",
       "en_mt": false
      },
      {
       "cyr": "Македонците се борат",
       "lat": "Makedoncite se borat",
       "en": "Macedonians are fighting",
       "en_mt": false
      },
      {
       "cyr": "за своите правдини.",
       "lat": "za svoite pravdini.",
       "en": "for their own rights.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Одново сега знамето се вее",
       "lat": "Odnovo sega znameto se vee",
       "en": "Now once again the flag flutters,",
       "en_mt": false
      },
      {
       "cyr": "на Крушевската Република,",
       "lat": "na Kruševskata Republika,",
       "en": "(that) of the Krushevo Republic,",
       "en_mt": false
      },
      {
       "cyr": "на Гоце Делчев, Питу Гули",
       "lat": "na Goce Delčev, Pitu Guli",
       "en": "of Goce Delchev, Pitu Guli,",
       "en_mt": false
      },
      {
       "cyr": "Даме Груев, Сандански.",
       "lat": "Dame Gruev, Sandanski.",
       "en": "Dame Gruev, Sandanski.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Горите македонски шумно пеат",
       "lat": "Gorite makedonski šumno peat",
       "en": "The Macedonian woods resoundly sing",
       "en_mt": false
      },
      {
