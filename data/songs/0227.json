       "lat": "dali ḱe te dade za mene,",
       "en": "whether she will give you to me,"
      },
      {
       "cyr": "оф, аман, аман, аман,",
       "lat": "of, aman, aman, aman,",
       "en": "oh, aman, aman, aman,"
      },
      {
       "cyr": "за мене бре сирак, сиромав,",
       "lat": "za mene bre sirak, siromav,",
       "en": "to me, a poor orphan, a pauper,"
      },
      {
       "cyr": "оф, аман, аман, аман.",
       "lat": "of, aman, aman, aman.",
       "en": "oh, aman, aman, aman."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре лудо, а бре будало,",
       "lat": "- A bre ludo, a bre budalo,",
       "en": "- Hey fool, hey silly one,"
      },
      {
       "cyr": "јас си немам никој од рода,",
       "lat": "jas si nemam nikoj od roda,",
       "en": "I have nobody of my kin,"
      },
      {
       "cyr": "оф, аман, аман, аман,",
       "lat": "of, aman, aman, aman,",
       "en": "oh, aman, aman, aman,"
      },
      {
       "cyr": "сираче сум без мајка и татко,",
       "lat": "sirače sum bez majka i tatko,",
       "en": "I am an orphan without mother and father,"
      },
      {
       "cyr": "оф, аман, аман, аман.",
       "lat": "of, aman, aman, aman.",
       "en": "oh, aman, aman, aman."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако сакаш ти да ме земиш,",
