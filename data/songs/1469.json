   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Те чекам мила и пеам,",
       "lat": "Te čekam mila i peam,",
       "en": "I wait for you, dear, and sing,"
      },
      {
       "cyr": "на брегот цел ден пеам,",
       "lat": "na bregot cel den peam,",
       "en": "on the shore all day I sing,"
      },
      {
       "cyr": "сведоци се далгите",
       "lat": "svedoci se dalgite",
       "en": "the waves are witnesses"
      },
      {
       "cyr": "и солзите.",
       "lat": "i solzite.",
       "en": "and the tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми рече пак ќе се вратиш,",
       "lat": "Mi reče pak ḱe se vratiš,",
       "en": "You told me you would come back again,"
      },
      {
       "cyr": "за мене вистински патиш,",
       "lat": "za mene vistinski patiš,",
       "en": "for me a true path,"
      },
      {
       "cyr": "на разделба плачеше",
       "lat": "na razdelba plačeše",
       "en": "at parting you cried"
      },
      {
       "cyr": "и ми ветуваше.",
       "lat": "i mi vetuvaše.",
       "en": "and promised me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Милице, моја Милице,",
       "lat": "Milice, moja Milice,",
       "en": "Milica, my Milica,"
      },
      {
       "cyr": "не рони солзи по лице.",
       "lat": "ne roni solzi po lice.",
       "en": "do not shed tears down your face."
      },
      {
       "cyr": "Езерска ти убавице,",
       "lat": "Ezerska ti ubavice,",
       "en": "Beauty of the lake,"
      },
      {
       "cyr": "врати се на зајдисонце.",
       "lat": "vrati se na zajdisonce.",
       "en": "come back at sunset."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А сега збогум ти велам,",
       "lat": "A sega zbogum ti velam,",
       "en": "And now I say farewell to you,"
      },
      {
       "cyr": "со тебе судбина делам,",
       "lat": "so tebe sudbina delam,",
       "en": "I share my fate with you,"
      },
      {
       "cyr": "сведоци се далгите",
       "lat": "svedoci se dalgite",
       "en": "the waves are witnesses"
      },
      {
       "cyr": "и солзите.",
       "lat": "i solzite.",
       "en": "and the tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми рече пак ќе се вратиш,",
       "lat": "Mi reče pak ḱe se vratiš,",
