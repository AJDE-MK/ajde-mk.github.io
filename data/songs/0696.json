       "cyr": "Ангеле еден на мама, џанам,",
       "lat": "Angele eden na mama, džanam,",
       "en": "Angel, mother's only one, dear,"
      },
      {
       "cyr": "не дигај кула голема.",
       "lat": "ne digaj kula golema.",
       "en": "do not raise a great tower."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не мачи млади невести, џанам,",
       "lat": "Ne mači mladi nevesti, džanam,",
       "en": "Do not torment young brides, dear,"
      },
      {
       "cyr": "да носат песок и цигли.",
       "lat": "da nosat pesok i cigli.",
       "en": "to carry sand and bricks."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не мачи млади ергени, џанам,",
