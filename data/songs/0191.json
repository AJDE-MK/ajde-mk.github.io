   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Зашчо плачиш, зашчо жалваш,",
       "lat": "Zaščo plačiš, zaščo žalvaš,",
       "en": "Why do you weep, why do you mourn,"
      },
      {
       "cyr": "ти високи Лисец,",
       "lat": "ti visoki Lisec,",
       "en": "you high Lisec,"
      },
      {
       "cyr": "зашчо с' магла се покриваш",
       "lat": "zaščo s' magla se pokrivaš",
       "en": "why do you cover yourself with fog"
      },
      {
       "cyr": "од горе до долу?",
       "lat": "od gore do dolu?",
       "en": "from top to bottom?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас ќе плачам, јас ќе жалвам,",
       "lat": "Jas ḱe plačam, jas ḱe žalvam,",
       "en": "I will weep, I will mourn,"
      },
      {
       "cyr": "дор до век и веков,",
       "lat": "dor do vek i vekov,",
       "en": "forever and ever,"
      },
      {
       "cyr": "зашчо видов как' заклаја",
       "lat": "zaščo vidov kak' zaklaja",
       "en": "because I saw how they slaughtered"
      },
      {
       "cyr": "Лазо Папатрајков.",
       "lat": "Lazo Papatrajkov.",
       "en": "Lazo Papatrajkov."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Отрежаа му главата",
       "lat": "Otrežaa mu glavata",
       "en": "They cut off his head"
      },
      {
       "cyr": "за пендесет лири,",
       "lat": "za pendeset liri,",
       "en": "for fifty lira,"
      },
      {
       "cyr": "однесоа ја во Костур,",
       "lat": "odnesoa ja vo Kostur,",
       "en": "they carried it to Kostur,"
      },
      {
       "cyr": "бакшиш на деспотот.",
       "lat": "bakšiš na despotot.",
       "en": "a gift for the bishop."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Колку жално, срамно ести",
       "lat": "Kolku žalno, sramno esti",
       "en": "How sad and shameful it is"
      },
      {
       "cyr": "за грчкиот деспот,",
       "lat": "za grčkiot despot,",
       "en": "for the Greek bishop,"
      },
      {
       "cyr": "шчо го плате ѕверот Коте",
       "lat": "ščo go plate dzverot Kote",
       "en": "who paid the beast Kote"
      },
      {
       "cyr": "да заколи Лазо.",
       "lat": "da zakoli Lazo.",
       "en": "to slaughter Lazo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај да кажеме: „Бог да прости",
       "lat": "Aj da kažeme: „Bog da prosti",
       "en": "Come, let us say: 'God forgive"
      },
      {
       "cyr": "Лазо Поптрајков“!",
       "lat": "Lazo Poptrajkov“!",
       "en": "Lazo Poptrajkov!'"
      },
      {
       "cyr": "Првиот и најголемиот",
       "lat": "Prviot i najgolemiot",
       "en": "The first and greatest"
      },
      {
       "cyr": "костурски началник.",
       "lat": "kosturski načalnik.",
       "en": "chief of Kostur."
      }
     ]
    }
   ]
  }
