    {
     "lines": [
      {
       "cyr": "- Стојне црнаок невесто ле,",
       "lat": "- Stojne crnaok nevesto le,",
       "en": "- Stojna, black-eyed girl,",
       "en_mt": false
      },
      {
       "cyr": "Стојне, црнаок невесто,",
       "lat": "Stojne, crnaok nevesto,",
       "en": "- Stojna, black-eyed girl,",
       "en_mt": false
      },
      {
       "cyr": "пука лудото за тебе ле,",
       "lat": "puka ludoto za tebe le,",
       "en": "this crazy lad is consumed by love for you.",
       "en_mt": false
      },
      {
       "cyr": "пука лудото за тебе.",
       "lat": "puka ludoto za tebe.",
       "en": "this crazy lad is consumed by love for you.",
       "en_mt": false
      },
      {
       "cyr": "- Ако пука нека пукне ле,",
       "lat": "- Ako puka neka pukne le,",
       "en": "- If he is consumed, let him be.",
       "en_mt": false
      },
      {
       "cyr": "ако пука нека пукне.",
       "lat": "ako puka neka pukne.",
       "en": "- If he is consumed, let him be.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И синоќа едно пукна ле,",
