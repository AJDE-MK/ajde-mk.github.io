     "lines": [
      {
       "cyr": "Чифте чифте пајтонлари",
       "lat": "Čifte čifte pajtonlari",
       "en": "I serve you two, and two phaetons.",
       "en_mt": false
      },
      {
       "cyr": "гетирдим сана.",
       "lat": "getirdim sana.",
       "en": "I brought them to you.",
       "en_mt": true
      },
      {
       "cyr": "Не дедим сана, аман!",
       "lat": "Ne dedim sana, aman!",
       "en": "What I say to you, aman!",
       "en_mt": false
      },
      {
       "cyr": "Дарилма бана, опа!",
       "lat": "Darilma bana, opa!",
       "en": "Don't be angry with me! Hoppa!",
       "en_mt": false
      },
      {
