      {
       "cyr": "јас убав сон си сонував,",
       "lat": "jas ubav son si sonuvav,",
       "en": "I was dreaming a beautiful dream,"
      },
      {
       "cyr": "неа ја целивав.",
       "lat": "nea ja celivav.",
       "en": "I was kissing her in it."
      }
     ]
    },
    {
     "lines": [
      {
