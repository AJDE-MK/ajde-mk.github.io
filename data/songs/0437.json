   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Јас сум мома охриѓанка",
       "lat": "Jas sum moma ohriǵanka",
       "en": "I am a girl from Ohrid,"
      },
      {
       "cyr": "измамена од љубов,",
       "lat": "izmamena od ljubov,",
       "en": "cheated by love,"
      },
      {
       "cyr": "а сега сегде скитам",
       "lat": "a sega segde skitam",
       "en": "and now I wander everywhere,"
      },
      {
       "cyr": "достојна за љубов.",
       "lat": "dostojna za ljubov.",
       "en": "worthy of love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А пред петнајс' години",
       "lat": "A pred petnajs' godini",
       "en": "And fifteen years ago"
      },
      {
       "cyr": "бев млада како цвет,",
       "lat": "bev mlada kako cvet,",
       "en": "I was young as a flower,"
      },
      {
       "cyr": "а сега сегде скитам",
       "lat": "a sega segde skitam",
       "en": "and now I wander everywhere,"
      },
      {
       "cyr": "достојна за љубов.",
       "lat": "dostojna za ljubov.",
       "en": "worthy of love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кој и кој да минува",
       "lat": "Koj i koj da minuva",
       "en": "Whoever may pass by,"
      },
      {
       "cyr": "мене не ми е срам,",
       "lat": "mene ne mi e sram,",
       "en": "I am not ashamed,"
      },
      {
       "cyr": "ќе одам да го барам",
       "lat": "ḱe odam da go baram",
       "en": "I will go to look for"
      },
      {
       "cyr": "измамникот мој.",
       "lat": "izmamnikot moj.",
       "en": "my deceiver."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А вие мој другарки",
       "lat": "A vie moj drugarki",
       "en": "And you, my friends,"
      },
      {
       "cyr": "немој да ми се смејте,",
       "lat": "nemoj da mi se smejte,",
       "en": "do not laugh at me,"
      },
      {
       "cyr": "з'ш вие ушче не знајте",
       "lat": "z'š vie ušče ne znajte",
       "en": "you still do not know"
      },
      {
       "cyr": "што значит љубовта.",
       "lat": "što značit ljubovta.",
       "en": "what love means."
      }
     ]
    }
   ]
  }
