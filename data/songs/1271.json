     "lines": [
      {
       "cyr": "Војник ти заминуваш,",
       "lat": "Vojnik ti zaminuvaš,",
       "en": "Soldier, you are leaving,"
      },
      {
       "cyr": "мене ме млада оставаш,",
       "lat": "mene me mlada ostavaš,",
       "en": "you leave me, young as I am,"
      },
      {
       "cyr": "ако ме либе оставаш,",
       "lat": "ako me libe ostavaš,",
       "en": "if you leave me, my love,"
      },
      {
       "cyr": "само немој да ме забраваш.",
       "lat": "samo nemoj da me zabravaš.",
       "en": "just do not forget me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Секаде јас погледнувам,",
       "lat": "Sekade jas poglednuvam,",
       "en": "Everywhere I look,"
      },
      {
       "cyr": "тебе те побарувам,",
       "lat": "tebe te pobaruvam,",
       "en": "I search for you,"
      },
      {
       "cyr": "тебе те нема крај мене,",
       "lat": "tebe te nema kraj mene,",
       "en": "you are not beside me,"
      },
      {
       "cyr": "мене ме нема крај тебе.",
       "lat": "mene me nema kraj tebe.",
       "en": "I am not beside you."
      }
     ]
    },
    {
     "lines": [
      {
