      {
       "cyr": "Засвирил Стојан, посвирил,",
       "lat": "Zasviril Stojan, posviril,",
       "en": "Stojan began to play"
      },
      {
       "cyr": "со шарен кавал, леле, на село,",
       "lat": "so šaren kaval, lele, na selo,",
       "en": "a kaval with patterns, in the village,"
      },
      {
       "cyr": "со шарен кавал, леле, на село.",
       "lat": "so šaren kaval, lele, na selo.",
       "en": "a kaval with patterns, in the village."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дочула Стојна Попова",
       "lat": "Dočula Stojna Popova",
       "en": "Stojna Popova heard him,"
      },
      {
       "cyr": "метејќи рамни, леле, дворови,",
       "lat": "metejḱi ramni, lele, dvorovi,",
       "en": "while sweeping her yard,"
      },
      {
       "cyr": "метејќи рамни, леле, дворови.",
       "lat": "metejḱi ramni, lele, dvorovi.",
       "en": "while sweeping her yard."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- На ти ја мајко, метлава,",
       "lat": "- Na ti ja majko, metlava,",
       "en": "- Take this broom, mother,"
      },
      {
       "cyr": "да видам, мајко леле, кој свири",
       "lat": "da vidam, majko lele, koj sviri",
       "en": "let me see who is playing,"
      },
      {
       "cyr": "да видам, мајко леле, кој свири.",
