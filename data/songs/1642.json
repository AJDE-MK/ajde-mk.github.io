   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Од далеку еве идам,",
       "lat": "Od daleku eve idam,",
       "en": "Here I come from afar,"
      },
      {
       "cyr": "тебе сестро да те видам.",
       "lat": "tebe sestro da te vidam.",
       "en": "to see you, sister."
      },
      {
       "cyr": "Од постела крени глава,",
       "lat": "Od postela kreni glava,",
       "en": "Raise your head from your bed,"
      },
      {
       "cyr": "исправи полна става.",
       "lat": "ispravi polna stava.",
       "en": "stand up straight."
      },
      {
       "cyr": "Од далеку еве идам,",
       "lat": "Od daleku eve idam,",
       "en": "Here I come from afar,"
      },
      {
       "cyr": "тебе сестро да те видам.",
       "lat": "tebe sestro da te vidam.",
       "en": "to see you, sister."
      },
      {
       "cyr": "Во нашата куќа бела,",
       "lat": "Vo našata kuḱa bela,",
       "en": "In our white house,"
      },
      {
       "cyr": "да се врати радост, смеа.",
       "lat": "da se vrati radost, smea.",
       "en": "may joy and laughter return."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стани, стани, сестро мила,",
       "lat": "Stani, stani, sestro mila,",
       "en": "Get up, get up, dear sister,"
      },
      {
       "cyr": "боже, боже, дај ѝ сила",
       "lat": "bože, bože, daj ì sila",
       "en": "God, God, give her strength"
      },
      {
       "cyr": "да исправи раце, крила,",
       "lat": "da ispravi race, krila,",
       "en": "to straighten her arms, her wings,"
      },
      {
       "cyr": "да преболи болест дива,",
       "lat": "da preboli bolest diva,",
       "en": "to overcome this wild illness,"
      },
      {
       "cyr": "да ми мине тешка тага,",
       "lat": "da mi mine teška taga,",
       "en": "to overcome my heavy sorrow,"
      },
      {
       "cyr": "тешка тага, сестро драга.",
       "lat": "teška taga, sestro draga.",
       "en": "heavy sorrow, dear sister."
      }
     ]
    },
