   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Дали чекаш стара мајчице",
       "lat": "Dali čekaš stara majčice",
       "en": "Are you waiting, old mother,"
      },
      {
       "cyr": "писмо да ти напишам, да ти испратам?",
       "lat": "pismo da ti napišam, da ti ispratam?",
       "en": "for me to write you a letter, to send it to you?"
      },
      {
       "cyr": "Дали чекаш стара мајчице",
       "lat": "Dali čekaš stara majčice",
       "en": "Are you waiting, old mother,"
      },
      {
       "cyr": "глас од синот далечен, незаборавен?",
       "lat": "glas od sinot dalečen, nezaboraven?",
       "en": "for a word from your distant, unforgotten son?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Памти ме по добро,",
       "lat": "Pamti me po dobro,",
       "en": "Remember me kindly,"
      },
      {
       "cyr": "ти мајко стара, душо страдална.",
       "lat": "ti majko stara, dušo stradalna.",
       "en": "you old mother, suffering soul."
      },
      {
       "cyr": "Камен да сум студен, тебе",
       "lat": "Kamen da sum studen, tebe",
       "en": "Even if I were a cold stone, I"
      },
      {
       "cyr": "ќе те спомнам, прошка да ти побарам.",
       "lat": "ḱe te spomnam, proška da ti pobaram.",
       "en": "will remember you, to ask your forgiveness."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Порти да ми отвориш, мајко,",
       "lat": "Porti da mi otvoriš, majko,",
       "en": "Open the gates for me, mother,"
      },
      {
       "cyr": "оган да ми запалиш, стара.",
       "lat": "ogan da mi zapališ, stara.",
       "en": "light a fire for me, old one."
      },
      {
       "cyr": "Кога ќе се вратам,",
       "lat": "Koga ḱe se vratam,",
       "en": "When I return,"
      },
      {
       "cyr": "сонце да ми грее душа,",
       "lat": "sonce da mi gree duša,",
       "en": "let the sun warm my soul,"
      },
      {
       "cyr": "тебе да те прегрнам.",
       "lat": "tebe da te pregrnam.",
       "en": "let me embrace you."
      }
     ]
    },
