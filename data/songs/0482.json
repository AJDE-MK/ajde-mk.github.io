   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Четворица комити",
       "lat": "Četvorica komiti",
       "en": "Four komiti",
       "en_mt": false
      },
      {
       "cyr": "од балкани слегвеа,",
       "lat": "od balkani slegvea,",
       "en": "came down from the mountains,",
       "en_mt": false
      },
      {
       "cyr": "од балкан ми слегоја",
       "lat": "od balkan mi slegoja",
       "en": "came down from the mountains",
       "en_mt": false
      },
      {
       "cyr": "право тргат за Прилеп.",
       "lat": "pravo trgat za Prilep.",
       "en": "heading straight for Prilep.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Право тргат на Прилеп",
       "lat": "Pravo trgat na Prilep",
       "en": "Heading straight for Prilep,",
       "en_mt": false
      },
      {
       "cyr": "кај Методи Крапчета.",
       "lat": "kaj Metodi Krapčeta.",
       "en": "to Metodi Krapche.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не го нашле Крапчета",
       "lat": "Ne go našle Krapčeta",
       "en": "They didn't find Krapche,",
       "en_mt": false
      },
      {
       "cyr": "тук' ја нашле невестата.",
       "lat": "tuk' ja našle nevestata.",
       "en": "instead they found his bride.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Добро утро невесто.",
       "lat": "- Dobro utro nevesto.",
       "en": "- Good morning, bride.",
       "en_mt": false
      },
      {
       "cyr": "- Дал бог добро, комити.",
       "lat": "- Dal bog dobro, komiti.",
       "en": "- May God bring you good, komiti.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Појдите во одаја",
       "lat": "- Pojdite vo odaja",
       "en": "- Come into the room",
       "en_mt": false
      },
      {
       "cyr": "ракија да пијате.",
       "lat": "rakija da pijate.",
       "en": "and drink some rakija.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не сме дошле за ракија,",
       "lat": "Ne sme došle za rakija,",
       "en": "We haven't come for rakija,",
       "en_mt": false
      },
      {
       "cyr": "туку за амането.",
       "lat": "tuku za amaneto.",
       "en": "but for the inheritance.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го бараме Крапчета",
       "lat": "Go barame Krapčeta",
       "en": "We are looking for Krapche,",
       "en_mt": false
      },
      {
       "cyr": "да ни даде сто лири.",
       "lat": "da ni dade sto liri.",
       "en": "so he can give us 100 liri.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да ни даде сто лири",
       "lat": "Da ni dade sto liri",
       "en": "So he can give us 100 liri",
       "en_mt": false
      },
      {
       "cyr": "за касата комитска.",
       "lat": "za kasata komitska.",
       "en": "for the komiti cashbox.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пушки да си купиме",
       "lat": "Puški da si kupime",
       "en": "So we may buy guns",
       "en_mt": false
      },
      {
       "cyr": "за четата комитска.",
       "lat": "za četata komitska.",
       "en": "for the company of komiti.",
       "en_mt": false
      },
      {
       "cyr": "Пушки да си купиме,",
       "lat": "Puški da si kupime,",
       "en": "So we may buy guns",
       "en_mt": false
      },
      {
       "cyr": "в' борба да си одиме.",
       "lat": "v' borba da si odime.",
       "en": "to march into battle.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "В' борба да си одиме,",
       "lat": "V' borba da si odime,",
       "en": "To march into battle",
       "en_mt": false
      },
      {
       "cyr": "земја да ослободиме.",
       "lat": "zemja da oslobodime.",
       "en": "and free our land.",
       "en_mt": false
      },
      {
       "cyr": "Земја да ослободиме,",
       "lat": "Zemja da oslobodime,",
       "en": "To free our land,",
       "en_mt": false
      },
      {
       "cyr": "земја Македонија.",
       "lat": "zemja Makedonija.",
       "en": "the land of Macedonia.",
