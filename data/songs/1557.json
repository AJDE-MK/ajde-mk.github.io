   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Силен бој ми се заврза,",
       "lat": "Silen boj mi se zavrza,",
       "en": "A fierce battle broke out for me,"
      },
      {
       "cyr": "на Крушево, Мечкин Камен.",
       "lat": "na Kruševo, Mečkin Kamen.",
       "en": "at Krushevo, at Mechkin Kamen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ем од пушки, ем од бомби,",
       "lat": "Em od puški, em od bombi,",
       "en": "Both from rifles and from bombs,"
      },
      {
       "cyr": "јасно небо се затемни.",
       "lat": "jasno nebo se zatemni.",
       "en": "the clear sky grew dark."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Извика се Питу Гули",
       "lat": "Izvika se Pitu Guli",
       "en": "Pitu Guli cried out"
      },
      {
       "cyr": "на Милана Даскалчето:",
       "lat": "na Milana Daskalčeto:",
       "en": "to Milan the Little Teacher:"
      },
      {
       "cyr": "- Ој, Милане, мили брате,",
       "lat": "- Oj, Milane, mili brate,",
       "en": "- Oh, Milan, dear brother,"
      },
      {
       "cyr": "ој, Милане мили брате!",
       "lat": "oj, Milane mili brate!",
       "en": "oh, Milan, dear brother!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја фрли си тешки бомби,",
       "lat": "Ja frli si teški bombi,",
       "en": "Hurl your heavy bombs,"
      },
      {
       "cyr": "малце аскер да растераш,",
       "lat": "malce asker da rasteraš,",
       "en": "to scatter the army a little,"
      },
      {
       "cyr": "мене патот да отвориш.",
       "lat": "mene patot da otvoriš.",
       "en": "to open the road for me."
      }
     ]
    }
   ]
  }
