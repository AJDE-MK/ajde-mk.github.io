   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Слушам кај шумат шумите, буките",
       "lat": "Slušam kaj šumat šumite, bukite",
       "en": "I hear the forests rustling, the beeches,"
      },
      {
       "cyr": "Слушам кај шумат буките,",
       "lat": "Slušam kaj šumat bukite,",
       "en": "I hear the beeches rustling,"
      },
      {
       "cyr": "плачат за војводата, капиданот.",
       "lat": "plačat za vojvodata, kapidanot.",
       "en": "they are crying for the duke, the captain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Другари верни другари Македонци,",
       "lat": "Drugari verni drugari Makedonci,",
       "en": "- Worthy friends, Macedonian friends,"
      },
      {
       "cyr": "кога низ село врвите, врвите,",
       "lat": "koga niz selo vrvite, vrvite,",
       "en": "when you pass through my village,"
      },
      {
       "cyr": "кога низ село врвите",
       "lat": "koga niz selo vrvite",
       "en": "when you pass through the village,"
      },
      {
       "cyr": "со коњи да не тропате, не тропате.",
       "lat": "so konji da ne tropate, ne tropate.",
       "en": "don't rumble with the horses, don't rumble."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Со коњи да не тропате, тропате,",
       "lat": "So konji da ne tropate, tropate,",
       "en": "Don't rumble with the horses,"
      },
      {
       "cyr": "со коњи да не тропате,",
       "lat": "so konji da ne tropate,",
       "en": "with the horses don't you rumble,"
      },
      {
       "cyr": "со пушки да не фрлате, не фрлате.",
       "lat": "so puški da ne frlate, ne frlate.",
       "en": "don't shoot with the rifles, don't shoot them."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да не ве чуе мајка ми, старата,",
       "lat": "Da ne ve čue majka mi, starata,",
       "en": "So my old mother doesn't hear you,"
      },
      {
       "cyr": "да не ве чуе мајка ми,",
       "lat": "da ne ve čue majka mi,",
       "en": "so my mother doesn't notice you,"
      },
      {
       "cyr": "ќе ве праша за мене, аман за мене.",
       "lat": "ḱe ve praša za mene, aman za mene.",
       "en": "she'll ask you about me, oh about me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Каде е син ми Костадин, Костадин?",
       "lat": "Kade e sin mi Kostadin, Kostadin?",
       "en": "- Where is my son Kostadin, Kostadin?"
      },
      {
       "cyr": "Каде је син ми Костадин,",
       "lat": "Kade je sin mi Kostadin,",
       "en": "Where is my son Kostadin,"
      },
      {
