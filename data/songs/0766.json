    {
     "lines": [
      {
       "cyr": "Никнала трева зелена,",
       "lat": "Niknala treva zelena,",
       "en": "As green grass started to grow,",
       "en_mt": false
      },
      {
       "cyr": "ми разлистала гората,",
       "lat": "mi razlistala gorata,",
       "en": "and the forest turned green,",
       "en_mt": false
      },
      {
       "cyr": "излегол Дејан војвода,",
       "lat": "izlegol Dejan vojvoda,",
       "en": "Dejan vojvoda went out,",
       "en_mt": false
      },
      {
       "cyr": "низ таа славна Дебарца,",
       "lat": "niz taa slavna Debarca,",
       "en": "through famous Debarca,",
       "en_mt": false
      },
      {
       "cyr": "излегол Дејан војвода,",
       "lat": "izlegol Dejan vojvoda,",
       "en": "Dejan vojvoda went out",
       "en_mt": false
      },
      {
       "cyr": "со својта верна дружина.",
       "lat": "so svojta verna družina.",
       "en": "with his faithful platoon.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "До што е село прошетал,",
       "lat": "Do što e selo prošetal,",
       "en": "He went to all villages",
       "en_mt": false
      },
      {
       "cyr": "до девет мајки тој видел,",
       "lat": "do devet majki toj videl,",
       "en": "and saw nine mothers,",
       "en_mt": false
      },
      {
       "cyr": "до девет мајки тој видел,",
       "lat": "do devet majki toj videl,",
       "en": "he saw nine mothers,",
       "en_mt": false
      },
      {
       "cyr": "во црно сè облечени.",
       "lat": "vo crno sè oblečeni.",
       "en": "all dressed in black.",
       "en_mt": false
      },
      {
       "cyr": "До девет мајки тој видел,",
       "lat": "Do devet majki toj videl,",
       "en": "He saw nine mothers,",
       "en_mt": false
      },
      {
