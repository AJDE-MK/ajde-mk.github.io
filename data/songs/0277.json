 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Три години болен лежав",
       "lat": "Tri godini bolen ležav",
       "en": "I have been lying sick for three years,"
      },
      {
       "cyr": "аман, аман, аман,",
       "lat": "aman, aman, aman,",
       "en": "oh, oh, oh,"
      },
      {
       "cyr": "за твоите црни очи.",
       "lat": "za tvoite crni oči.",
       "en": "for your black eyes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Отвори го пенџерчето",
       "lat": "Otvori go pendžerčeto",
       "en": "Open the little window,"
      },
      {
       "cyr": "аман, аман, аман,",
       "lat": "aman, aman, aman,",
       "en": "oh, oh, oh,"
      },
      {
       "cyr": "да ти речам до два збора",
       "lat": "da ti rečam do dva zbora",
       "en": "I want to tell you a word or two,"
      },
      {
       "cyr": "отвори го и пак затвори го.",
       "lat": "otvori go i pak zatvori go.",
       "en": "open it and then close it again."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Очите ми, очите ти",
       "lat": "Očite mi, očite ti",
       "en": "My eyes, your eyes,"
      },
      {
       "cyr": "аман, аман, аман,",
       "lat": "aman, aman, aman,",
       "en": "oh, oh, oh,"
      },
      {
       "cyr": "тие ми се стројниците.",
       "lat": "tie mi se strojnicite.",
       "en": "they are my matchmakers."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Милување, бакнување",
       "lat": "Miluvanje, baknuvanje",
       "en": "Caressing, kissing,"
      },
      {
       "cyr": "аман, аман, аман",
       "lat": "aman, aman, aman",
       "en": "oh, oh, oh,"
      },
      {
       "cyr": "тоа се, велат, прикаски.",
       "lat": "toa se, velat, prikaski.",
       "en": "those are, they say, just stories."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај повтори, избаци ме",
       "lat": "Aj povtori, izbaci me",
       "en": "Come on, do it again, kiss me,"
      },
      {
       "cyr": "аман, аман, аман,",
       "lat": "aman, aman, aman,",
       "en": "oh, oh, oh,"
      },
      {
       "cyr": "да не легнам и да умрам.",
       "lat": "da ne legnam i da umram.",
       "en": "or I will lie down and die."
      }
     ]
    }
   ]
  }
 ],
