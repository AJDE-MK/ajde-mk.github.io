   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Вино пијам, ем ракија,",
       "lat": "Vino pijam, em rakija,",
       "en": "I drink wine and rakija,"
      },
      {
       "cyr": "коња јавам аџамија.",
       "lat": "konja javam adžamija.",
       "en": "I ride my horse, Adzamija."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Коњ ме шета горе, доле,",
       "lat": "Konj me šeta gore, dole,",
       "en": "The horse walks me up and down,"
      },
      {
       "cyr": "горе, доле низ тоа поле.",
       "lat": "gore, dole niz toa pole.",
       "en": "up and down across that field."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ме одведе в' ладна меана,",
       "lat": "Me odvede v' ladna meana,",
       "en": "It led me to a cold tavern,"
      },
      {
       "cyr": "у меана до три моми.",
       "lat": "u meana do tri momi.",
       "en": "in the tavern there were three girls."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Прва точи, другата носи,",
       "lat": "Prva toči, drugata nosi,",
       "en": "The first pours, the second carries,"
      },
      {
       "cyr": "а третата мене ме гледа.",
       "lat": "a tretata mene me gleda.",
       "en": "and the third looks at me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па ја качив на коњчето,",
       "lat": "Pa ja kačiv na konjčeto,",
       "en": "So I lifted her onto the little horse,"
      },
      {
       "cyr": "ја однесов право дома.",
       "lat": "ja odnesov pravo doma.",
       "en": "and took her straight home."
      }
     ]
    }
   ]
  }
 ],
