   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Јас сум од дете мачено,",
       "lat": "Jas sum od dete mačeno,",
       "en": "I have been a tormented child,"
      },
      {
       "cyr": "ниту една солза немам плачено,",
       "lat": "nitu edna solza nemam plačeno,",
       "en": "I have not cried a single tear,"
      },
      {
       "cyr": "само една тежина",
       "lat": "samo edna težina",
       "en": "only one weight"
      },
      {
       "cyr": "машко срце искина:",
       "lat": "maško srce iskina:",
       "en": "torn a man's heart:"
      },
      {
       "cyr": "мојта љуба голема",
       "lat": "mojta ljuba golema",
       "en": "my great love"
      },
      {
       "cyr": "за друг ми ја дадоа.",
       "lat": "za drug mi ja dadoa.",
       "en": "was given for another."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Распукај срце ко Шар Планина,",
       "lat": "Raspukaj srce ko Šar Planina,",
       "en": "Crack, my heart like Shar Mountain,"
      },
      {
       "cyr": "на сто парчиња,",
       "lat": "na sto parčinja,",
       "en": "into a hundred pieces,"
      },
      {
       "cyr": "што ќе ми срце кога немам јас",
       "lat": "što ḱe mi srce koga nemam jas",
       "en": "what will my heart do when I have"
      },
      {
       "cyr": "кого да љубам.",
       "lat": "kogo da ljubam.",
       "en": "no one to love."
      },
      {
       "cyr": "Дај ми Боже бар да остарам,",
       "lat": "Daj mi Bože bar da ostaram,",
       "en": "God grant me at least to grow old,"
      },
      {
       "cyr": "да заборавам.",
       "lat": "da zaboravam.",
       "en": "to forget."
      },
      {
       "cyr": "Луѓе велат време лечи сè,",
       "lat": "Luǵe velat vreme leči sè,",
       "en": "People say time heals everything,"
      },
      {
       "cyr": "дај, остари ме.",
       "lat": "daj, ostari me.",
       "en": "come on, make me old."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас и од ерген многу не видов,",
       "lat": "Jas i od ergen mnogu ne vidov,",
       "en": "I haven't seen much while I was a bachelor,"
      },
      {
       "cyr": "сам со стара мајка в' град не отидов,",
       "lat": "sam so stara majka v' grad ne otidov,",
       "en": "living alone with an old mother, I haven't gone to the city,"
      },
      {
       "cyr": "а и таа пустата,",
       "lat": "a i taa pustata,",
       "en": "and her poor soul,"
      },
      {
       "cyr": "невеста не дочека.",
       "lat": "nevesta ne dočeka.",
       "en": "didn't live long enough to see me with a bride."
      },
      {
       "cyr": "Трошна куќа остана",
       "lat": "Trošna kuḱa ostana",
       "en": "A dilapidated house remained"
      },
      {
       "cyr": "така, необелена.",
       "lat": "taka, neobelena.",
       "en": "like that, unpainted."
      }
     ]
    },
