       "en": "from three sides,"
      },
      {
       "cyr": "првата пусија ле браќа,",
       "lat": "prvata pusija le braḱa,",
       "en": "the first trap, brothers,"
      },
      {
       "cyr": "Јане Сандански,",
       "lat": "Jane Sandanski,",
       "en": "Jane Sandanski,"
      },
      {
       "cyr": "втората пусија ле браќа",
       "lat": "vtorata pusija le braḱa",
       "en": "the second trap, brothers,"
      },
      {
       "cyr": "на Хаџи Димов.",
