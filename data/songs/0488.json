 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Црна се чума зададе",
       "lat": "Crna se čuma zadade",
       "en": "The black plague has struck"
      },
      {
       "cyr": "там' долу в' Македонија,",
       "lat": "tam' dolu v' Makedonija,",
       "en": "yonder in Macedonia"
      },
      {
       "cyr": "там' долу в' Демир Капија.",
       "lat": "tam' dolu v' Demir Kapija.",
       "en": "yonder in Demir Kapija."
      },
      {
       "cyr": "Кој ќе се јунак избере",
       "lat": "Koj ḱe se junak izbere",
       "en": "Which hero will come forward"
      },
      {
       "cyr": "чумата да изгони",
       "lat": "čumata da izgoni",
       "en": "to eliminate the plague"
      },
      {
       "cyr": "од жална Македонија?",
       "lat": "od žalna Makedonija?",
       "en": "from suffering Macedonia?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Избрал се, ми се изнашол",
       "lat": "Izbral se, mi se iznašol",
       "en": "Young Goce Delchev, the captain"
      },
      {
       "cyr": "млад Гоце Делчев војвода,",
       "lat": "mlad Goce Delčev vojvoda,",
       "en": "volunteered"
      },
      {
       "cyr": "чумата да ја пропади.",
       "lat": "čumata da ja propadi.",
       "en": "to eliminate the plague."
      },
      {
       "cyr": "С' негова верна дружина",
       "lat": "S' negova verna družina",
       "en": "With his devoted group of friends"
      },
      {
       "cyr": "тој ојде в' Македонија,",
       "lat": "toj ojde v' Makedonija,",
       "en": "he travelled to Macedonia"
      },
      {
       "cyr": "там долу Демир Капија.",
       "lat": "tam dolu Demir Kapija.",
       "en": "yonder to Demir Kapija."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гоце на дружба говори:",
       "lat": "Goce na družba govori:",
       "en": "Goce said to his group of friends:"
      },
      {
       "cyr": "- Дружино верна зговорна,",
       "lat": "- Družino verna zgovorna,",
       "en": "- My friends, you true followers,"
      },
      {
       "cyr": "кога ќе вие врвите",
       "lat": "koga ḱe vie vrvite",
       "en": "when you come back"
      },
      {
       "cyr": "низ моја града Кукуша,",
       "lat": "niz moja grada Kukuša,",
       "en": "to my town Kukush"
      },
      {
       "cyr": "мајка ми ќе ве запраша:",
       "lat": "majka mi ḱe ve zapraša:",
       "en": "my mother will say:"
      },
      {
       "cyr": "„каде е Гоце војвода“?",
       "lat": "„kade e Goce vojvoda“?",
       "en": "Where is Goce, the vojvoda?"
      },
      {
       "cyr": "Вие ќе ѝ нејзе кажете:",
       "lat": "Vie ḱe ì nejze kažete:",
       "en": "And you shall tell her:"
      },
      {
       "cyr": "„Гоце се, мајко, ожени",
       "lat": "„Goce se, majko, oženi",
       "en": "Goce, mother, is marrying"
      },
      {
       "cyr": "за мајка Македонија“.",
       "lat": "za majka Makedonija“.",
       "en": "mother Macedonia."
      }
     ]
    }
   ]
  }
 ],
