   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Од што те љубам, не спијам,",
       "lat": "Od što te ljubam, ne spijam,",
       "en": "Because I love you, I do not sleep,"
      },
      {
       "cyr": "в' меани чаши испивам.",
       "lat": "v' meani čaši ispivam.",
       "en": "in taverns I drain glasses."
      },
      {
       "cyr": "Ноќите ми се бессони,",
       "lat": "Noḱite mi se bessoni,",
       "en": "My nights are sleepless,"
      },
      {
       "cyr": "постели без тебе студени.",
       "lat": "posteli bez tebe studeni.",
       "en": "beds cold without you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Севдано, Севдо моја, што ми стори,",
       "lat": "Sevdano, Sevdo moja, što mi stori,",
       "en": "Sevdana, my Sevda, what have you done to me,"
      },
      {
       "cyr": "љута рана на срце ми отвори.",
       "lat": "ljuta rana na srce mi otvori.",
       "en": "you opened a bitter wound in my heart."
      },
      {
       "cyr": "Севдано, Севдо моја најголема,",
       "lat": "Sevdano, Sevdo moja najgolema,",
       "en": "Sevdana, my greatest Sevda,"
      },
      {
       "cyr": "моја стара рано, непреболена.",
       "lat": "moja stara rano, neprebolena.",
       "en": "my old wound, never healed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Чаршија збори за мене",
       "lat": "Čaršija zbori za mene",
       "en": "The bazaar talks about me,"
      },
      {
       "cyr": "дека сум голем бекрија.",
       "lat": "deka sum golem bekrija.",
       "en": "that I am a great bachelor-drinker."
      },
      {
       "cyr": "Дека сум прв мераклија,",
       "lat": "Deka sum prv meraklija,",
       "en": "That I am the first reveller,"
      },
      {
       "cyr": "на песна и на љута ракија.",
       "lat": "na pesna i na ljuta rakija.",
       "en": "for song and for strong brandy."
      }
     ]
    },
