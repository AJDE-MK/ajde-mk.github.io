 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Стани моме да заиграш,",
       "lat": "Stani mome da zaigraš,",
       "en": "Stand up girl and dance"
      },
      {
       "cyr": "да те гледам весел јас,",
       "lat": "da te gledam vesel jas,",
       "en": "let me see you with joy,"
      },
      {
       "cyr": "чифте, чамче игриво,",
       "lat": "čifte, čamče igrivo,",
       "en": "a couple of playful dances,"
      },
      {
       "cyr": "наше оро убаво.",
       "lat": "naše oro ubavo.",
       "en": "our dance is beautiful."
      },
      {
       "cyr": "Опа нина нинанај, нинај на",
       "lat": "Opa nina ninanaj, ninaj na",
       "en": "Opa nina ninanai, nina nai na"
      },
      {
       "cyr": "нинанај мило моме нинанајнај.",
       "lat": "ninanaj milo mome ninanajnaj.",
       "en": "nina nai dear girl nina nai nai."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Изви моме снагата ти,",
       "lat": "Izvi mome snagata ti,",
       "en": "Curl your body, girl,"
      },
      {
       "cyr": "твојта снага убава,",
       "lat": "tvojta snaga ubava,",
       "en": "your beautiful body,"
      },
      {
       "cyr": "да те гледам, да пејам",
       "lat": "da te gledam, da pejam",
       "en": "let me see you, let me sing,"
      },
      {
       "cyr": "оти само еднаш живеам.",
       "lat": "oti samo ednaš živeam.",
       "en": "because I live only once."
      },
      {
       "cyr": "Опа нина нинанај, нинај на",
       "lat": "Opa nina ninanaj, ninaj na",
       "en": "Opa nina ninanai, nina nai na"
      },
      {
       "cyr": "нинанај мило моме нинанајнај.",
       "lat": "ninanaj milo mome ninanajnaj.",
       "en": "nina nai dear girl nina nai nai."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Само еднаш се живее",
       "lat": "Samo ednaš se živee",
       "en": "We live just once"
      },
      {
       "cyr": "овој живот лажовен,",
       "lat": "ovoj život lažoven,",
       "en": "this cunning life,"
      },
      {
       "cyr": "дур' сум сум жив да се рад'вам",
       "lat": "dur' sum sum živ da se rad'vam",
       "en": "while I am alive, let me rejoice"
      },
      {
       "cyr": "и да умрам да не жалам.",
       "lat": "i da umram da ne žalam.",
       "en": "and if I die, I won't complain."
      },
      {
       "cyr": "Опа нина нинанај, нинај на",
       "lat": "Opa nina ninanaj, ninaj na",
       "en": "Opa nina ninanai, nina nai na"
      },
      {
       "cyr": "нинанај мило моме нинанајнај.",
       "lat": "ninanaj milo mome ninanajnaj.",
       "en": "nina nai dear girl nina nai nai."
      }
     ]
    }
   ]
  }
