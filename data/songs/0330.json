   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Матен Вардар течеше",
       "lat": "Maten Vardar tečeše",
       "en": "The Vardar flowed muddy,"
      },
      {
       "cyr": "матиле го солзите",
       "lat": "matile go solzite",
       "en": "tears had clouded it,"
      },
      {
       "cyr": "плаче Македонија",
       "lat": "plače Makedonija",
       "en": "Macedonia weeps,"
      },
      {
       "cyr": "деца кој ги зема.",
       "lat": "deca koj gi zema.",
       "en": "who took her children."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "С' векови сум патила",
       "lat": "S' vekovi sum patila",
       "en": "For centuries I have suffered,"
      },
      {
       "cyr": "ропски живот водела",
       "lat": "ropski život vodela",
       "en": "I led a slave's life,"
      },
      {
       "cyr": "на крило од Вардарот",
       "lat": "na krilo od Vardarot",
       "en": "on the wing of the Vardar"
      },
      {
       "cyr": "златно Скопје створила.",
       "lat": "zlatno Skopje stvorila.",
       "en": "I created golden Skopje."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Едно утро жалосно",
       "lat": "Edno utro žalosno",
       "en": "One sorrowful morning"
      },
      {
       "cyr": "земјата се затресе",
       "lat": "zemjata se zatrese",
       "en": "the earth shook"
      },
      {
       "cyr": "и од скутот мајчин",
       "lat": "i od skutot majčin",
       "en": "and from the mother's lap"
      },
      {
       "cyr": "чедо Скопје однесе.",
       "lat": "čedo Skopje odnese.",
       "en": "it carried off the child Skopje."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не плачи сестро Србијо,",
       "lat": "Ne plači sestro Srbijo,",
       "en": "Do not weep, sister Serbia,"
      },
      {
       "cyr": "ни вие други сестрички",
       "lat": "ni vie drugi sestrički",
       "en": "nor you other little sisters,"
      },
      {
       "cyr": "живее Македонија",
       "lat": "živee Makedonija",
       "en": "Macedonia lives,"
      },
      {
       "cyr": "ново Скопје ќе роди,",
       "lat": "novo Skopje ḱe rodi,",
       "en": "she will give birth to a new Skopje,"
      },
      {
       "cyr": "мајка Македонија",
       "lat": "majka Makedonija",
       "en": "mother Macedonia"
      },
      {
       "cyr": "лично чедо ќе роди.",
       "lat": "lično čedo ḱe rodi.",
       "en": "will give birth to a beautiful child."
      }
     ]
    }
