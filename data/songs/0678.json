    {
     "lines": [
      {
       "cyr": "Македонијо, жална ле мајко",
       "lat": "Makedonijo, žalna le majko",
       "en": "Macedonia, sorrowful mother,"
      },
      {
       "cyr": "доста си страдала,",
       "lat": "dosta si stradala,",
       "en": "you have suffered enough,"
      },
      {
       "cyr": "страдала си, жална ле мајко,",
       "lat": "stradala si, žalna le majko,",
       "en": "you have suffered, sorrowful mother,"
      },
      {
       "cyr": "цели пет векови.",
       "lat": "celi pet vekovi.",
       "en": "for five whole centuries."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако сакаш, горо ле мајко",
       "lat": "Ako sakaš, goro le majko",
       "en": "If you wish, forest, mother,"
      },
      {
       "cyr": "јас да си пораснам,",
       "lat": "jas da si porasnam,",
       "en": "let me grow up,"
      },
      {
       "cyr": "села ќе соберам ле, мајко",
       "lat": "sela ḱe soberam le, majko",
       "en": "I will gather villages, mother,"
      },
      {
       "cyr": "чета ќе направам.",
       "lat": "četa ḱe napravam.",
       "en": "I will form a band of fighters."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "В' планина ќе одам ле мајко",
       "lat": "V' planina ḱe odam le majko",
       "en": "I will go into the mountain, mother,"
      },
      {
       "cyr": "с' душман ќе се бијам,",
       "lat": "s' dušman ḱe se bijam,",
       "en": "I will fight the enemy,"
      },
      {
       "cyr": "с' душман ќе се бијам ле мајко",
       "lat": "s' dušman ḱe se bijam le majko",
       "en": "I will fight the enemy, mother,"
      },
      {
       "cyr": "знаме ќе развијам.",
       "lat": "zname ḱe razvijam.",
       "en": "I will unfurl the banner."
      }
     ]
    },
    {
     "lines": [
      {
