   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Душа за ништо не се продава",
       "lat": "Duša za ništo ne se prodava",
       "en": "A soul is not sold for anything,"
      },
      {
       "cyr": "крвта со вода не се менува.",
       "lat": "krvta so voda ne se menuva.",
       "en": "blood is not exchanged for water."
      },
      {
       "cyr": "Господ ни дарил долги корени,",
       "lat": "Gospod ni daril dolgi koreni,",
       "en": "The Lord gave us long roots,"
      },
      {
       "cyr": "признајте еднаш: не сме Елини",
       "lat": "priznajte ednaš: ne sme Elini",
       "en": "admit once: we are not Hellenes,"
      },
      {
       "cyr": "признајте еднаш: сме Македонци.",
       "lat": "priznajte ednaš: sme Makedonci.",
       "en": "admit once: we are Macedonians."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Егејки мајки нè родија,",
       "lat": "Egejki majki nè rodija,",
       "en": "Aegean mothers bore us,"
      },
      {
       "cyr": "тие со Егеј нè задоија.",
       "lat": "tie so Egej nè zadoija.",
       "en": "they nursed us with the Aegean."
      },
      {
       "cyr": "Мајчинска клетва ни оставија,",
       "lat": "Majčinska kletva ni ostavija,",
       "en": "They left us a mother's curse,"
      },
      {
       "cyr": "клетва за нашата Македонија.",
       "lat": "kletva za našata Makedonija.",
       "en": "a curse for our Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тие што тешки маки тргале,",
       "lat": "Tie što teški maki trgale,",
       "en": "Those who endured heavy hardships"
      },
      {
       "cyr": "својата судба ја проколнале.",
       "lat": "svojata sudba ja prokolnale.",
       "en": "cursed their own fate."
      },
      {
       "cyr": "Само што пеат песни нашински,",
       "lat": "Samo što peat pesni našinski,",
       "en": "They only sing songs of our own,"
      },
      {
       "cyr": "само што мислат на македонски.",
       "lat": "samo što mislat na makedonski.",
       "en": "they only think in Macedonian."
      }
     ]
    },
