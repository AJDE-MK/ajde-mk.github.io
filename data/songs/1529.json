   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Таму далеку на Балканот,",
       "lat": "Tamu daleku na Balkanot,",
       "en": "There far away in the Balkans,"
      },
      {
       "cyr": "там' е мојто родно село,",
       "lat": "tam' e mojto rodno selo,",
       "en": "there is my native village,"
      },
      {
       "cyr": "там' е мојот крај,",
       "lat": "tam' e mojot kraj,",
       "en": "there is my homeland,"
      },
      {
       "cyr": "там' ме мајка мене роди,",
       "lat": "tam' me majka mene rodi,",
       "en": "there my mother bore me,"
      },
      {
       "cyr": "там' ме срце води.",
       "lat": "tam' me srce vodi.",
       "en": "there my heart leads me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Македонијо, земјо најмила,",
       "lat": "Makedonijo, zemjo najmila,",
       "en": "Macedonia, dearest land,"
      },
      {
       "cyr": "еј ти роден крај",
       "lat": "ej ti roden kraj",
       "en": "hey, you my native land,"
      },
      {
       "cyr": "в' срце те носам јас.",
       "lat": "v' srce te nosam jas.",
       "en": "I carry you in my heart."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кај што извира Вардар,",
       "lat": "Kaj što izvira Vardar,",
       "en": "Where the Vardar rises,"
      },
      {
       "cyr": "па до Егејско Море,",
       "lat": "pa do Egejsko More,",
       "en": "all the way to the Aegean Sea,"
      },
      {
       "cyr": "од Пирин дур' до Шара,",
       "lat": "od Pirin dur' do Šara,",
       "en": "from Pirin to Shar,"
      },
      {
       "cyr": "таму е наш'та Македонија.",
       "lat": "tamu e naš'ta Makedonija.",
       "en": "there is our Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Велат некогаш на Илинден,",
       "lat": "Velat nekogaš na Ilinden,",
       "en": "They say that once on Ilinden,"
      },
      {
       "cyr": "тоа беше деветстотин'",
       "lat": "toa beše devetstotin'",
       "en": "it was nineteen hundred"
      },
      {
       "cyr": "и третата година",
       "lat": "i tretata godina",
       "en": "and the third year,"
      },
      {
       "cyr": "кога народ за слобода",
       "lat": "koga narod za sloboda",
       "en": "when the people for freedom"
      },
      {
       "cyr": "крвта своја ја лееше.",
       "lat": "krvta svoja ja leeše.",
       "en": "shed their blood."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Македонија, в' славно Крушево",
       "lat": "Makedonija, v' slavno Kruševo",
       "en": "Macedonia, in glorious Krusevo"
      },
      {
       "cyr": "република",
       "lat": "republika",
       "en": "a republic"
      },
      {
       "cyr": "се роди на Балканот.",
       "lat": "se rodi na Balkanot.",
       "en": "was born in the Balkans."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кај што извира Вардар,",
       "lat": "Kaj što izvira Vardar,",
       "en": "Where the Vardar rises,"
      },
      {
       "cyr": "па до Егејско Море,",
       "lat": "pa do Egejsko More,",
       "en": "all the way to the Aegean Sea,"
      },
      {
       "cyr": "од Пирин дур' до Шара,",
       "lat": "od Pirin dur' do Šara,",
       "en": "from Pirin to Shar,"
      },
      {
       "cyr": "таму е наш'та Македонија.",
       "lat": "tamu e naš'ta Makedonija.",
       "en": "there is our Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Македонијо, земјо илинденска,",
       "lat": "Makedonijo, zemjo ilindenska,",
       "en": "Macedonia, land of Ilinden,"
      },
      {
       "cyr": "Илинден е наш'то сонце",
       "lat": "Ilinden e naš'to sonce",
       "en": "Ilinden is our sun"
      },
      {
       "cyr": "што не води до слобода,",
       "lat": "što ne vodi do sloboda,",
       "en": "that leads us to freedom,"
      },
      {
       "cyr": "Илинден е роденден",
       "lat": "Ilinden e rodenden",
       "en": "Ilinden is the birthday"
      },
      {
       "cyr": "на нашата Република.",
       "lat": "na našata Republika.",
       "en": "of our Republic."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Два Илиндена, со крв натопени",
       "lat": "Dva Ilindena, so krv natopeni",
       "en": "Two Ilindens, soaked with blood"
      },
      {
       "cyr": "за слободата",
       "lat": "za slobodata",
       "en": "for the freedom"
      },
      {
       "cyr": "на Македонија.",
       "lat": "na Makedonija.",
       "en": "of Macedonia."
      }
     ]
    },
    {
     "lines": [
