    {
     "lines": [
      {
       "cyr": "Дали знаеш мајко мила",
       "lat": "Dali znaeš majko mila",
       "en": "Do you know, dear mother,"
      },
      {
       "cyr": "какви синој ти си родила",
       "lat": "kakvi sinoj ti si rodila",
       "en": "what sort of sons you bore,"
      },
      {
       "cyr": "сите беа Илинденци",
       "lat": "site bea Ilindenci",
       "en": "they were all Ilinden men,"
      },
      {
       "cyr": "сите беа славни борци",
       "lat": "site bea slavni borci",
       "en": "they were all glorious fighters,"
      },
      {
       "cyr": "за слобода наша мила",
       "lat": "za sloboda naša mila",
       "en": "for our dear freedom"
      },
      {
       "cyr": "се бореа загинаа.",
       "lat": "se borea zaginaa.",
       "en": "they fought and perished."
      }
     ]
    },
    {
