   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Си заљубив едно моме",
       "lat": "Si zaljubiv edno mome",
       "en": "I fell in love with a girl"
      },
      {
       "cyr": "од малечко до големо,",
       "lat": "od malečko do golemo,",
       "en": "from when she was small until she was grown,"
      },
      {
       "cyr": "дојде време да го земам, оф аман, аман,",
       "lat": "dojde vreme da go zemam, of aman, aman,",
       "en": "the time came for me to take her, oh aman, aman,"
      },
      {
       "cyr": "падна моме, се разболе.",
       "lat": "padna mome, se razbole.",
       "en": "the girl fell ill."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас отидов да ја видам,",
       "lat": "Jas otidov da ja vidam,",
       "en": "I went to see her,"
      },
      {
       "cyr": "ми побара понадица,",
       "lat": "mi pobara ponadica,",
       "en": "she asked me for a treat,"
      },
      {
       "cyr": "среде зима бело грозје, оф аман, аман,",
       "lat": "srede zima belo grozje, of aman, aman,",
       "en": "in the middle of winter white grapes, oh aman, aman,"
      },
      {
       "cyr": "среде лето - жолта дуња.",
       "lat": "srede leto - žolta dunja.",
       "en": "in the middle of summer a yellow quince."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас отидов во чаршија,",
       "lat": "Jas otidov vo čaršija,",
       "en": "I went to the bazaar"
      },
      {
       "cyr": "да побарам понадица,",
       "lat": "da pobaram ponadica,",
       "en": "to ask for a treat,"
      },
      {
       "cyr": "среде зима бело грозје, оф аман, аман,",
       "lat": "srede zima belo grozje, of aman, aman,",
       "en": "in the middle of winter white grapes, oh aman, aman,"
      },
      {
       "cyr": "среде лето - жолта дуња.",
       "lat": "srede leto - žolta dunja.",
       "en": "in the middle of summer a yellow quince."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ко се вратив од чаршија,",
       "lat": "Ko se vrativ od čaršija,",
       "en": "When I came back from the bazaar,"
      },
      {
       "cyr": "сретнав моме на носилка,",
       "lat": "sretnav mome na nosilka,",
       "en": "I met the girl on a stretcher,"
      },
      {
       "cyr": "двесто давам - спуштете ја, оф аман, аман,",
       "lat": "dvesto davam - spuštete ja, of aman, aman,",
       "en": "I offer two hundred - put her down, oh aman, aman,"
      },
      {
       "cyr": "тристо давам - да ја видам.",
       "lat": "tristo davam - da ja vidam.",
       "en": "I offer three hundred - so I can see her."
      }
     ]
    }
   ]
  }
