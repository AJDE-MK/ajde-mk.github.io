   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Еј, море Илија,",
       "lat": "Ej, more Ilija,",
       "en": "Hey, hey Ilija,"
      },
      {
       "cyr": "зошто пиеш вино, ракија?",
       "lat": "zošto pieš vino, rakija?",
       "en": "why do you drink wine, rakija?"
      },
      {
       "cyr": "Еј, не си бекрија,",
       "lat": "Ej, ne si bekrija,",
       "en": "Hey, you are not a drunkard,"
      },
      {
       "cyr": "меанџика да те успива.",
       "lat": "meandžika da te uspiva.",
       "en": "the tavern-keeper's girl lulls you to sleep."
      },
      {
       "cyr": "Еј, Иле, Илија,",
       "lat": "Ej, Ile, Ilija,",
       "en": "Hey, Ile, Ilija,"
      },
      {
       "cyr": "сите порти ги затворија,",
       "lat": "site porti gi zatvorija,",
       "en": "they have shut all the gates,"
      },
      {
       "cyr": "еј, а ти остана",
       "lat": "ej, a ti ostana",
       "en": "hey, and you stayed"
      },
      {
       "cyr": "пак во таа пуста меана.",
       "lat": "pak vo taa pusta meana.",
       "en": "again in that wretched tavern."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пусти ти биле меаните Иле",
       "lat": "Pusti ti bile meanite Ile",
       "en": "Cursed be the taverns, Ile,"
      },
      {
       "cyr": "и тоа вино црвено,",
       "lat": "i toa vino crveno,",
       "en": "and that red wine,"
      },
      {
       "cyr": "а јас те чекам дома да ми дојдеш,",
       "lat": "a jas te čekam doma da mi dojdeš,",
       "en": "and I wait for you to come home to me,"
      },
      {
       "cyr": "во бела мека постела.",
       "lat": "vo bela meka postela.",
       "en": "in a white soft bed."
      }
     ]
