   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Таму долу крај Белото Море,",
       "lat": "Tamu dolu kraj Beloto More,",
       "en": "Down there by the White Sea,"
      },
      {
       "cyr": "таму е браќа мојот роден крај,",
       "lat": "tamu e braḱa mojot roden kraj,",
       "en": "there, brothers, is my native land,"
      },
      {
       "cyr": "тиран дојде нас нè пропади,",
       "lat": "tiran dojde nas nè propadi,",
       "en": "a tyrant came and ruined us,"
      },
      {
       "cyr": "па скитаме по целиот свет,",
       "lat": "pa skitame po celiot svet,",
       "en": "so we wander around the whole world,"
      },
      {
       "cyr": "ох, Македонијо,",
       "lat": "oh, Makedonijo,",
       "en": "oh, Macedonia,"
      },
      {
       "cyr": "моја земјо напатена.",
       "lat": "moja zemjo napatena.",
       "en": "my suffering land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Уште памтам, браќа, бежанците,",
       "lat": "Ušte pamtam, braḱa, bežancite,",
       "en": "I still remember, brothers, the refugees,"
      },
      {
       "cyr": "с' очи тажни, срца ранети,",
       "lat": "s' oči tažni, srca raneti,",
       "en": "with sad eyes, wounded hearts,"
      },
      {
       "cyr": "напуштија родно огниште,",
       "lat": "napuštija rodno ognište,",
       "en": "they left their native hearth,"
      },
      {
       "cyr": "па тргнаа земји далечни,",
       "lat": "pa trgnaa zemji dalečni,",
       "en": "and set out for distant lands,"
      },
      {
       "cyr": "ох, Македонијо,",
       "lat": "oh, Makedonijo,",
       "en": "oh, Macedonia,"
      },
      {
       "cyr": "моја земјо напатена.",
       "lat": "moja zemjo napatena.",
       "en": "my suffering land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Уште памтам, браќа Македонци,",
