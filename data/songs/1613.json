 "versions": [
  {
   "label": "Version 1",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Патруно моме убава",
       "lat": "- Patruno mome ubava",
       "en": "Patruna, beautiful girl,",
       "en_mt": false
      },
      {
       "cyr": "Патруна тенка, висока.",
       "lat": "Patruna tenka, visoka.",
       "en": "Patruna, thin and tall,",
       "en_mt": false
      },
      {
       "cyr": "Зашо ми врвиш крај порти?",
       "lat": "Zašo mi vrviš kraj porti?",
       "en": "Why do you pass by my gates?",
       "en_mt": false
      },
      {
       "cyr": "Зошто ми гориш срцето?",
       "lat": "Zošto mi goriš srceto?",
       "en": "Why is my heart burning for you?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Патруно моме убава",
       "lat": "Patruno mome ubava",
       "en": "Patruna, beautiful girl,",
       "en_mt": false
      },
      {
       "cyr": "дај да ја питаш мајка ти",
       "lat": "daj da ja pitaš majka ti",
       "en": "Oh, go ask your mother,",
       "en_mt": false
      },
      {
       "cyr": "дал ќе те даде за мене",
       "lat": "dal ḱe te dade za mene",
       "en": "If she will give you to me,",
       "en_mt": false
      },
      {
       "cyr": "за мене џанам, зулумџија.",
       "lat": "za mene džanam, zulumdžija.",
       "en": "To me, my love, my soul.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре ти лудо будало",
       "lat": "- A bre ti ludo budalo",
       "en": "Oh come on, you are a crazy fool,",
       "en_mt": false
      },
      {
       "cyr": "како да ја питам мајка ми",
       "lat": "kako da ja pitam majka mi",
       "en": "How can I ask my mother?",
       "en_mt": false
      },
      {
       "cyr": "јаска сам веќе армасана",
       "lat": "jaska sam veḱe armasana",
       "en": "I am already engaged,",
       "en_mt": false
      },
      {
       "cyr": "за тој ми Кољо зенгија.",
       "lat": "za toj mi Koljo zengija.",
       "en": "With Koljo zengija1.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Патруно моме убаво",
       "lat": "- Patruno mome ubavo",
       "en": "Patruna, beautiful girl,",
       "en_mt": false
      },
      {
       "cyr": "дај да те бегам за мене",
       "lat": "daj da te begam za mene",
       "en": "Oh, I will elope with you,",
       "en_mt": false
      },
      {
       "cyr": "и јас си имам богатство",
       "lat": "i jas si imam bogatstvo",
       "en": "I have wealth of my own:",
       "en_mt": false
      },
      {
       "cyr": "Мегленско поле широко.",
       "lat": "Meglensko pole široko.",
       "en": "The wide fields of Meglen.",
       "en_mt": false
      }
     ]
    }
   ]
