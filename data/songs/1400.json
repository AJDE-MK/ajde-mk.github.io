   "stanzas": [
    {
     "lines": [
      {
       "cyr": "На разделба многу тешка",
       "lat": "Na razdelba mnogu teška",
       "en": "At a very hard parting"
      },
      {
       "cyr": "за егејски мајки расплакани,",
       "lat": "za egejski majki rasplakani,",
       "en": "for the weeping Aegean mothers,"
      },
      {
       "cyr": "срцата си ги кинеа",
       "lat": "srcata si gi kinea",
       "en": "they tore their hearts"
      },
      {
       "cyr": "кога се разделија",
       "lat": "koga se razdelija",
       "en": "when they were separated"
      },
      {
       "cyr": "од своите чеда.",
       "lat": "od svoite čeda.",
       "en": "from their children."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Четириесет и осма година,",
       "lat": "Četirieset i osma godina,",
       "en": "In the year forty-eight,"
      },
      {
       "cyr": "создале кордон ?",
       "lat": "sozdale kordon ?",
       "en": "they made a cordon ?"
      },
      {
       "cyr": "ги собрале сите деца,",
       "lat": "gi sobrale site deca,",
       "en": "they gathered all the children,"
      },
      {
       "cyr": "од сите наши егејски села.",
       "lat": "od site naši egejski sela.",
       "en": "from all our Aegean villages."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мајчици, чеда плачеа,",
       "lat": "Majčici, čeda plačea,",
       "en": "Little mothers, the children wept,"
      },
      {
       "cyr": "тешки солзи си ронеа,",
       "lat": "teški solzi si ronea,",
       "en": "they shed heavy tears,"
      },
      {
       "cyr": "покрај Вичо планина поминаа,",
       "lat": "pokraj Vičo planina pominaa,",
       "en": "they passed by Mount Vicho,"
      },
      {
       "cyr": "на туѓи раце ги предадоа,",
       "lat": "na tuǵi race gi predadoa,",
       "en": "they handed them over to foreign hands,"
      },
      {
       "cyr": "во непознати земји отидоа.",
       "lat": "vo nepoznati zemji otidoa.",
       "en": "they went off to unknown lands."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Солзите ?",
       "lat": "Solzite ?",
       "en": "The tears ?"
      },
      {
       "cyr": "мајчински очи в' солзи тежеа,",
       "lat": "majčinski oči v' solzi težea,",
       "en": "the mothers' eyes were heavy with tears,"
      },
      {
       "cyr": "свои чеда испратија,",
       "lat": "svoi čeda ispratija,",
       "en": "they saw off their children,"
      },
      {
       "cyr": "со празни раце се вратија.",
       "lat": "so prazni race se vratija.",
       "en": "they returned with empty hands."
      }
     ]
    },
    {
     "lines": [
