   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Срцево не ми спие,",
       "lat": "Srcevo ne mi spie,",
       "en": "My heart does not sleep,",
       "en_mt": false
      },
      {
       "cyr": "чека ти да дојдеш,",
       "lat": "čeka ti da dojdeš,",
       "en": "waiting for you to come,",
       "en_mt": false
      },
      {
       "cyr": "роса во мугрите",
       "lat": "rosa vo mugrite",
       "en": "dew at dawn",
       "en_mt": true
      },
      {
       "cyr": "да ми донесеш.",
       "lat": "da mi doneseš.",
       "en": "to bring to me.",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мојот живот со тебе",
       "lat": "Mojot život so tebe",
       "en": "My life with you",
       "en_mt": false
      },
      {
       "cyr": "како бајка врви,",
       "lat": "kako bajka vrvi,",
       "en": "is like a fairy tale,",
       "en_mt": false
      },
      {
       "cyr": "љубовта решила",
       "lat": "ljubovta rešila",
       "en": "love has decided",
       "en_mt": false
      },
      {
       "cyr": "да нè задржи.",
       "lat": "da nè zadrži.",
       "en": "to keep us together.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Песна душава ми бара,",
       "lat": "Pesna dušava mi bara,",
       "en": "My soul is looking for a song,",
       "en_mt": false
      },
      {
       "cyr": "песна да ти подарам.",
       "lat": "pesna da ti podaram.",
       "en": "a song to give you.",
       "en_mt": false
      },
      {
       "cyr": "Љубов очи ќе ти кажат,",
       "lat": "Ljubov oči ḱe ti kažat,",
       "en": "Love, my eyes will tell you,",
       "en_mt": false
      },
      {
       "cyr": "усни кога не можат.",
       "lat": "usni koga ne možat.",
       "en": "when the lips cannot.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сонот ми е јаве,",
       "lat": "Sonot mi e jave,",
       "en": "My dream is a reality,",
       "en_mt": false
      },
      {
       "cyr": "господ ми те даде,",
       "lat": "gospod mi te dade,",
       "en": "the Lord gave you to me,",
       "en_mt": false
      },
      {
       "cyr": "небо полно ѕвезди си ти.",
       "lat": "nebo polno dzvezdi si ti.",
       "en": "you are a sky full of stars.",
       "en_mt": false
      },
      {
       "cyr": "Сонот ми е јаве,",
       "lat": "Sonot mi e jave,",
       "en": "My dream is a reality,",
       "en_mt": false
      },
      {
       "cyr": "господ ми те даде,",
       "lat": "gospod mi te dade,",
       "en": "the Lord gave you to me,",
       "en_mt": false
      },
      {
       "cyr": "срце полно среќа си ти.",
       "lat": "srce polno sreḱa si ti.",
       "en": "you are a heart full of happiness.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сè што сакав од тебе",
       "lat": "Sè što sakav od tebe",
       "en": "Everything I wanted from you,",
       "en_mt": false
      },
      {
       "cyr": "од срце го добив,",
       "lat": "od srce go dobiv,",
       "en": "from my heart, I got it,",
       "en_mt": false
      },
      {
       "cyr": "нежно за секогаш",
       "lat": "nežno za sekogaš",
       "en": "tenderly, forever,",
       "en_mt": true
      },
      {
       "cyr": "ти ме зароби.",
       "lat": "ti me zarobi.",
       "en": "you have captured me.",
       "en_mt": true
