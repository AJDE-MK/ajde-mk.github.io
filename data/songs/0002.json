 "versions": [
  {
   "label": "Version 1",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мори чупи костурчанки,",
       "lat": "Mori čupi kosturčanki,",
       "en": "Hey, girls from Kostur,",
       "en_mt": false
      },
      {
       "cyr": "раширете го орото,",
       "lat": "raširete go oroto,",
       "en": "spread the oro a little wider,",
       "en_mt": false
      },
      {
       "cyr": "да ви вијме фустаните,",
       "lat": "da vi vijme fustanite,",
       "en": "let us see your dresses,",
       "en_mt": false
      },
      {
       "cyr": "чиј е ф'стан дамкалија,",
       "lat": "čij e f'stan damkalija,",
       "en": "whose dress has marks on it,",
       "en_mt": false
      },
      {
       "cyr": "да се сторам севдалија,",
       "lat": "da se storam sevdalija,",
       "en": "and I will fall in love,",
       "en_mt": false
      },
      {
       "cyr": "по фустано на чупчето.",
       "lat": "po fustano na čupčeto.",
       "en": "in that girl's dress.",
       "en_mt": false
      }
     ]
    }
   ]
  },
  {
   "label": "Version 2",
   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
