   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Абер дојде Донке, абер дојде.",
       "lat": "Aber dojde Donke, aber dojde.",
       "en": "News came, Donka, news came."
      },
      {
       "cyr": "Абер дојде Донке од кулата,",
       "lat": "Aber dojde Donke od kulata,",
       "en": "News came, Donka, from the tower,"
      },
      {
       "cyr": "од кулата Донке од агата.",
       "lat": "od kulata Donke od agata.",
       "en": "from the tower, Donka, from the aga."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да ги збереш Донке аргатите.",
       "lat": "Da gi zbereš Donke argatite.",
       "en": "To gather the farmhands, Donka."
      },
      {
       "cyr": "Аргатите Донке невестите,",
       "lat": "Argatite Donke nevestite,",
       "en": "The farmhands, Donka, the brides,"
      },
      {
       "cyr": "ергените Донке, девојките.",
       "lat": "ergenite Donke, devojkite.",
       "en": "the bachelors, Donka, the girls."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе жнееме Донке, ќе жнееме.",
       "lat": "Ḱe žneeme Donke, ḱe žneeme.",
       "en": "We will reap, Donka, we will reap."
      },
      {
       "cyr": "Ќе жнееме Донке куси јачмен,",
       "lat": "Ḱe žneeme Donke kusi jačmen,",
       "en": "We will reap short barley, Donka,"
      },
      {
       "cyr": "куси јачмен Донке до колена.",
       "lat": "kusi jačmen Donke do kolena.",
       "en": "short barley, Donka, up to the knee."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ти ќе јадеш Донке, рудо јагне.",
       "lat": "Ti ḱe jadeš Donke, rudo jagne.",
       "en": "You will eat, Donka, ruddy lamb"
      },
      {
       "cyr": "Со агата Донке, на кулата,",
       "lat": "So agata Donke, na kulata,",
       "en": "with the aga, Donka, in the tower,"
      },
      {
       "cyr": "аргати ќе јадат лук и оцет.",
       "lat": "argati ḱe jadat luk i ocet.",
       "en": "the farmhands will eat garlic and vinegar."
      }
     ]
    }
   ]
  }
