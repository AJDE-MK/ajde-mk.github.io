   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Боже, боже што ми стори,",
       "lat": "Bože, bože što mi stori,",
       "en": "God, God what have you done to me,"
      },
      {
       "cyr": "уште срце да ми гори?",
       "lat": "ušte srce da mi gori?",
       "en": "my heart is still burning?"
      },
      {
       "cyr": "Да сонувам нејна лика,",
       "lat": "Da sonuvam nejna lika,",
       "en": "To dream about her face,"
      },
      {
       "cyr": "да ја сонувам Марика?",
       "lat": "da ja sonuvam Marika?",
       "en": "to dream about Marika?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ника, Ника, Ника, убава Марика,",
       "lat": "Nika, Nika, Nika, ubava Marika,",
       "en": "Nika, Nika, Nika, beautiful Marika,"
      },
      {
       "cyr": "ми остави само слика.",
       "lat": "mi ostavi samo slika.",
       "en": "she left me only a picture,"
      },
      {
       "cyr": "Ми избега мојата Марика",
       "lat": "Mi izbega mojata Marika",
       "en": "She run away, my Marika,"
      },
      {
       "cyr": "со два нови свршеника.",
       "lat": "so dva novi svršenika.",
       "en": "with two new fiancés."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Малку беше што те молев",
       "lat": "Malku beše što te molev",
       "en": "Was it not enough that I begged you"
      },
      {
       "cyr": "и на тебе што ти зборев.",
       "lat": "i na tebe što ti zborev.",
       "en": "and talked to you."
      },
      {
       "cyr": "Малку беа куќи, дворој,",
       "lat": "Malku bea kuḱi, dvoroj,",
       "en": "Were they not enough, the houses, yards,"
      },
      {
       "cyr": "мојте песни, мојте зборој.",
       "lat": "mojte pesni, mojte zboroj.",
       "en": "my songs, my words."
      }
     ]
