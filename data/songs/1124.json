   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Димна јуда, мамо, град градила,",
       "lat": "Dimna juda, mamo, grad gradila,",
       "en": "A wonderful fairy was building a city,"
      },
      {
       "cyr": "на планина, мамо, на Влаина.",
       "lat": "na planina, mamo, na Vlaina.",
       "en": "on the mountain, mother, on Vlaina."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што е колје, мамо, побивала,",
       "lat": "Što e kolje, mamo, pobivala,",
       "en": "All the posts she drove into the ground,"
      },
      {
       "cyr": "сè ергени, мамо, за главење.",
       "lat": "sè ergeni, mamo, za glavenje.",
       "en": "were all young men, ready to be engaged."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што е плиќе, мамо, заплиќала,",
       "lat": "Što e pliḱe, mamo, zapliḱala,",
       "en": "All the wands she plaited,"
      },
      {
       "cyr": "сè девојки, мамо, за мажење.",
       "lat": "sè devojki, mamo, za maženje.",
       "en": "were all young girls, ready for marriage."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Димна јуда, мамо, град градила,",
