   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ој Јоване зару домаќине,",
       "lat": "Oj Jovane zaru domaḱine,",
       "en": "Oh Jovan, indeed, master of the house,"
      },
      {
       "cyr": "кај куќа ти зару река течи,",
       "lat": "kaj kuḱa ti zaru reka teči,",
       "en": "by your house, indeed, a river flows,"
      },
      {
       "cyr": "во реката зару крива врба,",
       "lat": "vo rekata zaru kriva vrba,",
       "en": "in the river, indeed, a crooked willow,"
      },
      {
       "cyr": "на врбата зару три седела,",
       "lat": "na vrbata zaru tri sedela,",
       "en": "on the willow, indeed, three sat,"
      },
      {
       "cyr": "во седела зару три билбили,",
       "lat": "vo sedela zaru tri bilbili,",
       "en": "in the seat, indeed, three nightingales,"
      },
      {
       "cyr": "први пее зару за поручок,",
       "lat": "prvi pee zaru za poručok,",
       "en": "the first sings, indeed, for the midday meal,"
      },
      {
       "cyr": "втори пее зару за ужина,",
       "lat": "vtori pee zaru za užina,",
       "en": "the second sings, indeed, for the afternoon snack,"
      },
      {
       "cyr": "трети пее зару за вечера:",
       "lat": "treti pee zaru za večera:",
       "en": "the third sings, indeed, for supper:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Кој ни даде со сито,",
       "lat": "- Koj ni dade so sito,",
       "en": "- Whoever gave us with a sieve,"
      },
      {
       "cyr": "зару да е ситна година,",
       "lat": "zaru da e sitna godina,",
       "en": "indeed, may the year be fine-grained,"
      },
      {
       "cyr": "зару да е ситна година.",
       "lat": "zaru da e sitna godina.",
       "en": "indeed, may the year be fine-grained."
