   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Езеро рајско убаво,",
       "lat": "Ezero rajsko ubavo,",
       "en": "Beautiful heavenly lake,"
      },
      {
       "cyr": "слатко, бисерно, чудесно,",
       "lat": "slatko, biserno, čudesno,",
       "en": "sweet, pearly, wonderful,"
      },
      {
       "cyr": "не испраќај си ветрови,",
       "lat": "ne ispraḱaj si vetrovi,",
       "en": "do not send winds out,"
      },
      {
       "cyr": "реката Дрим ми ја матиш.",
       "lat": "rekata Drim mi ja matiš.",
       "en": "you are muddying my river Drim."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Излегов да се прошетам,",
       "lat": "Izlegov da se prošetam,",
       "en": "I went out for a walk,"
      },
      {
       "cyr": "крај Дримот у езерото,",
       "lat": "kraj Drimot u ezeroto,",
       "en": "along the Drim by the lake,"
      },
      {
       "cyr": "од што ветрови вееја",
       "lat": "od što vetrovi veeja",
       "en": "from where the winds blew"
      },
      {
       "cyr": "тамо песна пееја:",
       "lat": "tamo pesna peeja:",
       "en": "there a song was sung:"
      },
      {
       "cyr": "- “О, што сум слатко заспало,",
       "lat": "- “O, što sum slatko zaspalo,",
       "en": "- \"Oh, how sweetly I had fallen asleep,"
      },
      {
       "cyr": "па брата на сон сонувало“.",
       "lat": "pa brata na son sonuvalo“.",
       "en": "and dreamed of my brother in my sleep\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Кои сте вие двајцата",
       "lat": "- Koi ste vie dvajcata",
       "en": "- Who are you two"
      },
      {
       "cyr": "што бели книги читате,",
       "lat": "što beli knigi čitate,",
       "en": "who read white books,"
      },
      {
       "cyr": "галеби лисја ви вртат?",
       "lat": "galebi lisja vi vrtat?",
       "en": "the seagulls turn your pages?"
      },
      {
       "cyr": "- Миладиновци ние сме.",
       "lat": "- Miladinovci nie sme.",
       "en": "- We are the Miladinovs."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во сон си поздрав праќаа,",
       "lat": "Vo son si pozdrav praḱaa,",
       "en": "In a dream they sent greetings,"
      },
      {
       "cyr": "од Димитри и Константин,",
       "lat": "od Dimitri i Konstantin,",
       "en": "Dimitri and Konstantin,"
      },
      {
       "cyr": "поздрав од Миладиновци",
       "lat": "pozdrav od Miladinovci",
       "en": "greetings from the Miladinovs"
      },
      {
       "cyr": "до народ в' Струга и струшко.",
       "lat": "do narod v' Struga i struško.",
       "en": "to the people in Struga and the Struga region."
      },
      {
       "cyr": "Поздрав за Македонија,",
       "lat": "Pozdrav za Makedonija,",
       "en": "Greetings to Macedonia,"
      },
      {
       "cyr": "нашава мила татковина.",
       "lat": "našava mila tatkovina.",
       "en": "our dear fatherland."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ние сме браќа Миладиновци,",
       "lat": "- Nie sme braḱa Miladinovci,",
       "en": "- We are the Miladinov brothers,"
      },
      {
       "cyr": "Константин и Димитрија,",
       "lat": "Konstantin i Dimitrija,",
       "en": "Konstantin and Dimitrija,"
      },
      {
       "cyr": "млади стружани, учители,",
       "lat": "mladi stružani, učiteli,",
       "en": "young men of Struga, teachers,"
      },
      {
       "cyr": "од златна Струга, убава.",
       "lat": "od zlatna Struga, ubava.",
       "en": "from golden, beautiful Struga."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во Струга сме се родиле,",
       "lat": "Vo Struga sme se rodile,",
       "en": "We were born in Struga,"
      },
      {
       "cyr": "песни, приказни собирале,",
       "lat": "pesni, prikazni sobirale,",
       "en": "we collected songs and tales,"
      },
      {
       "cyr": "од народ поклон оставиле.",
       "lat": "od narod poklon ostavile.",
       "en": "we left them as a gift to the people."
      },
      {
       "cyr": "Со перо в' рака се боревме",
       "lat": "So pero v' raka se borevme",
       "en": "With a pen in hand we fought"
      },
      {
       "cyr": "слобода да добиеме",
       "lat": "sloboda da dobieme",
       "en": "to win freedom"
      },
      {
       "cyr": "од пусти грчки тирани.",
       "lat": "od pusti grčki tirani.",
       "en": "from the wretched Greek tyrants."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А зошто толку сте мачени,",
       "lat": "- A zošto tolku ste mačeni,",
       "en": "- And why were you so tormented,"
      },
      {
       "cyr": "брада пуштиле, потемнеле,",
       "lat": "brada puštile, potemnele,",
       "en": "you let your beards grow, you darkened,"
      },
      {
       "cyr": "очите ви се насолзени",
       "lat": "očite vi se nasolzeni",
       "en": "your eyes are full of tears,"
      },
      {
       "cyr": "крвави солзи роните?",
       "lat": "krvavi solzi ronite?",
       "en": "you shed bloody tears?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "По бел си свет си одевме,",
       "lat": "Po bel si svet si odevme,",
       "en": "We wandered the wide world,"
      },
      {
       "cyr": "наша слобода баравме,",
       "lat": "naša sloboda baravme,",
       "en": "we sought our freedom,"
      },
      {
       "cyr": "никаде правда не најдовме.",
       "lat": "nikade pravda ne najdovme.",
       "en": "we found justice nowhere."
      },
      {
       "cyr": "Секаде душман нè бараше",
       "lat": "Sekade dušman nè baraše",
       "en": "Everywhere the enemy hunted us"
      },
      {
       "cyr": "и в' зандан нас нè затвори,",
       "lat": "i v' zandan nas nè zatvori,",
       "en": "and threw us in a dungeon,"
      },
      {
       "cyr": "в' Стамбола зандан' да гниеме.",
       "lat": "v' Stambola zandan' da gnieme.",
       "en": "in Istanbul, to rot in the dungeon."
      }
     ]
    }
   ]
  }
 ],
