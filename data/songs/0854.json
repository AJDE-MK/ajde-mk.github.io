     "lines": [
      {
       "cyr": "Три години, лудо, болна лежам",
       "lat": "Tri godini, ludo, bolna ležam",
       "en": "For three years, crazy lad, I lie sick,"
      },
      {
       "cyr": "нити други армасани.",
       "lat": "niti drugi armasani.",
       "en": "neighter anybody else,"
      },
      {
       "cyr": "Ти не дојде, лудо, да ме видиш",
       "lat": "Ti ne dojde, ludo, da me vidiš",
       "en": "nor you, crazy lad, came to see me,"
      },
      {
       "cyr": "сега дојде на умрење.",
       "lat": "sega dojde na umrenje.",
       "en": "and now you came on my death bed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сега дојде, лудо, на умрење",
       "lat": "Sega dojde, ludo, na umrenje",
       "en": "Now you came, crazy lad, on my death bed,"
      },
      {
       "cyr": "кога снага овенала.",
       "lat": "koga snaga ovenala.",
       "en": "when my strentght has withered."
      },
      {
       "cyr": "Кога снага, лудо, овенала,",
       "lat": "Koga snaga, ludo, ovenala,",
       "en": "When my strength, crazy lad, has withered,"
      },
      {
       "cyr": "бело лице потемнело.",
       "lat": "belo lice potemnelo.",
       "en": "my white face has darkened."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Бело лице, лудо, потемнело",
       "lat": "Belo lice, ludo, potemnelo",
       "en": "My white face, crazy lad, has darkened,"
      },
      {
       "cyr": "црни очи пропаднале.",
       "lat": "crni oči propadnale.",
       "en": "my black eyes have sunken in."
      },
      {
       "cyr": "Заврти ме, лудо, карши сонце",
       "lat": "Zavrti me, ludo, karši sonce",
       "en": "Turn me, crazy lad, towards the sun,"
      },
      {
       "cyr": "да го видам сино небо.",
       "lat": "da go vidam sino nebo.",
       "en": "let me see the blue sky."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да го видам, лудо, сино небо",
       "lat": "Da go vidam, ludo, sino nebo",
       "en": "Let me see, crazy lad, the blue sky,"
      },
      {
       "cyr": "сино небо, црна земја.",
       "lat": "sino nebo, crna zemja.",
       "en": "blue sky, black earth."
