   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Огреала месечина, леле",
       "lat": "Ogreala mesečina, lele",
       "en": "The moon shone, oh,"
      },
      {
       "cyr": "огрејала месечина,",
       "lat": "ogrejala mesečina,",
       "en": "the moon shone,"
      },
      {
       "cyr": "од Солуна до Тетово.",
       "lat": "od Soluna do Tetovo.",
       "en": "from Salonica to Tetovo."
      },
      {
       "cyr": "Не ми била месечина леле,",
       "lat": "Ne mi bila mesečina lele,",
       "en": "It was not the moon, oh,"
      },
      {
       "cyr": "тук' ми биле три невесте,",
       "lat": "tuk' mi bile tri neveste,",
       "en": "it was three brides,"
      },
      {
       "cyr": "три нејесте Сетолчанке.",
       "lat": "tri nejeste Setolčanke.",
       "en": "three brides from Setolci."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Прво теглат за Тетово, леле",
       "lat": "Prvo teglat za Tetovo, lele",
       "en": "First they trudge toward Tetovo, oh,"
      },
      {
       "cyr": "право одат за Тетово,",
       "lat": "pravo odat za Tetovo,",
       "en": "they go straight to Tetovo,"
      },
      {
       "cyr": "кај бакалот чичо Кољо.",
       "lat": "kaj bakalot čičo Koljo.",
       "en": "to the grocer, Uncle Koljo."
      },
      {
       "cyr": "- Добро утро чичо Кољо, море",
       "lat": "- Dobro utro čičo Koljo, more",
       "en": "- Good morning, Uncle Koljo, hey,"
      },
      {
       "cyr": "добро утро чичо Кољо.",
       "lat": "dobro utro čičo Koljo.",
       "en": "good morning, Uncle Koljo."
      },
      {
       "cyr": "- Дал бог добро три нејесте,",
       "lat": "- Dal bog dobro tri nejeste,",
       "en": "- May God give good, three brides,"
      },
      {
       "cyr": "три нејесте Сетолчанке.",
       "lat": "tri nejeste Setolčanke.",
       "en": "three brides from Setolci."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да ми дадеш драм белило, леле",
       "lat": "Da mi dadeš dram belilo, lele",
       "en": "Give me a dram of whitener, oh,"
      },
      {
       "cyr": "да ми дадеш драм белило,",
       "lat": "da mi dadeš dram belilo,",
       "en": "give me a dram of whitener,"
      },
      {
       "cyr": "драм белило, драм црвило.",
       "lat": "dram belilo, dram crvilo.",
       "en": "a dram of whitener, a dram of red."
      },
      {
       "cyr": "Наши мажи гурбетчие, леле",
       "lat": "Naši maži gurbetčie, lele",
       "en": "Our husbands are away working abroad, oh,"
      },
      {
       "cyr": "наши мажи гурбетчие,",
       "lat": "naši maži gurbetčie,",
       "en": "our husbands are away working abroad,"
      },
      {
       "cyr": "кој ќе дојдат, ќе ти платат.",
       "lat": "koj ḱe dojdat, ḱe ti platat.",
       "en": "when they come, they will pay you."
      }
     ]
