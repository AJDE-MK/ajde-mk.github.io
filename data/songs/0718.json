   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Тивка ноќ е, сите спијат,",
       "lat": "Tivka noḱ e, site spijat,",
       "en": "It is a quiet night, everyone is sleeping,"
      },
      {
       "cyr": "само ние двајцата не,",
       "lat": "samo nie dvajcata ne,",
       "en": "Only we two are not."
      },
      {
       "cyr": "јас и мојата гитара",
       "lat": "jas i mojata gitara",
       "en": "Me and my guitar,"
      },
      {
       "cyr": "под твоето пенџере.",
       "lat": "pod tvoeto pendžere.",
       "en": "Under your window."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Тивко свирам за да можеш",
       "lat": "Tivko sviram za da možeš",
       "en": "I am playing quietly, so that"
      },
      {
       "cyr": "да ме чуеш само ти,",
       "lat": "da me čueš samo ti,",
       "en": "Only you can hear me,"
      },
      {
       "cyr": "колку љубам ќе ти кажат",
       "lat": "kolku ljubam ḱe ti kažat",
       "en": "My musical chords will tell you,"
      },
      {
       "cyr": "моите звучни акорди.",
       "lat": "moite zvučni akordi.",
       "en": "How much I love (you)."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако чуеш, мила моја,",
       "lat": "Ako čueš, mila moja,",
       "en": "If you can hear, my dear,"
      },
      {
       "cyr": "нека светне пенџере,",
       "lat": "neka svetne pendžere,",
       "en": "Let a light shine at the window,"
      },
      {
       "cyr": "јас ќе бидам среќен, мила,",
       "lat": "jas ḱe bidam sreḱen, mila,",
       "en": "I will be happy, dear,"
      },
      {
       "cyr": "како да си крај мене.",
       "lat": "kako da si kraj mene.",
       "en": "As if you are next to me."
      }
     ]
    },
    {
     "lines": [
