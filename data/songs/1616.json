   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Убава моме Јанико",
       "lat": "Ubava mome Janiko",
       "en": "Beautiful girl Janika"
      },
      {
       "cyr": "сонце се слага да зајде",
       "lat": "sonce se slaga da zajde",
       "en": "the sun is setting"
      },
      {
       "cyr": "зад таа равна ридина.",
       "lat": "zad taa ravna ridina.",
       "en": "behind that flat hill."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зад ридината зелен бор,",
       "lat": "Zad ridinata zelen bor,",
       "en": "Behind the hill is a green pine,"
      },
      {
       "cyr": "под борот седат аргати.",
       "lat": "pod borot sedat argati.",
       "en": "under the pine sit the workers."
      },
      {
       "cyr": "Голем си одбор правеа.",
       "lat": "Golem si odbor pravea.",
       "en": "They were making a big board."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кој ќе одбори калинка,",
       "lat": "Koj ḱe odbori kalinka,",
       "en": "Whoever picks a pomegranate,"
      },
      {
       "cyr": "тој ќе си земе Јанинка,",
       "lat": "toj ḱe si zeme Janinka,",
       "en": "will take Janinka,"
      },
      {
       "cyr": "Јанинка мома убава.",
       "lat": "Janinka moma ubava.",
       "en": "the beautiful girl Janinka."
      }
     ]
    }
   ]
  }
 ],
