       "en": "When I come, dear,"
      },
      {
       "cyr": "порти да отвориш,",
       "lat": "porti da otvoriš,",
       "en": "open the doors,"
      },
      {
       "cyr": "портите широки.",
       "lat": "portite široki.",
       "en": "the wide doors."
      },
      {
       "cyr": "- Идам, не идам,",
       "lat": "- Idam, ne idam,",
       "en": "I come, I don't come,"
      },
      {
       "cyr": "сама ќе дојдам.",
       "lat": "sama ḱe dojdam.",
       "en": "alone I'll come."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Мене да пречекаш,",
       "lat": "- Mene da prečekaš,",
       "en": "Wait for me,"
      },
