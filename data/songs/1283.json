      },
      {
       "cyr": "песна нек' се пее,",
       "lat": "pesna nek' se pee,",
       "en": "let a song be sung,"
      },
      {
       "cyr": "налеј, мила мајко,",
       "lat": "nalej, mila majko,",
       "en": "pour, dear mother,"
      },
      {
       "cyr": "вино нек' се пие,",
