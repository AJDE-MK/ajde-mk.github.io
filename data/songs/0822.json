    {
     "lines": [
      {
       "cyr": "Народ се собрал,",
       "lat": "Narod se sobral,",
       "en": "People are gathered,"
      },
      {
       "cyr": "народ македонски,",
       "lat": "narod makedonski,",
       "en": "Macedonian people,"
      },
      {
       "cyr": "горе на Пирин да слави,",
       "lat": "gore na Pirin da slavi,",
       "en": "up there on the Pirin Mountain, to celebrate"
      },
      {
       "cyr": "на зелени ливади,",
       "lat": "na zeleni livadi,",
       "en": "on green meadows,"
      },
      {
       "cyr": "кај манастирот Рожденски.",
       "lat": "kaj manastirot Roždenski.",
       "en": "at the Rozhden monastery."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј, народе македонски,",
       "lat": "Ej, narode makedonski,",
       "en": "Hey, Macedonian people,"
      },
      {
       "cyr": "тука падна славен јунак,",
       "lat": "tuka padna slaven junak,",
       "en": "here a glorious hero fell,"
      },
      {
       "cyr": "живот даде за слобода,",
       "lat": "život dade za sloboda,",
       "en": "he gave his life for freedom,"
      },
      {
       "cyr": "за својата Македонија.",
       "lat": "za svojata Makedonija.",
       "en": "for his Macedonia."
      }
     ]
    },
    {
     "lines": [
