    },
    {
     "lines": [
      {
       "cyr": "Гората трае, не збори",
       "lat": "Gorata trae, ne zbori",
       "en": "The forest is silent, does not speak,"
      },
      {
       "cyr": "на Јанка не одговара.",
       "lat": "na Janka ne odgovara.",
       "en": "it does not answer Yanka."
      },
      {
       "cyr": "Кога би гора зборела,",
       "lat": "Koga bi gora zborela,",
       "en": "If the forest could speak,"
      },
      {
       "cyr": "не би ја секла секира,",
       "lat": "ne bi ja sekla sekira,",
       "en": "the axe would not cut it,"
      },
      {
       "cyr": "нит' би ја стада газеле.",
