      {
       "cyr": "Мори деј Невено, невен душо,",
       "lat": "Mori dej Neveno, neven dušo,",
       "en": "Hey now, Neveno, my marigold soul,"
      },
      {
       "cyr": "невен да се твојте очи.",
       "lat": "neven da se tvojte oči.",
       "en": "may your eyes be marigold."
      },
      {
       "cyr": "Или твојте очи, како мојте,",
       "lat": "Ili tvojte oči, kako mojte,",
       "en": "Or may your eyes be like mine,"
      },
      {
       "cyr": "дун, дум дуру дум, како мојте.",
       "lat": "dun, dum duru dum, kako mojte.",
       "en": "dun, dum duru dum, like mine."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде ние да ги замешаме,",
       "lat": "Ajde nie da gi zamešame,",
       "en": "Come on, let us mix them up,"
      },
      {
       "cyr": "јазе твојте, ти зеј мојте.",
       "lat": "jaze tvojte, ti zej mojte.",
       "en": "I take yours, you take mine."
      },
      {
       "cyr": "Ило да се сторат црно гројзе,",
       "lat": "Ilo da se storat crno grojze,",
       "en": "May they turn into black grapes,"
      },
      {
       "cyr": "дун, дум дуру дум, црно гројзе.",
       "lat": "dun, dum duru dum, crno grojze.",
       "en": "dun, dum duru dum, black grapes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде ние двајца да зобаме",
       "lat": "Ajde nie dvajca da zobame",
       "en": "Come on, let the two of us feast"
      },
      {
       "cyr": "во темнина, без борина.",
       "lat": "vo temnina, bez borina.",
       "en": "in the dark, without a pine forest."
      },
      {
