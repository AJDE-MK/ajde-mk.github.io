   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ја излези, стара мајко,",
       "lat": "Ja izlezi, stara majko,",
       "en": "Come on out, old mother,"
      },
      {
       "cyr": "надвор до портата,",
       "lat": "nadvor do portata,",
       "en": "outside to the gate,"
      },
      {
       "cyr": "па да чуеш, стара мајко,",
       "lat": "pa da čueš, stara majko,",
       "en": "and hear, old mother,"
      },
      {
       "cyr": "што песна се пее.",
       "lat": "što pesna se pee.",
       "en": "what song is being sung."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да го чуеш, стара мајко,",
       "lat": "Da go čueš, stara majko,",
       "en": "Hear him, old mother,"
      },
      {
       "cyr": "твојот син комита,",
       "lat": "tvojot sin komita,",
       "en": "your son the rebel,"
      },
      {
       "cyr": "песна пее, стара мајко,",
       "lat": "pesna pee, stara majko,",
       "en": "he sings a song, old mother,"
      },
      {
       "cyr": "в' планина ќе оди.",
       "lat": "v' planina ḱe odi.",
       "en": "he will go into the mountains."
      },
      {
       "cyr": "Песна пее, стара мајко,",
       "lat": "Pesna pee, stara majko,",
       "en": "He sings a song, old mother,"
      },
      {
       "cyr": "песна за слобода.",
       "lat": "pesna za sloboda.",
       "en": "a song of freedom."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Збогум мајко, збогум жено,",
       "lat": "Zbogum majko, zbogum ženo,",
       "en": "Farewell, mother, farewell, wife,"
      },
      {
       "cyr": "збогум мили деца.",
       "lat": "zbogum mili deca.",
       "en": "farewell, dear children."
      },
      {
       "cyr": "Мојта жена, стара мајко,",
       "lat": "Mojta žena, stara majko,",
       "en": "My wife, old mother,"
      },
      {
       "cyr": "пушка малихера.",
       "lat": "puška malihera.",
       "en": "is the Mannlicher rifle."
      },
      {
       "cyr": "Мојте деца, стара мајко,",
       "lat": "Mojte deca, stara majko,",
       "en": "My children, old mother,"
      },
      {
       "cyr": "дребните куршуми.",
       "lat": "drebnite kuršumi.",
       "en": "are the small bullets."
      }
     ]
    }
