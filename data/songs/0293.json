 "versions": [
  {
   "label": "",
   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "(Со маки сум се родил јас)",
       "lat": "(So maki sum se rodil jas)",
       "en": "(I was born with suffering)",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Со маки сум се родил јас,",
       "lat": "So maki sum se rodil jas,",
       "en": "I was born with suffering,",
       "en_mt": false
      },
      {
       "cyr": "со жалости јас ќе си умрам.",
       "lat": "so žalosti jas ḱe si umram.",
       "en": "with sorrow I'll die.",
       "en_mt": false
      },
      {
       "cyr": "Маките да ми ги напишете",
       "lat": "Makite da mi gi napišete",
       "en": "I want you to write down my sorrows",
       "en_mt": false
      },
      {
       "cyr": "одозгора на гробот мој.",
       "lat": "odozgora na grobot moj.",
       "en": "on top of my grave.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе се качам на планина,",
       "lat": "Ḱe se kačam na planina,",
       "en": "I'll climb up the mountain,",
       "en_mt": false
      },
      {
       "cyr": "ќе влезам в' темни пештери.",
       "lat": "ḱe vlezam v' temni pešteri.",
       "en": "I'll enter dark caves.",
       "en_mt": false
      },
      {
       "cyr": "Очите да ми паралдисаат,",
       "lat": "Očite da mi paraldisaat,",
       "en": "Let my eyes go blind,",
       "en_mt": false
      },
      {
       "cyr": "сонцето да не го видам.",
       "lat": "sonceto da ne go vidam.",
       "en": "never to see the Sun again.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе слезам долу в' ѓул бавчи,",
       "lat": "Ḱe slezam dolu v' ǵul bavči,",
       "en": "I'll go to the rose garden,",
       "en_mt": false
      },
      {
       "cyr": "по тој ми алов катмер каранфил.",
       "lat": "po toj mi alov katmer karanfil.",
       "en": "to get that red-layered carnation.",
       "en_mt": false
      },
      {
       "cyr": "По тој алов катмер каранфил",
       "lat": "Po toj alov katmer karanfil",
       "en": "To get that red-layered carnation,",
       "en_mt": false
      },
      {
       "cyr": "по тој ран, бел босилок.",
       "lat": "po toj ran, bel bosilok.",
       "en": "that early white basil.",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
