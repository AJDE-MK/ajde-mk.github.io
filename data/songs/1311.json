   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Под старите кули, в' меана една",
       "lat": "Pod starite kuli, v' meana edna",
       "en": "Under the old towers, in a tavern,"
      },
      {
       "cyr": "песни мераклиски ечат.",
       "lat": "pesni merakliski ečat.",
       "en": "songs of longing ring out."
      },
      {
       "cyr": "Тамбури свират, виолината плаче,",
       "lat": "Tamburi svirat, violinata plače,",
       "en": "Tamburas play, the violin weeps,"
      },
      {
       "cyr": "боемите рани си лечат.",
       "lat": "boemite rani si lečat.",
       "en": "the bohemians heal their wounds."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стариот фенер згаснува,",
       "lat": "Stariot fener zgasnuva,",
       "en": "The old lantern is going out,"
      },
      {
       "cyr": "се губи трепетниот сјај,",
       "lat": "se gubi trepetniot sjaj,",
       "en": "the trembling glow is fading,"
      },
      {
       "cyr": "уморни тамбурашите",
       "lat": "umorni tamburašite",
       "en": "the tired tambura players"
      },
      {
       "cyr": "свират фајронт за крај.",
       "lat": "svirat fajront za kraj.",
       "en": "play the closing time for the end."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кранфили бели, црвени рози",
       "lat": "Kranfili beli, crveni rozi",
       "en": "White carnations, red roses"
      },
      {
       "cyr": "продава младата дама.",
       "lat": "prodava mladata dama.",
       "en": "the young lady sells,"
      },
      {
       "cyr": "Заматен поглед, убавица млада,",
       "lat": "Zamaten pogled, ubavica mlada,",
       "en": "with a clouded gaze, a young beauty,"
      },
      {
       "cyr": "сонува тажна и сама.",
       "lat": "sonuva tažna i sama.",
       "en": "she dreams, sad and alone."
      }
     ]
    },
