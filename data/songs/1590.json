   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ќе ме боли душата",
       "lat": "Ḱe me boli dušata",
       "en": "My soul will ache"
      },
      {
       "cyr": "да ме остави",
       "lat": "da me ostavi",
       "en": "when she leaves me,"
      },
      {
       "cyr": "таа што ја милувам",
       "lat": "taa što ja miluvam",
       "en": "the one I have cherished"
      },
      {
       "cyr": "девет години.",
       "lat": "devet godini.",
       "en": "for nine years."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Но, тебе да те немам,",
       "lat": "No, tebe da te nemam,",
       "en": "But if I didn't have you,"
      },
      {
       "cyr": "песно најмила,",
       "lat": "pesno najmila,",
       "en": "dearest song,"
      },
      {
       "cyr": "јас ќе лунѕам слеп и болен,",
       "lat": "jas ḱe lundzam slep i bolen,",
       "en": "I would stare, blind and sick,"
      },
      {
       "cyr": "вечно далдисан.",
       "lat": "večno daldisan.",
       "en": "forever dazed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе ме стега срцето,",
       "lat": "Ḱe me stega srceto,",
       "en": "My heart will tighten,"
      },
      {
       "cyr": "ќе ми препукне,",
       "lat": "ḱe mi prepukne,",
       "en": "it will burst,"
      },
      {
       "cyr": "да не видам роднини",
       "lat": "da ne vidam rodnini",
       "en": "so that I do not see relatives"
      },
      {
       "cyr": "и верни другари.",
       "lat": "i verni drugari.",
       "en": "and faithful friends."
      }
     ]
