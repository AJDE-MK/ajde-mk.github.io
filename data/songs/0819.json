       "lat": "vrvci ima, čevli nema,",
       "en": "he has shoe laces, but no shoes,"
      },
      {
       "cyr": "сиромав, сиромав.",
       "lat": "siromav, siromav.",
       "en": "poor him, poor him."
      }
     ]
    },
