   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Модерна си имам жена",
       "lat": "Moderna si imam žena",
       "en": "I have a modern wife,"
      },
      {
       "cyr": "пријатели мои,",
       "lat": "prijateli moi,",
       "en": "my friends,"
      },
      {
       "cyr": "граѓанка од добра куќа",
       "lat": "graǵanka od dobra kuḱa",
       "en": "a citizen from a good house,"
      },
      {
       "cyr": "и од добар сој.",
       "lat": "i od dobar soj.",
       "en": "and of noble descent."
      },
      {
       "cyr": "Да ја видиш, да се чудиш,",
       "lat": "Da ja vidiš, da se čudiš,",
       "en": "If you see her, you will be surprised,"
      },
      {
       "cyr": "да се исплашиш, леле,",
       "lat": "da se isplašiš, lele,",
       "en": "you will be scared, oh,"
      },
      {
       "cyr": "три дни далеку да бегаш",
       "lat": "tri dni daleku da begaš",
       "en": "you will run far away for three days"
      },
      {
       "cyr": "да не е сретниш.",
       "lat": "da ne e sretniš.",
       "en": "just to avoid seeing her."
      }
     ]
    },
    {
     "lines": [
