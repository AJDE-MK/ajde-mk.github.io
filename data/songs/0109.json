   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Што ми е мерак полјак да бидам,",
       "lat": "Što mi e merak poljak da bidam,",
       "en": "I have a desire1 to be a field guard2",
       "en_mt": false
      },
      {
       "cyr": "мори Божано,",
       "lat": "mori Božano,",
       "en": "My dear Bozhano3,",
       "en_mt": false
      },
      {
       "cyr": "полјак да бидам на ваш'та нива,",
       "lat": "poljak da bidam na vaš'ta niva,",
       "en": "To be a field guard in your fields,",
       "en_mt": false
      },
      {
       "cyr": "мори девојко.",
       "lat": "mori devojko.",
       "en": "Dear one (young girl).",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На ваш'та нива, нива голема,",
       "lat": "Na vaš'ta niva, niva golema,",
       "en": "In your fields, in your vast fields,",
       "en_mt": false
      },
      {
       "cyr": "мори Божано,",
       "lat": "mori Božano,",
       "en": "My dear Bozhano,",
       "en_mt": false
      },
      {
       "cyr": "ти да ја жнееш, јас да те гледам,",
       "lat": "ti da ja žneeš, jas da te gledam,",
       "en": "You to cut (harvest), me to watch you,",
       "en_mt": false
      },
      {
       "cyr": "мори девојко.",
       "lat": "mori devojko.",
       "en": "Dear one (young girl).",
       "en_mt": false
