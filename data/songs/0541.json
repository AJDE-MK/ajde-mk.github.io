   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Од Битола до Вевчани сè сардисано,",
       "lat": "Od Bitola do Vevčani sè sardisano,",
       "en": "From Bitola to Vevchani, everything was encircled"
      },
      {
       "cyr": "ура, ура, Ставре војвода!",
       "lat": "ura, ura, Stavre vojvoda!",
       "en": "Hurrah, hurrah, Stavre the Vojvoda!"
      },
      {
       "cyr": "Го сардисаа млад Ставре у Шекутко'и.",
       "lat": "Go sardisaa mlad Stavre u Šekutko'i.",
       "en": "Young Stavre was encircled in Shekutko's"
      },
      {
       "cyr": "ура, ура, Ставре војвода!",
       "lat": "ura, ura, Stavre vojvoda!",
       "en": "Hurrah, hurrah Stavre the Vojvoda!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ставре имат машко срце, не се предават,",
       "lat": "Stavre imat maško srce, ne se predavat,",
       "en": "Stavre has a manly heart, he is not surrendering"
      },
      {
       "cyr": "ура, ура, Ставре војвода!",
       "lat": "ura, ura, Stavre vojvoda!",
       "en": "Hurrah, hurrah, Stavre the Vojvoda!"
      },
      {
       "cyr": "Ставре има бердан пушка, не се предава,",
       "lat": "Stavre ima berdan puška, ne se predava,",
       "en": "Stavre has a Berdan rifle, he is not surrendering"
      },
      {
       "cyr": "ура, ура, Ставре војвода!",
       "lat": "ura, ura, Stavre vojvoda!",
       "en": "Hurrah, hurrah Stavre the Vojvoda!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Прва бомба што ми фрли в' конопиштата,",
       "lat": "Prva bomba što mi frli v' konopištata,",
       "en": "The first bomb he threw hit the hemp field"
      },
      {
       "cyr": "ура, ура, Ставре војвода!",
       "lat": "ura, ura, Stavre vojvoda!",
       "en": "Hurrah, hurrah, Stavre the Vojvoda"
      },
      {
       "cyr": "Па ми удри десет души од аскерот,",
       "lat": "Pa mi udri deset duši od askerot,",
       "en": "Then he hit ten soldiers"
      },
      {
       "cyr": "ура, ура, Ставре војвода!",
       "lat": "ura, ura, Stavre vojvoda!",
       "en": "Hurrah, hurrah, Stavre the Vojvoda!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сврти пушка под брадата, Ставре војвода,",
