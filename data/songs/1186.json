   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Нашата света куќа,",
       "lat": "Našata sveta kuḱa,",
       "en": "Our holy home,"
      },
      {
       "cyr": "нашето огниште,",
       "lat": "našeto ognište,",
       "en": "our hearth,"
      },
      {
       "cyr": "тука си бевме среќни,",
       "lat": "tuka si bevme sreḱni,",
       "en": "here we were happy,"
      },
      {
       "cyr": "тука си растевме.",
       "lat": "tuka si rastevme.",
       "en": "here we grew up."
      },
      {
       "cyr": "И нашето дрво расте",
       "lat": "I našeto drvo raste",
       "en": "And our tree grows"
      },
      {
       "cyr": "на старото скришно место,",
       "lat": "na staroto skrišno mesto,",
       "en": "in the old secret place,"
      },
      {
       "cyr": "кај што се љубевме.",
       "lat": "kaj što se ljubevme.",
       "en": "where we kissed."
      },
      {
       "cyr": "И наеднаш сè ќе згасне",
       "lat": "I naednaš sè ḱe zgasne",
       "en": "And suddenly everything will go out"
      },
      {
       "cyr": "и летото ќе се смири,",
       "lat": "i letoto ḱe se smiri,",
       "en": "and the summer will grow calm,"
      },
      {
       "cyr": "кавал ќе засвири.",
       "lat": "kaval ḱe zasviri.",
       "en": "a shepherd's flute will play."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, за една судбина,",
       "lat": "Aj, za edna sudbina,",
       "en": "Ah, for one fate,"
      },
      {
       "cyr": "оној што силно љуби,",
       "lat": "onoj što silno ljubi,",
       "en": "the one who loves strongly"
      },
      {
       "cyr": "мора да губи,",
       "lat": "mora da gubi,",
       "en": "must lose,"
      },
      {
       "cyr": "туѓа си бескрајно.",
       "lat": "tuǵa si beskrajno.",
       "en": "you are endlessly someone else's."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оној што сега молчи",
       "lat": "Onoj što sega molči",
       "en": "The one who is silent now"
