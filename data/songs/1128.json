 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Ој ти момче охриѓанче,",
       "lat": "- Oj ti momče ohriǵanče,",
       "en": "- Hey you Ohrid lad,"
      },
      {
       "cyr": "што си толку замислено,",
       "lat": "što si tolku zamisleno,",
       "en": "why are you so absent-minded,"
      },
      {
       "cyr": "крај езеро везден шеташ,",
       "lat": "kraj ezero vezden šetaš,",
       "en": "walking all the time near the lake,"
      },
      {
       "cyr": "кажи дали некој чекаш,",
       "lat": "kaži dali nekoj čekaš,",
       "en": "tell me, are you waiting for someone,"
      },
      {
       "cyr": "или срце некој ти открадна,",
       "lat": "ili srce nekoj ti otkradna,",
       "en": "or did someone steal your heart,"
      },
      {
       "cyr": "тешко да го заборавиш?",
       "lat": "teško da go zaboraviš?",
       "en": "which is hard to forget?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не ме прашај, моме младо,",
       "lat": "- Ne me prašaj, mome mlado,",
       "en": "- Don't ask me, young lady,"
      },
      {
       "cyr": "мачно ми е да ти кажам,",
       "lat": "mačno mi e da ti kažam,",
       "en": "it is hard for me to tell you,"
      },
      {
       "cyr": "јас си љубев моме лично,",
       "lat": "jas si ljubev mome lično,",
       "en": "but I loved a pretty lady,"
      },
      {
       "cyr": "туѓинче од друго место,",
       "lat": "tuǵinče od drugo mesto,",
       "en": "she lived in another place,"
      },
      {
       "cyr": "љубов си дадовме, среќни бевме,",
       "lat": "ljubov si dadovme, sreḱni bevme,",
       "en": "we loved each other and were happy"
      },
      {
       "cyr": "само едно, едно лето.",
       "lat": "samo edno, edno leto.",
       "en": "just one, one summer."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дојде време, си замина,",
       "lat": "Dojde vreme, si zamina,",
       "en": "The time came, she left,"
      },
      {
       "cyr": "крај водите ме остави,",
       "lat": "kraj vodite me ostavi,",
       "en": "she left me near these waters,"
      },
      {
       "cyr": "да ме мачат спомените,",
       "lat": "da me mačat spomenite,",
       "en": "my memories torment me,"
      },
      {
       "cyr": "в' срце трејат, не се бришат.",
       "lat": "v' srce trejat, ne se brišat.",
       "en": "they can't be erased from my heart."
      },
      {
       "cyr": "Само дојди момче, врати ми се,",
       "lat": "Samo dojdi momče, vrati mi se,",
       "en": "Just come dear, come back to me,"
      },
      {
       "cyr": "чекам, чекам крај езеро,",
       "lat": "čekam, čekam kraj ezero,",
       "en": "I am waiting, waiting by the lake,"
      },
      {
       "cyr": "само дојди либе, врати ми се,",
       "lat": "samo dojdi libe, vrati mi se,",
       "en": "just come my love, come back to me,"
      },
      {
       "cyr": "чекам, чекам крај езеро.",
       "lat": "čekam, čekam kraj ezero.",
       "en": "I am waiting, waiting by the lake."
      }
     ]
    }
   ]
  }
 ],
