   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ај, Ѓорушице, црно око,",
       "lat": "Aj, Ǵorušice, crno oko,",
       "en": "Oh, Gjorusica, dark eyes,"
      },
      {
       "cyr": "ај, промени се, накити се.",
       "lat": "aj, promeni se, nakiti se.",
       "en": "oh, change your clothes, dress up,"
      },
      {
       "cyr": "Ај, па излези на ќушето.",
       "lat": "Aj, pa izlezi na ḱušeto.",
       "en": "oh, then come out onto the corner."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај там' ќе пројде силвин Кочо,",
       "lat": "Aj tam' ḱe projde silvin Kočo,",
       "en": "Oh, there handsome Kocho will pass by,"
      },
      {
       "cyr": "ај ќе ти рече добро вечер.",
       "lat": "aj ḱe ti reče dobro večer.",
       "en": "oh, he will say good evening to you."
      },
      {
       "cyr": "Ај, ти му речи дојди вечер.",
       "lat": "Aj, ti mu reči dojdi večer.",
       "en": "Oh, you tell him: come this evening."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, дојди вечер пред вечера,",
       "lat": "Aj, dojdi večer pred večera,",
       "en": "Oh, come in the evening, before supper,"
      },
      {
       "cyr": "ај, дури не сме вечерале.",
       "lat": "aj, duri ne sme večerale.",
       "en": "oh, while we have not yet eaten supper."
      },
      {
       "cyr": "Ај дур' постела не сме послале.",
       "lat": "Aj dur' postela ne sme poslale.",
       "en": "Oh, while we have not yet made the bed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, дур' постела не сме послале,",
       "lat": "Aj, dur' postela ne sme poslale,",
       "en": "Oh, while we have not yet made the bed,"
      },
      {
       "cyr": "ај, вити порти затвориле.",
       "lat": "aj, viti porti zatvorile.",
       "en": "oh, they have closed the vine-covered gates."
      },
      {
       "cyr": "Ај, шимшир порти затвориле.",
       "lat": "Aj, šimšir porti zatvorile.",
       "en": "Oh, they have closed the boxwood gates."
      }
