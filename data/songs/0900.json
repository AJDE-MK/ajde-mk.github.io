     "lines": [
      {
       "cyr": "Стори ми абер Божано",
       "lat": "Stori mi aber Božano",
       "en": "Send me word, Bozhana,"
      },
      {
       "cyr": "дали да идам порано,",
       "lat": "dali da idam porano,",
       "en": "whether I should come sooner,"
      },
      {
       "cyr": "оти јас слушнав приказни",
       "lat": "oti jas slušnav prikazni",
       "en": "because I have heard stories"
      },
      {
       "cyr": "дека ти ќе ме оставиш.",
       "lat": "deka ti ḱe me ostaviš.",
       "en": "that you will leave me."
      },
      {
       "cyr": "Знам какво писмо пишуваш,",
       "lat": "Znam kakvo pismo pišuvaš,",
       "en": "I know what letter you are writing,"
      },
      {
       "cyr": "те молам да не го праќаш",
       "lat": "te molam da ne go praḱaš",
       "en": "I beg you not to send it,"
      },
      {
       "cyr": "писмото абер од тебе,",
       "lat": "pismoto aber od tebe,",
       "en": "a letter, news from you,"
      },
      {
       "cyr": "писмото, камен за мене.",
       "lat": "pismoto, kamen za mene.",
       "en": "a letter, a stone for me."
      },
      {
       "cyr": "Не можам да го прочитам,",
       "lat": "Ne možam da go pročitam,",
       "en": "I cannot read it,"
      },
      {
       "cyr": "душава ќе ја разболам.",
       "lat": "dušava ḱe ja razbolam.",
       "en": "I would make my soul ill."
      }
     ]
