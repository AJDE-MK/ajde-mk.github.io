       "en": "so that they can see me"
      },
      {
       "cyr": "кога очите ми гледаат,",
       "lat": "koga očite mi gledaat,",
       "en": "when my eyes see,"
      },
      {
       "cyr": "а душата ми бара",
       "lat": "a dušata mi bara",
       "en": "and my soul seeks"
      },
      {
       "cyr": "чашка ракија,",
       "lat": "čaška rakija,",
       "en": "a glass of rakija,"
      },
      {
       "cyr": "рујно вино црвено?",
       "lat": "rujno vino crveno?",
       "en": "and some red wine?"
      },
      {
       "cyr": "Веднаш очите ми светат",
       "lat": "Vednaš očite mi svetat",
       "en": "My eyes immediately light up"
      },
      {
       "cyr": "штом ќе видам туѓо.",
       "lat": "štom ḱe vidam tuǵo.",
       "en": "when I see someone else's."
      }
     ]
    },
