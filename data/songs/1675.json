    {
     "lines": [
      {
       "cyr": "Ние Македонците",
       "lat": "Nie Makedoncite",
       "en": "We Macedonians"
      },
      {
       "cyr": "мераклии сме големи,",
       "lat": "meraklii sme golemi,",
       "en": "are lovers of life's pleasures,"
      },
      {
       "cyr": "такви сме се родиле,",
       "lat": "takvi sme se rodile,",
       "en": "that is how we were born,"
      },
      {
       "cyr": "на сè си мерак имаме.",
       "lat": "na sè si merak imame.",
       "en": "we have a passion for everything."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И на бела лута ракија,",
       "lat": "I na bela luta rakija,",
       "en": "For strong, clear rakija,"
      },
      {
       "cyr": "и на рујно вино црвено,",
       "lat": "i na rujno vino crveno,",
       "en": "and for rich red wine,"
      },
      {
       "cyr": "по меани да лудуваме,",
       "lat": "po meani da luduvame,",
       "en": "to revel in the taverns,"
      },
      {
       "cyr": "со туѓи жени да лудуваме.",
       "lat": "so tuǵi ženi da luduvame.",
       "en": "to revel with other men's wives."
      }
