   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Еј Деспино, убавино,",
       "lat": "Ej Despino, ubavino,",
       "en": "Hey Despina, beauty,"
      },
      {
       "cyr": "тешки порти отвори ми,",
       "lat": "teški porti otvori mi,",
       "en": "open your heavy gates for me,"
      },
      {
       "cyr": "пак ти пејам со другари,",
       "lat": "pak ti pejam so drugari,",
       "en": "again I’ll sing to you with my friends,"
      },
      {
       "cyr": "рујно вино донеси ми.",
       "lat": "rujno vino donesi mi.",
       "en": "bring me some red wine."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе те земам за невеста,",
       "lat": "Ḱe te zemam za nevesta,",
       "en": "I will take you as my wife,"
      },
      {
       "cyr": "ќе те венчам",
       "lat": "ḱe te venčam",
       "en": "I will marry you in"
      },
      {
       "cyr": "Свети Наум на Илинден,",
       "lat": "Sveti Naum na Ilinden,",
       "en": "Saint Naum on Ilinden,"
      },
      {
       "cyr": "в' рани зори",
       "lat": "v' rani zori",
       "en": "in early dawn you'll"
      },
      {
       "cyr": "да ми красиш бели двори.",
       "lat": "da mi krasiš beli dvori.",
       "en": "decorate my white courtyard."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Остави си убав ѓергеф,",
       "lat": "Ostavi si ubav ǵergef,",
       "en": "Leave your nice embroidery frame,"
      },
      {
       "cyr": "не ти треба пари, руба,",
       "lat": "ne ti treba pari, ruba,",
       "en": "you don't need money, clothes,"
      },
      {
       "cyr": "срце твое отвори ми",
       "lat": "srce tvoe otvori mi",
       "en": "open your heart to me"
      },
      {
       "cyr": "да ми бидеш верна љуба.",
       "lat": "da mi bideš verna ljuba.",
       "en": "to be my faithful love."
      }
     ]
    },
    {
     "lines": [
