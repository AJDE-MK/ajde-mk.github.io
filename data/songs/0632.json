     "lines": [
      {
       "cyr": "Јанке ле, Јанке убава,",
       "lat": "Janke le, Janke ubava,",
       "en": "Janka, oh Janka, beautiful,"
      },
      {
       "cyr": "облечи бела промена.",
       "lat": "obleči bela promena.",
       "en": "put on a white kerchief."
      },
      {
       "cyr": "Облечи бела промена,",
       "lat": "Obleči bela promena,",
       "en": "Put on a white kerchief,"
      },
      {
       "cyr": "па слези Јанке сред село.",
       "lat": "pa slezi Janke sred selo.",
       "en": "and come down, Janka, to the middle of the village."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па слези долу сред село,",
       "lat": "Pa slezi dolu sred selo,",
       "en": "And come down to the middle of the village,"
      },
      {
       "cyr": "да видиш чудо големо.",
       "lat": "da vidiš čudo golemo.",
       "en": "to see a great wonder."
      },
      {
       "cyr": "Да видиш оро големо",
       "lat": "Da vidiš oro golemo",
       "en": "To see a great dance"
      },
      {
       "cyr": "и да се фатиш на оро.",
       "lat": "i da se fatiš na oro.",
       "en": "and to join the dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не можам брату да дојдам,",
       "lat": "Ne možam bratu da dojdam,",
       "en": "I cannot come to my brother,"
      },
      {
       "cyr": "нели сме пусто роднина?",
       "lat": "neli sme pusto rodnina?",
       "en": "are we not close kin?"
      },
      {
       "cyr": "Тате и чичо, два брата,",
       "lat": "Tate i čičo, dva brata,",
       "en": "Father and uncle, two brothers,"
      },
      {
       "cyr": "мама и стрина јатрви.",
       "lat": "mama i strina jatrvi.",
       "en": "mother and aunt, wives of brothers."
      },
      {
       "cyr": "Тате и чичо, два брата,",
       "lat": "Tate i čičo, dva brata,",
       "en": "Father and uncle, two brothers,"
      },
      {
       "cyr": "јас и ти први брачеди.",
       "lat": "jas i ti prvi bračedi.",
       "en": "you and I, first cousins."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јано ле Јанке, убаво",
