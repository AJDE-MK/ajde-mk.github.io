   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Штом ќе блеснат први зраци,",
       "lat": "Štom ḱe blesnat prvi zraci,",
       "en": "As soon as the first rays flash,"
      },
      {
       "cyr": "мајко разбуди ме, моја,",
       "lat": "majko razbudi me, moja,",
       "en": "mother, wake me, my own,"
      },
      {
       "cyr": "пат ме чека далечен,",
       "lat": "pat me čeka dalečen,",
       "en": "a distant road awaits me,"
      },
      {
       "cyr": "прегратка дај ми сега твоја.",
       "lat": "pregratka daj mi sega tvoja.",
       "en": "give me your embrace now."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Одам, одам мила мајчице,",
       "lat": "Odam, odam mila majčice,",
       "en": "I go, I go, dear mother,"
      },
      {
       "cyr": "в' туѓина одам, ќе бидам сама.",
       "lat": "v' tuǵina odam, ḱe bidam sama.",
       "en": "I go to a foreign land, I will be alone."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Барам малку среќа јас,",
       "lat": "Baram malku sreḱa jas,",
       "en": "I am looking for a little happiness,"
      },
      {
       "cyr": "судбата што ќе ми даде,",
       "lat": "sudbata što ḱe mi dade,",
       "en": "that fate will give me,"
      },
      {
       "cyr": "што ли ме чека не знам ни сама",
       "lat": "što li me čeka ne znam ni sama",
       "en": "what awaits me I do not know myself,"
