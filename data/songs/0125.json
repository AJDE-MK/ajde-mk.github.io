 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Абер ми дојде од Солуна града:",
       "lat": "Aber mi dojde od Soluna grada:",
       "en": "News comes to me from Solun [now Thessalonika] city",
       "en_mt": false
      },
      {
       "cyr": "солунчаните бесилка стаиле,",
       "lat": "solunčanite besilka staile,",
       "en": "The Solun people have made a gallows",
       "en_mt": false
      },
      {
       "cyr": "ќе ми го бесат Гоцета,",
       "lat": "ḱe mi go besat Goceta,",
       "en": "They will hang Goce",
       "en_mt": false
      },
      {
       "cyr": "Гоцета Делчев војвода.",
       "lat": "Goceta Delčev vojvoda.",
       "en": "Goce Delcev war-leader.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гоце ми се сторил",
       "lat": "Goce mi se storil",
       "en": "Goce disguised himself",
       "en_mt": false
      },
      {
       "cyr": "црно ќумурџиче",
       "lat": "crno ḱumurdžiče",
       "en": "as a black charcoal-burner",
       "en_mt": false
      },
      {
       "cyr": "па ми се шетал",
       "lat": "pa mi se šetal",
       "en": "And went walking",
       "en_mt": false
      },
      {
       "cyr": "Солунска чаршија.",
       "lat": "Solunska čaršija.",
       "en": "in the Solun market.",
       "en_mt": false
      },
      {
       "cyr": "На среќа сретнал аскери",
       "lat": "Na sreḱa sretnal askeri",
       "en": "As luck would have it, he met some Turkish soldiers",
       "en_mt": false
      },
      {
       "cyr": "и на Гоцета зборуваат:",
       "lat": "i na Goceta zboruvaat:",
       "en": "and they spoke to Goce:",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре ѓаурче, црно ќумурџиче",
       "lat": "- A bre ǵaurče, crno ḱumurdžiče",
       "en": "- Hey little non-Muslim-scum, black charcoal-burner",
       "en_mt": false
      },
      {
       "cyr": "не ли го виде Гоцета,",
       "lat": "ne li go vide Goceta,",
       "en": "Haven't you seen Goce,",
       "en_mt": false
      },
      {
       "cyr": "Гоцета Делчев војвода?",
       "lat": "Goceta Delčev vojvoda?",
       "en": "Goce Delcev war-leader?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре аскери, вие бре аскери",
       "lat": "- A bre askeri, vie bre askeri",
       "en": "- Hey Turkish soldiers, hey you Turkish soldiers",
       "en_mt": false
      },
      {
       "cyr": "и да го видам Гоцета,",
       "lat": "i da go vidam Goceta,",
       "en": "And if I see Goce",
       "en_mt": false
      },
      {
       "cyr": "јас Гоце не го познавам.",
       "lat": "jas Goce ne go poznavam.",
       "en": "I wouldn't know Goce.",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
 "pending_english": false
}