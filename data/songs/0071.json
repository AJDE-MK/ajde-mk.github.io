      {
       "cyr": "Ој девојче, девојче,",
       "lat": "Oj devojče, devojče,",
       "en": "Oh young girl, young girl,"
      },
      {
       "cyr": "ти тетовско јаболче.",
       "lat": "ti tetovsko jabolče.",
       "en": "you apple from Tetovo."
      },
      {
       "cyr": "Покажи белото лице,",
       "lat": "Pokaži beloto lice,",
       "en": "Show me your white face"
      },
      {
       "cyr": "сакам да го видам јас.",
       "lat": "sakam da go vidam jas.",
       "en": "I want to see it."
      }
     ]
    },
    {
     "lines": [
      {
