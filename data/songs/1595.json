   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Не спиј ќерко, не спи душо",
       "lat": "- Ne spij ḱerko, ne spi dušo",
       "en": "- Don't sleep, daughter, don't sleep, my soul,"
      },
      {
       "cyr": "надвор на тремчево.",
       "lat": "nadvor na tremčevo.",
       "en": "outside on the porch."
      },
      {
       "cyr": "Ми се фалат до три луди",
       "lat": "Mi se falat do tri ludi",
       "en": "Three men are boasting"
      },
      {
       "cyr": "да те грабат на полноќи.",
       "lat": "da te grabat na polnoḱi.",
       "en": "they will abduct you at midnight."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Херој биди, стара мајко,",
       "lat": "- Heroj bidi, stara majko,",
       "en": "- Be brave, old mother,"
      },
      {
       "cyr": "не ми се јадосуј.",
       "lat": "ne mi se jadosuj.",
       "en": "don't grieve over me."
      },
      {
       "cyr": "Јас си имам три пиштола,",
       "lat": "Jas si imam tri pištola,",
       "en": "I have three pistols,"
      },
      {
       "cyr": "три пиштола од Јанета.",
       "lat": "tri pištola od Janeta.",
       "en": "three pistols from Janeta."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе им пукнам на три луди,",
       "lat": "Ḱe im puknam na tri ludi,",
       "en": "I will shoot the three men,"
      },
      {
       "cyr": "ќе утепам три луди",
       "lat": "ḱe utepam tri ludi",
       "en": "I will kill the three men"
      },
      {
       "cyr": "и ќе одам во планина,",
       "lat": "i ḱe odam vo planina,",
       "en": "and go to the mountains,"
      },
      {
       "cyr": "во планина, кај Јанета.",
       "lat": "vo planina, kaj Janeta.",
       "en": "to the mountains, to Janeta."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пукна Јана, с' три пиштола,",
       "lat": "Pukna Jana, s' tri pištola,",
       "en": "Jana fired with all three pistols,"
      },
      {
       "cyr": "ми отепа три луди",
