   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Еј, години поминати,",
       "lat": "Ej, godini pominati,",
       "en": "Hey, years gone by,"
      },
      {
       "cyr": "еј, ѓердани искинати.",
       "lat": "ej, ǵerdani iskinati.",
       "en": "hey, necklaces torn."
      },
      {
       "cyr": "Еден ден, еден миг",
       "lat": "Eden den, eden mig",
       "en": "One day, one moment,"
      },
      {
       "cyr": "срце ќе отворам,",
       "lat": "srce ḱe otvoram,",
       "en": "I will open my heart,"
      },
      {
       "cyr": "еј, искрено ќе прозборам.",
       "lat": "ej, iskreno ḱe prozboram.",
       "en": "hey, I will speak sincerely."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не се крие мерак македонски,",
       "lat": "Ne se krie merak makedonski,",
       "en": "Macedonian merak is not hidden,"
      },
      {
       "cyr": "в' гради пробива,",
       "lat": "v' gradi probiva,",
       "en": "it breaks through in the chest,"
      },
      {
       "cyr": "ниту вино, ниту ракија",
       "lat": "nitu vino, nitu rakija",
       "en": "neither wine nor brandy"
      },
      {
       "cyr": "го заспива.",
       "lat": "go zaspiva.",
       "en": "puts it to sleep."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј, ливади несонети,",
       "lat": "Ej, livadi nesoneti,",
       "en": "Hey, meadows unmown,"
      },
      {
       "cyr": "еј, класови изронети.",
       "lat": "ej, klasovi izroneti.",
       "en": "hey, ears of grain shed."
      },
      {
       "cyr": "Спомени далечни душа ќе изгорат,",
       "lat": "Spomeni dalečni duša ḱe izgorat,",
       "en": "Distant memories will burn the soul,"
      },
      {
       "cyr": "еј, висушки што говорат.",
       "lat": "ej, visuški što govorat.",
       "en": "hey, weeping willows that speak."
      }
