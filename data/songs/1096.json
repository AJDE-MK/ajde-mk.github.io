       "cyr": "Горе Славеј дошле борци млади,",
       "lat": "Gore Slavej došle borci mladi,",
       "en": "Up at Slavej young fighters have come,"
      },
      {
       "cyr": "ечи песна од јуначки гради,",
       "lat": "eči pesna od junački gradi,",
       "en": "a song echoes from heroic chests,"
      },
      {
       "cyr": "нарамиле пушки на рамена,",
       "lat": "naramile puški na ramena,",
       "en": "they shouldered rifles on their shoulders,"
      },
      {
       "cyr": "развеале знаме аловито.",
       "lat": "razveale zname alovito.",
       "en": "they unfurled the scarlet banner."
      },
      {
       "cyr": "Развеале срце игровито,",
       "lat": "Razveale srce igrovito,",
       "en": "They unfurled a playful heart,"
      },
      {
       "cyr": "рашириле оро шировито.",
       "lat": "raširile oro širovito.",
       "en": "they spread a wide dance."
      }
     ]
    },
    {
     "lines": [
      {
