     "lines": [
      {
       "cyr": "Не се карај, стара ле мајко,",
       "lat": "Ne se karaj, stara le majko,",
       "en": "Do not scold me, old mother,"
      },
      {
       "cyr": "кога сум пијан.",
       "lat": "koga sum pijan.",
       "en": "when I am drunk."
      },
      {
       "cyr": "Зошто лесно не се заб'рава",
       "lat": "Zošto lesno ne se zab'rava",
       "en": "Because it is not easily forgotten,"
      },
      {
       "cyr": "првата љубов.",
       "lat": "prvata ljubov.",
       "en": "first love."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј, мако моја ти,",
       "lat": "Ej, mako moja ti,",
       "en": "Hey, my dear mother,"
      },
      {
       "cyr": "што ме заљуби,",
       "lat": "što me zaljubi,",
       "en": "who made me fall in love,"
      },
      {
       "cyr": "што ме остави.",
       "lat": "što me ostavi.",
       "en": "who left me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Бев заљубил, стара ле мајко,",
