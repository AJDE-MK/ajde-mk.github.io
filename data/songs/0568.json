   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Јас Методи Патче од Охрида",
       "lat": "Jas Metodi Patče od Ohrida",
       "en": "I, Methody Patche, of Ohrid"
      },
      {
       "cyr": "ослободен од битолски затвор.",
       "lat": "osloboden od bitolski zatvor.",
       "en": "was freed from a prison in Bitola."
      },
      {
       "cyr": "Па си тргнав за Охрида града,",
       "lat": "Pa si trgnav za Ohrida grada,",
       "en": "So I left for the city of Ohrid."
      },
      {
       "cyr": "там' не најдов ни мајка, ни татко.",
       "lat": "tam' ne najdov ni majka, ni tatko.",
       "en": "There I found neither my mother, nor my father."
      },
      {
       "cyr": "Там' си најдов верната бисерка,",
       "lat": "Tam' si najdov vernata biserka,",
       "en": "There I only found my worthy pearl,"
      },
      {
       "cyr": "верната бисерка, малихерка.",
       "lat": "vernata biserka, maliherka.",
       "en": "my worthy pearl, my rifle."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па си тргнав за Прилепа града,",
       "lat": "Pa si trgnav za Prilepa grada,",
       "en": "So I left for the city of Prilep,"
      },
      {
       "cyr": "за Прилепа, село Кадиново.",
       "lat": "za Prilepa, selo Kadinovo.",
       "en": "towards Prilep, the village of Kadinovo."
      },
      {
       "cyr": "Там' си најдов верната дружина,",
       "lat": "Tam' si najdov vernata družina,",
       "en": "There I found my faithful company,"
      },
      {
       "cyr": "верната дружина, договорна.",
       "lat": "vernata družina, dogovorna.",
       "en": "my faithful company, resolute."
      },
      {
       "cyr": "Слово држи Методија Патчев:",
       "lat": "Slovo drži Metodija Patčev:",
       "en": "Methody Patchev firmly speaks:"
      },
      {
       "cyr": "напред браќа, борба да водиме.",
       "lat": "napred braḱa, borba da vodime.",
       "en": "- Forward brothers, let’s go to battle."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се зададе силната потера,",
       "lat": "Se zadade silnata potera,",
       "en": "The mighty pursuer started to arrive,"
      },
      {
       "cyr": "силната потера, кавалерија.",
       "lat": "silnata potera, kavalerija.",
       "en": "the mighty pursuer, cavalry."
      },
      {
       "cyr": "Поарџија сите си куршуми,",
       "lat": "Poardžija site si kuršumi,",
       "en": "They used up all their bullets,"
      },
      {
       "cyr": "оставија само еден куршум.",
       "lat": "ostavija samo eden kuršum.",
       "en": "leaving only one bullet."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Слово држи Методија Патче:",
       "lat": "Slovo drži Metodija Patče:",
       "en": "Metody Patche firmly speaks:"
      },
      {
       "cyr": "ајде браќа да се убиеме.",
       "lat": "ajde braḱa da se ubieme.",
       "en": "- Come on brothers, let’s kill ourselves."
      },
      {
       "cyr": "Навртија пушки во градите.",
       "lat": "Navrtija puški vo gradite.",
       "en": "They aimed their rifles towards their chests."
      },
      {
       "cyr": "Прв се уби Методија Патче,",
       "lat": "Prv se ubi Metodija Patče,",
       "en": "The first to kill himself was Methody Patchev,"
      },
      {
       "cyr": "а по него целата дружина.",
       "lat": "a po nego celata družina.",
       "en": "and following him, the whole company."
      }
     ]
    }
   ]
  }
 ],
