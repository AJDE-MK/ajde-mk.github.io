   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сама мома во планина,",
       "lat": "Sama moma vo planina,",
       "en": "A girl alone in the mountain,"
      },
      {
       "cyr": "во планина, без дружина.",
       "lat": "vo planina, bez družina.",
       "en": "in the mountain, without an escort."
      },
      {
       "cyr": "Ја намери лудо младо,",
       "lat": "Ja nameri ludo mlado,",
       "en": "She met a crazy young lad,"
      },
      {
       "cyr": "му ѝ фатил патишчата.",
       "lat": "mu ì fatil patiščata.",
       "en": "he blocked her passage."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Му ги фатил патишчата,",
       "lat": "Mu gi fatil patiščata,",
       "en": "He blocked her passage,"
      },
      {
       "cyr": "му ја фати десна рака.",
       "lat": "mu ja fati desna raka.",
       "en": "he grabbed her right arm."
      },
      {
       "cyr": "Почна моме да се моли,",
       "lat": "Počna mome da se moli,",
       "en": "The girl started to ask him,"
      },
      {
       "cyr": "да се моли на лудото:",
       "lat": "da se moli na ludoto:",
       "en": "to ask the crazy young lad:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Пушчи лудо патишчата,",
       "lat": "- Pušči ludo patiščata,",
       "en": "- Let me pass, please,"
      },
      {
       "cyr": "пушчи ми ја десна рака.",
       "lat": "pušči mi ja desna raka.",
       "en": "let go of my right arm."
      },
      {
       "cyr": "Нели има чисти пости,",
       "lat": "Neli ima čisti posti,",
       "en": "These days we are fasting,"
      },
      {
       "cyr": "чисти пости, велигденски.",
       "lat": "čisti posti, veligdenski.",
       "en": "obserivng the Easter holidays."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се измами лудо младо,",
       "lat": "Se izmami ludo mlado,",
       "en": "The crazy yound lad got confused,"
      },
      {
       "cyr": "му ги пушчи патишчата.",
       "lat": "mu gi pušči patiščata.",
       "en": "he moved away from the passage."
      },
      {
       "cyr": "Му ги пушчи патишчата,",
       "lat": "Mu gi pušči patiščata,",
       "en": "He unblocked the passage,"
      },
      {
       "cyr": "му ја пушчи десна рака.",
       "lat": "mu ja pušči desna raka.",
       "en": "and freed her right arm."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Почна моме да се фали,",
       "lat": "Počna mome da se fali,",
       "en": "The girl started to tell"
      },
      {
       "cyr": "да се фали на лудото:",
       "lat": "da se fali na ludoto:",
       "en": "a story to the crazy lad:"
      },
      {
       "cyr": "- Нашол волкот рудо јагне,",
       "lat": "- Našol volkot rudo jagne,",
       "en": "- A wolf found a young lamb,"
      },
      {
       "cyr": "не знаеше да го јади.",
       "lat": "ne znaeše da go jadi.",
       "en": "he didn't know how to eat it."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Фатил сокол јаребица,",
       "lat": "Fatil sokol jarebica,",
       "en": "The hawk caught a partridge,"
      },
      {
       "cyr": "не знаеше да ја к'лва.",
       "lat": "ne znaeše da ja k'lva.",
       "en": "he didn't know how to peck it."
      },
      {
       "cyr": "Нашол лудо млада љуба",
       "lat": "Našol ludo mlada ljuba",
       "en": "A crazy lad found a young loving girl,"
      },
      {
       "cyr": "не знаеше да ја љуби.",
       "lat": "ne znaeše da ja ljubi.",
       "en": "he didn't know how to love her."
      }
     ]
    }
   ]
  }
 ],
