   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Челник Пејо, леле, овци чува,",
       "lat": "Čelnik Pejo, lele, ovci čuva,",
       "en": "Headman Peyo, alas, tends the sheep,"
      },
      {
       "cyr": "овци чува, леле, на планина.",
       "lat": "ovci čuva, lele, na planina.",
       "en": "tends the sheep, alas, on the mountain."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го догледа, леле, арамија,",
       "lat": "Go dogleda, lele, aramija,",
       "en": "The bandits spotted him, alas,"
      },
      {
       "cyr": "арамија, леле, горски змија.",
       "lat": "aramija, lele, gorski zmija.",
       "en": "the bandits, alas, mountain snakes."
      },
      {
       "cyr": "Абер стори, леле, арамија,",
       "lat": "Aber stori, lele, aramija,",
       "en": "The bandits, alas, sent word,"
      },
      {
       "cyr": "на четето, леле, горски змии.",
       "lat": "na četeto, lele, gorski zmii.",
       "en": "to their band, alas, mountain snakes."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Го фатија, леле, челник Пејо,",
       "lat": "Go fatija, lele, čelnik Pejo,",
       "en": "They caught him, alas, headman Peyo,"
      },
      {
       "cyr": "му врзаа, леле, двете раце.",
       "lat": "mu vrzaa, lele, dvete race.",
       "en": "they tied, alas, both his hands."
      },
      {
       "cyr": "Челник Пејо им се жално моли:",
       "lat": "Čelnik Pejo im se žalno moli:",
       "en": "Headman Peyo pleads sadly with them:"
      },
      {
       "cyr": "- Пуштете ми барем една рака.",
       "lat": "- Puštete mi barem edna raka.",
       "en": "- Release at least one hand for me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да соберам, леле, мојто стадо,",
       "lat": "Da soberam, lele, mojto stado,",
       "en": "So I can gather, alas, my flock,"
      },
      {
       "cyr": "стадо ми е, леле, растурено.",
       "lat": "stado mi e, lele, rastureno.",
       "en": "my flock is, alas, scattered."
      }
     ]
    }
   ]
  }
