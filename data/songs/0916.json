   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Покрај домот твој",
       "lat": "Pokraj domot tvoj",
       "en": "Beside your home"
      },
      {
       "cyr": "има еден јоргован.",
       "lat": "ima eden jorgovan.",
       "en": "there is a lilac."
      },
      {
       "cyr": "Во една рана пролет",
       "lat": "Vo edna rana prolet",
       "en": "In one early spring"
      },
      {
       "cyr": "од него јас ти кинев",
       "lat": "od nego jas ti kinev",
       "en": "I picked from it for you"
      },
      {
       "cyr": "и коси ти украсував.",
       "lat": "i kosi ti ukrasuvav.",
       "en": "and adorned your hair."
      },
      {
       "cyr": "Во една рана пролет",
       "lat": "Vo edna rana prolet",
       "en": "In one early spring"
      },
      {
       "cyr": "од него јас ти кинев,",
       "lat": "od nego jas ti kinev,",
       "en": "I picked from it for you,"
      },
      {
       "cyr": "о, рано голема.",
       "lat": "o, rano golema.",
       "en": "oh, great sorrow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј, зраци сончеви",
       "lat": "Ej, zraci sončevi",
       "en": "Hey, rays of sun"
      },
      {
       "cyr": "стопете тажни снегови,",
       "lat": "stopete tažni snegovi,",
       "en": "melt the sad snows,"
      },
      {
       "cyr": "за да го видам расцутен",
       "lat": "za da go vidam rascuten",
       "en": "so that I may see in bloom"
      },
      {
       "cyr": "стариот нејзин јоргован.",
       "lat": "stariot nejzin jorgovan.",
       "en": "her old lilac."
      },
      {
       "cyr": "Еј вие тамбури",
       "lat": "Ej vie tamburi",
       "en": "Hey, you tambura strings"
      },
      {
       "cyr": "спомнете драги денови,",
       "lat": "spomnete dragi denovi,",
       "en": "recall the dear days,"
      },
      {
       "cyr": "сеуште јас го паметам",
       "lat": "seušte jas go pametam",
       "en": "I still remember"
      },
      {
       "cyr": "стариот нејзин јоргован.",
       "lat": "stariot nejzin jorgovan.",
       "en": "her old lilac."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Само виното",
       "lat": "Samo vinoto",
       "en": "Only the wine"
      },
      {
       "cyr": "знае за оној јоргован.",
       "lat": "znae za onoj jorgovan.",
       "en": "knows about that lilac."
      },
      {
       "cyr": "Ќе скршам безброј чаши",
       "lat": "Ḱe skršam bezbroj čaši",
       "en": "I will break countless glasses"
      },
      {
       "cyr": "за тие деној наши,",
       "lat": "za tie denoj naši,",
       "en": "for those days of ours,"
      },
      {
       "cyr": "за таа младост мината.",
       "lat": "za taa mladost minata.",
       "en": "for that youth now gone."
