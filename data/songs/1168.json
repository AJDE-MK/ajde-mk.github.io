   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Блажена горо, мори зелена,",
       "lat": "Blažena goro, mori zelena,",
       "en": "Blessed forest, hey, green,"
      },
      {
       "cyr": "убава Малеш мори планино,",
       "lat": "ubava Maleš mori planino,",
       "en": "beautiful Malesh, hey, mountain,"
      },
      {
       "cyr": "в' лете си полна, мори, овчари,",
       "lat": "v' lete si polna, mori, ovčari,",
       "en": "in summer you are full, hey, of shepherds,"
      },
      {
       "cyr": "в' зиме си полна, мори, ајдуци.",
       "lat": "v' zime si polna, mori, ajduci.",
       "en": "in winter you are full, hey, of outlaws."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Турци во село, море, влегоа,",
       "lat": "Turci vo selo, more, vlegoa,",
       "en": "The Turks, hey, entered the village,"
      },
      {
       "cyr": "ајдучка сестра, море, грабнаа,",
       "lat": "ajdučka sestra, more, grabnaa,",
       "en": "they seized, hey, the outlaw's sister,"
      },
      {
       "cyr": "ајдуци за страв, море, не знаат,",
       "lat": "ajduci za strav, more, ne znaat,",
       "en": "the outlaws, out of fear, hey, did not know,"
      },
      {
       "cyr": "во турско село, море влегоа.",
       "lat": "vo tursko selo, more vlegoa.",
       "en": "they entered, hey, the Turkish village."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "В' бегова куќа море, влегоа,",
       "lat": "V' begova kuḱa more, vlegoa,",
       "en": "They entered, hey, the bey's house,"
      },
      {
       "cyr": "куќата му ја, море, запалија,",
       "lat": "kuḱata mu ja, more, zapalija,",
       "en": "they set, hey, his house on fire,"
      },
      {
       "cyr": "децата му ги, море, грабнаја,",
       "lat": "decata mu gi, more, grabnaja,",
       "en": "they seized, hey, his children,"
      },
      {
       "cyr": "сестра од ропство, море, извадија.",
       "lat": "sestra od ropstvo, more, izvadija.",
       "en": "they freed, hey, the sister from bondage."
