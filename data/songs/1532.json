   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Македонијо, земјо родена наша",
       "lat": "Makedonijo, zemjo rodena naša",
       "en": "Macedonia, our native land"
      },
      {
       "cyr": "о, да знаеш колку жалиме",
       "lat": "o, da znaeš kolku žalime",
       "en": "oh, if you knew how we grieve"
      },
      {
       "cyr": "за нашите убавини,",
       "lat": "za našite ubavini,",
       "en": "for our beauties,"
      },
      {
       "cyr": "за нашите браќа, сестри.",
       "lat": "za našite braḱa, sestri.",
       "en": "for our brothers, sisters."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ох, ох Македонијо,",
       "lat": "Oh, oh Makedonijo,",
       "en": "Oh, oh Macedonia,"
      },
      {
       "cyr": "ох, ох земјо родена.",
       "lat": "oh, oh zemjo rodena.",
       "en": "oh, oh native land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Може дека сме толку далеку",
       "lat": "Može deka sme tolku daleku",
       "en": "Perhaps because we are so far"
      },
      {
       "cyr": "од тебе, од нашите мили деца,",
       "lat": "od tebe, od našite mili deca,",
       "en": "from you, from our dear children,"
      },
      {
       "cyr": "дење-ноќе си плачиме",
       "lat": "denje-noḱe si plačime",
       "en": "day and night we weep"
      },
      {
       "cyr": "за нашиот мил роден крај.",
       "lat": "za našiot mil roden kraj.",
       "en": "for our dear native region."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ох, ох Македонијо,",
       "lat": "Oh, oh Makedonijo,",
       "en": "Oh, oh Macedonia,"
      },
      {
       "cyr": "ох, ох земјо родена.",
       "lat": "oh, oh zemjo rodena.",
       "en": "oh, oh native land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога од тебе се одделивме ние",
       "lat": "Koga od tebe se oddelivme nie",
       "en": "When we parted from you"
      },
      {
       "cyr": "многу солзи проронивме,",
       "lat": "mnogu solzi proronivme,",
       "en": "we shed many tears,"
      },
      {
       "cyr": "но солзите не пресекнаа",
       "lat": "no solzite ne preseknaa",
       "en": "but the tears did not dry up"
      },
      {
       "cyr": "и љубовта за наш роден крај.",
       "lat": "i ljubovta za naš roden kraj.",
       "en": "nor the love for our native region."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ох, ох Македонијо,",
       "lat": "Oh, oh Makedonijo,",
       "en": "Oh, oh Macedonia,"
      },
      {
       "cyr": "ох, ох земјо родена.",
       "lat": "oh, oh zemjo rodena.",
       "en": "oh, oh native land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дал' ќе дојде ден пак да дојдиме ние,",
       "lat": "Dal' ḱe dojde den pak da dojdime nie,",
       "en": "Will the day come when we return,"
      },
      {
       "cyr": "да се видиме со наш'те деца,",
       "lat": "da se vidime so naš'te deca,",
       "en": "to see our children,"
      },
      {
       "cyr": "да запееме, да заиграме",
       "lat": "da zapeeme, da zaigrame",
       "en": "to sing and to dance"
      },
      {
       "cyr": "и да умреме, да не жалиме.",
       "lat": "i da umreme, da ne žalime.",
       "en": "and to die without regret."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ох, ох Македонијо,",
       "lat": "Oh, oh Makedonijo,",
       "en": "Oh, oh Macedonia,"
