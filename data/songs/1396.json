       "lat": "i sinoḱa edno pukna.",
       "en": "Last night another one was consumed.",
       "en_mt": false
      },
      {
       "cyr": "Стојна му е учинила ле,",
       "lat": "Stojna mu e učinila le,",
       "en": "Stojna cast a spell on him,",
       "en_mt": false
      },
      {
       "cyr": "Стојна му е учинила,",
       "lat": "Stojna mu e učinila,",
       "en": "Stojna cast a spell on him,",
       "en_mt": false
      },
      {
       "cyr": "колку ѕвезди на небето ле,",
       "lat": "kolku dzvezdi na nebeto le,",
       "en": "as many stars there are in the skies...",
       "en_mt": false
      },
      {
       "cyr": "колку ѕвезди на небето...",
       "lat": "kolku dzvezdi na nebeto...",
       "en": "as many stars there are in the skies...",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
