   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мома крај извор седеше",
       "lat": "Moma kraj izvor sedeše",
       "en": "A girl sat by a spring"
      },
      {
       "cyr": "од рози венец плетеше",
       "lat": "od rozi venec pleteše",
       "en": "weaving a wreath of roses,"
      },
      {
       "cyr": "изворот брзо течеше",
       "lat": "izvorot brzo tečeše",
       "en": "the spring flowed fast,"
      },
      {
       "cyr": "венецот вечно венеше.",
       "lat": "venecot večno veneše.",
       "en": "the wreath kept withering forever."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ах, како течит тој извор",
       "lat": "Ah, kako tečit toj izvor",
       "en": "Ah, as that spring flows,"
      },
      {
       "cyr": "така ми течат моите дни",
       "lat": "taka mi tečat moite dni",
       "en": "so my days flow,"
      },
      {
       "cyr": "ах како венит венецот",
       "lat": "ah kako venit venecot",
       "en": "ah, as the wreath withers,"
      },
      {
       "cyr": "така ми венит младоста.",
       "lat": "taka mi venit mladosta.",
       "en": "so my youth withers."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А штом ќе пукнит пролетта",
       "lat": "A štom ḱe puknit proletta",
       "en": "And when spring bursts open"
      },
      {
       "cyr": "и се' се живо распеват",
       "lat": "i se' se živo raspevat",
       "en": "and everything alive sings out,"
      },
      {
       "cyr": "пак ќе ме прашаш мене ти",
       "lat": "pak ḱe me prašaš mene ti",
       "en": "you will ask me again"
      },
      {
       "cyr": "колку ме мачит љубовта.",
       "lat": "kolku me mačit ljubovta.",
       "en": "how much love torments me."
      }
     ]
    }
   ]
  }
 ],
