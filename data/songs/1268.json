   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мили гости, песна запејте,",
       "lat": "Mili gosti, pesna zapejte,",
       "en": "Dear guests, strike up a song,"
      },
      {
       "cyr": "што сум среќна не прашувајте,",
       "lat": "što sum sreḱna ne prašuvajte,",
       "en": "do not ask why I am happy,"
      },
      {
       "cyr": "синот стани китка мирисна,",
       "lat": "sinot stani kitka mirisna,",
       "en": "my son has become a fragrant bouquet,"
      },
      {
       "cyr": "од денес тој војник се вика.",
       "lat": "od denes toj vojnik se vika.",
       "en": "from today he is called a soldier."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Крени глава, сине мој,",
       "lat": "Kreni glava, sine moj,",
       "en": "Raise your head, my son,"
      },
      {
       "cyr": "гордост наша биди ти,",
       "lat": "gordost naša bidi ti,",
       "en": "be our pride,"
      },
      {
       "cyr": "војник чесен да ни бидеш,",
       "lat": "vojnik česen da ni bideš,",
       "en": "be an honest soldier for us,"
      },
      {
       "cyr": "земја наша да ни чуваш.",
       "lat": "zemja naša da ni čuvaš.",
       "en": "guard our land for us."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дур' да мајка војник испраќа,",
       "lat": "Dur' da majka vojnik ispraḱa,",
       "en": "While a mother sends off a soldier,"
      },
      {
       "cyr": "срце бие, солзи не крие,",
       "lat": "srce bie, solzi ne krie,",
       "en": "her heart beats, she hides no tears,"
      },
      {
       "cyr": "синот војник да го виде,",
       "lat": "sinot vojnik da go vide,",
       "en": "to see her son a soldier,"
      },
      {
       "cyr": "Македонијо, чесен ќе ти биде.",
       "lat": "Makedonijo, česen ḱe ti bide.",
       "en": "Macedonia, he will be honest to you."
      }
     ]
