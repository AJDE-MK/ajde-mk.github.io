   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Катерино моме, Катерино,",
       "lat": "- Katerino mome, Katerino,",
       "en": "- Katerina, girl, Katerina,"
      },
      {
       "cyr": "зошто си толку, моме, убава,",
       "lat": "zošto si tolku, mome, ubava,",
       "en": "why are you so beautiful, girl,"
      },
      {
       "cyr": "зошто си толку, моме, гиздава?",
       "lat": "zošto si tolku, mome, gizdava?",
       "en": "why are you so elegant, girl?"
      },
      {
       "cyr": "Каква си трева, моме, газила,",
       "lat": "Kakva si treva, mome, gazila,",
       "en": "What grass did you trample, girl,"
      },
      {
       "cyr": "каква си вода, моме, пиела,",
       "lat": "kakva si voda, mome, piela,",
       "en": "what water did you drink, girl,"
      },
      {
       "cyr": "каква те мајка, моме, родила,",
       "lat": "kakva te majka, mome, rodila,",
       "en": "what mother bore you, girl,"
      },
      {
       "cyr": "па штом си толку, моме, убава?",
       "lat": "pa štom si tolku, mome, ubava?",
       "en": "that you are so beautiful, girl?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Јас сум по мајка, либе, од Пирина,",
       "lat": "- Jas sum po majka, libe, od Pirina,",
       "en": "- On my mother's side, love, I am from Pirin,"
      },
      {
       "cyr": "јас сум по татко, либе, од Егеја,",
       "lat": "jas sum po tatko, libe, od Egeja,",
       "en": "on my father's side, love, from the Aegean,"
      },
      {
       "cyr": "раснела, мило либе, крај Вардара,",
       "lat": "rasnela, milo libe, kraj Vardara,",
       "en": "I grew up, dear love, beside the Vardar,"
      },
      {
       "cyr": "затоа сум си, либе, убава.",
       "lat": "zatoa sum si, libe, ubava.",
       "en": "that is why, love, I am beautiful."
      },
      {
       "cyr": "Затоа сум си, либе, убава,",
       "lat": "Zatoa sum si, libe, ubava,",
       "en": "That is why, love, I am beautiful."
