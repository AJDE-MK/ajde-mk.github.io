    {
     "lines": [
      {
       "cyr": "Ајде Лено д' ојме",
       "lat": "Ajde Leno d' ojme",
       "en": "Come Lena, let's go"
      },
      {
       "cyr": "долу на сред село,",
       "lat": "dolu na sred selo,",
       "en": "down, to the center of the village,"
      },
      {
       "cyr": "долу на сред село,",
       "lat": "dolu na sred selo,",
       "en": "down, to the center of the village,"
      },
      {
       "cyr": "собор се собрало.",
       "lat": "sobor se sobralo.",
       "en": "there is a gathering."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму се собрале",
       "lat": "Tamu se sobrale",
       "en": "There have gathered"
      },
      {
       "cyr": "и стари и млади,",
       "lat": "i stari i mladi,",
       "en": "old and young,"
      },
      {
       "cyr": "оро заиграле,",
       "lat": "oro zaigrale,",
       "en": "they dance oro,"
      },
      {
       "cyr": "песни запеале.",
       "lat": "pesni zapeale.",
       "en": "they sing songs."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Среде во орото,",
       "lat": "Srede vo oroto,",
       "en": "In the middle of the oro,"
      },
      {
       "cyr": "нашето овчарче,",
       "lat": "našeto ovčarče,",
       "en": "there is our shepherd,"
      },
      {
       "cyr": "како е надувало,",
       "lat": "kako e naduvalo,",
       "en": "he is blowing"
      },
      {
       "cyr": "таја пуста гајда.",
       "lat": "taja pusta gajda.",
       "en": "his damn gajda (bagpipe)."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите девојчиња",
       "lat": "Site devojčinja",
       "en": "All the girls"
      },
      {
       "cyr": "играат и пеат,",
       "lat": "igraat i peat,",
       "en": "are dancing and singing,"
      },
      {
       "cyr": "убавата Цена",
       "lat": "ubavata Cena",
       "en": "the pretty Cena"
      },
      {
       "cyr": "ни игра, ни пее.",
       "lat": "ni igra, ni pee.",
       "en": "neighter dances, nor sings."
      }
     ]
    }
   ]
