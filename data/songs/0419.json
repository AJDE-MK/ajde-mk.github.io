   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ако умрам ил' загинам,",
       "lat": "Ako umram il' zaginam,",
       "en": "If I die or perish"
      },
      {
       "cyr": "немој да ме жалите,",
       "lat": "nemoj da me žalite,",
       "en": "don't cry for me."
      },
      {
       "cyr": "напијте се рујно вино",
       "lat": "napijte se rujno vino",
       "en": "Drink some red wine"
      },
      {
       "cyr": "скршете ги чашите.",
       "lat": "skršete gi čašite.",
       "en": "and break the glasses."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј, верни другари,",
       "lat": "Ej, verni drugari,",
       "en": "Hey, my faithful friends,"
      },
      {
       "cyr": "песна запејте,",
       "lat": "pesna zapejte,",
       "en": "sing a song"
      },
      {
       "cyr": "мене спомнете.",
       "lat": "mene spomnete.",
       "en": "and remember me."
      }
     ]
    },
    {
     "lines": [
      {
