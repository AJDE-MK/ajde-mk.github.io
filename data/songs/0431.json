   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Марие млада невесто",
       "lat": "Marie mlada nevesto",
       "en": "Marie, young bride,"
      },
      {
       "cyr": "елај се Маре потурчи,",
       "lat": "elaj se Mare poturči,",
       "en": "come, Mara, convert to Islam,"
      },
      {
       "cyr": "ела анама да бидеш.",
       "lat": "ela anama da bideš.",
       "en": "come and be my lady."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На висок чардак да седиш",
       "lat": "Na visok čardak da sediš",
       "en": "You will sit on a high balcony,"
      },
      {
       "cyr": "жолти жолтици да нижиш",
       "lat": "žolti žoltici da nižiš",
       "en": "stringing yellow gold coins"
      },
      {
       "cyr": "на бело грло да носиш.",
       "lat": "na belo grlo da nosiš.",
       "en": "to wear on your white throat."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Подарок ќе ти подарам",
       "lat": "Podarok ḱe ti podaram",
       "en": "I will give you a gift:"
      },
      {
       "cyr": "Едрене Султан Сељим џамија,",
       "lat": "Edrene Sultan Seljim džamija,",
       "en": "the Sultan Selim Mosque in Edirne,"
      },
      {
       "cyr": "Цариград Света Софија.",
       "lat": "Carigrad Sveta Sofija.",
       "en": "the Hagia Sophia in Constantinople."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Пуста ти била Сељим џамија,",
       "lat": "Pusta ti bila Seljim džamija,",
       "en": "May your Selim Mosque be desolate,"
      },
      {
       "cyr": "пуста ти била Света Софија,",
       "lat": "pusta ti bila Sveta Sofija,",
       "en": "may your Hagia Sophia be desolate,"
      },
      {
       "cyr": "јас си ја сакам верата.",
       "lat": "jas si ja sakam verata.",
       "en": "I love my faith."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас си ја сакам верата,",
