   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Излегу да се рашетам",
       "lat": "Izlegu da se rašetam",
       "en": "I went out to take a walk"
      },
      {
       "cyr": "во това поле широко,",
       "lat": "vo tova pole široko,",
       "en": "in this wide field,"
      },
      {
       "cyr": "поминав село Дреново",
       "lat": "pominav selo Drenovo",
       "en": "I passed the village of Drenovo"
      },
      {
       "cyr": "си виду момче дреновче.",
       "lat": "si vidu momče drenovče.",
       "en": "and saw a boy from Drenovo."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Си виду момче дреновче",
       "lat": "Si vidu momče drenovče",
       "en": "I saw the boy from Drenovo"
      },
      {
       "cyr": "на сиво коњче јаваше,",
       "lat": "na sivo konjče javaše,",
       "en": "riding a gray horse,"
      },
      {
       "cyr": "на сино седло седеше,",
       "lat": "na sino sedlo sedeše,",
       "en": "sitting on a blue saddle,"
      },
      {
       "cyr": "сребрен ми ѓемој држеше.",
       "lat": "srebren mi ǵemoj držeše.",
       "en": "holding a silver bridle (my reading)."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Давај ме мајко за него",
       "lat": "Davaj me majko za nego",
       "en": "Give me, mother, to him"
      },
      {
       "cyr": "оти ќе бегам по него,",
       "lat": "oti ḱe begam po nego,",
       "en": "because I will run away after him,"
      },
      {
       "cyr": "лепото приќе на глава,",
       "lat": "lepoto priḱe na glava,",
       "en": "the beautiful veil onto my head,"
      },
      {
       "cyr": "д'лги чорапи на раци.",
       "lat": "d'lgi čorapi na raci.",
       "en": "long socks on my hands (my reading)."
      }
     ]
    }
   ]
  }
