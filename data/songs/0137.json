   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Збогум мајко, јас отидов",
       "lat": "Zbogum majko, jas otidov",
       "en": "Farewell, mother, I have left,"
      },
      {
       "cyr": "дојде денот да заминам.",
       "lat": "dojde denot da zaminam.",
       "en": "the day has come for me to depart."
      },
      {
       "cyr": "Разделба ми срце мачи",
       "lat": "Razdelba mi srce mači",
       "en": "Parting torments my heart"
      },
      {
       "cyr": "и пак ме тера да пејам.",
       "lat": "i pak me tera da pejam.",
       "en": "and yet makes me sing."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Збогом татково огниште,",
       "lat": "Zbogom tatkovo ognište,",
       "en": "Farewell, father's hearth,"
      },
      {
       "cyr": "збогом браќа и сестри.",
       "lat": "zbogom braḱa i sestri.",
       "en": "farewell, brothers and sisters."
      },
      {
       "cyr": "Збогум другари, ем другарки,",
       "lat": "Zbogum drugari, em drugarki,",
       "en": "Farewell, friends, male and female,"
      },
      {
       "cyr": "стари и млади дечиња.",
       "lat": "stari i mladi dečinja.",
       "en": "old and young children."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "За последно збогум ви кажам,",
       "lat": "Za posledno zbogum vi kažam,",
       "en": "For the last time I say farewell to you,"
      },
      {
       "cyr": "последен пат ви гледам јас.",
       "lat": "posleden pat vi gledam jas.",
       "en": "for the last time I look at you."
      },
      {
       "cyr": "Било каде и да идам,",
       "lat": "Bilo kade i da idam,",
       "en": "Wherever I may go,"
      },
      {
       "cyr": "вечно ќе ве споменвам.",
       "lat": "večno ḱe ve spomenvam.",
       "en": "I will remember you forever."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А за тебе, мила мајко,",
       "lat": "A za tebe, mila majko,",
       "en": "And for you, dear mother,"
      },
      {
       "cyr": "јас ќе жалам, ем тажам.",
       "lat": "jas ḱe žalam, em tažam.",
       "en": "I will grieve and mourn."
      },
      {
       "cyr": "В' туѓа земја, непозната,",
       "lat": "V' tuǵa zemja, nepoznata,",
       "en": "In a foreign, unknown land,"
      },
      {
       "cyr": "живот ле мајко ќе поминам.",
       "lat": "život le majko ḱe pominam.",
       "en": "my life, oh mother, I will spend."
      }
     ]
    }
   ]
  }
