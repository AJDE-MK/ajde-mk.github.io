   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Велешките ергени",
       "lat": "Veleškite ergeni",
       "en": "The bachelors of Veles"
      },
      {
       "cyr": "каде одат сал пејат,",
       "lat": "kade odat sal pejat,",
       "en": "wherever they go, they only sing,"
      },
      {
       "cyr": "по момите гледаат,",
       "lat": "po momite gledaat,",
       "en": "they look at the girls,"
      },
      {
       "cyr": "штом ги видат, ќе им свирнат",
       "lat": "štom gi vidat, ḱe im svirnat",
       "en": "as soon as they see them, they whistle at them"
      },
      {
       "cyr": "и со око ќе намигнат,",
       "lat": "i so oko ḱe namignat,",
       "en": "and wink with an eye,"
      },
      {
       "cyr": "леле, леле што се убави.",
       "lat": "lele, lele što se ubavi.",
       "en": "oh, oh, how beautiful they are."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А момите играат,",
       "lat": "A momite igraat,",
       "en": "And the girls dance,"
      },
      {
       "cyr": "гајтан веѓи дигаат,",
       "lat": "gajtan veǵi digaat,",
       "en": "they raise their braided eyebrows,"
      },
      {
       "cyr": "шега се подбиваат,",
       "lat": "šega se podbivaat,",
       "en": "they tease each other as a joke,"
      },
      {
       "cyr": "ситно, ситно оро вијат,",
       "lat": "sitno, sitno oro vijat,",
       "en": "they spin a small, small round dance,"
      },
      {
       "cyr": "од ергени очи кријат,",
       "lat": "od ergeni oči krijat,",
       "en": "they hide their eyes from the bachelors,"
      },
      {
       "cyr": "леле, леле што се убави.",
       "lat": "lele, lele što se ubavi.",
       "en": "oh, oh, how beautiful they are."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стари дедо ми седнал,",
       "lat": "Stari dedo mi sednal,",
       "en": "Old grandfather has sat down,"
      },
      {
       "cyr": "од далеку ми гледа",
       "lat": "od daleku mi gleda",
       "en": "he watches me from afar"
      },
      {
       "cyr": "и на баба ѝ вели:",
       "lat": "i na baba ì veli:",
       "en": "and says to grandmother:"
      },
      {
       "cyr": "- Елај бабо да те бацам,",
       "lat": "- Elaj babo da te bacam,",
       "en": "- Come, grandma, let me kiss you,"
      },
      {
       "cyr": "ич со рака не те фаќам,",
       "lat": "ič so raka ne te faḱam,",
       "en": "I do not touch you with a hand at all,"
      },
      {
       "cyr": "леле, леле што си убава!",
       "lat": "lele, lele što si ubava!",
       "en": "oh, oh, how beautiful you are!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стара баба сал се мршти",
       "lat": "Stara baba sal se mršti",
       "en": "Old grandmother only frowns"
      },
      {
       "cyr": "и на дедо му вели:",
       "lat": "i na dedo mu veli:",
       "en": "and says to grandfather:"
      },
      {
       "cyr": "- А бре старо будало,",
       "lat": "- A bre staro budalo,",
       "en": "- You old fool,"
      },
      {
       "cyr": "пусти ѓавол ти навлегол,",
       "lat": "pusti ǵavol ti navlegol,",
       "en": "a cursed devil has got into you,"
      },
      {
       "cyr": "сиот памет ти излегол,",
       "lat": "siot pamet ti izlegol,",
       "en": "all your sense has gone out,"
      },
      {
       "cyr": "леле, леле што си будала.",
       "lat": "lele, lele što si budala.",
       "en": "oh, oh, what a fool you are."
      }
     ]
    }
   ]
  }
