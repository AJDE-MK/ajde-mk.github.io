       "cyr": "до роден крај мој да стигнам,",
       "lat": "do roden kraj moj da stignam,",
       "en": "to reach my native land,"
      },
      {
       "cyr": "Охрид и Струга да видам.",
       "lat": "Ohrid i Struga da vidam.",
       "en": "to see Ohrid and Struga."
