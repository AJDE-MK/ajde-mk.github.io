 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Филка мома моле бога",
       "lat": "Filka moma mole boga",
       "en": "Maiden Filka prays to God",
       "en_mt": false
      },
      {
       "cyr": "да ја сторе леле, едно пиле",
       "lat": "da ja store lele, edno pile",
       "en": "to make her into a bird,",
       "en_mt": false
      },
      {
       "cyr": "да прелета леле, ширно море",
       "lat": "da preleta lele, širno more",
       "en": "to fly over the wide sea",
       "en_mt": false
      },
      {
       "cyr": "да си иде леле, ју Солуна.",
       "lat": "da si ide lele, ju Soluna.",
       "en": "to go into Solun.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да си иде, ју Солуна",
       "lat": "Da si ide, ju Soluna",
       "en": "To go into Solun",
       "en_mt": false
      },
      {
       "cyr": "ју в' чаршија леле, на сергија",
       "lat": "ju v' čaršija lele, na sergija",
       "en": "in the bazaar, to the booths,",
       "en_mt": false
      },
      {
       "cyr": "да си купе леле, астурена",
       "lat": "da si kupe lele, asturena",
       "en": "to buy some textile",
       "en_mt": false
      },
      {
       "cyr": "да ѝ шие леле антерија.",
       "lat": "da ì šie lele anterija.",
       "en": "to tailor a gown.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да ѝ шие, антерија",
       "lat": "Da ì šie, anterija",
       "en": "To tailor a gown",
       "en_mt": false
      },
      {
       "cyr": "д'лга, д'лга леле, ем широка",
       "lat": "d'lga, d'lga lele, em široka",
       "en": "long, long and wide,",
       "en_mt": false
      },
      {
       "cyr": "да се веје леле, до земјата",
       "lat": "da se veje lele, do zemjata",
       "en": "waving all the way down to the ground,",
       "en_mt": false
      },
      {
       "cyr": "да ја гале леле, калдрмата.",
       "lat": "da ja gale lele, kaldrmata.",
       "en": "caressing the cobble.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Филка ќ' онде, на орото",
       "lat": "Filka ḱ' onde, na oroto",
       "en": "Filka will then dance the oro,",
       "en_mt": false
      },
      {
       "cyr": "на орото леле, кукушкото",
       "lat": "na oroto lele, kukuškoto",
       "en": "the oro of Kukush,",
       "en_mt": false
      },
      {
       "cyr": "дек' шо играт леле, с'л ергени",
       "lat": "dek' šo igrat lele, s'l ergeni",
       "en": "where only unmarried men dance,",
       "en_mt": false
      },
      {
       "cyr": "с'л ергени леле, кукушари.",
       "lat": "s'l ergeni lele, kukušari.",
       "en": "only unmarried men, from Kukush.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да ја видат, ергените",
       "lat": "Da ja vidat, ergenite",
       "en": "So that the unmarried men see her,",
       "en_mt": false
      },
      {
       "cyr": "ергените леле, кукушките",
       "lat": "ergenite lele, kukuškite",
       "en": "the unmarried men from Kukush,",
       "en_mt": false
      },
      {
       "cyr": "да запукат леле, комшиите",
       "lat": "da zapukat lele, komšiite",
       "en": "so that the neighbors will envy her,",
       "en_mt": false
      },
      {
       "cyr": "комшиите леле, душманите.",
       "lat": "komšiite lele, dušmanite.",
       "en": "her neighbors, her enemies.",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
 "pending_english": false
}