   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Дали некој видел,",
       "lat": "Dali nekoj videl,",
       "en": "Has anyone seen,"
      },
      {
       "cyr": "дали некој слушнал",
       "lat": "dali nekoj slušnal",
       "en": "has anyone heard"
      },
      {
       "cyr": "на сред Европа",
       "lat": "na sred Evropa",
       "en": "in the middle of Europe"
      },
      {
       "cyr": "ваква неправда?",
       "lat": "vakva nepravda?",
       "en": "such an injustice?"
      },
      {
       "cyr": "Дома да ти дојдат,",
       "lat": "Doma da ti dojdat,",
       "en": "They come to your home,"
      },
      {
       "cyr": "судба да ти кројат,",
       "lat": "sudba da ti krojat,",
       "en": "they cut out your fate,"
      },
      {
       "cyr": "корен да ти откорнат.",
       "lat": "koren da ti otkornat.",
       "en": "they uproot your roots."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Боже правда нема",
       "lat": "Bože pravda nema",
       "en": "God, there is no justice,"
      },
      {
       "cyr": "земја да ти земат,",
       "lat": "zemja da ti zemat,",
       "en": "they take your land,"
      },
      {
       "cyr": "наша Македонија.",
       "lat": "naša Makedonija.",
       "en": "our Macedonia."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Егејски песни ни замреа,",
       "lat": "Egejski pesni ni zamrea,",
       "en": "The Aegean songs died out for us,"
      },
      {
       "cyr": "душмани јазикот ни бранеа,",
       "lat": "dušmani jazikot ni branea,",
       "en": "enemies defended our language,"
      },
      {
       "cyr": "егејска мајка не се уплаши,",
       "lat": "egejska majka ne se uplaši,",
       "en": "the Aegean mother was not afraid,"
      },
      {
       "cyr": "македонски децата си ги научи.",
       "lat": "makedonski decata si gi nauči.",
       "en": "she taught the children Macedonian."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Секој Егеец во домот има",
       "lat": "Sekoj Egeec vo domot ima",
       "en": "Every Aegean person has at home"
      },
      {
       "cyr": "по една грутка од стари крај.",
       "lat": "po edna grutka od stari kraj.",
       "en": "a clod of earth from the old country."
      },
      {
       "cyr": "Кај и да оди, кај да се сели,",
       "lat": "Kaj i da odi, kaj da se seli,",
       "en": "Wherever he goes, wherever he moves,"
      },
      {
       "cyr": "со него е грутката.",
