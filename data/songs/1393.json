 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Борјано, Борјанке,",
       "lat": "Borjano, Borjanke,",
       "en": "Borjana, Borjanka,"
      },
      {
       "cyr": "сал ти ли си мома,",
       "lat": "sal ti li si moma,",
       "en": "are you the only girl,"
      },
      {
       "cyr": "сал ти ли си мома мори,",
       "lat": "sal ti li si moma mori,",
       "en": "are you the only girl, hey,"
      },
      {
       "cyr": "сал ти ли знаеш да пееш?",
       "lat": "sal ti li znaeš da peeš?",
       "en": "are you the only one who knows how to sing?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Гласот ти се слуша",
       "lat": "Glasot ti se sluša",
       "en": "Your voice is heard"
      },
      {
       "cyr": "дур' до нашта нива,",
       "lat": "dur' do našta niva,",
       "en": "all the way to our field,"
      },
      {
       "cyr": "дур' до наша нива мори,",
       "lat": "dur' do naša niva mori,",
       "en": "all the way to our field, hey,"
      },
      {
       "cyr": "меѓу двата рида.",
       "lat": "meǵu dvata rida.",
       "en": "between the two hills."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Српот си оставам",
       "lat": "Srpot si ostavam",
       "en": "I leave my sickle"
      },
      {
       "cyr": "тебе да те слушам",
       "lat": "tebe da te slušam",
       "en": "to listen to you,"
      },
      {
       "cyr": "какви песни пееш,",
       "lat": "kakvi pesni peeš,",
       "en": "what songs you sing,"
      },
      {
       "cyr": "какви редби редиш.",
       "lat": "kakvi redbi rediš.",
       "en": "what verses you arrange."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На арните момци,",
       "lat": "Na arnite momci,",
       "en": "To the good lads,"
      },
      {
       "cyr": "полошите моми,",
       "lat": "pološite momi,",
       "en": "the worse girls,"
      },
      {
       "cyr": "на лошите моми,",
       "lat": "na lošite momi,",
       "en": "to the bad girls,"
      },
      {
       "cyr": "арните момчиња.",
       "lat": "arnite momčinja.",
       "en": "the good boys."
      },
      {
       "cyr": "На мен' се годило",
       "lat": "Na men' se godilo",
       "en": "To me it fell"
      },
      {
       "cyr": "едно старо аро.",
       "lat": "edno staro aro.",
       "en": "an old one, a good-for-nothing."
      }
     ]
    }
   ]
  }
 ],
