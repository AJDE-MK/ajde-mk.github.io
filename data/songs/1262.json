   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Сегде одев, сегде шетав,",
       "lat": "Segde odev, segde šetav,",
       "en": "Everywhere I went, everywhere I wandered,"
      },
      {
       "cyr": "по овој бел и шарен свет.",
       "lat": "po ovoj bel i šaren svet.",
       "en": "across this white and colourful world."
      },
      {
       "cyr": "Ама како тебе, бела Јано,",
       "lat": "Ama kako tebe, bela Jano,",
       "en": "But one like you, white Jana,"
      },
      {
       "cyr": "ама како тебе, моја рано,",
       "lat": "ama kako tebe, moja rano,",
       "en": "but one like you, my wound,"
      },
      {
       "cyr": "уште нигде не најдов.",
       "lat": "ušte nigde ne najdov.",
       "en": "I have not found anywhere yet."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јано мори, Јанинке,",
       "lat": "Jano mori, Janinke,",
       "en": "Jana, hey, Janinka,"
      },
      {
       "cyr": "моја мала фиданке,",
       "lat": "moja mala fidanke,",
       "en": "my little sapling,"
      },
      {
       "cyr": "знаеш каде ли згрешивме?",
       "lat": "znaeš kade li zgrešivme?",
       "en": "do you know where we went wrong?"
      },
      {
       "cyr": "Двајца млади, еј,",
       "lat": "Dvajca mladi, ej,",
       "en": "We two young ones, hey,"
      },
      {
       "cyr": "не се зедовме!",
       "lat": "ne se zedovme!",
       "en": "we did not marry!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дали знаеш, дали памтиш",
       "lat": "Dali znaeš, dali pamtiš",
       "en": "Do you know, do you remember"
      },
      {
       "cyr": "кога бевме крај Радика?",
       "lat": "koga bevme kraj Radika?",
       "en": "when we were by the Radika?"
      },
      {
       "cyr": "Тогаш ти ми рече, бела Јано,",
       "lat": "Togaš ti mi reče, bela Jano,",
       "en": "Then you told me, white Jana,"
      },
      {
       "cyr": "тогаш ти ми вети, моја Јано,",
       "lat": "togaš ti mi veti, moja Jano,",
       "en": "then you promised me, my Jana,"
      },
      {
       "cyr": "дека вечно ќе се љубиме.",
       "lat": "deka večno ḱe se ljubime.",
       "en": "that we would love each other forever."
      }
     ]
