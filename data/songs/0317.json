   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Се решив да се женам,",
       "lat": "Se rešiv da se ženam,",
       "en": "I decided to get married,"
      },
      {
       "cyr": "дури сум уште млад",
       "lat": "duri sum ušte mlad",
       "en": "while I am still young"
      },
      {
       "cyr": "и тргнав мома да барам,",
       "lat": "i trgnav moma da baram,",
       "en": "and I set out to look for a girl,"
      },
      {
       "cyr": "од род голем богат.",
       "lat": "od rod golem bogat.",
       "en": "from a great rich family."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да биде убавица",
       "lat": "Da bide ubavica",
       "en": "Let her be a beauty,"
      },
      {
       "cyr": "да знае да чита,",
       "lat": "da znae da čita,",
       "en": "let her know how to read,"
      },
      {
       "cyr": "пијаното да пишти",
       "lat": "pijanoto da pišti",
       "en": "let the piano squeal"
      },
      {
       "cyr": "под нејзини раце.",
       "lat": "pod nejzini race.",
       "en": "under her hands."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не помина многу време",
       "lat": "Ne pomina mnogu vreme",
       "en": "Not much time passed"
      },
      {
       "cyr": "и јас се оженив,",
       "lat": "i jas se oženiv,",
       "en": "and I got married,"
      },
      {
       "cyr": "си најдов таква мома",
       "lat": "si najdov takva moma",
       "en": "I found such a girl"
      },
      {
       "cyr": "што барав по светот.",
       "lat": "što barav po svetot.",
       "en": "as I had sought across the world."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од првин беше ангел,",
       "lat": "Od prvin beše angel,",
       "en": "At first she was an angel,"
      },
      {
       "cyr": "ангел на овој свет,",
       "lat": "angel na ovoj svet,",
       "en": "an angel of this world,"
      },
      {
       "cyr": "од ангел се претвори",
       "lat": "od angel se pretvori",
       "en": "from an angel she turned"
      },
      {
       "cyr": "вистинска сатана.",
       "lat": "vistinska satana.",
       "en": "into a real Satan."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми почна шапка да носит,",
       "lat": "Mi počna šapka da nosit,",
       "en": "She started to wear a hat,"
      },
      {
       "cyr": "да одит шантиклер,",
       "lat": "da odit šantikler,",
       "en": "to go to the chantant,"
      },
      {
       "cyr": "кафани да ангажират",
       "lat": "kafani da angažirat",
       "en": "to hire cafes (my reading)"
      },
      {
       "cyr": "по две до три на ден.",
       "lat": "po dve do tri na den.",
       "en": "two to three a day."
      }
     ]
    }
   ]
  }
