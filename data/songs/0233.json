      {
       "cyr": "Кирајџиче, јабанџиче,",
       "lat": "Kirajdžiče, jabandžiče,",
       "en": "Hired-carriage boy, stranger,"
      },
      {
       "cyr": "каде одиш, џанам, каде шеташ?",
       "lat": "kade odiš, džanam, kade šetaš?",
       "en": "where are you going, dear, where are you wandering?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дал' го виде, џанам, мојто либе,",
       "lat": "Dal' go vide, džanam, mojto libe,",
       "en": "Did you see, dear, my love,"
      },
      {
       "cyr": "мојто либе, џанам, тој Ѓорѓија?",
       "lat": "mojto libe, džanam, toj Ǵorǵija?",
       "en": "my love, dear, that Gjorgjija?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас го видов, џанам, во меана,",
       "lat": "Jas go vidov, džanam, vo meana,",
       "en": "I saw him, dear, in the tavern,"
      },
      {
