      {
       "cyr": "сербез Донка на Јаричкови.",
       "lat": "serbez Donka na Jaričkovi.",
       "en": "Brave Donka of the Jarichkov family."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се собрале комшиите",
       "lat": "Se sobrale komšiite",
       "en": "The neighbors gathered"
      },
      {
       "cyr": "тра, ла, ла, ла, ла, ла, ла, ла, ла",
       "lat": "tra, la, la, la, la, la, la, la, la",
       "en": "tra, la, la, la, la, la, la, la, la"
      },
      {
       "cyr": "комшиите, другарките.",
       "lat": "komšiite, drugarkite.",
       "en": "the neighbors, her friends."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Аирлија, сербез Донке",
       "lat": "- Airlija, serbez Donke",
       "en": "Congratulations, brave Donka"
      },
      {
       "cyr": "тра, ла, ла, ла, ла, ла, ла, ла, ла",
       "lat": "tra, la, la, la, la, la, la, la, la",
       "en": "tra, la, la, la, la, la, la, la, la"
      },
      {
       "cyr": "аирлија свршувачката.",
       "lat": "airlija svršuvačkata.",
       "en": "congratulations on the engagement."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не викајте аирлија",
       "lat": "- Ne vikajte airlija",
       "en": "Don’t say congratulations"
      },
      {
       "cyr": "тра, ла, ла, ла, ла, ла, ла, ла, ла",
       "lat": "tra, la, la, la, la, la, la, la, la",
       "en": "tra, la, la, la, la, la, la, la, la"
      },
      {
       "cyr": "тук' речете на мајка ми.",
       "lat": "tuk' rečete na majka mi.",
       "en": "but tell my mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Што ме даде на далеку",
       "lat": "Što me dade na daleku",
       "en": "She gave me away far"
      },
