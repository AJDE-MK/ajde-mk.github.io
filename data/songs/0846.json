       "en": "The young landlord's wife"
      },
      {
       "cyr": "млада меанџика:",
       "lat": "mlada meandžika:",
       "en": "says:"
      },
      {
       "cyr": "- Море ја продај си",
       "lat": "- More ja prodaj si",
       "en": "- You better sell"
      },
      {
       "cyr": "твоја брза коња,",
       "lat": "tvoja brza konja,",
       "en": "your fast horse"
      },
      {
       "cyr": "вино да си платиш!",
       "lat": "vino da si platiš!",
       "en": "to pay for the wine!"
      }
     ]
    },
