      {
       "cyr": "Ружиче бело и црвено,",
       "lat": "Ružiče belo i crveno,",
       "en": "White and red rose,"
      },
      {
       "cyr": "не оди ситно пред мене,",
       "lat": "ne odi sitno pred mene,",
       "en": "do not walk daintily before me,"
      },
      {
       "cyr": "не дигај магли раови.",
       "lat": "ne digaj magli raovi.",
       "en": "do not raise the fog of sorrows."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не скоривај моме јадови,",
       "lat": "Ne skorivaj mome jadovi,",
       "en": "Do not hide, girl, your troubles,"
      },
      {
       "cyr": "надеа сум само, јадовно.",
       "lat": "nadea sum samo, jadovno.",
       "en": "I only hoped, in sorrow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Деј гиди Страте, море будала,",
       "lat": "Dej gidi Strate, more budala,",
       "en": "Hey, you Strate, you fool,"
      },
      {
       "cyr": "што жалиш толку за мене,",
       "lat": "što žališ tolku za mene,",
       "en": "why do you grieve so much for me,"
      },
      {
       "cyr": "имаш невеста убава?",
