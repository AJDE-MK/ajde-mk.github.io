 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Болен лежи млад Стојан",
       "lat": "Bolen leži mlad Stojan",
       "en": "Young Stoyan lay sick,"
      },
      {
       "cyr": "болен лежи и ќе умре",
       "lat": "bolen leži i ḱe umre",
       "en": "sick and dying"
      },
      {
       "cyr": "над глава му младата невеста",
       "lat": "nad glava mu mladata nevesta",
       "en": "at his head, the young bride"
      },
      {
       "cyr": "с' машко дете на раце",
       "lat": "s' maško dete na race",
       "en": "with a boy in her hands"
      },
      {
       "cyr": "солзи рони, солзите капат",
       "lat": "solzi roni, solzite kapat",
       "en": "tears flowing, tears falling"
      },
      {
       "cyr": "по Стојаново лице.",
       "lat": "po Stojanovo lice.",
       "en": "on Stoyan's face."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стојан се подразбуди",
       "lat": "Stojan se podrazbudi",
       "en": "Stoyan became aware"
      },
      {
       "cyr": "и тихо ѝ прозбори:",
       "lat": "i tiho ì prozbori:",
       "en": "and quietly said to her:"
      },
      {
       "cyr": "- Ој, Невено ти млада невесто",
       "lat": "- Oj, Neveno ti mlada nevesto",
       "en": "Oh, Nevena, you young bride"
      },
      {
       "cyr": "што ми лади лицево",
       "lat": "što mi ladi licevo",
       "en": "what cools my face?"
      },
      {
       "cyr": "дали силна роса подроснува",
       "lat": "dali silna rosa podrosnuva",
       "en": "Is there a fine dew"
      },
      {
       "cyr": "или силни дождови?",
       "lat": "ili silni doždovi?",
       "en": "or strong rains?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А Невена му вели:",
       "lat": "A Nevena mu veli:",
       "en": "And Nevena says to him"
      },
      {
       "cyr": "- Стојане бре, мили стопане",
       "lat": "- Stojane bre, mili stopane",
       "en": "Stoyan, dear master"
      },
      {
       "cyr": "ниту ситна роса подроснува",
       "lat": "nitu sitna rosa podrosnuva",
       "en": "It's not fine dew"
      },
      {
       "cyr": "нити силни дождови.",
       "lat": "niti silni doždovi.",
       "en": "It's not strong rains."
      },
      {
       "cyr": "Моите солзи по лице ти капат",
       "lat": "Moite solzi po lice ti kapat",
       "en": "My tears are falling on your face"
      },
      {
       "cyr": "од селански неправдини.",
       "lat": "od selanski nepravdini.",
       "en": "from the injustice of the villagers."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Синоќа кај чешмичето",
       "lat": "Sinoḱa kaj češmičeto",
       "en": "Last night at the fountain"
      },
      {
       "cyr": "селани се збираа",
       "lat": "selani se zbiraa",
       "en": "the villagers gathered"
      },
      {
       "cyr": "збор зборвеја кога ти ќе умреш",
       "lat": "zbor zborveja koga ti ḱe umreš",
       "en": "they decided when you shall die"
      },
      {
       "cyr": "дете да ми задават",
       "lat": "dete da mi zadavat",
       "en": "my child will strangle"
      },
      {
       "cyr": "мене ќе ме земат, далеку однесат",
       "lat": "mene ḱe me zemat, daleku odnesat",
       "en": "me they will take, carry me far away"
      },
      {
       "cyr": "за пари ме продадат.",
       "lat": "za pari me prodadat.",
       "en": "sell me for money."
      }
     ]
    }
   ]
  }
 ],
