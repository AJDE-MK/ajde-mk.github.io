    {
     "lines": [
      {
       "cyr": "Ценив се у попа,",
       "lat": "Ceniv se u popa,",
       "en": "I was hired by the priest,"
      },
      {
       "cyr": "да му чувам гуските.",
       "lat": "da mu čuvam guskite.",
       "en": "to look after his geese."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Шарена гајда изшарана,",
       "lat": "Šarena gajda izšarana,",
       "en": "Colorful patterned gajda*,"
      },
      {
       "cyr": "с'с мониста нанижана.",
       "lat": "s's monista nanižana.",
       "en": "strung with beads."
      },
      {
       "cyr": "Зумбај, зум-ба-ба.",
       "lat": "Zumbaj, zum-ba-ba.",
       "en": "Zumbai, zum-ba-ba."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Откара ги долови,",
       "lat": "Otkara gi dolovi,",
       "en": "I've taken them away,"
      },
      {
       "cyr": "куде вода не тече.",
       "lat": "kude voda ne teče.",
       "en": "where the water doesn't flow."
      },
      {
