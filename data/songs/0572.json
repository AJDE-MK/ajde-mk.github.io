   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Излегол Јане Сандански, леле",
       "lat": "Izlegol Jane Sandanski, lele",
       "en": "Jane Sandanski set out, oh,"
      },
      {
       "cyr": "да ми се Јане прошета.",
       "lat": "da mi se Jane prošeta.",
       "en": "to go for a stroll, Jane."
      },
      {
       "cyr": "Низ таа Пирин Планина, леле",
       "lat": "Niz taa Pirin Planina, lele",
       "en": "Through that Pirin Mountain, oh,"
      },
      {
       "cyr": "низ тоа поле широко.",
       "lat": "niz toa pole široko.",
       "en": "through that wide field."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нарамил пушка на рамо, леле",
       "lat": "Naramil puška na ramo, lele",
       "en": "He slung his rifle on his shoulder, oh,"
      },
      {
       "cyr": "настранил капа на чело.",
       "lat": "nastranil kapa na čelo.",
       "en": "he tilted his cap on his brow."
      },
      {
       "cyr": "На пат си сретнал овчарче, леле",
       "lat": "Na pat si sretnal ovčarče, lele",
       "en": "On the road he met a shepherd boy, oh,"
      },
      {
       "cyr": "на овчарче вели, говори:",
       "lat": "na ovčarče veli, govori:",
       "en": "and said to the shepherd boy:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Овчарче младо чобанче, леле",
       "lat": "- Ovčarče mlado čobanče, lele",
       "en": "- Young shepherd, little herdsman, oh,"
      },
      {
       "cyr": "дали ја виде четата?",
       "lat": "dali ja vide četata?",
       "en": "did you see the band?"
      },
      {
       "cyr": "Нели ја виде четата, леле",
       "lat": "Neli ja vide četata, lele",
       "en": "Did you not see the band, oh,"
      },
      {
       "cyr": "четата на Јане Сандански.",
       "lat": "četata na Jane Sandanski.",
       "en": "the band of Jane Sandanski?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Видело сум ја слушнало, леле",
       "lat": "- Videlo sum ja slušnalo, lele",
       "en": "- I have seen it and I have heard, oh,"
      },
      {
       "cyr": "сега за Јане збореа:",
       "lat": "sega za Jane zborea:",
       "en": "they were just talking about Jane:"
      },
      {
       "cyr": "- Каде е Јане Сандански, леле",
       "lat": "- Kade e Jane Sandanski, lele",
       "en": "- Where is Jane Sandanski, oh,"
      },
      {
       "cyr": "четата да си прибере.",
       "lat": "četata da si pribere.",
       "en": "to gather his band?"
      }
     ]
    }
