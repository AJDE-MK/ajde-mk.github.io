       "cyr": "Вирум вода, вирум вировита,",
       "lat": "Virum voda, virum virovita,",
       "en": "The water whirls, a whirling pool,"
      },
      {
       "cyr": "вир се берит, не ми истекуват.",
       "lat": "vir se berit, ne mi istekuvat.",
       "en": "the whirlpool gathers, it does not flow away from me."
      },
      {
       "cyr": "Не ми била вода вировита,",
       "lat": "Ne mi bila voda virovita,",
       "en": "It was not whirling water for me,"
      },
      {
       "cyr": "туку ми биле јунакови дворје.",
       "lat": "tuku mi bile junakovi dvorje.",
       "en": "but the courtyard of the young hero."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми се берат китени сватови,",
       "lat": "Mi se berat kiteni svatovi,",
       "en": "The decked-out wedding guests gather,"
      },
      {
       "cyr": "ќе ми одат по лепа невеста,",
       "lat": "ḱe mi odat po lepa nevesta,",
       "en": "they will go to fetch a fair bride,"
      },
      {
       "cyr": "од далеку, мошне на далеку,",
       "lat": "od daleku, mošne na daleku,",
       "en": "from far away, very far away,"
      },
      {
       "cyr": "од богато, мошне на богато.",
       "lat": "od bogato, mošne na bogato.",
       "en": "from a rich house, very rich."
