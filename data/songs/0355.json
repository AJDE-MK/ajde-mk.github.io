   "stanzas": [
    {
     "lines": [
      {
       "cyr": "На сред село едно дрво,",
       "lat": "Na sred selo edno drvo,",
       "en": "In the middle of the village a tree,"
      },
      {
       "cyr": "едно дрво тополово,",
       "lat": "edno drvo topolovo,",
       "en": "a poplar tree,"
      },
      {
       "cyr": "на него од сите страни",
       "lat": "na nego od site strani",
       "en": "on it from all sides"
      },
      {
       "cyr": "имињата напишани.",
       "lat": "iminjata napišani.",
       "en": "names are written."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Меѓу нив е и моето,",
       "lat": "Meǵu niv e i moeto,",
       "en": "Among them is mine too,"
      },
      {
       "cyr": "до името на момето",
       "lat": "do imeto na mometo",
       "en": "next to the name of the girl"
      },
      {
       "cyr": "што го љубам и милувам",
       "lat": "što go ljubam i miluvam",
       "en": "whom I love and caress"
      },
      {
       "cyr": "и во сонот го целувам.",
       "lat": "i vo sonot go celuvam.",
       "en": "and kiss in my dreams."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од година, на година,",
       "lat": "Od godina, na godina,",
       "en": "From year to year"
      },
      {
       "cyr": "расте дрво тополово,",
       "lat": "raste drvo topolovo,",
       "en": "the poplar tree grows,"
      },
      {
       "cyr": "а со него имињата",
       "lat": "a so nego iminjata",
       "en": "and with it the names"
      },
      {
       "cyr": "израснаа, се здружија,",
       "lat": "izrasnaa, se združija,",
       "en": "grew and joined together,"
      },
      {
       "cyr": "а со него и љубовта",
       "lat": "a so nego i ljubovta",
       "en": "and with it our love"
      },
      {
       "cyr": "нас нè сврза засекогаш.",
       "lat": "nas nè svrza zasekogaš.",
       "en": "bound us together forever."
      }
     ]
    }
   ]
  }
