   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Павле ми пие, Павле ми пие",
       "lat": "Pavle mi pie, Pavle mi pie",
       "en": "Pavle is drinking, Pavle is drinking,"
      },
      {
       "cyr": "вино ем ракија, вино ем ракија.",
       "lat": "vino em rakija, vino em rakija.",
       "en": "wine and brandy, wine and brandy."
      },
      {
       "cyr": "Море тој ми испил",
       "lat": "More toj mi ispil",
       "en": "He already drank"
      },
      {
       "cyr": "три илјади гроша.",
       "lat": "tri iljadi groša.",
       "en": "three thousand Groschen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Везден седи Павле море,",
       "lat": "Vezden sedi Pavle more,",
       "en": "Pavle sits all day"
      },
      {
       "cyr": "во ладна меана,",
       "lat": "vo ladna meana,",
       "en": "in the cold tavern,"
      },
      {
       "cyr": "вино пие, ем лута ракија.",
       "lat": "vino pie, em luta rakija.",
       "en": "drinking wine and strong spirits."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога дојде време",
       "lat": "Koga dojde vreme",
       "en": "When the time came"
      },
      {
       "cyr": "вино да се плати,",
       "lat": "vino da se plati,",
       "en": "to pay for the wine,"
      },
      {
       "cyr": "Павле пари нема.",
       "lat": "Pavle pari nema.",
       "en": "Pavle has no money."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Везден седи Павле море,",
