      {
       "cyr": "девојче едно мало, малечко,",
       "lat": "devojče edno malo, malečko,",
       "en": "a little girl, tiny,"
      },
      {
       "cyr": "девојче младо, мамо, убаво.",
       "lat": "devojče mlado, mamo, ubavo.",
       "en": "a young girl, mother, beautiful."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Учам те, мили сине, карам те,",
       "lat": "- Učam te, mili sine, karam te,",
       "en": "- I teach you, dear son, I scold you,"
      },
      {
       "cyr": "момето ти е сине, малечко,",
