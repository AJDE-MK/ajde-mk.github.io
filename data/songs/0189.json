   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Топовите грмат, татни земјата",
       "lat": "Topovite grmat, tatni zemjata",
       "en": "The cannons thunder, the earth rumbles,"
      },
      {
       "cyr": "пламен се дига до небото.",
       "lat": "plamen se diga do neboto.",
       "en": "flame rises to the sky."
      },
      {
       "cyr": "Жалете браќа, браќа славјани",
       "lat": "Žalete braḱa, braḱa slavjani",
       "en": "Mourn, brothers, Slavic brothers,"
      },
      {
       "cyr": "Смилево славно в' оган гори.",
       "lat": "Smilevo slavno v' ogan gori.",
       "en": "glorious Smilevo burns in fire."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Жените плачат, пиштат децата,",
       "lat": "Ženite plačat, pištat decata,",
       "en": "Women weep, children scream,"
      },
      {
       "cyr": "моми се кријат во беспокој.",
       "lat": "momi se krijat vo bespokoj.",
       "en": "girls hide in distress."
      },
      {
       "cyr": "Наспроти стои Даме Груев,",
       "lat": "Nasproti stoi Dame Gruev,",
       "en": "Opposite stands Dame Gruev,"
      },
      {
       "cyr": "верна дружина командува.",
       "lat": "verna družina komanduva.",
       "en": "he commands the faithful band."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Удрете браќа, не се плашете,",
       "lat": "Udrete braḱa, ne se plašete,",
       "en": "Strike, brothers, do not be afraid,"
      },
      {
       "cyr": "скоро ќе падне овој тиран.",
       "lat": "skoro ḱe padne ovoj tiran.",
       "en": "soon this tyrant will fall."
      },
      {
       "cyr": "И на ова царство ќе достоеме,",
       "lat": "I na ova carstvo ḱe dostoeme,",
       "en": "And we will outlast this empire,"
      },
      {
       "cyr": "на таја пуста тиранија.",
       "lat": "na taja pusta tiranija.",
       "en": "this wretched tyranny."
      }
     ]
    },
    {
     "lines": [
      {
