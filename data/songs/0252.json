       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Рајна на порти стоеше,",
       "lat": "Rajna na porti stoeše,",
       "en": "Rajna was standing at the gates,",
       "en_mt": false
      },
      {
       "cyr": "Рајна на порти стоеше,",
       "lat": "Rajna na porti stoeše,",
       "en": "Rajna was standing at the gates,",
       "en_mt": false
      },
      {
       "cyr": "меракот си го чекаше,",
       "lat": "merakot si go čekaše,",
       "en": "waiting for her love,",
       "en_mt": false
      },
      {
       "cyr": "меракот си го чекаше.",
       "lat": "merakot si go čekaše.",
       "en": "waiting for her love.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оф, ој Рајне Бурева",
       "lat": "Of, oj Rajne Bureva",
       "en": "Oh, oh, Rajna Bureva,",
       "en_mt": false
      },
      {
       "cyr": "прибери ме мили Боже при неа",
       "lat": "priberi me mili Bože pri nea",
       "en": "dear God, put me next to her.",
       "en_mt": false
      },
      {
       "cyr": "Оф, ој Рајна Бурева",
       "lat": "Of, oj Rajna Bureva",
       "en": "Oh, oh, Rajna Bureva,",
       "en_mt": false
      },
      {
       "cyr": "јас не можам мили Боже без неа.",
       "lat": "jas ne možam mili Bože bez nea.",
       "en": "I can't go on, dear God, without her.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оздола иде Ѓошето,",
       "lat": "Ozdola ide Ǵošeto,",
       "en": "From down there here comes Gjoshe,",
       "en_mt": false
      },
      {
       "cyr": "оздола иде Ѓошето,",
       "lat": "ozdola ide Ǵošeto,",
       "en": "from down there here comes Gjoshe,",
       "en_mt": false
      },
      {
       "cyr": "Ѓошето на Поп-јаневци.",
       "lat": "Ǵošeto na Pop-janevci.",
       "en": "Gjoshe of Pop-janev family.",
       "en_mt": false
      },
      {
       "cyr": "И на Рајна вели, говори,",
       "lat": "I na Rajna veli, govori,",
       "en": "And he says to Rajna, tells her,",
