    {
     "lines": [
      {
       "cyr": "Излегла е невестата",
       "lat": "Izlegla e nevestata",
       "en": "The bride came outside"
      },
      {
       "cyr": "од утрина во недела,",
       "lat": "od utrina vo nedela,",
       "en": "On Sunday morning"
      },
      {
       "cyr": "од утрина во недела.",
       "lat": "od utrina vo nedela.",
       "en": "On Sunday morning."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да си мете рамни дворе,",
       "lat": "Da si mete ramni dvore,",
       "en": "To sweep the front yard"
      },
      {
       "cyr": "дворе мете, солзи роне.",
       "lat": "dvore mete, solzi rone.",
       "en": "She sweeps and tears flow"
      },
      {
       "cyr": "Изметила, исчистила.",
       "lat": "Izmetila, isčistila.",
       "en": "She swept, she cleaned."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Та застана спроти слонце,",
       "lat": "Ta zastana sproti slonce,",
       "en": "She stood facing the sun"
      },
      {
       "cyr": "со слонцето си зборува:",
       "lat": "so slonceto si zboruva:",
       "en": "To the sun she talks:"
      },
      {
       "cyr": "- Еј ти слонце, летно слонце.",
       "lat": "- Ej ti slonce, letno slonce.",
       "en": "- Hey sun, you summer sun."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ти си греиш на високо,",
       "lat": "Ti si greiš na visoko,",
       "en": "You warm from very high"
      },
      {
       "cyr": "ти си гледаш на далеку,",
       "lat": "ti si gledaš na daleku,",
       "en": "You see far away"
      },
      {
       "cyr": "ти си греиш на високо,",
       "lat": "ti si greiš na visoko,",
       "en": "You warm from very high"
      },
      {
       "cyr": "ти си гледаш на далеку.",
       "lat": "ti si gledaš na daleku.",
       "en": "You see far away."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На далеку, на широко.",
       "lat": "Na daleku, na široko.",
       "en": "Far and wide"
      },
      {
       "cyr": "Нели виде мојта мајка,",
       "lat": "Neli vide mojta majka,",
       "en": "Have you not seen my mother"
      },
      {
       "cyr": "мојта мајка, мојот тејко?",
       "lat": "mojta majka, mojot tejko?",
       "en": "My mother, my father?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И моите до два брата,",
       "lat": "I moite do dva brata,",
       "en": "And my two brothers"
      },
      {
       "cyr": "до два брата, два близнака,",
       "lat": "do dva brata, dva bliznaka,",
       "en": "Two brothers, the twins"
      },
      {
       "cyr": "и моите до два брата,",
       "lat": "i moite do dva brata,",
       "en": "And my two brothers"
      },
      {
       "cyr": "до два брата, два близнака?",
       "lat": "do dva brata, dva bliznaka?",
       "en": "Two brothers, the twins?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И моите до две снахи,",
       "lat": "I moite do dve snahi,",
       "en": "And my two sisters-in-law"
      },
      {
       "cyr": "до две снахи и две сестри?",
       "lat": "do dve snahi i dve sestri?",
       "en": "Two sisters-in-law and sisters?"
      },
      {
       "cyr": "Слонцето ѝ проговара:",
       "lat": "Slonceto ì progovara:",
       "en": "The sun spoke back to her:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Еј невесто црнооко,",
       "lat": "- Ej nevesto crnooko,",
       "en": "- Hey you black-eyed bride"
      },
      {
       "cyr": "вчере от таму поминах,",
       "lat": "včere ot tamu pominah,",
       "en": "They came from there yesterday"
      },
      {
       "cyr": "еј невесто црнооко,",
       "lat": "ej nevesto crnooko,",
       "en": "Hey you black-eyed bride"
      },
      {
       "cyr": "вчере от таму поминах.",
