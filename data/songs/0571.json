       "en": "through that Dembel market."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дафина, мома убава,",
       "lat": "Dafina, moma ubava,",
       "en": "Dafina, a beautiful girl,"
      },
      {
       "cyr": "на висок чардак седеше,",
       "lat": "na visok čardak sedeše,",
       "en": "sat on a high balcony,"
      },
      {
       "cyr": "во раце чешел држеше,",
       "lat": "vo race češel držeše,",
       "en": "in her hands she held a comb,"
      },
      {
       "cyr": "руси си коси чешлаше,",
       "lat": "rusi si kosi češlaše,",
       "en": "she combed her golden hair,"
      },
      {
       "cyr": "руси си коси чешлаше,",
       "lat": "rusi si kosi češlaše,",
       "en": "she combed her golden hair,"
      },
      {
       "cyr": "луто си мајка колнеше:",
