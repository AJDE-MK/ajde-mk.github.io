   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Одит Веља на вода:",
       "lat": "Odit Velja na voda:",
       "en": "Velja is going for water:"
      },
      {
       "cyr": "- Ај ти Вељо, Вељушо,",
       "lat": "- Aj ti Veljo, Veljušo,",
       "en": "- Hey you Velja, Veljusha,"
      },
      {
       "cyr": "Веље пушти коњите,",
       "lat": "Velje pušti konjite,",
       "en": "Velje let go of the horses,"
      },
      {
       "cyr": "та е скрши стомните.",
       "lat": "ta e skrši stomnite.",
       "en": "They broke the pitchers."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Седна Веља да плачит,",
       "lat": "Sedna Velja da plačit,",
       "en": "Velja sat down and cried,"
      },
      {
       "cyr": "Веље ми ја палтеше:",
       "lat": "Velje mi ja palteše:",
       "en": "Velje consoled her:"
      },
      {
       "cyr": "- Молчи Вељо, не плачи,",
       "lat": "- Molči Veljo, ne plači,",
       "en": "- Calm down Velja, don’t cry,"
      },
      {
       "cyr": "ќе ти купам стомните,",
       "lat": "ḱe ti kupam stomnite,",
       "en": "I will buy you pitchers,"
      },
      {
       "cyr": "денеска е сабота,",
       "lat": "deneska e sabota,",
       "en": "today is Saturday,"
      },
      {
       "cyr": "утре ми е недела.",
       "lat": "utre mi e nedela.",
       "en": "tomorrow is Sunday."
      }
     ]
    },
    {
     "lines": [
      {
