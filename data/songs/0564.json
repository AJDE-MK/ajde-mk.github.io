   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ми товарил калеш Дончо",
       "lat": "Mi tovaril kaleš Dončo",
       "en": "He loaded up, prisoner Doncho,",
       "en_mt": false
      },
      {
       "cyr": "три товари ориз,",
       "lat": "tri tovari oriz,",
       "en": "three loads of rice.",
       "en_mt": false
      },
      {
       "cyr": "па си тргнал Дончо",
       "lat": "pa si trgnal Dončo",
       "en": "And he headed, prisoner Doncho,",
       "en_mt": false
      },
      {
       "cyr": "за пуста Битола.",
       "lat": "za pusta Bitola.",
       "en": "for damned Bitola.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Леле, леле, леле, Дончо,",
       "lat": "Lele, lele, lele, Dončo,",
       "en": "Lele, lele, lele, grieve for Doncho.",
       "en_mt": false
      },
      {
       "cyr": "Дончо мачна душо.",
       "lat": "Dončo mačna dušo.",
       "en": "Doncho, tormented soul.",
       "en_mt": true
      },
      {
       "cyr": "Леле, леле, леле, Дончо,",
       "lat": "Lele, lele, lele, Dončo,",
       "en": "Lele, lele, lele, grieve for Doncho.",
       "en_mt": false
      },
      {
       "cyr": "Дончо штипјанчето.",
       "lat": "Dončo štipjančeto.",
       "en": "Doncho the Boy from Shtip.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На пат го сретнале Дончо",
       "lat": "Na pat go sretnale Dončo",
       "en": "On the road, Doncho,",
       "en_mt": false
      },
      {
       "cyr": "турски караколи,",
       "lat": "turski karakoli,",
       "en": "Turks rode round him.",
       "en_mt": false
      },
      {
       "cyr": "му најдоја пусти Турци",
       "lat": "mu najdoja pusti Turci",
       "en": "They turned up, damned Turks,",
       "en_mt": false
      },
      {
       "cyr": "бомби и патрони.",
       "lat": "bombi i patroni.",
       "en": "bombs and bullets.",
       "en_mt": false
      }
     ]
    },
