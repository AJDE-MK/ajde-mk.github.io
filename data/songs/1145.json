   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Разболе ми се Калина",
       "lat": "Razbole mi se Kalina",
       "en": "Kalina fell ill on me"
      },
      {
       "cyr": "во това поле широко, широко.",
       "lat": "vo tova pole široko, široko.",
       "en": "in this field, wide, so wide."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Никој при неја немаше",
       "lat": "Nikoj pri neja nemaše",
       "en": "Nobody was near her"
      },
      {
       "cyr": "сал едно пиле шарено, шарено.",
       "lat": "sal edno pile šareno, šareno.",
       "en": "only one little speckled bird, speckled."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Со уста вода носеше",
       "lat": "So usta voda noseše",
       "en": "With its beak it carried water,"
      },
      {
       "cyr": "со крилца сенка држеше, држеше.",
       "lat": "so krilca senka držeše, držeše.",
       "en": "with its wings it held shade, held shade."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Еј море пиле шарено",
       "lat": "- Ej more pile šareno",
       "en": "- Hey, little speckled bird,"
      },
      {
       "cyr": "шо добро виде од мене, од мене?",
       "lat": "šo dobro vide od mene, od mene?",
       "en": "what good did you see from me, from me?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Калино, моме убаво",
       "lat": "- Kalino, mome ubavo",
       "en": "- Kalina, lovely girl,"
      },
      {
       "cyr": "кога гореше гората, гората.",
       "lat": "koga goreše gorata, gorata.",
       "en": "when the forest was burning, burning."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ти мен во раци држеше",
       "lat": "Ti men vo raci držeše",
       "en": "You held me in your arms,"
      },
      {
       "cyr": "со масло крилца ладеше, ладеше.",
       "lat": "so maslo krilca ladeše, ladeše.",
       "en": "with oil you cooled my wings, cooled them."
      }
     ]
    }
