      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Зашто ми се срдиш либе",
       "lat": "- Zašto mi se srdiš libe",
       "en": "- Why are you angry, dear,",
       "en_mt": false
      },
      {
       "cyr": "срдиш не доаѓаш?",
       "lat": "srdiš ne doaǵaš?",
       "en": "angry, not visiting me?",
       "en_mt": false
      },
      {
       "cyr": "Дали коња немаш либе",
       "lat": "Dali konja nemaš libe",
       "en": "Don't you have a horse, dear,",
       "en_mt": false
      },
      {
       "cyr": "или друм не знаеш?",
       "lat": "ili drum ne znaeš?",
       "en": "or did you forget the road?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Врана коња имам либе",
       "lat": "- Vrana konja imam libe",
       "en": "- I have a black stallion, dear,",
       "en_mt": false
      },
      {
       "cyr": "до три друма знае,",
       "lat": "do tri druma znae,",
       "en": "he knows all roads,",
       "en_mt": false
      },
      {
       "cyr": "само ти се срдам либе",
       "lat": "samo ti se srdam libe",
       "en": "I am just angry at you",
       "en_mt": false
      },
      {
       "cyr": "за сношната вечер.",
       "lat": "za snošnata večer.",
       "en": "for last night.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "# # #",
       "lat": "# # #",
       "en": "# # #",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Јас ти реков: добро вечер",
       "lat": "- Jas ti rekov: dobro večer",
       "en": "- I said: good evening,",
       "en_mt": false
      },
      {
       "cyr": "ти ми рече: дојди вечер.",
       "lat": "ti mi reče: dojdi večer.",
       "en": "you said: come tonight.",
       "en_mt": false
      },
      {
       "cyr": "Јас ти реков: добро вечер",
       "lat": "Jas ti rekov: dobro večer",
       "en": "I said: good evening,",
       "en_mt": false
      },
      {
       "cyr": "ти ми рече: дојди вечер.",
       "lat": "ti mi reče: dojdi večer.",
       "en": "you said: come tonight.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дојди вечер на вечера",
       "lat": "Dojdi večer na večera",
       "en": "Come tonight to dinner",
       "en_mt": false
      },
      {
       "cyr": "дури не сме вечерале,",
       "lat": "duri ne sme večerale,",
       "en": "before we start dining,",
       "en_mt": false
      },
      {
       "cyr": "дури не сме вечерале,",
       "lat": "duri ne sme večerale,",
       "en": "before we start dining,",
       "en_mt": false
      },
      {
       "cyr": "вити порти затвориле.",
       "lat": "viti porti zatvorile.",
       "en": "before we close our gates.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "# # #",
