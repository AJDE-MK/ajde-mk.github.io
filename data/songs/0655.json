    {
     "lines": [
      {
       "cyr": "Добро ми дошле сватовите",
       "lat": "Dobro mi došle svatovite",
       "en": "Welcome, wedding guests,"
      },
      {
       "cyr": "кое добро ми носите?",
       "lat": "koe dobro mi nosite?",
       "en": "what good do you bring?"
      },
      {
       "cyr": "Ваша ќерка, ваша внука,",
       "lat": "Vaša ḱerka, vaša vnuka,",
       "en": "Your daughter, your granddaughter,"
      },
      {
       "cyr": "а на мене мила снаа.",
       "lat": "a na mene mila snaa.",
       "en": "and for me a dear daughter-in-law."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде, ајде да се напиеме,",
       "lat": "Ajde, ajde da se napieme,",
       "en": "Come, come, let us drink,"
      },
      {
       "cyr": "рујно вино, лута ракија.",
       "lat": "rujno vino, luta rakija.",
       "en": "ruby wine, strong brandy."
      },
      {
       "cyr": "Да сме среќни и весели,",
       "lat": "Da sme sreḱni i veseli,",
       "en": "May we be happy and merry,"
      },
      {
       "cyr": "до година на крштевка.",
       "lat": "do godina na krštevka.",
       "en": "until next year at the christening."
      }
     ]
    },
    {
