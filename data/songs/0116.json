   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Излези моме на чардак,",
       "lat": "Izlezi mome na čardak,",
       "en": "Come out, girl, onto the balcony,"
      },
      {
       "cyr": "да видиш моме оро големо.",
       "lat": "da vidiš mome oro golemo.",
       "en": "to see, girl, the great dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На оро моме, на оро,",
       "lat": "Na oro mome, na oro,",
       "en": "To the dance, girl, to the dance,"
      },
      {
       "cyr": "млади ергени, моми убави.",
       "lat": "mladi ergeni, momi ubavi.",
       "en": "young bachelors, beautiful girls."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Везден гледам моме на орото,",
       "lat": "Vezden gledam mome na oroto,",
       "en": "I watch the dance all dressed up, girl,"
      },
      {
       "cyr": "до тебе моме да заиграм.",
       "lat": "do tebe mome da zaigram.",
       "en": "to start dancing next to you, girl."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Срце ми гори за тебе,",
       "lat": "Srce mi gori za tebe,",
       "en": "My heart burns for you,"
      },
      {
       "cyr": "не можам моме без тебе.",
       "lat": "ne možam mome bez tebe.",
       "en": "I cannot, girl, without you."
      }
     ]
    }
   ]
  }
