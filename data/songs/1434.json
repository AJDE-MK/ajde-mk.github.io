   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Не плачи Стано мори, не жали,",
       "lat": "- Ne plači Stano mori, ne žali,",
       "en": "- Don't cry, Stana, hey, don't grieve,"
      },
      {
       "cyr": "не рони солзи, мори, крвави,",
       "lat": "ne roni solzi, mori, krvavi,",
       "en": "don't shed tears, hey, bloody ones,"
      },
      {
       "cyr": "не груби лице мори црвено,",
       "lat": "ne grubi lice mori crveno,",
       "en": "don't scratch your red face, hey,"
      },
      {
       "cyr": "не топи сајче мори срмено.",
       "lat": "ne topi sajče mori srmeno.",
       "en": "don't ruin the silver-threaded sayak."
      },
      {
       "cyr": "Скапо ти е сајче мори платено,",
       "lat": "Skapo ti e sajče mori plateno,",
       "en": "The sayak is dear, hey, it was paid for,"
      },
      {
       "cyr": "в' Стамбола града е предено.",
       "lat": "v' Stambola grada e predeno.",
       "en": "it was spun in the city of Istanbul."
      }
     ]
    },
    {
     "lines": [
      {
