   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ојде дедо во градина",
       "lat": "Ojde dedo vo gradina",
       "en": "Grandpa went to the garden,"
      },
      {
       "cyr": "во градина кај цвеќиња.",
       "lat": "vo gradina kaj cveḱinja.",
       "en": "in the garden, by the flowers."
      },
      {
       "cyr": "Тамо најде девојчиња",
       "lat": "Tamo najde devojčinja",
       "en": "There he found some girls,"
      },
      {
       "cyr": "та им вели ем говори:",
       "lat": "ta im veli em govori:",
       "en": "and he said to them:"
      },
      {
       "cyr": "- „Ај кажете девојчиња",
       "lat": "- „Aj kažete devojčinja",
       "en": "- \"Hey girls, tell me,"
      },
      {
       "cyr": "која од вас ќе ме земи?“",
       "lat": "koja od vas ḱe me zemi?“",
       "en": "which one of you will be with me\"?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Прва вели говори:",
       "lat": "Prva veli govori:",
       "en": "The first girl says:"
      },
      {
       "cyr": "- „А бре дедо, стари дедо",
       "lat": "- „A bre dedo, stari dedo",
       "en": "- \"Hey grandpa, old grandpa,"
      },
      {
       "cyr": "избричи си брадичката",
       "lat": "izbriči si bradičkata",
       "en": "shave your little beard,"
      },
      {
       "cyr": "поткастри си мустаќите",
       "lat": "potkastri si mustaḱite",
       "en": "trim your mustaches,"
      },
      {
       "cyr": "јас бре дедо ќе те земам“.",
       "lat": "jas bre dedo ḱe te zemam“.",
       "en": "and I will be with you\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Втора вели говори:",
       "lat": "Vtora veli govori:",
       "en": "The second girl says:"
      },
      {
       "cyr": "- „А бре дедо, стари дедо",
       "lat": "- „A bre dedo, stari dedo",
       "en": "- \"Hey grandpa, old grandpa,"
      },
      {
       "cyr": "продај си ја кобилата",
       "lat": "prodaj si ja kobilata",
       "en": "sell your horse,"
      },
      {
       "cyr": "кобилата и колата",
       "lat": "kobilata i kolata",
       "en": "your horse and your cart,"
      },
      {
       "cyr": "јас бре дедо ќе те земам“.",
       "lat": "jas bre dedo ḱe te zemam“.",
       "en": "and I will be with you\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Трета вели и говори:",
       "lat": "Treta veli i govori:",
       "en": "The third girl says:"
      },
      {
       "cyr": "- „Абре дедо, стари дедо",
       "lat": "- „Abre dedo, stari dedo",
       "en": "- \"Hey grandpa, old grandpa,"
      },
      {
       "cyr": "запали си куќичката",
       "lat": "zapali si kuḱičkata",
       "en": "burn your house,"
      },
      {
       "cyr": "изгори си бабичката",
       "lat": "izgori si babičkata",
       "en": "burn your grandma,"
      },
      {
       "cyr": "јас бре дедо ќе те земам“.",
       "lat": "jas bre dedo ḱe te zemam“.",
       "en": "and I will be with you\"."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Си запалил куќичката,",
       "lat": "Si zapalil kuḱičkata,",
       "en": "He burned his house,"
      },
      {
       "cyr": "си изгорел бабичката,",
       "lat": "si izgorel babičkata,",
       "en": "he burned his wife,"
      },
      {
       "cyr": "па се вратил кај момите,",
       "lat": "pa se vratil kaj momite,",
       "en": "and he returned to the girls,"
      },
      {
       "cyr": "а моми му побегнале.",
       "lat": "a momi mu pobegnale.",
       "en": "but the girls have run away."
      },
      {
       "cyr": "Почнал дедо да си плачи,",
       "lat": "Počnal dedo da si plači,",
       "en": "The grandpa started to cry,"
      },
      {
       "cyr": "да си плачи да си реди:",
       "lat": "da si plači da si redi:",
       "en": "to cry and to mourn:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- „Стара беше ме крпеше",
       "lat": "- „Stara beše me krpeše",
       "en": "- \"She was old, but she was patching my clothes,"
      },
      {
       "cyr": "стара беше ми готвеше",
       "lat": "stara beše mi gotveše",
       "en": "she was old, but she cooked for me,"
      },
      {
       "cyr": "стара беше ме љубеше",
       "lat": "stara beše me ljubeše",
       "en": "she was old, but she loved me,"
      },
      {
       "cyr": "и на старост ме топлеше“.",
       "lat": "i na starost me topleše“.",
       "en": "and in these old days she kept me warm\"."
      }
     ]
    }
   ]
  }
 ],
