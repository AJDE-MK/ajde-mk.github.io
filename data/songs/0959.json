   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Нешо пиле, Нешо мори,",
       "lat": "- Nešo pile, Nešo mori,",
       "en": "- Little bird Nesho, Nesho my dear,"
      },
      {
       "cyr": "мамино калешо,",
       "lat": "mamino kalešo,",
       "en": "mother's little messenger,"
      },
      {
       "cyr": "тоа што не дојдеш, Нешо,",
       "lat": "toa što ne dojdeš, Nešo,",
       "en": "why is it you haven't come, Nesho,"
      },
      {
       "cyr": "кај мама на гости?",
       "lat": "kaj mama na gosti?",
       "en": "to visit mother?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Како да дојдам, мамо,",
       "lat": "- Kako da dojdam, mamo,",
       "en": "- How can I come, mother,"
      },
      {
       "cyr": "немам ни со кого,",
       "lat": "nemam ni so kogo,",
       "en": "I have no one to come with,"
      },
      {
       "cyr": "едно момче имам, мамо,",
       "lat": "edno momče imam, mamo,",
       "en": "I have one little boy, mother,"
      },
      {
       "cyr": "мошне малечко,",
       "lat": "mošne malečko,",
       "en": "very small,"
      },
      {
       "cyr": "сè по мене оди,",
       "lat": "sè po mene odi,",
       "en": "he follows me everywhere,"
      },
      {
       "cyr": "за поли ме држи.",
       "lat": "za poli me drži.",
       "en": "he holds on to my skirt hems."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе појдам да месам, мамо,",
       "lat": "Ḱe pojdam da mesam, mamo,",
       "en": "I'll go to knead, mother,"
      },
      {
       "cyr": "и оно по мене,",
       "lat": "i ono po mene,",
       "en": "and he comes after me,"
      },
      {
       "cyr": "за поли ме држи, мамо,",
       "lat": "za poli me drži, mamo,",
       "en": "he holds my skirt hems, mother,"
      },
      {
       "cyr": "само ме препиња.",
       "lat": "samo me prepinja.",
       "en": "he only hinders me."
      },
      {
       "cyr": "- Чекај ме, дадо мори,",
       "lat": "- Čekaj me, dado mori,",
       "en": "- Wait for me, nanny, hey,"
      },
      {
       "cyr": "меси ми кравајче!",
       "lat": "mesi mi kravajče!",
       "en": "knead me a loaf!"
      },
      {
       "cyr": "- Не сум ти дада, лудо,",
       "lat": "- Ne sum ti dada, ludo,",
       "en": "- I'm not your nanny, fool,"
      },
      {
       "cyr": "туку сум ти жена,",
       "lat": "tuku sum ti žena,",
       "en": "I'm your wife,"
      },
      {
       "cyr": "желка ти во грло,",
       "lat": "želka ti vo grlo,",
       "en": "a sore in your throat,"
      },
      {
       "cyr": "чума те затрело!",
       "lat": "čuma te zatrelo!",
       "en": "may the plague wipe you out!"
      }
     ]
    },
    {
     "lines": [
      {
