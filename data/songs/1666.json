      {
       "cyr": "Да не се караат старите",
       "lat": "Da ne se karaat starite",
       "en": "May the old not argue"
      },
      {
       "cyr": "зошто им се сега парите?",
       "lat": "zošto im se sega parite?",
       "en": "why do they need money now?"
      },
      {
       "cyr": "Нека им ги дадат на младите,",
       "lat": "Neka im gi dadat na mladite,",
       "en": "Let's give it to the young,"
      },
      {
       "cyr": "на младост да ги трошат парите,",
       "lat": "na mladost da gi trošat parite,",
       "en": "to spend their money on youth,"
      },
      {
       "cyr": "да им се љубат младите,",
       "lat": "da im se ljubat mladite,",
       "en": "let their young people love,"
      },
      {
       "cyr": "да им се множат внуците.",
       "lat": "da im se množat vnucite.",
       "en": "let their grandchildren multiply."
      }
