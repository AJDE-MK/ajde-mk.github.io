     "lines": [
      {
       "cyr": "Ај, в Македонија глас се слуша",
       "lat": "Aj, v Makedonija glas se sluša",
       "en": "Hey, in Macedonia a voice is heard"
      },
      {
       "cyr": "од нејзини синови.",
       "lat": "od nejzini sinovi.",
       "en": "from her sons."
      },
      {
       "cyr": "Ај, душманите побеснале,",
       "lat": "Aj, dušmanite pobesnale,",
       "en": "Hey, the enemies have gone mad,"
      },
      {
       "cyr": "колат, бесат сè на ред.",
       "lat": "kolat, besat sè na red.",
       "en": "they slaughter, they rage, all in a row."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, вие браќа Македонци,",
       "lat": "Aj, vie braḱa Makedonci,",
       "en": "Hey, you Macedonian brothers,"
      },
      {
       "cyr": "вие славни јунаци.",
       "lat": "vie slavni junaci.",
       "en": "you glorious heroes."
      },
      {
       "cyr": "Алово знаме да развејме",
       "lat": "Alovo zname da razvejme",
       "en": "Let us unfurl the crimson banner"
      },
      {
       "cyr": "над македонски долини.",
       "lat": "nad makedonski dolini.",
       "en": "over the Macedonian valleys."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, на знаме е напишано:",
       "lat": "Aj, na zname e napišano:",
       "en": "Hey, on the banner it is written:"
      },
      {
       "cyr": "„Слобода или смрт“.",
       "lat": "„Sloboda ili smrt“.",
       "en": "\"Freedom or death\"."
      },
      {
       "cyr": "Ај, нека чует и Европа,",
       "lat": "Aj, neka čuet i Evropa,",
       "en": "Hey, let Europe hear too,"
      },
      {
       "cyr": "народот се разбуди.",
       "lat": "narodot se razbudi.",
       "en": "the people have awakened."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ај, Македонец не се плаши",
       "lat": "Aj, Makedonec ne se plaši",
       "en": "Hey, the Macedonian is not afraid"
      },
      {
       "cyr": "од душмански јатаган.",
       "lat": "od dušmanski jatagan.",
       "en": "of the enemy's yatagan."
