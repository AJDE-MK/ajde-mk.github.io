    },
    {
     "lines": [
      {
       "cyr": "Деца бевме напатени,",
       "lat": "Deca bevme napateni,",
       "en": "We were children, tormented,"
      },
      {
       "cyr": "ширум светот распадени,",
       "lat": "širum svetot raspadeni,",
       "en": "scattered widely across the world,"
      },
      {
       "cyr": "само да не разнебитат,",
       "lat": "samo da ne raznebitat,",
       "en": "only so that they would not break us up,"
      },
      {
       "cyr": "само да не однародат.",
       "lat": "samo da ne odnarodat.",
       "en": "only so that they would not make us lose our nation."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј одродници, што ни сторивте,",
       "lat": "Ej odrodnici, što ni storivte,",
       "en": "Hey renegades, what have you done to us,"
      },
      {
       "cyr": "свети огништа ни растуривте,",
       "lat": "sveti ogništa ni rasturivte,",
       "en": "you scattered our sacred hearths,"
      },
      {
       "cyr": "ко што било пак ќе биде,",
       "lat": "ko što bilo pak ḱe bide,",
       "en": "what was will be again,"
      },
      {
       "cyr": "род со рода ќе се види,",
       "lat": "rod so roda ḱe se vidi,",
       "en": "kin will meet kin,"
      },
      {
       "cyr": "Беломорје нов ден ќе го раздени.",
       "lat": "Belomorje nov den ḱe go razdeni.",
       "en": "the Aegean will bring a new day to dawn."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Солзи тешки Беломорски,",
       "lat": "Solzi teški Belomorski,",
       "en": "Heavy tears of the Aegean,"
      },
      {
       "cyr": "нигде пристан татков, мајчински,",
       "lat": "nigde pristan tatkov, majčinski,",
       "en": "no haven anywhere, father's or mother's,"
      },
      {
       "cyr": "клетва лута ќе ги стигне,",
       "lat": "kletva luta ḱe gi stigne,",
       "en": "the bitter curse will catch up with them,"
