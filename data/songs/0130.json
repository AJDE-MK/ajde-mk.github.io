   "stanzas": [
    {
     "lines": [
      {
       "cyr": "А бре Македонче, за каде се спремаш?",
       "lat": "A bre Makedonče, za kade se spremaš?",
       "en": "Hey Macedonian boy, what are you preparing for?"
      },
      {
       "cyr": "Борба те чека, борба за слобода.",
       "lat": "Borba te čeka, borba za sloboda.",
       "en": "A fight await for you, a fight for freedom."
      },
      {
       "cyr": "Борба за слобода, за Македонија,",
       "lat": "Borba za sloboda, za Makedonija,",
       "en": "A fight for freedom, for Macedonia,"
      },
      {
       "cyr": "за Македонија, земја поробена.",
       "lat": "za Makedonija, zemja porobena.",
       "en": "for Macedonia, enslaved land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Момци наредени, моми накитени,",
       "lat": "Momci naredeni, momi nakiteni,",
       "en": "Young men, decorated, young women with flowers,"
      },
      {
       "cyr": "борба ќе одат, борба за слобода.",
       "lat": "borba ḱe odat, borba za sloboda.",
       "en": "they'll go to fight, to fight for freedom."
      },
      {
       "cyr": "Борба за слобода, за Македонија,",
       "lat": "Borba za sloboda, za Makedonija,",
       "en": "A fight for freedom, for Macedonia,"
      },
      {
       "cyr": "за Македонија, земја поробена.",
       "lat": "za Makedonija, zemja porobena.",
       "en": "for Macedonia, enslaved land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нека разберат клетите фашисти,",
       "lat": "Neka razberat kletite fašisti,",
       "en": "Let the damned fascists know:"
      },
      {
       "cyr": "македонско име нема да загине!",
       "lat": "makedonsko ime nema da zagine!",
       "en": "the Macedonian name will not die!"
