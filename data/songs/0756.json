    {
     "lines": [
      {
       "cyr": "Дајте ми лек за душава,",
       "lat": "Dajte mi lek za dušava,",
       "en": "Give me a cure for my soul,"
      },
      {
       "cyr": "минато да заборавам",
       "lat": "minato da zaboravam",
       "en": "so I may forget the past"
      },
      {
       "cyr": "и сите тажни спомени",
       "lat": "i site tažni spomeni",
       "en": "and all the sad memories"
      },
      {
       "cyr": "од луди млади години.",
       "lat": "od ludi mladi godini.",
       "en": "of my foolish young years."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зар има лек за вљубени",
       "lat": "Zar ima lek za vljubeni",
       "en": "Is there a cure for those in love,"
      },
      {
       "cyr": "за надежи изгубени?",
       "lat": "za nadeži izgubeni?",
       "en": "for hopes that are lost?"
      },
      {
       "cyr": "Со вино болка лекувам,",
       "lat": "So vino bolka lekuvam,",
       "en": "With wine I heal the pain,"
      },
      {
       "cyr": "цел живот сам јас векувам.",
       "lat": "cel život sam jas vekuvam.",
       "en": "I alone live out my whole life."
      }
     ]
    },
