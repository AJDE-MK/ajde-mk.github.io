      {
       "cyr": "Момче мајка љуто колнит,",
       "lat": "Momče majka ljuto kolnit,",
       "en": "A mother angrily curses her son,"
      },
      {
       "cyr": "момче је се милно молит:",
       "lat": "momče je se milno molit:",
       "en": "the boy sweetly begs her:"
