   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Запеало славеј пиле",
       "lat": "Zapealo slavej pile",
       "en": "The nightingale bird began to sing"
      },
      {
       "cyr": "на багремот, под пенџери.",
       "lat": "na bagremot, pod pendžeri.",
       "en": "on the acacia, under the windows."
      },
      {
       "cyr": "Го разбуди малој моме,",
       "lat": "Go razbudi maloj mome,",
       "en": "It woke the young girl,"
      },
      {
       "cyr": "уплакано, нажалено.",
       "lat": "uplakano, nažaleno.",
       "en": "tearful, grieving."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проговара малој моме:",
       "lat": "Progovara maloj mome:",
       "en": "The young girl speaks:"
      },
      {
       "cyr": "- Не пеј пиле толку рано,",
       "lat": "- Ne pej pile tolku rano,",
       "en": "- Do not sing so early, little bird,"
      },
      {
       "cyr": "саноќ сум си проплакала",
       "lat": "sanoḱ sum si proplakala",
       "en": "all night I have been crying"
      },
      {
       "cyr": "и пред зора сум заспала.",
       "lat": "i pred zora sum zaspala.",
       "en": "and before dawn I fell asleep."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Три ноќи сум проплакала,",
       "lat": "Tri noḱi sum proplakala,",
       "en": "Three nights I have cried,"
      },
      {
       "cyr": "мојто либе испраќала.",
       "lat": "mojto libe ispraḱala.",
       "en": "seeing off my sweetheart."
      },
      {
       "cyr": "Тој ми појде на туѓина,",
       "lat": "Toj mi pojde na tuǵina,",
       "en": "He went off to a foreign land,"
      },
      {
       "cyr": "на туѓина, на печалба.",
       "lat": "na tuǵina, na pečalba.",
       "en": "to a foreign land, to work for money."
      },
      {
       "cyr": "Пред да појде, ми нарача",
       "lat": "Pred da pojde, mi narača",
       "en": "Before he left, he told me"
      },
      {
       "cyr": "да го чекам пет години.",
       "lat": "da go čekam pet godini.",
       "en": "to wait for him five years."
      }
     ]
    }
   ]
