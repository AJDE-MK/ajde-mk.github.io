   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Го пленал Моско,",
       "lat": "Go plenal Mosko,",
       "en": "Mosko took her captive,"
      },
      {
       "cyr": "го пленал џанам,",
       "lat": "go plenal džanam,",
       "en": "took her captive, dear,"
      },
      {
       "cyr": "нашата сестра Јулија.",
       "lat": "našata sestra Julija.",
       "en": "our sister Julija."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога Јулија грабнаја џанам,",
       "lat": "Koga Julija grabnaja džanam,",
       "en": "When they seized Julija, dear,"
      },
      {
       "cyr": "анами коси корнеја,",
       "lat": "anami kosi korneja,",
       "en": "the ladies tore their hair,"
      },
      {
       "cyr": "бегови солзи ронеја.",
       "lat": "begovi solzi roneja.",
       "en": "the beys shed tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Што стори Јуле,",
       "lat": "- Što stori Jule,",
       "en": "- What did you do, Jule,"
      },
      {
       "cyr": "што стори, џанам,",
       "lat": "što stori, džanam,",
       "en": "what did you do, dear,"
      },
      {
       "cyr": "срцето ми го изгоре?",
       "lat": "srceto mi go izgore?",
       "en": "you burned my heart!"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Чифликот ќе го продајме џанам,",
       "lat": "Čiflikot ḱe go prodajme džanam,",
       "en": "We will sell the estate, dear,"
      },
      {
       "cyr": "Јулија ќе ја грабиме.",
       "lat": "Julija ḱe ja grabime.",
       "en": "we will take Julija back."
      },
      {
       "cyr": "- Чифлици да си продајте џанам,",
