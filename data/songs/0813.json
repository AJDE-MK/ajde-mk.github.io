    {
     "lines": [
      {
       "cyr": "Македонци наглас запејте",
       "lat": "Makedonci naglas zapejte",
       "en": "Macedonians sing aloud,"
      },
      {
       "cyr": "македонско оро играјте",
       "lat": "makedonsko oro igrajte",
       "en": "dance the Macedonian dance."
      },
      {
       "cyr": "мајка мила спомнете ја",
       "lat": "majka mila spomnete ja",
       "en": "Don't forget your dear mother,"
      },
      {
