   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Свекрвице мори,",
       "lat": "Svekrvice mori,",
       "en": "Mother-in-law, hey,"
      },
      {
       "cyr": "нели имам т'нка снага",
       "lat": "neli imam t'nka snaga",
       "en": "do I not have a slender waist"
      },
      {
       "cyr": "за сина ти?",
       "lat": "za sina ti?",
       "en": "for your son?"
      },
      {
       "cyr": "Нели ти е син ти",
       "lat": "Neli ti e sin ti",
       "en": "Isn't your son"
      },
      {
       "cyr": "чифтели чапуљ,",
       "lat": "čifteli čapulj,",
       "en": "a çiftetelli-dancing scoundrel,"
      },
      {
       "cyr": "пуш пијаница,",
       "lat": "puš pijanica,",
       "en": "a worthless drunkard,"
      },
      {
       "cyr": "по меане иде,",
       "lat": "po meane ide,",
       "en": "he goes around the taverns,"
      },
      {
       "cyr": "рујно вино пие,",
       "lat": "rujno vino pie,",
       "en": "drinks ruby-red wine,"
      },
      {
       "cyr": "со мене не спие?",
       "lat": "so mene ne spie?",
       "en": "and does not sleep with me?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дал' да го најде,",
       "lat": "Dal' da go najde,",
       "en": "May it find him,"
      },
      {
       "cyr": "што беља не снајде,",
       "lat": "što belja ne snajde,",
       "en": "the trouble that has not found (him yet),"
      },
      {
       "cyr": "бесно куче.",
       "lat": "besno kuče.",
       "en": "the rabid dog."
      },
      {
       "cyr": "Иљче море џан,",
       "lat": "Iljče more džan,",
       "en": "Ilche, hey, my dear,"
      },
      {
       "cyr": "медор мол сенга, ајде",
       "lat": "medor mol senga, ajde",
       "en": "medor mol senga, come on"
      },
      {
       "cyr": "елем дотурма, џанам,",
       "lat": "elem doturma, džanam,",
       "en": "elem doturma, my dear,"
      },
      {
       "cyr": "не се задирај.",
       "lat": "ne se zadiraj.",
       "en": "don't pick on me."
      }
     ]
    },
