   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Чије е оној моме мамо,",
       "lat": "Čije e onoj mome mamo,",
       "en": "Whose girl is that, mother,"
      },
      {
       "cyr": "чије је оној моме,",
       "lat": "čije je onoj mome,",
       "en": "whose girl is that,"
      },
      {
       "cyr": "от пенџер што гледа, мила мамо,",
       "lat": "ot pendžer što gleda, mila mamo,",
       "en": "looking from the window, dear mother,"
      },
      {
       "cyr": "од пенџер шо гледа?",
       "lat": "od pendžer šo gleda?",
       "en": "looking from the window?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А што глава има, мамо,",
       "lat": "A što glava ima, mamo,",
       "en": "What a head she has, mother,"
      },
      {
       "cyr": "а што глава има,",
       "lat": "a što glava ima,",
       "en": "what a head she has,"
      },
      {
       "cyr": "битолска курија, мила мамо,",
       "lat": "bitolska kurija, mila mamo,",
       "en": "like a forest near Bitola, dear mother,"
      },
      {
       "cyr": "битолска курија.",
       "lat": "bitolska kurija.",
       "en": "like a forest near Bitola."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А што чело има мамо,",
       "lat": "A što čelo ima mamo,",
       "en": "What a forehead she has, mother,"
      },
      {
       "cyr": "а што чело има,",
       "lat": "a što čelo ima,",
       "en": "what a forehead she has,"
      },
      {
       "cyr": "алтан амајлија, мила мамо,",
       "lat": "altan amajlija, mila mamo,",
       "en": "like a golden amulet, dear mother,"
      },
      {
       "cyr": "алтан амајлија.",
       "lat": "altan amajlija.",
       "en": "like a golden amulet."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А што веѓи има мамо,",
       "lat": "A što veǵi ima mamo,",
       "en": "What eyebrows she has, mother,"
      },
      {
       "cyr": "а што веѓи има,",
       "lat": "a što veǵi ima,",
       "en": "what eyebrows she has,"
      },
      {
       "cyr": "морски пијавици, мила мамо,",
       "lat": "morski pijavici, mila mamo,",
       "en": "like sea leeches, dear mother,"
      },
      {
       "cyr": "морски пијавици.",
       "lat": "morski pijavici.",
       "en": "like sea leaches."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А што очи има мамо,",
       "lat": "A što oči ima mamo,",
       "en": "What eyes she has, mother,"
      },
      {
       "cyr": "а што очи има,",
       "lat": "a što oči ima,",
       "en": "what eyes she has,"
      },
      {
       "cyr": "беглерски филџани, мила мамо,",
       "lat": "beglerski fildžani, mila mamo,",
       "en": "like coffee cups from a bey, dear mother,"
      },
      {
       "cyr": "беглерски филџани.",
       "lat": "beglerski fildžani.",
       "en": "like coffee cups from a bey."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Иди ја посакај мамо,",
       "lat": "Idi ja posakaj mamo,",
       "en": "Go and ask if she is available, mother,"
      },
      {
       "cyr": "иди ја посакај,",
       "lat": "idi ja posakaj,",
       "en": "go and ask about her,"
      },
      {
       "cyr": "дал' ќе ти ја дадат, мила мамо,",
       "lat": "dal' ḱe ti ja dadat, mila mamo,",
       "en": "will they give her to you, dear mother,"
      },
      {
       "cyr": "снаа да ти биде.",
       "lat": "snaa da ti bide.",
       "en": "to be your daughter-in-law?"
      }
     ]
    }
   ]
  }
 ],
