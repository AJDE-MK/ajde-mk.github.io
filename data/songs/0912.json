   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ти не плачи мајко што сум далеку и сам,",
       "lat": "Ti ne plači majko što sum daleku i sam,",
       "en": "Do not cry, mother, that I am far away and alone,"
      },
      {
       "cyr": "и не кревај магли, силни јадови,",
       "lat": "i ne krevaj magli, silni jadovi,",
       "en": "and do not raise mists, mighty sorrows,"
      },
      {
       "cyr": "својот пат, затрупан, сеуште го знам,",
       "lat": "svojot pat, zatrupan, seušte go znam,",
       "en": "my road, buried, I still know,"
      },
      {
       "cyr": "ако згрешам, нека изгорам.",
       "lat": "ako zgrešam, neka izgoram.",
       "en": "if I err, let me burn."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј ридови, сини мориња,",
       "lat": "Ej ridovi, sini morinja,",
       "en": "Hey hills, blue seas,"
      },
      {
       "cyr": "сам ќе морам да ве пробијам,",
       "lat": "sam ḱe moram da ve probijam,",
       "en": "I will have to break through you alone,"
      },
      {
       "cyr": "еј кораби, назад пловете,",
       "lat": "ej korabi, nazad plovete,",
       "en": "hey ships, sail back,"
      },
      {
       "cyr": "ако згрешам, нека изгорам.",
       "lat": "ako zgrešam, neka izgoram.",
       "en": "if I err, let me burn."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе препливам води, назад ќе се вратам пак,",
       "lat": "Ḱe preplivam vodi, nazad ḱe se vratam pak,",
       "en": "I will swim across waters, I will come back again,"
      },
      {
       "cyr": "во градиве едра, распнувам за пат,",
       "lat": "vo gradive edra, raspnuvam za pat,",
       "en": "in this town I raise sails for the journey,"
      },
      {
       "cyr": "огнови високи, сам ќе изодам,",
       "lat": "ognovi visoki, sam ḱe izodam,",
       "en": "high fires, I will walk through alone,"
