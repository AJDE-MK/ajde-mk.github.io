      {
       "cyr": "Цвета се крла а ѓурѓеле,",
       "lat": "Cveta se krla a ǵurǵele,",
       "en": "Tsveta is swinging, oh gjurgjele,"
      },
      {
       "cyr": "Доне га пули:",
       "lat": "Done ga puli:",
       "en": "Done is watching her:"
      },
      {
       "cyr": "- Кротком крлајте а ѓурѓеле",
       "lat": "- Krotkom krlajte a ǵurǵele",
       "en": "- Swing gently, oh gjurgjele,"
      },
      {
       "cyr": "моето либе",
       "lat": "moeto libe",
       "en": "my love"
      },
      {
       "cyr": "да не ми падни а ѓурѓеле",
       "lat": "da ne mi padni a ǵurǵele",
       "en": "so she does not fall, oh gjurgjele,"
      },
      {
       "cyr": "да не се удри.",
       "lat": "da ne se udri.",
       "en": "so she does not hurt herself."
      },
      {
       "cyr": "Местото ѝ е каменливо",
       "lat": "Mestoto ì e kamenlivo",
       "en": "The place is stony,"
      },
      {
       "cyr": "кротком крлајте",
       "lat": "krotkom krlajte",
       "en": "swing gently,"
      },
      {
       "cyr": "и ако падниш, ластар Цвето",
       "lat": "i ako padniš, lastar Cveto",
       "en": "and if you fall, young shoot Tsveta,"
      },
      {
       "cyr": "Доне те чека,",
       "lat": "Done te čeka,",
       "en": "Done is waiting for you,"
      },
      {
       "cyr": "Доне те чека, ластар Цвето",
       "lat": "Done te čeka, lastar Cveto",
       "en": "Done is waiting for you, young shoot Tsveta,"
      },
      {
       "cyr": "ву бели раци.",
