   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Стара мајка седи,",
       "lat": "Stara majka sedi,",
       "en": "Old mother is sitting there,"
      },
      {
       "cyr": "разбојот го реди,",
       "lat": "razbojot go redi,",
       "en": "working on her loom,"
      },
      {
       "cyr": "армас таа зема",
       "lat": "armas taa zema",
       "en": "she started"
      },
      {
       "cyr": "да ми ткае, да ми спрема.",
       "lat": "da mi tkae, da mi sprema.",
       "en": "to weave, to prepare my dowry."
      },
      {
       "cyr": "Тука момци нема,",
       "lat": "Tuka momci nema,",
       "en": "There are no young men here,"
      },
      {
       "cyr": "туѓина ги зема,",
       "lat": "tuǵina gi zema,",
       "en": "foreign countries took them away,"
      },
      {
       "cyr": "па се сети мајка",
       "lat": "pa se seti majka",
       "en": "the mother thinks of that"
      },
      {
       "cyr": "и си заплака.",
       "lat": "i si zaplaka.",
       "en": "and starts to cry."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Слушни ме, мајко стара,",
       "lat": "- Slušni me, majko stara,",
       "en": "- Listen, old mother,"
      },
      {
       "cyr": "тој друга не ќе бара.",
       "lat": "toj druga ne ḱe bara.",
       "en": "he won't look for another girl friend."
      },
      {
       "cyr": "В туѓина кога појде,",
       "lat": "V tuǵina koga pojde,",
       "en": "When he went abroad,"
      },
      {
       "cyr": "рече скоро ќе си дојде.",
       "lat": "reče skoro ḱe si dojde.",
       "en": "he said he'll be back soon."
      },
      {
       "cyr": "Слушни ме, мајко стара,",
       "lat": "Slušni me, majko stara,",
       "en": "Listen, old mother,"
      },
      {
       "cyr": "ветена не се дава,",
       "lat": "vetena ne se dava,",
       "en": "you can't give a promised woman to someone else,"
      },
      {
       "cyr": "или на него жена,",
       "lat": "ili na nego žena,",
       "en": "either I’ll be his wife,"
      },
      {
       "cyr": "или сама до века.",
       "lat": "ili sama do veka.",
       "en": "or I’ll stay alone forever."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мајка платно бели,",
       "lat": "Majka platno beli,",
       "en": "The mother does the washing,"
      },
      {
       "cyr": "три години цели,",
       "lat": "tri godini celi,",
       "en": "for three years,"
      },
      {
       "cyr": "в село момче бара,",
       "lat": "v selo momče bara,",
       "en": "she looks for a boy in the village"
      },
      {
       "cyr": "кому жена јас да станам.",
       "lat": "komu žena jas da stanam.",
       "en": "whose wife I shall be."
      },
      {
       "cyr": "Сите печалбари,",
       "lat": "Site pečalbari,",
       "en": "All that have gone abroad,"
      },
      {
       "cyr": "еј, за пусти пари,",
       "lat": "ej, za pusti pari,",
       "en": "oh, because of that damned money,"
      },
      {
       "cyr": "никој не се вратил,",
       "lat": "nikoj ne se vratil,",
       "en": "nobody has come back,"
      },
      {
       "cyr": "не се оженил.",
       "lat": "ne se oženil.",
       "en": "and nobody got married."
      }
     ]
    },
