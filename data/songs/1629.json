   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Марика писмо пишеше,",
       "lat": "Marika pismo pišeše,",
       "en": "Marika was writing a letter,"
      },
      {
       "cyr": "дробни си солзи ронеше,",
       "lat": "drobni si solzi roneše,",
       "en": "her tears were falling,"
      },
      {
       "cyr": "либето си го молеше:",
       "lat": "libeto si go moleše:",
       "en": "she was begging her love:"
      },
      {
       "cyr": "- Оф, либе, либе ле,",
       "lat": "- Of, libe, libe le,",
       "en": "- Oh, love, love,"
      },
      {
       "cyr": "јас не можам либе ич без тебе.",
       "lat": "jas ne možam libe ič bez tebe.",
       "en": "I can't do anything without you."
      },
      {
       "cyr": "Дојди, дојди либе,",
       "lat": "Dojdi, dojdi libe,",
       "en": "Come, come, love,"
      },
      {
       "cyr": "дојди си при мене,",
       "lat": "dojdi si pri mene,",
       "en": "come to me,"
      },
      {
       "cyr": "оти јас сум болна либе",
       "lat": "oti jas sum bolna libe",
       "en": "because I am sick, love,"
      },
      {
       "cyr": "само за тебе.",
       "lat": "samo za tebe.",
       "en": "just for you."
      },
      {
       "cyr": "Дојди, дојди либе,",
       "lat": "Dojdi, dojdi libe,",
       "en": "Come, come, love,"
      },
      {
       "cyr": "дојди си при мене,",
       "lat": "dojdi si pri mene,",
       "en": "come to me,"
      },
      {
       "cyr": "оти јас ќе умрам либе",
       "lat": "oti jas ḱe umram libe",
       "en": "because I will die, love,"
      },
      {
       "cyr": "само за тебе.",
       "lat": "samo za tebe.",
       "en": "just for you."
      }
     ]
    },
