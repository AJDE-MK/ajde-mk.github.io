    {
     "lines": [
      {
       "cyr": "Ој Ленко, Ленко галенко де,",
       "lat": "Oj Lenko, Lenko galenko de,",
       "en": "Oh Lenka, Lenka you spoiled maiden,"
      },
      {
       "cyr": "белото лице на тебе",
       "lat": "beloto lice na tebe",
       "en": "that white face of yours,"
      },
      {
       "cyr": "фрли го, метни го на мене,",
       "lat": "frli go, metni go na mene,",
       "en": "throw it, give it to me,"
      },
      {
       "cyr": "јас да го носам, подносам,",
       "lat": "jas da go nosam, podnosam,",
       "en": "so I can wear it for a little while"
      },
      {
       "cyr": "пак ќе ти го донесам.",
       "lat": "pak ḱe ti go donesam.",
       "en": "and I will return it to you."
      }
     ]
    },
