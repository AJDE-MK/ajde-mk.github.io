  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Останал Кољо сираче",
       "lat": "Ostanal Koljo sirače",
       "en": "Kolyo was left an orphan,"
      },
      {
       "cyr": "без мајка, Кољо, без татко.",
       "lat": "bez majka, Koljo, bez tatko.",
       "en": "without a mother, Kolyo, without a father."
      },
      {
       "cyr": "Главил се Кољо слугинче",
       "lat": "Glavil se Koljo sluginče",
       "en": "Kolyo hired himself out as a servant boy"
      },
      {
       "cyr": "при една бела анама.",
       "lat": "pri edna bela anama.",
       "en": "to a certain fair-skinned lady."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Девет години слугувал,",
       "lat": "Devet godini sluguval,",
       "en": "Nine years he served,"
      },
      {
       "cyr": "лицето не ѝ го видел.",
       "lat": "liceto ne ì go videl.",
       "en": "he never saw her face."
      },
      {
       "cyr": "Поддувна ветар од море,",
       "lat": "Podduvna vetar od more,",
       "en": "A wind blew in from the sea,"
      },
      {
       "cyr": "јашмакот ѝ го подигна.",
       "lat": "jašmakot ì go podigna.",
       "en": "it lifted her veil."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Анамче оди на бања,",
       "lat": "Anamče odi na banja,",
       "en": "The young lady goes to the bathhouse,"
      },
      {
       "cyr": "слугинче оди на бербер.",
       "lat": "sluginče odi na berber.",
       "en": "the servant boy goes to the barber."
      },
      {
       "cyr": "Сретнале ми се, сретнале,",
       "lat": "Sretnale mi se, sretnale,",
       "en": "They met, they met,"
      },
      {
       "cyr": "при едно мало сокаче.",
       "lat": "pri edno malo sokače.",
       "en": "in a little side street."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Слугинче вели, говори:",
       "lat": "Sluginče veli, govori:",
       "en": "The servant says, he speaks:"
      },
      {
       "cyr": "- Двајцата да се земиме.",
       "lat": "- Dvajcata da se zemime.",
       "en": "- Let the two of us marry."
      }
     ]
    }
   ]
  }
 ],
