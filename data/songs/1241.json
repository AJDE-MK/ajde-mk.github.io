   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Лудо младо сон засонило,",
       "lat": "Ludo mlado son zasonilo,",
       "en": "The young lad fell asleep dreaming,"
      },
      {
       "cyr": "на раката бела момина,",
       "lat": "na rakata bela momina,",
       "en": "on the girl's white arm,"
      },
      {
       "cyr": "а мома се чудно чуди,",
       "lat": "a moma se čudno čudi,",
       "en": "and the girl wonders strangely,"
      },
      {
       "cyr": "жално ѝ е да го буди,",
       "lat": "žalno ì e da go budi,",
       "en": "she is sorry to wake him,"
      },
      {
       "cyr": "мило ѝ е да го гледа.",
       "lat": "milo ì e da go gleda.",
       "en": "she loves to look at him."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па му рекла: - Стани лудо,",
       "lat": "Pa mu rekla: - Stani ludo,",
       "en": "Then she said: - Get up, my lad,"
      },
      {
       "cyr": "жално ми е да те будам.",
       "lat": "žalno mi e da te budam.",
       "en": "I am sorry to wake you."
      },
      {
       "cyr": "Рана зора зазорува,",
       "lat": "Rana zora zazoruva,",
       "en": "Early dawn is breaking,"
      },
      {
       "cyr": "јасно сонце веќе иде,",
       "lat": "jasno sonce veḱe ide,",
       "en": "the bright sun is already coming,"
      },
      {
       "cyr": "ќе изгрее, ќе нè виде.",
       "lat": "ḱe izgree, ḱe nè vide.",
       "en": "it will rise, it will see us."
      },
      {
       "cyr": "Мило ми е да те гледам,",
       "lat": "Milo mi e da te gledam,",
       "en": "I love to look at you,"
      },
      {
       "cyr": "ама сонце ќе нè види,",
       "lat": "ama sonce ḱe nè vidi,",
       "en": "but the sun will see us,"
      },
      {
       "cyr": "ќе нè види и завиди.",
       "lat": "ḱe nè vidi i zavidi.",
       "en": "it will see us and envy."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "А момче се милно моли:",
       "lat": "A momče se milno moli:",
       "en": "And the lad pleads tenderly:"
      },
      {
       "cyr": "- Как' да станам, малој моме?",
       "lat": "- Kak' da stanam, maloj mome?",
       "en": "- How can I get up, little girl?"
      },
      {
       "cyr": "Как' да станам, малој моме,",
       "lat": "Kak' da stanam, maloj mome,",
       "en": "How can I get up, little girl,"
      },
      {
       "cyr": "кога немам веќе сила,",
       "lat": "koga nemam veḱe sila,",
       "en": "when I have no strength left,"
      },
      {
       "cyr": "кога ти си ја испила?",
       "lat": "koga ti si ja ispila?",
       "en": "when you have drunk it up?"
      }
     ]
    }
   ]
  }
