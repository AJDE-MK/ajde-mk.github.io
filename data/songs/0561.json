       "cyr": "- Каранфил невесто мори",
       "lat": "- Karanfil nevesto mori",
       "en": "- Karanfil (Carnation) girl"
      },
      {
       "cyr": "вода ми се пие.",
       "lat": "voda mi se pie.",
       "en": "I want to drink some water."
      },
      {
       "cyr": "- Ако ти се пие лудо,",
       "lat": "- Ako ti se pie ludo,",
       "en": "- If you want to drink,"
      },
      {
       "cyr": "појди па се напи.",
       "lat": "pojdi pa se napi.",
       "en": "go and have a drink."
      }
     ]
    },
