   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ден се разденило, сонце огреало",
       "lat": "Den se razdenilo, sonce ogrealo",
       "en": "The day has dawned, the sun has risen",
       "en_mt": false
      },
      {
       "cyr": "високо, ајде над Мариово,",
       "lat": "visoko, ajde nad Mariovo,",
       "en": "high, come over Mariovo,",
       "en_mt": false
      },
      {
       "cyr": "по цела рамна Пелагонија.",
       "lat": "po cela ramna Pelagonija.",
       "en": "all over flat Pelagonija.",
       "en_mt": false
      },
      {
       "cyr": "Ај, од мерак да не можеш",
       "lat": "Aj, od merak da ne možeš",
       "en": "Oh, it is joy",
       "en_mt": false
      },
      {
       "cyr": "да се нагледаш",
       "lat": "da se nagledaš",
       "en": "to see",
       "en_mt": false
      },
      {
       "cyr": "планини, села македонски.",
       "lat": "planini, sela makedonski.",
       "en": "the mountains, Macedonian villages.",
       "en_mt": false
      },
      {
       "cyr": "Над Крушево и Прилеп",
       "lat": "Nad Kruševo i Prilep",
       "en": "Over Kruševo and Prilep",
       "en_mt": false
      },
      {
       "cyr": "и над Битола.",
       "lat": "i nad Bitola.",
       "en": "and over Bitola.",
       "en_mt": false
      }
     ]
    },
