   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Си заљуби Џефа од Долна Река",
       "lat": "Si zaljubi Džefa od Dolna Reka",
       "en": "They fell in love with Dzhefa from Dolna Reka,"
      },
      {
       "cyr": "двајца браќа, два близнака,",
       "lat": "dvajca braḱa, dva bliznaka,",
       "en": "two brothers, two twins,"
      },
      {
       "cyr": "еден Мевмет, други Асан.",
       "lat": "eden Mevmet, drugi Asan.",
       "en": "one Mevmet, the other Asan."
      },
      {
       "cyr": "Ја побара постариот,",
       "lat": "Ja pobara postariot,",
       "en": "The elder asked for her,"
      },
      {
       "cyr": "ја дадоа на помалиот,",
       "lat": "ja dadoa na pomaliot,",
       "en": "they gave her to the younger,"
      },
      {
       "cyr": "одма Асан, џанам, болен легна.",
       "lat": "odma Asan, džanam, bolen legna.",
       "en": "right away Asan, my soul, lay down sick."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Лежа што ми лежа девет години,",
       "lat": "Leža što mi leža devet godini,",
       "en": "He lay for nine years,"
      },
      {
       "cyr": "ми искина девет постели,",
       "lat": "mi iskina devet posteli,",
       "en": "he wore out nine beds,"
      },
      {
       "cyr": "ми искина девет перници,",
       "lat": "mi iskina devet pernici,",
       "en": "he wore out nine pillows,"
      },
      {
       "cyr": "болен ми е, севда голема,",
       "lat": "bolen mi e, sevda golema,",
       "en": "he is sick, great longing,"
      },
      {
       "cyr": "тешка болест, не се лекува,",
       "lat": "teška bolest, ne se lekuva,",
       "en": "heavy illness, it cannot be cured,"
      },
      {
       "cyr": "нит умира Асан, нит станува.",
       "lat": "nit umira Asan, nit stanuva.",
       "en": "Asan neither dies nor gets up."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Па ѝ рече Асан на мајка си:",
       "lat": "Pa ì reče Asan na majka si:",
       "en": "Then Asan said to his mother:"
      },
      {
       "cyr": "- Ја појди си кај Мевмета",
       "lat": "- Ja pojdi si kaj Mevmeta",
       "en": "- Go yourself to Mevmet"
      },
      {
       "cyr": "и речи му да ја пушти,",
       "lat": "i reči mu da ja pušti,",
       "en": "and tell him to let her go,"
      },
      {
       "cyr": "да ја пушти лична Џефа",
       "lat": "da ja pušti lična Džefa",
       "en": "to let go the fair Dzhefa"
      },
      {
       "cyr": "да ми баци десна рака,",
       "lat": "da mi baci desna raka,",
       "en": "to lay her right hand on me,"
      },
      {
       "cyr": "ил' да умрам, море, ил' да станам.",
       "lat": "il' da umram, more, il' da stanam.",
       "en": "so I either die, hey, or get up."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Си послуша Џефа девера си,",
       "lat": "Si posluša Džefa devera si,",
       "en": "Dzhefa obeyed her brother-in-law,"
      },
      {
       "cyr": "си облече бело руво,",
       "lat": "si obleče belo ruvo,",
       "en": "she put on white clothes,"
      },
      {
       "cyr": "бело руво, жолти чевли,",
       "lat": "belo ruvo, žolti čevli,",
       "en": "white clothes, yellow shoes,"
      },
      {
       "cyr": "па си појде кај Асана,",
       "lat": "pa si pojde kaj Asana,",
       "en": "and went to Asan,"
      },
      {
       "cyr": "и му баци десна рака,",
       "lat": "i mu baci desna raka,",
       "en": "and laid her right hand on him,"
      },
      {
       "cyr": "одма Асан, џанам, душа даде.",
       "lat": "odma Asan, džanam, duša dade.",
       "en": "right away Asan, my soul, gave up his soul."
      }
     ]
