   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Величко, скопски војвода",
       "lat": "Veličko, skopski vojvoda",
       "en": "Velichko, the voivoda (captain) from Skopje"
      },
      {
       "cyr": "ноќеска гора оставил,",
       "lat": "noḱeska gora ostavil,",
       "en": "left the forest tonight,"
      },
      {
       "cyr": "решил при мајка да оди,",
       "lat": "rešil pri majka da odi,",
       "en": "decided to go to his mother,"
      },
      {
       "cyr": "силна го тага фанала.",
       "lat": "silna go taga fanala.",
       "en": "for he feels deep sorrow."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Куќа сум мајко отворил,",
       "lat": "Kuḱa sum majko otvoril,",
       "en": "I opened a house, mother,"
      },
      {
       "cyr": "у тие горски пештери,",
       "lat": "u tie gorski pešteri,",
       "en": "in those forest caves,"
      },
      {
       "cyr": "а од тебе кријам одамна,",
       "lat": "a od tebe krijam odamna,",
       "en": "and I am not telling you for a long time"
      },
      {
       "cyr": "у тија борби крвави.",
       "lat": "u tija borbi krvavi.",
       "en": "about those bloody battles."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проштевај мајко, не жалај,",
       "lat": "Proštevaj majko, ne žalaj,",
       "en": "Forgive me, mother,"
      },
      {
       "cyr": "збогум за навек од мене.",
       "lat": "zbogum za navek od mene.",
       "en": "goodbye forever from me."
      },
      {
       "cyr": "Не можам, мајко комитска,",
       "lat": "Ne možam, majko komitska,",
       "en": "I cannot, mother of komita (warrior)"
      },
      {
       "cyr": "в' ропство да трпам крваво,",
       "lat": "v' ropstvo da trpam krvavo,",
       "en": "take to this bloody slavery,"
      },
      {
       "cyr": "ни да го гледам народот",
       "lat": "ni da go gledam narodot",
       "en": "or see the people"
      },
      {
       "cyr": "како се сруши на нозе.",
       "lat": "kako se sruši na noze.",
       "en": "brought down to their knees."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Когај да влезе наближил,",
       "lat": "Kogaj da vleze nabližil,",
       "en": "When he came close"
      },
      {
       "cyr": "у тоа село Црешево,",
       "lat": "u toa selo Creševo,",
       "en": "to the village Creshevo,"
      },
      {
       "cyr": "наеднаш пушки згрмеа",
       "lat": "naednaš puški zgrmea",
       "en": "suddenly rifles started a thunder"
      },
      {
       "cyr": "од сите страни на него.",
       "lat": "od site strani na nego.",
       "en": "from all directions toward him."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Извади бомби од појас,",
       "lat": "Izvadi bombi od pojas,",
       "en": "He took bombs from his belt,"
      },
      {
       "cyr": "разигра срце јуначко",
       "lat": "razigra srce junačko",
       "en": "his heroic heart started to beat faster"
      },
      {
       "cyr": "кога ми леле пукнаа",
       "lat": "koga mi lele puknaa",
       "en": "and when they detonated,"
      },
      {
       "cyr": "цела се земја потресе.",
       "lat": "cela se zemja potrese.",
       "en": "the ground started to shake."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проштевај мајко, не жалај,",
       "lat": "Proštevaj majko, ne žalaj,",
       "en": "Forgive me, mother,"
      },
      {
       "cyr": "збогум за навек од мене.",
       "lat": "zbogum za navek od mene.",
       "en": "goodbye forever from me."
      },
      {
       "cyr": "Не можам, мајко комитска,",
       "lat": "Ne možam, majko komitska,",
       "en": "I can't, mother of komita"
      },
      {
       "cyr": "в' ропство да трпам крваво,",
       "lat": "v' ropstvo da trpam krvavo,",
       "en": "take to this bloody slavery,"
      },
      {
       "cyr": "ни да го гледам народот",
       "lat": "ni da go gledam narodot",
       "en": "or see the people"
      },
      {
       "cyr": "како се сруши на нозе.",
       "lat": "kako se sruši na noze.",
       "en": "brought down to their knees."
      }
     ]
    }
   ]
