   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Не плачете стари мајки",
       "lat": "Ne plačete stari majki",
       "en": "Do not weep, old mothers,"
      },
      {
       "cyr": "доста е живот,",
       "lat": "dosta e život,",
       "en": "life is enough,"
      },
      {
       "cyr": "? клети тиран,",
       "lat": "? kleti tiran,",
       "en": "? cursed tyrant,"
      },
      {
       "cyr": "нас да нè мачи.",
       "lat": "nas da nè mači.",
       "en": "to torment us."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Спомнете ги браќа мили,",
       "lat": "Spomnete gi braḱa mili,",
       "en": "Remember them, dear brothers,"
      },
      {
       "cyr": "наш'те другари:",
       "lat": "naš'te drugari:",
       "en": "our comrades:"
      },
      {
       "cyr": "Гоце Делчев, Питу Гуле,",
       "lat": "Goce Delčev, Pitu Gule,",
       "en": "Goce Delchev, Pitu Guli,"
      },
      {
       "cyr": "Јане Сандански.",
       "lat": "Jane Sandanski.",
       "en": "Jane Sandanski."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите тие за слобода",
       "lat": "Site tie za sloboda",
       "en": "All of them for freedom"
      },
      {
       "cyr": "гордо паднаа,",
       "lat": "gordo padnaa,",
       "en": "fell proudly,"
      },
      {
       "cyr": "сè за тебе, сите ние",
       "lat": "sè za tebe, site nie",
       "en": "all for you, all of us"
      },
      {
       "cyr": "по нив да одиме.",
       "lat": "po niv da odime.",
       "en": "to follow them."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сите што се партизани,",
       "lat": "Site što se partizani,",
       "en": "All who are partisans,"
      },
      {
       "cyr": "смели се борци,",
       "lat": "smeli se borci,",
       "en": "they are brave fighters,"
      },
      {
       "cyr": "нив не им е жал да умрат",
       "lat": "niv ne im e žal da umrat",
       "en": "they do not regret dying"
      },
      {
       "cyr": "в' бој за слобода.",
       "lat": "v' boj za sloboda.",
       "en": "in battle for freedom."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "По затвори и темници",
       "lat": "Po zatvori i temnici",
       "en": "In prisons and dungeons"
      },
      {
       "cyr": "млади изгинаја,",
       "lat": "mladi izginaja,",
       "en": "the young perished,"
      },
      {
       "cyr": "ќе изградат живот, мила,",
       "lat": "ḱe izgradat život, mila,",
       "en": "they will build a life, my dear,"
      },
      {
       "cyr": "живот, слободна.",
       "lat": "život, slobodna.",
       "en": "a life, free."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Излегоја партизани",
       "lat": "Izlegoja partizani",
       "en": "Partisans came out"
      },
      {
       "cyr": "горе в' планина,",
       "lat": "gore v' planina,",
       "en": "up into the mountain,"
      },
      {
       "cyr": "да се борат за слобода",
       "lat": "da se borat za sloboda",
       "en": "to fight for freedom"
      },
      {
       "cyr": "и за правдина.",
       "lat": "i za pravdina.",
       "en": "and for justice."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Македонските синови,",
       "lat": "Makedonskite sinovi,",
       "en": "The Macedonian sons,"
      },
      {
       "cyr": "сегде се напред,",
       "lat": "segde se napred,",
       "en": "everywhere forward,"
      },
      {
       "cyr": "по планини, по полиња,",
       "lat": "po planini, po polinja,",
       "en": "through mountains, through fields,"
      },
      {
       "cyr": "и по градови.",
       "lat": "i po gradovi.",
       "en": "and through towns."
      }
     ]
    }
   ]
  }
