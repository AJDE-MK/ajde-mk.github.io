   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Стојне, млада меанџико, ле,",
       "lat": "Stojne, mlada meandžiko, le,",
       "en": "Stojna, young innkeeper,"
      },
      {
       "cyr": "сипи вино да пиеме,",
       "lat": "sipi vino da pieme,",
       "en": "pour me wine to drink,"
      },
      {
       "cyr": "ели вино, ели вода.",
       "lat": "eli vino, eli voda.",
       "en": "either wine, or water."
      },
      {
       "cyr": "Ели вино, ели вода, ле",
       "lat": "Eli vino, eli voda, le",
       "en": "Either wine, or water,"
      },
      {
       "cyr": "ели кажи да си ода,",
       "lat": "eli kaži da si oda,",
       "en": "or tell me to leave,"
      },
      {
       "cyr": "да не вија темнините.",
       "lat": "da ne vija temninite.",
       "en": "so that I won't get into the dark."
      }
     ]
    },
