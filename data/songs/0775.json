    {
     "lines": [
      {
       "cyr": "Се посврши азган Мара,",
       "lat": "Se posvrši azgan Mara,",
       "en": "Defiant Mara got engaged to be married,"
      },
      {
       "cyr": "азган Мара, мераклика,",
       "lat": "azgan Mara, meraklika,",
       "en": "defiant Mara, who liked men,"
      },
      {
       "cyr": "во сабота се омажи,",
       "lat": "vo sabota se omaži,",
       "en": "on Saturday she got married,"
      },
      {
       "cyr": "во недела се развела.",
       "lat": "vo nedela se razvela.",
       "en": "on Sunday she got devorced."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја качиле на магаре,",
       "lat": "Ja kačile na magare,",
       "en": "They put her on a donkey,"
      },
      {
       "cyr": "ја седнале наопаку:",
       "lat": "ja sednale naopaku:",
       "en": "they faced her backwards:"
      },
      {
       "cyr": "- Држ' се Маро за магарето,",
       "lat": "- Drž' se Maro za magareto,",
       "en": "- Hold on, Mara, to the donkey,"
      },
      {
       "cyr": "држ' се Маро за опашката.",
       "lat": "drž' se Maro za opaškata.",
       "en": "hold on to its tail."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се собрале селаните",
       "lat": "Se sobrale selanite",
       "en": "All the villagers gathered"
      },
      {
       "cyr": "да ја видат азган Мара,",
       "lat": "da ja vidat azgan Mara,",
       "en": "to see defiant Mara,"
      },
      {
       "cyr": "азган Мара, мераклика,",
       "lat": "azgan Mara, meraklika,",
       "en": "defiant Mara who liked men,"
      },
      {
       "cyr": "какво чудо направила.",
       "lat": "kakvo čudo napravila.",
       "en": "what a miracle she performed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се породи машко дете,",
       "lat": "Se porodi maško dete,",
       "en": "She gave birth to a male child,"
      },
      {
       "cyr": "па не знае од кого е",
       "lat": "pa ne znae od kogo e",
       "en": "and she does not know who is his father,"
      },
      {
       "cyr": "дал од попот, ил' од падарот,",
       "lat": "dal od popot, il' od padarot,",
       "en": "is it the priest, or the field guard,"
      },
      {
       "cyr": "или некој од друго село.",
       "lat": "ili nekoj od drugo selo.",
       "en": "or someone else from the village."
      }
     ]
