   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "И три години станаа",
       "lat": "I tri godini stanaa",
       "en": "And three years have passed"
      },
      {
       "cyr": "откако болен лежав,",
       "lat": "otkako bolen ležav,",
       "en": "since I lay sick,"
      },
      {
       "cyr": "и никој не се решават",
       "lat": "i nikoj ne se rešavat",
       "en": "and no one dares"
      },
      {
       "cyr": "кај мене да дојдит.",
       "lat": "kaj mene da dojdit.",
       "en": "to come to me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Само еднаш се реши",
       "lat": "Samo ednaš se reši",
       "en": "Only once she resolved,"
      },
      {
       "cyr": "моето верно либе",
       "lat": "moeto verno libe",
       "en": "my faithful love,"
      },
      {
       "cyr": "тоа кај мене да дојдит,",
       "lat": "toa kaj mene da dojdit,",
       "en": "to come to me,"
      },
      {
       "cyr": "и прочка да земит.",
       "lat": "i pročka da zemit.",
       "en": "and take her leave."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "О, гори не зеленејте",
       "lat": "O, gori ne zelenejte",
       "en": "Oh, green forests, do not turn green"
      },
      {
       "cyr": "и птици не пејте,",
       "lat": "i ptici ne pejte,",
       "en": "and birds, do not sing,"
      },
      {
       "cyr": "љубовта ме напуштат",
       "lat": "ljubovta me napuštat",
       "en": "love is leaving me"
      },
      {
       "cyr": "и скоро ќе умрам.",
       "lat": "i skoro ḱe umram.",
       "en": "and soon I will die."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И венец направете",
       "lat": "I venec napravete",
       "en": "And make a wreath"
      },
      {
       "cyr": "од мајски цвеќиња,",
       "lat": "od majski cveḱinja,",
       "en": "of May flowers,"
      },
      {
       "cyr": "дајте го на другарите",
       "lat": "dajte go na drugarite",
       "en": "give it to my comrades"
      },
      {
       "cyr": "да ми го донесат.",
       "lat": "da mi go donesat.",
       "en": "to bring it to me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да можам ангел да станам,",
       "lat": "Da možam angel da stanam,",
       "en": "If only I could become an angel,"
      },
      {
       "cyr": "по небо да шетам,",
       "lat": "po nebo da šetam,",
       "en": "to wander across the sky,"
      },
      {
       "cyr": "да видам кој ќе те љуби",
       "lat": "da vidam koj ḱe te ljubi",
       "en": "to see who will love you"
      },
      {
       "cyr": "и душа да му земам.",
       "lat": "i duša da mu zemam.",
       "en": "and take his soul."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И сè се заборават,",
       "lat": "I sè se zaboravat,",
       "en": "And everything is forgotten,"
      },
      {
       "cyr": "и имот и богатство,",
       "lat": "i imot i bogatstvo,",
       "en": "both property and wealth,"
      },
      {
       "cyr": "само не се заборават",
       "lat": "samo ne se zaboravat",
       "en": "only one thing is not forgotten,"
      },
      {
       "cyr": "љубовта искрена.",
       "lat": "ljubovta iskrena.",
       "en": "sincere love."
      }
     ]
    }
   ]
  }
 ],
