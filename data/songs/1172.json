      {
       "cyr": "и на гората збореше:",
       "lat": "i na gorata zboreše:",
       "en": "and spoke to the forest:"
      },
      {
       "cyr": "- Горо ле, горо зелена,",
       "lat": "- Goro le, goro zelena,",
       "en": "- Forest, hey green forest,"
      },
      {
       "cyr": "горо ле, горо убава,",
       "lat": "goro le, goro ubava,",
       "en": "forest, hey lovely forest,"
      },
      {
       "cyr": "мина ли горо низ тебе",
       "lat": "mina li goro niz tebe",
       "en": "has he passed through you,"
      },
      {
       "cyr": "млад Гоце Делчев војвода?",
       "lat": "mlad Goce Delčev vojvoda?",
       "en": "young Goce Delchev the voivode?"
      }
