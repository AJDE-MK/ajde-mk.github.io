   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Лилјано моме, Лилјано,",
       "lat": "- Liljano mome, Liljano,",
       "en": "- Liljana, girl, Liljana,"
      },
      {
       "cyr": "ја стани рано, пред зори,",
       "lat": "ja stani rano, pred zori,",
       "en": "get up early, before the dawn,"
      },
      {
       "cyr": "ја стани рано, пред зори,",
       "lat": "ja stani rano, pred zori,",
       "en": "get up early, before the dawn,"
      },
      {
       "cyr": "либето си прегрни.",
       "lat": "libeto si pregrni.",
       "en": "give your love a hug."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Не ми излегла Лилјана,",
       "lat": "Ne mi izlegla Liljana,",
       "en": "Liljana doesn't come out,"
      },
      {
       "cyr": "тук' е излегла мајка ѝ,",
       "lat": "tuk' e izlegla majka ì,",
       "en": "instead, her mother comes,"
      },
      {
       "cyr": "лути си клетви колнеше",
       "lat": "luti si kletvi kolneše",
       "en": "she curses bitterly"
      },
      {
       "cyr": "и на Ѓорѓи думаше:",
       "lat": "i na Ǵorǵi dumaše:",
       "en": "and says to Gjorgji:"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Иди си, Ѓорѓи, иди си,",
       "lat": "- Idi si, Ǵorǵi, idi si,",
       "en": "- Go away, Gjorgji, go away,"
      },
      {
       "cyr": "Лилјана болна легнала,",
       "lat": "Liljana bolna legnala,",
       "en": "Liljana is lying ill,"
      },
      {
       "cyr": "Лилјана болна легнала",
       "lat": "Liljana bolna legnala",
       "en": "Liljana is lying ill"
      },
      {
       "cyr": "и не може да стане.",
       "lat": "i ne može da stane.",
       "en": "and she cannot even stand up."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Не ми го лажи, мамо ма,",
       "lat": "- Ne mi go laži, mamo ma,",
       "en": "- Don't lie to him, mother,"
      },
      {
       "cyr": "јас сум си Ѓорѓи љубила,",
       "lat": "jas sum si Ǵorǵi ljubila,",
       "en": "I love Gjorgji,"
      },
      {
       "cyr": "јас сум си Ѓорѓи љубила,",
       "lat": "jas sum si Ǵorǵi ljubila,",
       "en": "I love Gjorgji"
      },
      {
       "cyr": "за него ќе се посвршам.",
