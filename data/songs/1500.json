   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Иде моме џанам од бањата,",
       "lat": "Ide mome džanam od banjata,",
       "en": "A girl is coming, dear, from the bathhouse,"
      },
      {
       "cyr": "измиено џанам, исчешлано.",
       "lat": "izmieno džanam, isčešlano.",
       "en": "washed, dear, and combed."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Руси коси џанам по рамена,",
       "lat": "Rusi kosi džanam po ramena,",
       "en": "Her fair hair, dear, over her shoulders,"
      },
      {
       "cyr": "ситно и дробно џанам заплетено.",
       "lat": "sitno i drobno džanam zapleteno.",
       "en": "finely and thickly, dear, braided."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Сретна лудо џанам рудо јагне,",
       "lat": "Sretna ludo džanam rudo jagne,",
       "en": "She met a lad, dear, a fleecy lamb,"
      },
      {
       "cyr": "не знаеше џанам да го јаде.",
       "lat": "ne znaeše džanam da go jade.",
       "en": "he did not know, dear, how to eat it."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Си го пушти џанам во планина,",
       "lat": "Si go pušti džanam vo planina,",
       "en": "She let it go, dear, into the mountain,"
      },
      {
       "cyr": "да си пасе џанам детелина.",
       "lat": "da si pase džanam detelina.",
       "en": "to graze, dear, on clover."
      }
     ]
    }
   ]
  }
