   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Македонски ергени,",
       "lat": "Makedonski ergeni,",
       "en": "Macedonian bachelors,"
      },
      {
       "cyr": "сите лични мажи,",
       "lat": "site lični maži,",
       "en": "all handsome men,"
      },
      {
       "cyr": "да го прашаш сиот свет,",
       "lat": "da go prašaš siot svet,",
       "en": "ask the whole world,"
      },
      {
       "cyr": "исто ќе ти кажи.",
       "lat": "isto ḱe ti kaži.",
       "en": "it will tell you the same."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ве раѓа мајка Македонија,",
       "lat": "Ve raǵa majka Makedonija,",
       "en": "Mother Macedonia bore you,"
      },
      {
       "cyr": "од Охрид, Пирин,",
       "lat": "od Ohrid, Pirin,",
       "en": "from Ohrid, Pirin,"
      },
      {
       "cyr": "дур' до Солуна.",
       "lat": "dur' do Soluna.",
       "en": "all the way to Salonica."
      },
      {
       "cyr": "А таа мајка раѓа јунаци,",
       "lat": "A taa majka raǵa junaci,",
       "en": "And that mother bears heroes,"
      },
      {
       "cyr": "јунаци, чиста крв Македонци.",
       "lat": "junaci, čista krv Makedonci.",
       "en": "heroes, pure Macedonian blood."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Машка снага имате,",
       "lat": "Maška snaga imate,",
       "en": "You have a man's strength,"
      },
      {
       "cyr": "како мермер планина,",
       "lat": "kako mermer planina,",
       "en": "like a marble mountain,"
      },
      {
       "cyr": "очи бистри езера,",
       "lat": "oči bistri ezera,",
       "en": "eyes like clear lakes,"
      },
      {
       "cyr": "лице - цветна долина.",
       "lat": "lice - cvetna dolina.",
       "en": "a face like a flowery valley."
      }
     ]
    },
