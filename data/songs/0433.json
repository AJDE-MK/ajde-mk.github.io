 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мајка на Марика думаше:",
       "lat": "Majka na Marika dumaše:",
       "en": "Mother says to Marika"
      },
      {
       "cyr": "- Марике, ќерко Марике,",
       "lat": "- Marike, ḱerko Marike,",
       "en": "Marike, daughter Marike"
      },
      {
       "cyr": "земи го ќерко Ѓорѓија,",
       "lat": "zemi go ḱerko Ǵorǵija,",
       "en": "go marry Gjorgji,"
      },
      {
       "cyr": "Ѓорѓија први бекрија.",
       "lat": "Ǵorǵija prvi bekrija.",
       "en": "Gjorgji, the first (biggest) drunkard."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Нејќум го мајко Ѓорѓија,",
       "lat": "- Nejḱum go majko Ǵorǵija,",
       "en": "I don't want, mother, Gjorgji"
      },
      {
       "cyr": "Ѓорѓија први бекрија.",
       "lat": "Ǵorǵija prvi bekrija.",
       "en": "Gjorgji, the biggest drunkard."
      },
      {
       "cyr": "Девет си жени погубил,",
       "lat": "Devet si ženi pogubil,",
       "en": "Nine women he teased"
      },
      {
       "cyr": "јас ќе сум мајко десетта.",
       "lat": "jas ḱe sum majko desetta.",
       "en": "And I will be, mother, the tenth."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Послуша Марика мајка си",
       "lat": "Posluša Marika majka si",
       "en": "Marika listens to her mother,"
      },
      {
       "cyr": "зеде го Ѓорѓи бекрија.",
       "lat": "zede go Ǵorǵi bekrija.",
       "en": "Marries Gjorgji the drunkard."
      },
      {
       "cyr": "Ѓорѓи на Марика думаше:",
       "lat": "Ǵorǵi na Marika dumaše:",
       "en": "Gjorgji says to Marika:"
      },
      {
       "cyr": "- Марике, либе Марике.",
       "lat": "- Marike, libe Marike.",
       "en": "Marike, dear Marike."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нова се крчма отвора",
       "lat": "Nova se krčma otvora",
       "en": "A new pub is opening,"
      },
      {
       "cyr": "мене ме канат да идам.",
       "lat": "mene me kanat da idam.",
       "en": "I am invited to come."
      },
      {
       "cyr": "Сефтето да им направам,",
       "lat": "Sefteto da im napravam,",
       "en": "To be their first customer,"
      },
      {
       "cyr": "фирмата да им напишам.",
       "lat": "firmata da im napišam.",
       "en": "To write the pub's name above the door."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ене го Ѓорѓи кај иде,",
       "lat": "Ene go Ǵorǵi kaj ide,",
       "en": "Here Gjorgji comes walking"
      },
      {
       "cyr": "девет му зурли свиреа,",
       "lat": "devet mu zurli svirea,",
       "en": "Nine zurlas are playing for him."
      },
      {
       "cyr": "девет му зурли свиреа,",
       "lat": "devet mu zurli svirea,",
       "en": "Nine zurlas are playing for him"
      },
      {
       "cyr": "десет тапани чукаа.",
       "lat": "deset tapani čukaa.",
       "en": "Ten tapans (drums) are beating for him."
      }
     ]
    }
   ]
  }
 ],
