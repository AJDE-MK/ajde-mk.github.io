    {
     "lines": [
      {
       "cyr": "Една мома калеша,",
       "lat": "Edna moma kaleša,",
       "en": "One girl, a kaleša,"
      },
      {
       "cyr": "што ја сретнав в' младоста,",
       "lat": "što ja sretnav v' mladosta,",
       "en": "whom I met in my youth,"
      },
      {
       "cyr": "уште не ме остава,",
       "lat": "ušte ne me ostava,",
       "en": "still does not leave me,"
      },
      {
       "cyr": "да ја сетам радоста.",
       "lat": "da ja setam radosta.",
       "en": "so that I recall the joy."
      }
     ]
    },
    {
     "lines": [
