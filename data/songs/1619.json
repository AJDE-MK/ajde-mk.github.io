   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Донка се в' гора изгуби, леле",
       "lat": "Donka se v' gora izgubi, lele",
       "en": "Donka got lost in the mountains, oh"
      },
      {
       "cyr": "там' најде младо овчарче.",
       "lat": "tam' najde mlado ovčarče.",
       "en": "there he found a young shepherd."
      },
      {
       "cyr": "Овчарче вели, говори, леле:",
       "lat": "Ovčarče veli, govori, lele:",
       "en": "Shepherd says, speaks, oh:"
      },
      {
       "cyr": "- Дај Донке да те пољубам.",
       "lat": "- Daj Donke da te poljubam.",
       "en": "- Donka, let me kiss you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- А бре овчарче, будалче леле,",
       "lat": "- A bre ovčarče, budalče lele,",
       "en": "- Come on, little shepherd, you fool, oh,"
      },
      {
       "cyr": "тука се мома не љуби.",
       "lat": "tuka se moma ne ljubi.",
       "en": "this is no place to kiss a girl."
      },
      {
       "cyr": "Ај д' идем' доле во коле леле,",
       "lat": "Aj d' idem' dole vo kole lele,",
       "en": "Let's go down to the carriage, oh,"
      },
      {
       "cyr": "да ти дам да ме пољубиш.",
       "lat": "da ti dam da me poljubiš.",
       "en": "there I will let you kiss me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ојдоја доле во коле, леле,",
       "lat": "Ojdoja dole vo kole, lele,",
       "en": "They went down in the carriage, oh,"
      },
      {
       "cyr": "Донка му вели, говори:",
       "lat": "Donka mu veli, govori:",
       "en": "Donka tells him, speaks:"
      },
      {
       "cyr": "- Ај д' идем' дома во двори, леле,",
       "lat": "- Aj d' idem' doma vo dvori, lele,",
       "en": "- Let's go home, in our courtyard, oh,"
      },
      {
       "cyr": "там ќе дам да ме пољубиш.",
       "lat": "tam ḱe dam da me poljubiš.",
       "en": "I will let you kiss me there."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ојдоа дома во двори, леле,",
       "lat": "Ojdoa doma vo dvori, lele,",
       "en": "They went home to the courtyards, oh,"
      },
      {
       "cyr": "Донка се викна, провикна:",
       "lat": "Donka se vikna, provikna:",
       "en": "Donka shouted, shouted:"
      },
      {
       "cyr": "- Излези мале да видиш, леле,",
       "lat": "- Izlezi male da vidiš, lele,",
       "en": "- Come out and see, oh,"
      },
      {
       "cyr": "какво будалче ти водам!",
       "lat": "kakvo budalče ti vodam!",
       "en": "what a fool I am bringing with me!"
      }
     ]
    }
   ]
  }
