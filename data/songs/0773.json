   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Денеска петок, сабота,",
       "lat": "Deneska petok, sabota,",
       "en": "Today is Friday, Saturday,"
      },
      {
       "cyr": "утре е света недела.",
       "lat": "utre e sveta nedela.",
       "en": "tomorrow is holy Sunday."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Марко војвода пристигна",
       "lat": "Marko vojvoda pristigna",
       "en": "Voivode Marko arrived"
      },
      {
       "cyr": "во това село Панделе.",
       "lat": "vo tova selo Pandele.",
       "en": "in this village of Pandele."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проклети биле шпиони,",
       "lat": "Prokleti bile špioni,",
       "en": "Cursed be the spies,"
      },
      {
       "cyr": "Марка војвода предадоо.",
       "lat": "Marka vojvoda predadoo.",
       "en": "they betrayed Voivode Marko."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Надојдоо турски табори,",
       "lat": "Nadojdoo turski tabori,",
       "en": "Turkish camps came,"
      },
      {
       "cyr": "Марка војвода сардисаа.",
       "lat": "Marka vojvoda sardisaa.",
       "en": "they surrounded Voivode Marko."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зафати битка голема,",
       "lat": "Zafati bitka golema,",
       "en": "A great battle broke out,"
      },
      {
       "cyr": "Марко војвода загина.",
       "lat": "Marko vojvoda zagina.",
       "en": "Voivode Marko fell."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Проклети биле шпиони,",
       "lat": "Prokleti bile špioni,",
       "en": "Cursed be the spies"
      },
      {
       "cyr": "Марко шо го предадоо.",
