    },
    {
     "lines": [
      {
       "cyr": "Спомен домот што на врвот стои,",
       "lat": "Spomen domot što na vrvot stoi,",
       "en": "The memorial house stands at the top,",
       "en_mt": false
      },
      {
       "cyr": "изграден од борците херои,",
       "lat": "izgraden od borcite heroi,",
       "en": "built by the fighter heroes,",
       "en_mt": false
      },
      {
       "cyr": "горда биди наша мајко мила,",
       "lat": "gorda bidi naša majko mila,",
       "en": "be proud our dear mother",
       "en_mt": false
      },
      {
       "cyr": "синовите што си ги родила.",
       "lat": "sinovite što si gi rodila.",
       "en": "of the sons you gave birth to.",
       "en_mt": false
      },
      {
       "cyr": "Љупчо Сантов, Раде Кратовчето,",
       "lat": "Ljupčo Santov, Rade Kratovčeto,",
       "en": "Ljupcho Santov, Rade Kratovche",
       "en_mt": false
      },
      {
       "cyr": "животот го даде за знамето.",
       "lat": "životot go dade za znameto.",
       "en": "gave their lives for the flag.",
