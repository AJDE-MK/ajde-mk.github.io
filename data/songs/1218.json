      {
       "cyr": "Цвеќе цутеше, мале,",
       "lat": "Cveḱe cuteše, male,",
       "en": "Flowers were blooming, mother,"
      },
      {
       "cyr": "во наш'та градина,",
       "lat": "vo naš'ta gradina,",
       "en": "in our garden,"
      },
      {
       "cyr": "како да кандисам, мале,",
       "lat": "kako da kandisam, male,",
       "en": "I felt like, mother,"
      },
      {
       "cyr": "да го искинам.",
       "lat": "da go iskinam.",
       "en": "picking it."
      }
     ]
    },
    {
     "lines": [
      {
