   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Нели ти ми вети малој моме бре",
       "lat": "- Neli ti mi veti maloj mome bre",
       "en": "- Did you not promise me, little girl,"
      },
      {
       "cyr": "дека ќе се земиме?",
       "lat": "deka ḱe se zemime?",
       "en": "that we would marry?"
      },
      {
       "cyr": "- Море лудо младо, времето ти мина,",
       "lat": "- More ludo mlado, vremeto ti mina,",
       "en": "- You foolish young man, your time has passed,"
      },
      {
       "cyr": "нејќам да се мажам јас.",
       "lat": "nejḱam da se mažam jas.",
       "en": "I do not want to marry."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Врати ми, врати ми сè,",
       "lat": "Vrati mi, vrati mi sè,",
       "en": "Give back, give back everything,"
      },
      {
       "cyr": "сè што имаш од мене.",
       "lat": "sè što imaš od mene.",
       "en": "everything you have of mine."
      },
      {
       "cyr": "Врати ми ја младоста,",
       "lat": "Vrati mi ja mladosta,",
