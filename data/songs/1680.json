    {
     "lines": [
      {
       "cyr": "Леле да си моја,",
       "lat": "Lele da si moja,",
       "en": "Oh, if only you were mine,"
      },
      {
       "cyr": "што ќе ти направам,",
       "lat": "što ḱe ti napravam,",
       "en": "the things I’d do to you,"
      },
      {
       "cyr": "таа рамна снага",
       "lat": "taa ramna snaga",
       "en": "how I’d caress"
      },
      {
       "cyr": "како ќе ја галам.",
       "lat": "kako ḱe ja galam.",
       "en": "that slender, shapely form."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да излудуваш",
       "lat": "Da izluduvaš",
       "en": "Driving me wild"
      },
      {
       "cyr": "и насладуваш,",
       "lat": "i nasladuvaš,",
       "en": "and bringing such delight,"
      },
      {
       "cyr": "сè до зори, мила моја,",
       "lat": "sè do zori, mila moja,",
       "en": "until dawn breaks, my darling,"
      },
      {
       "cyr": "ти да лудуваш.",
       "lat": "ti da luduvaš.",
       "en": "lost in passion's sway."
      }
     ]
    },
