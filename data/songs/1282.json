      {
       "cyr": "Те сретнав либе, пресретнав,",
       "lat": "Te sretnav libe, presretnav,",
       "en": "I met you, love, I ran into you,"
      },
      {
       "cyr": "во тоа тесно сокаче,",
       "lat": "vo toa tesno sokače,",
       "en": "in that narrow little alley,"
      },
      {
       "cyr": "таму те либе запрашав:",
       "lat": "tamu te libe zaprašav:",
       "en": "there I asked you, love:"
      },
      {
       "cyr": "- Од кај почнува љубовта?",
       "lat": "- Od kaj počnuva ljubovta?",
       "en": "- Where does love begin?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Љубовта, либе, почнува",
       "lat": "- Ljubovta, libe, počnuva",
       "en": "- Love, dear, begins"
      },
      {
       "cyr": "најпрвин од очиве,",
       "lat": "najprvin od očive,",
       "en": "first with the eyes,"
      },
      {
       "cyr": "второ е од устето,",
       "lat": "vtoro e od usteto,",
       "en": "second with the lips,"
      },
      {
       "cyr": "а трето е од срцето.",
       "lat": "a treto e od srceto.",
       "en": "and third with the heart."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Те сретнав либе, пресретнав,",
       "lat": "Te sretnav libe, presretnav,",
       "en": "I met you, love, I ran into you,"
      },
      {
       "cyr": "грутка ми в' срце застана,",
       "lat": "grutka mi v' srce zastana,",
       "en": "a lump stopped in my heart,"
      },
      {
       "cyr": "тогаш те либе видов јас,",
       "lat": "togaš te libe vidov jas,",
       "en": "then I saw you, love,"
      },
      {
       "cyr": "со друго либе стоеше.",
       "lat": "so drugo libe stoeše.",
       "en": "you were standing with another love."
      }
     ]
    },
    {
     "lines": [
      {
