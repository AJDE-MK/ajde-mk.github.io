 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Солзи сами капат, прости ми",
       "lat": "Solzi sami kapat, prosti mi",
       "en": "Tears fall from my face, forgive me,"
      },
      {
       "cyr": "тешки се ко твојте планини",
       "lat": "teški se ko tvojte planini",
       "en": "each as heavy as your mountains."
      },
      {
       "cyr": "плаче срце од три страни",
       "lat": "plače srce od tri strani",
       "en": "For the heart cries on three sides,"
      },
      {
       "cyr": "што крвави многу години.",
       "lat": "što krvavi mnogu godini.",
       "en": "which has bled for so many years."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Е, е, е, еј, Македонијо,",
       "lat": "E, e, e, ej, Makedonijo,",
       "en": "Hey Macedonia,"
      },
      {
       "cyr": "ти си бисер балкански",
       "lat": "ti si biser balkanski",
       "en": "you are the pearl of the Balkans."
      },
      {
       "cyr": "сплоти Пирин, Егеј син",
       "lat": "sploti Pirin, Egej sin",
       "en": "Reunite Pirin, the blue Aegean,"
      },
      {
       "cyr": "со бистри води вардарски.",
       "lat": "so bistri vodi vardarski.",
       "en": "all with the clear Vardar waters."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Само една има вистина",
       "lat": "Samo edna ima vistina",
       "en": "There is only one truth,"
      },
      {
       "cyr": "има една Македонија",
       "lat": "ima edna Makedonija",
       "en": "there is only one Macedonia."
      },
      {
       "cyr": "делете ја, парчете ја",
       "lat": "delete ja, parčete ja",
       "en": "Divide her and tear her up,"
      },
      {
       "cyr": "пак ќе биде наша најмила.",
       "lat": "pak ḱe bide naša najmila.",
       "en": "she'll still be our beloved."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Е, е, е, еј, Македонијо,",
       "lat": "E, e, e, ej, Makedonijo,",
