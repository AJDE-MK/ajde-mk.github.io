   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Дење ми те гледам,",
       "lat": "Denje mi te gledam,",
       "en": "I see you during the day,"
      },
      {
       "cyr": "ноќе ми те сонвам.",
       "lat": "noḱe mi te sonvam.",
       "en": "I dream of you at night."
      },
      {
       "cyr": "Дење ми одиш близу до менека,",
       "lat": "Denje mi odiš blizu do meneka,",
       "en": "During the day you stay close to me,"
      },
      {
       "cyr": "близу до менека.",
       "lat": "blizu do meneka.",
       "en": "close to me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ноќе ми легнуваш",
       "lat": "Noḱe mi legnuvaš",
       "en": "At night you lay"
      },
      {
       "cyr": "на десната рака.",
       "lat": "na desnata raka.",
       "en": "on my right arm."
      },
      {
       "cyr": "На десната рака, на правата страна,",
       "lat": "Na desnata raka, na pravata strana,",
       "en": "On my right arm, on the faithful side,"
      },
      {
       "cyr": "на правата страна.",
       "lat": "na pravata strana.",
       "en": "the faithful side."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Се разбудил лудо,",
       "lat": "Se razbudil ludo,",
       "en": "When the lad woke up,"
      },
      {
       "cyr": "рака устарпнала.",
       "lat": "raka ustarpnala.",
       "en": "his arm had fallen flat."
      },
      {
       "cyr": "Рака устарпнала, мома избегала,",
       "lat": "Raka ustarpnala, moma izbegala,",
       "en": "His arm had fallen flat, the maiden escaped,"
      },
      {
       "cyr": "мома избегала.",
       "lat": "moma izbegala.",
       "en": "the maiden escaped."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "И на перничката",
       "lat": "I na perničkata",
       "en": "So to the pillow"
      },
      {
       "cyr": "веле, ем говоре:",
       "lat": "vele, em govore:",
       "en": "he spoke and said:"
      },
      {
       "cyr": "- Перничко душманко, камо ми момата,",
       "lat": "- Perničko dušmanko, kamo mi momata,",
       "en": "- Little pillow, my enemy, where is my girl,"
      },
      {
       "cyr": "камо ми момата?",
       "lat": "kamo mi momata?",
       "en": "where is my girl?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Чужда беше, лудо,",
       "lat": "- Čužda beše, ludo,",
       "en": "- She was not yours, young lad,"
      },
      {
       "cyr": "дома си отиде,",
       "lat": "doma si otide,",
       "en": "she left for home"
      },
      {
       "cyr": "при нејзина мајка, при нејниот татко,",
       "lat": "pri nejzina majka, pri nejniot tatko,",
       "en": "to be by her mom, to be by her father,"
      },
      {
       "cyr": "при нејниот татко.",
       "lat": "pri nejniot tatko.",
       "en": "to be by her father."
      }
     ]
    }
   ]
  }
 ],
