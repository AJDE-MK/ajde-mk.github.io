 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ордан седи на кулата,",
       "lat": "Ordan sedi na kulata,",
       "en": "Ordan sits on the tower,",
       "en_mt": false
      },
      {
       "cyr": "па ми гледа горе-долу.",
       "lat": "pa mi gleda gore-dolu.",
       "en": "keeping a look-out (looking up and down).",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ми догледал силен аскер,",
       "lat": "Mi dogledal silen asker,",
       "en": "He saw a big army,",
       "en_mt": false
      },
      {
       "cyr": "силен аскер, башибозук.",
       "lat": "silen asker, bašibozuk.",
       "en": "a big army, bashi-bazouk*.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Фрли бомба во селото,",
       "lat": "Frli bomba vo seloto,",
       "en": "He threw a bomb in the village,",
       "en_mt": false
      },
      {
       "cyr": "се затресе цело село.",
       "lat": "se zatrese celo selo.",
       "en": "which shook the whole village.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Извикнаа селаните:",
       "lat": "Izviknaa selanite:",
       "en": "The villagers exclaimed:",
       "en_mt": false
      },
      {
       "cyr": "- Што е ова од Ордана,",
       "lat": "- Što e ova od Ordana,",
       "en": "\"What is this from Ordan,",
       "en_mt": false
      },
      {
       "cyr": "од Јордана Пиперката?",
       "lat": "od Jordana Piperkata?",
       "en": "from Jordan Piperka?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ордан сабја не го сече,",
       "lat": "Ordan sabja ne go seče,",
       "en": "A saber can't cut Jordan,",
       "en_mt": false
      },
      {
       "cyr": "Јордан куршум не го дупи.",
       "lat": "Jordan kuršum ne go dupi.",
       "en": "a bullet can't kill Jordan.\"",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "// Во спомен на Јордан Пиперката.",
       "lat": "// Vo spomen na Jordan Piperkata.",
       "en": "// In memory of vojvoda Jordan Piperkata (1870 -1903).",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
 "pending_english": false
}