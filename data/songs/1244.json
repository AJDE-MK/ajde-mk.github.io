   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Ој, ела ми Фелиџе,",
       "lat": "- Oj, ela mi Felidže,",
       "en": "- Oh, come to me Felidzhe"
      },
      {
       "cyr": "на малото дуќанче.",
       "lat": "na maloto duḱanče.",
       "en": "to the small workshop."
      },
      {
       "cyr": "- Идам, не идам,",
       "lat": "- Idam, ne idam,",
       "en": "- I come, I don't come,"
      },
      {
       "cyr": "сама ќе дојдам.",
       "lat": "sama ḱe dojdam.",
       "en": "alone I'll come."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Кога дојдам, либе,",
