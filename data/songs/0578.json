 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Елено ќерко, Елено,",
       "lat": "Eleno ḱerko, Eleno,",
       "en": "Elena, my daughter, Elena,",
       "en_mt": false
      },
      {
       "cyr": "ти една на мајка,",
       "lat": "ti edna na majka,",
       "en": "you are my only child,",
       "en_mt": false
      },
      {
       "cyr": "што стоиш ќерко, што мислиш,",
       "lat": "što stoiš ḱerko, što misliš,",
       "en": "why are you distant, daughter, what are you thinking,",
       "en_mt": false
      },
      {
       "cyr": "што книга пишуваш?",
       "lat": "što kniga pišuvaš?",
       "en": "what are you writing?",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "На кого ќерко, на кого,",
       "lat": "Na kogo ḱerko, na kogo,",
       "en": "To whom, daughter, to whom,",
       "en_mt": false
      },
      {
       "cyr": "книга ќе испраќаш?",
       "lat": "kniga ḱe ispraḱaš?",
       "en": "will you send that letter?",
       "en_mt": false
      },
      {
       "cyr": "- Испраќам мајко, испраќам",
       "lat": "- Ispraḱam majko, ispraḱam",
       "en": "- I am sending it, mother,",
       "en_mt": false
      },
      {
       "cyr": "до градот Едрене.",
       "lat": "do gradot Edrene.",
       "en": "to the city of Edrene.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Едрене мајко, Едрене",
       "lat": "Edrene majko, Edrene",
       "en": "Edrene, mother, Edrene,",
       "en_mt": false
      },
      {
       "cyr": "на моето либе,",
       "lat": "na moeto libe,",
       "en": "to my love,",
       "en_mt": false
      },
      {
       "cyr": "да купи мајко, да купи",
       "lat": "da kupi majko, da kupi",
       "en": "to ask him to buy, mother,",
       "en_mt": false
      },
      {
       "cyr": "за мене капела.",
       "lat": "za mene kapela.",
       "en": "a hat for me.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Капела мајко, капела",
       "lat": "Kapela majko, kapela",
       "en": "A hat, mother, a hat,",
       "en_mt": false
      },
      {
       "cyr": "од триста гроша",
       "lat": "od trista groša",
       "en": "for 300 grosh,",
       "en_mt": false
      },
      {
       "cyr": "да носам мајко, да носам",
       "lat": "da nosam majko, da nosam",
       "en": "I'll wear it, mother, I'll wear it",
       "en_mt": false
      },
      {
       "cyr": "на ден за Илинден.",
       "lat": "na den za Ilinden.",
       "en": "on the day Ilinden.",
       "en_mt": false
      }
     ]
    }
   ]
  }
 ],
