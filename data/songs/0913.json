      {
       "cyr": "Мори моме, малој моме,",
       "lat": "Mori mome, maloj mome,",
       "en": "Hey girl, little girl,"
      },
      {
       "cyr": "каде вода да залеам?",
       "lat": "kade voda da zaleam?",
       "en": "where can I water the flowers?"
      },
      {
       "cyr": "- Море лудо, абре младо,",
       "lat": "- More ludo, abre mlado,",
       "en": "- Hey fool, hey young one,"
      },
      {
       "cyr": "таму долу, под селото.",
       "lat": "tamu dolu, pod seloto.",
       "en": "over there below the village."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму има два кладенца",
       "lat": "Tamu ima dva kladenca",
       "en": "There are two wells there"
      },
      {
       "cyr": "и над ними јаболчиња,",
       "lat": "i nad nimi jabolčinja,",
       "en": "and above them little apple trees,"
      },
      {
       "cyr": "јаболчиња род родиле,",
       "lat": "jabolčinja rod rodile,",
       "en": "the little apple trees bore fruit,"
      },
      {
       "cyr": "две јаболка позлатени.",
       "lat": "dve jabolka pozlateni.",
       "en": "two gilded apples."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Појди, лудо, откини ги,",
       "lat": "Pojdi, ludo, otkini gi,",
       "en": "Go, fool, pick them,"
      },
      {
       "cyr": "однеси кај кујунџии,",
       "lat": "odnesi kaj kujundžii,",
       "en": "take them to the goldsmiths,"
      },
      {
       "cyr": "да излеат два прстена,",
       "lat": "da izleat dva prstena,",
       "en": "to have two rings cast,"
      },
      {
       "cyr": "еден тебе, други мене.",
       "lat": "eden tebe, drugi mene.",
       "en": "one for you, the other for me."
      }
