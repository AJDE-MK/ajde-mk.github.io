   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Стојана мајка учеше:",
       "lat": "Stojana majka učeše:",
       "en": "Stojan's mother advised him:"
      },
      {
       "cyr": "- Стојане, сине Стојане,",
       "lat": "- Stojane, sine Stojane,",
       "en": "- Stojan, son Stojan,"
      },
      {
       "cyr": "не оди сине кумита.",
       "lat": "ne odi sine kumita.",
       "en": "don't go, son, to be a komita."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кумитлукот куќа не врти,",
       "lat": "Kumitlukot kuḱa ne vrti,",
       "en": "The komita life doesn't keep a household,"
      },
      {
       "cyr": "кумитлукот деца не гледа.",
       "lat": "kumitlukot deca ne gleda.",
       "en": "the komita life doesn't see children."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Стојан си мајка не слуша",
       "lat": "Stojan si majka ne sluša",
       "en": "Stojan does not listen to his mother,"
      },
      {
       "cyr": "нарами пушка на рамо,",
       "lat": "narami puška na ramo,",
       "en": "he slung his rifle on his shoulder,"
      },
      {
       "cyr": "замина Стојан в' планина.",
       "lat": "zamina Stojan v' planina.",
       "en": "Stojan set off into the mountain."
      }
     ]
    }
   ]
  }
