    {
     "lines": [
      {
       "cyr": "Топови грмат, земјата трештит,",
       "lat": "Topovi grmat, zemjata treštit,",
       "en": "The cannons thunder, the earth trembles,"
      },
      {
       "cyr": "славна Дебарца огон горит.",
       "lat": "slavna Debarca ogon gorit.",
       "en": "glorious Debarca burns with fire."
      },
      {
       "cyr": "Жените пиштат, децата плачат,",
       "lat": "Ženite pištat, decata plačat,",
       "en": "The women scream, the children cry,"
      },
      {
       "cyr": "моми се кријат во горите.",
       "lat": "momi se krijat vo gorite.",
       "en": "the girls hide in the forests."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од една страна партизаните,",
       "lat": "Od edna strana partizanite,",
       "en": "On one side the partisans,"
      },
      {
       "cyr": "од друга страна фашистите,",
       "lat": "od druga strana fašistite,",
       "en": "on the other side the fascists,"
      },
      {
       "cyr": "на срешта стои Петре Пирузе,",
       "lat": "na srešta stoi Petre Piruze,",
       "en": "opposite stands Petre Piruze,"
      },
      {
       "cyr": "верна дружина командува.",
       "lat": "verna družina komanduva.",
       "en": "he commands a loyal company."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Удрете браќа, не се боите,",
       "lat": "- Udrete braḱa, ne se boite,",
       "en": "- Strike, brothers, do not be afraid,"
      },
      {
       "cyr": "скоро ќе падне Германија!",
       "lat": "skoro ḱe padne Germanija!",
       "en": "Germany will soon fall!"
      }
