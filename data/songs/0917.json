   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Продават се, мале,",
       "lat": "Prodavat se, male,",
       "en": "The white monasteries"
      },
      {
       "cyr": "белите манастири",
       "lat": "belite manastiri",
       "en": "are up for sale,"
      },
      {
       "cyr": "белите манастири, милај мамо,",
       "lat": "belite manastiri, milaj mamo,",
       "en": "the white monasteries, dear mother,"
      },
      {
       "cyr": "црните калуѓерки.",
       "lat": "crnite kaluǵerki.",
       "en": "the black nuns."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Никој не се најде",
       "lat": "Nikoj ne se najde",
       "en": "There was none"
      },
      {
       "cyr": "манастир да купи,",
       "lat": "manastir da kupi,",
       "en": "to buy the monasteries,"
      },
      {
       "cyr": "ај, манастир да купи, милај мамо,",
       "lat": "aj, manastir da kupi, milaj mamo,",
       "en": "to buy the monasteries, dear mother,"
      },
      {
       "cyr": "чаршија да отвори.",
       "lat": "čaršija da otvori.",
       "en": "and build a street with stores."
      }
     ]
    },
    {
     "lines": [
      {
