   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Леле Јано, леле мила ќерко,",
       "lat": "Lele Jano, lele mila ḱerko,",
       "en": "Lele* Jana, lele dear daughter,"
      },
      {
       "cyr": "а што седиш везден на ѓерѓефот?",
       "lat": "a što sediš vezden na ǵerǵefot?",
       "en": "why are you sitting all day at that embroidery frame?"
      },
      {
       "cyr": "А што седиш везден на ѓерѓефот,",
       "lat": "A što sediš vezden na ǵerǵefot,",
       "en": "Why are you sitting all day at that embroidery frame,"
      },
      {
       "cyr": "а што везеш свилена марама?",
       "lat": "a što vezeš svilena marama?",
       "en": "what are you embroidering, a silk kerchief?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Леле мајко, леле стара мајко,",
       "lat": "Lele majko, lele stara majko,",
       "en": "Lele mother, lele old mother,"
      },
      {
       "cyr": "не си везам свилена марама.",
       "lat": "ne si vezam svilena marama.",
       "en": "I'm not embroidering a silk kerchief."
      },
      {
       "cyr": "Не си везам свилена марама,",
       "lat": "Ne si vezam svilena marama,",
       "en": "I'm not embroidering a silk kerchief,"
      },
      {
       "cyr": "тук си везам македонско знаме.",
       "lat": "tuk si vezam makedonsko zname.",
       "en": "but I'm embroidering a Macedonian flag."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да се сторам млада комита,",
       "lat": "Da se storam mlada komita,",
       "en": "I'll become a young Komitadji*,"
      },
      {
       "cyr": "да покријам млад Делчев војвода.",
       "lat": "da pokrijam mlad Delčev vojvoda.",
       "en": "so that I can cover young Delchev Vojvoda*."
      },
      {
       "cyr": "Да покријам Делчев војвода,",
       "lat": "Da pokrijam Delčev vojvoda,",
       "en": "To cover Delchev Vojvoda,"
      },
      {
       "cyr": "тој загина за Македонија,",
       "lat": "toj zagina za Makedonija,",
       "en": "he died for Macedonia,"
      },
      {
       "cyr": "за Македонија.",
       "lat": "za Makedonija.",
       "en": "for Macedonia."
      }
     ]
    }
   ]
  }
 ],
