   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Три години јас те чекам",
       "lat": "- Tri godini jas te čekam",
       "en": "- Three years I have waited for you"
      },
      {
       "cyr": "да пораснеш, да те земам.",
       "lat": "da porasneš, da te zemam.",
       "en": "for you to grow up, for me to take you."
      },
      {
       "cyr": "- Ах море либе, брзо дојди,",
       "lat": "- Ah more libe, brzo dojdi,",
       "en": "- Ah, my love, come quickly,"
      },
      {
       "cyr": "болна лежам за тебе.",
       "lat": "bolna ležam za tebe.",
       "en": "I lie sick for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Ако дојдам да те сакам,",
       "lat": "- Ako dojdam da te sakam,",
       "en": "- If I come to court you,"
      },
      {
       "cyr": "твојот татко не те дава.",
       "lat": "tvojot tatko ne te dava.",
       "en": "your father will not give you."
      },
      {
       "cyr": "- Ах море либе, брзо дојди,",
       "lat": "- Ah more libe, brzo dojdi,",
       "en": "- Ah, my love, come quickly,"
      },
      {
       "cyr": "јас ќе бегам бегалка.",
       "lat": "jas ḱe begam begalka.",
       "en": "I will run away."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кој што љуби, грев не чини,",
       "lat": "Koj što ljubi, grev ne čini,",
       "en": "Whoever loves does no sin,"
      },
      {
       "cyr": "тоа го знаат и старите.",
       "lat": "toa go znaat i starite.",
       "en": "even the old people know this."
      },
      {
       "cyr": "Затоа лудо не чекај,",
       "lat": "Zatoa ludo ne čekaj,",
       "en": "So do not wait foolishly,"
      },
      {
       "cyr": "испрати сватови.",
       "lat": "isprati svatovi.",
       "en": "send the wedding party."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Прстен купив, бурмајлија,",
       "lat": "- Prsten kupiv, burmajlija,",
       "en": "- I bought a ring, a wedding band,"
      },
      {
       "cyr": "утре идам да те сакам.",
       "lat": "utre idam da te sakam.",
       "en": "tomorrow I come to court you."
      },
      {
       "cyr": "- Немој лудо, не се троши,",
       "lat": "- Nemoj ludo, ne se troši,",
       "en": "- Do not, fool, do not spend,"
      },
      {
       "cyr": "јас сум твоја без прстен.",
       "lat": "jas sum tvoja bez prsten.",
       "en": "I am yours without a ring."
      }
     ]
    },
    {
     "lines": [
