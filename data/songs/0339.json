   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ој природо вечна убавице,",
       "lat": "Oj prirodo večna ubavice,",
       "en": "Oh nature, eternal beauty,"
      },
      {
       "cyr": "ти создаде сè на овој свет,",
       "lat": "ti sozdade sè na ovoj svet,",
       "en": "you created everything in this world,"
      },
      {
       "cyr": "ти создаде љубов и омраза,",
       "lat": "ti sozdade ljubov i omraza,",
       "en": "you created love and hatred,"
      },
      {
       "cyr": "среќа радост на овој свет.",
       "lat": "sreḱa radost na ovoj svet.",
       "en": "happiness and joy in this world."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Вие дами и убај господи",
       "lat": "Vie dami i ubaj gospodi",
       "en": "You ladies and you fine gentlemen"
      },
      {
       "cyr": "што имате богати мажи",
       "lat": "što imate bogati maži",
       "en": "who have rich husbands,"
      },
      {
       "cyr": "но затоа вие многу пати",
       "lat": "no zatoa vie mnogu pati",
       "en": "but for that reason you many times"
      },
      {
       "cyr": "честа си ја продавате.",
       "lat": "česta si ja prodavate.",
       "en": "sell your honor."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Јас не сакам големи богатства",
       "lat": "Jas ne sakam golemi bogatstva",
       "en": "I do not want great riches,"
      },
      {
       "cyr": "ниту сакам царски палати,",
       "lat": "nitu sakam carski palati,",
       "en": "nor do I want royal palaces,"
      },
      {
       "cyr": "јас си сакам сламена колиба,",
       "lat": "jas si sakam slamena koliba,",
       "en": "I want my straw hut,"
      },
      {
       "cyr": "и во неа слатко да спијам.",
       "lat": "i vo nea slatko da spijam.",
       "en": "and to sleep sweetly in it."
      }
     ]
    }
   ]
