 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ој девојче, бело и црвено",
       "lat": "Oj devojče, belo i crveno",
       "en": "Hey girl, white and red,"
      },
      {
       "cyr": "како тебе, моме,",
       "lat": "kako tebe, mome,",
       "en": "like you, girl,"
      },
      {
       "cyr": "нигде не најдов.",
       "lat": "nigde ne najdov.",
       "en": "I haven't found anywhere."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Каква мајка беше",
       "lat": "Kakva majka beše",
       "en": "Who was the mother"
      },
      {
       "cyr": "тебе што те роди",
       "lat": "tebe što te rodi",
       "en": "that gave birth to you,"
      },
      {
       "cyr": "тебе што те роди",
       "lat": "tebe što te rodi",
       "en": "that gave birth to you"
      },
      {
       "cyr": "толку убава?",
       "lat": "tolku ubava?",
       "en": "so beautiful?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дали си Гркиња,",
       "lat": "Dali si Grkinja,",
       "en": "Are you Greek"
      },
      {
       "cyr": "или Македонка,",
       "lat": "ili Makedonka,",
       "en": "or Macedonian,"
      },
      {
       "cyr": "цел свет да се чуди",
       "lat": "cel svet da se čudi",
       "en": "the whole wolrd is wondering"
      },
      {
       "cyr": "на твојта убост?",
       "lat": "na tvojta ubost?",
       "en": "about your beauty?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Три години стана",
       "lat": "Tri godini stana",
       "en": "Three years have passed now"
      },
      {
       "cyr": "како ме зафана,",
       "lat": "kako me zafana,",
       "en": "since it started,"
      },
      {
       "cyr": "љуто да ме мачи",
       "lat": "ljuto da me mači",
       "en": "since I am tormented"
      },
      {
       "cyr": "твојата љубов.",
       "lat": "tvojata ljubov.",
       "en": "by my love to you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ја земи ножето,",
       "lat": "Ja zemi nožeto,",
       "en": "Here, get the little knife,"
      },
      {
       "cyr": "распарај срцето,",
       "lat": "rasparaj srceto,",
       "en": "tear my heart apart,"
      },
      {
       "cyr": "таму ќе си најдеш",
       "lat": "tamu ḱe si najdeš",
       "en": "there you will find"
      },
      {
       "cyr": "отровна љубов.",
       "lat": "otrovna ljubov.",
       "en": "a poisonous love."
      }
     ]
    }
   ]
  }
 ],
