   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Билбил пее во планина,",
       "lat": "Bilbil pee vo planina,",
       "en": "A nightingale sings in the mountain,"
      },
      {
       "cyr": "моме седи во градина.",
       "lat": "mome sedi vo gradina.",
       "en": "a girl sits in a garden."
      },
      {
       "cyr": "Билбил моме наговара:",
       "lat": "Bilbil mome nagovara:",
       "en": "The nightingale says to the girl:"
      },
      {
       "cyr": "- Ајде моме да пееме.",
       "lat": "- Ajde mome da peeme.",
       "en": "- Let us sing."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако мене ти натпееш",
       "lat": "Ako mene ti natpeeš",
       "en": "If you sing better than me,"
      },
      {
       "cyr": "ќе ти дадам планината.",
       "lat": "ḱe ti dadam planinata.",
       "en": "I'll give you the mountain."
      },
      {
       "cyr": "Ќе ти дадам планината,",
       "lat": "Ḱe ti dadam planinata,",
       "en": "I'll give you the mountain,"
      },
      {
       "cyr": "со сè гранки, со сè буки.",
       "lat": "so sè granki, so sè buki.",
       "en": "including the branches, including the beeches."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако тебе јас натпеам",
       "lat": "Ako tebe jas natpeam",
       "en": "If I sing better than you,"
      },
      {
       "cyr": "ќе ти земам градината.",
       "lat": "ḱe ti zemam gradinata.",
       "en": "I'll take the garden."
      },
      {
       "cyr": "Ќе ти земам градината,",
       "lat": "Ḱe ti zemam gradinata,",
       "en": "I'll take the garden,"
      },
      {
       "cyr": "со сè цвеќе, со сè тебе.",
       "lat": "so sè cveḱe, so sè tebe.",
       "en": "including the flowers, including you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Билбил моме натпеало,",
       "lat": "Bilbil mome natpealo,",
       "en": "The nightingale sang better than the girl,"
      },
      {
       "cyr": "му ја зеде градината.",
       "lat": "mu ja zede gradinata.",
       "en": "he has taken the garden."
      },
      {
       "cyr": "Му ја зеде градината,",
       "lat": "Mu ja zede gradinata,",
       "en": "He has taken the garden,"
      },
      {
       "cyr": "со сè цвеќе, со сè моме.",
       "lat": "so sè cveḱe, so sè mome.",
       "en": "including the flowers, including the girl."
      }
     ]
    }
   ]
  }
 ],
