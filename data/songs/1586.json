      {
       "cyr": "Брале се, брале сватови,",
       "lat": "Brale se, brale svatovi,",
       "en": "The wedding guests gathered, gathered,"
      },
      {
       "cyr": "во стојанови дворови,",
       "lat": "vo stojanovi dvorovi,",
       "en": "in Stojan's yard,"
      },
      {
       "cyr": "под стојанови чардаци.",
       "lat": "pod stojanovi čardaci.",
       "en": "under Stojan's balconies."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Врани ми коњи јавнале,",
       "lat": "Vrani mi konji javnale,",
       "en": "They rode black horses,"
      },
      {
       "cyr": "на рамо пушки метнале,",
       "lat": "na ramo puški metnale,",
       "en": "slung rifles on their shoulders,"
      },
      {
       "cyr": "во раце шише ракија.",
       "lat": "vo race šiše rakija.",
       "en": "in their hands a bottle of rakija."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Невеста да ми донесат,",
       "lat": "Nevesta da mi donesat,",
       "en": "To bring me a bride,"
      },
      {
       "cyr": "невеста лична, убава,",
       "lat": "nevesta lična, ubava,",
       "en": "a bride fair and beautiful,"
      },
      {
       "cyr": "за Стојан лика, прилика.",
       "lat": "za Stojan lika, prilika.",
       "en": "for Stojan, a fine face and figure."
      }
     ]
    }
