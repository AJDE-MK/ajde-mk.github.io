    {
     "lines": [
      {
       "cyr": "Помина ти крај мене,",
       "lat": "Pomina ti kraj mene,",
       "en": "You passed by me,"
      },
      {
       "cyr": "а ми рече два збора:",
       "lat": "a mi reče dva zbora:",
       "en": "and said two words to me:"
      },
      {
       "cyr": "- Либе одам в' туѓина,",
       "lat": "- Libe odam v' tuǵina,",
       "en": "- Darling, I am going to a foreign land,"
      },
      {
       "cyr": "срцево ми тагува.",
       "lat": "srcevo mi taguva.",
       "en": "my heart is sorrowing."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Роден, роден крај,",
       "lat": "Roden, roden kraj,",
       "en": "Native, native land,"
      },
      {
       "cyr": "ти си како рај",
       "lat": "ti si kako raj",
       "en": "you are like paradise,"
      },
      {
       "cyr": "живот мој си ти,",
       "lat": "život moj si ti,",
       "en": "you are my life,"
      },
      {
       "cyr": "за тебе пеам јас.",
       "lat": "za tebe peam jas.",
       "en": "I sing for you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ќе се вратам в' роден крај,",
       "lat": "Ḱe se vratam v' roden kraj,",
       "en": "I will return to my native land,"
      },
      {
       "cyr": "кај што цути само мај,",
       "lat": "kaj što cuti samo maj,",
       "en": "where only May blooms,"
      },
      {
       "cyr": "да ги видам браќата,",
       "lat": "da gi vidam braḱata,",
       "en": "to see my brothers,"
      },
      {
       "cyr": "како градат мајко рај.",
       "lat": "kako gradat majko raj.",
       "en": "how they build paradise, mother."
      }
     ]
