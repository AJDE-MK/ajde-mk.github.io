   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Кога си тргнав в' туѓина",
       "lat": "Koga si trgnav v' tuǵina",
       "en": "When I set off into a foreign land,"
      },
      {
       "cyr": "Дафино либе, Дафино,",
       "lat": "Dafino libe, Dafino,",
       "en": "Dafina, my love, Dafina,"
      },
      {
       "cyr": "крај твојте порти поминав, мој галабе",
       "lat": "kraj tvojte porti pominav, moj galabe",
       "en": "I passed by your gate, my dear,"
      },
      {
       "cyr": "и солзи проронав.",
       "lat": "i solzi proronav.",
       "en": "and shed tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Откажуваш ли либе, откажуваш",
       "lat": "Otkažuvaš li libe, otkažuvaš",
       "en": "Are you renouncing, love, are you renouncing"
      },
      {
       "cyr": "од твојта верна си љубов,",
       "lat": "od tvojta verna si ljubov,",
       "en": "your faithful love,"
      },
      {
       "cyr": "думите да си ги приспомниш, мој галабе",
       "lat": "dumite da si gi prispomniš, moj galabe",
       "en": "will you remember the words, my dear,"
      },
      {
       "cyr": "назад да се вратиш?",
       "lat": "nazad da se vratiš?",
       "en": "and come back?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Вашиот чаир да пламни",
       "lat": "Vašiot čair da plamni",
       "en": "May your meadow burst into flame"
      },
      {
       "cyr": "и вашата куќа да изгори",
       "lat": "i vašata kuḱa da izgori",
       "en": "and your house burn down"
      },
      {
       "cyr": "и твојто ангелско лице, мој галабе",
       "lat": "i tvojto angelsko lice, moj galabe",
       "en": "and your angelic face, my dear,"
      },
      {
       "cyr": "во мојве раце да падни.",
       "lat": "vo mojve race da padni.",
       "en": "fall into these hands of mine."
      }
     ]
    }
   ]
