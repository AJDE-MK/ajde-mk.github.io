   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Мила моја мајко, благослови ме,",
       "lat": "Mila moja majko, blagoslovi me,",
       "en": "My dear mother, bless me,"
      },
      {
       "cyr": "со радост гордо ти испрати ме,",
       "lat": "so radost gordo ti isprati me,",
       "en": "send me off proudly with joy,"
      },
      {
       "cyr": "еве денес војник јас заминувам,",
       "lat": "eve denes vojnik jas zaminuvam,",
       "en": "today I am leaving as a soldier,"
      },
      {
       "cyr": "запеј песна мајко, оро поведи.",
       "lat": "zapej pesna majko, oro povedi.",
       "en": "start a song, mother, lead the dance."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Како цвеќе си ме гледала,",
       "lat": "Kako cveḱe si me gledala,",
       "en": "You watched me like a flower,"
      },
      {
       "cyr": "војник да одам ти дочека,",
       "lat": "vojnik da odam ti dočeka,",
       "en": "and lived to see me go as a soldier,"
      },
      {
       "cyr": "тешка песна пеат моите другари,",
       "lat": "teška pesna peat moite drugari,",
       "en": "my friends sing a heavy song,"
      },
      {
       "cyr": "биди силна, мајко, скриј ги солзите.",
       "lat": "bidi silna, majko, skrij gi solzite.",
       "en": "be strong, mother, hide your tears."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ајде мајко да се прегрнеме",
       "lat": "Ajde majko da se pregrneme",
