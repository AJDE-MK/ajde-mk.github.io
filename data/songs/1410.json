 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Негде ќе те премолчат,",
       "lat": "Negde ḱe te premolčat,",
       "en": "Somewhere they will silence you,"
      },
      {
       "cyr": "негде ќе те сокријат,",
       "lat": "negde ḱe te sokrijat,",
       "en": "somewhere they will hide you,"
      },
      {
       "cyr": "гроб со гроба ќе покријат.",
       "lat": "grob so groba ḱe pokrijat.",
       "en": "with grave upon grave they will cover you."
      },
      {
       "cyr": "Само ти си бесмртна,",
       "lat": "Samo ti si besmrtna,",
       "en": "Only you are immortal,"
      },
      {
       "cyr": "жива вода подземна,",
       "lat": "živa voda podzemna,",
       "en": "living water from the underground,"
      },
      {
       "cyr": "кај што тонеш ти извираш.",
       "lat": "kaj što toneš ti izviraš.",
       "en": "where you sink, you spring forth."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Векови пеколни заедно ќе минеме,",
       "lat": "Vekovi pekolni zaedno ḱe mineme,",
       "en": "Centuries of hell, together we shall pass,"
      },
      {
       "cyr": "древна земјо македонска,",
       "lat": "drevna zemjo makedonska,",
       "en": "ancient Macedonian land,"
      },
      {
       "cyr": "така е пишано ништо да не бидеме,",
       "lat": "taka e pišano ništo da ne bideme,",
       "en": "so it is written that we shall be nothing,"
      },
      {
       "cyr": "ти без мене, јас без тебе.",
       "lat": "ti bez mene, jas bez tebe.",
       "en": "you without me, and I without you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Може да те одречат,",
       "lat": "Može da te odrečat,",
       "en": "They may disown you,"
      },
      {
       "cyr": "други да те предадат,",
       "lat": "drugi da te predadat,",
       "en": "others may betray you,"
      },
      {
       "cyr": "можат сешто да измислат.",
       "lat": "možat sešto da izmislat.",
       "en": "they can invent anything."
      },
      {
       "cyr": "Само ти си бесмртна,",
       "lat": "Samo ti si besmrtna,",
       "en": "Only you are immortal,"
      },
      {
       "cyr": "жива вода подземна,",
       "lat": "živa voda podzemna,",
       "en": "living water from the underground,"
      },
      {
       "cyr": "кај што тонеш ти извираш.",
       "lat": "kaj što toneš ti izviraš.",
       "en": "where you sink, you spring forth."
      }
     ]
    },
