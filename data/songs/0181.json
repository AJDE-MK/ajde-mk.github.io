   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Иди ја мамо посакај,",
       "lat": "Idi ja mamo posakaj,",
       "en": "Go and ask for her, mother,"
      },
      {
       "cyr": "Марија, наша мамо комшивка.",
       "lat": "Marija, naša mamo komšivka.",
       "en": "Marija, our neighbor, mother."
      },
      {
       "cyr": "Ако је неја не давет,",
       "lat": "Ako je neja ne davet,",
       "en": "If they do not give her to you,"
      },
      {
       "cyr": "таа имат сестра, мамо, помала.",
       "lat": "taa imat sestra, mamo, pomala.",
       "en": "she has a younger sister, mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ако и неа не давет,",
       "lat": "Ako i nea ne davet,",
       "en": "If they do not give her either,"
      },
      {
       "cyr": "таа имат снаа, мамо, вдовица.",
       "lat": "taa imat snaa, mamo, vdovica.",
       "en": "she has a sister-in-law, mother, a widow."
      },
      {
       "cyr": "Ако и неја не е давет,",
       "lat": "Ako i neja ne e davet,",
       "en": "If they do not give her either,"
      },
      {
       "cyr": "плевната ќе му, мамо, запалам.",
       "lat": "plevnata ḱe mu, mamo, zapalam.",
       "en": "I will set the barn on fire, mother."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Да горит, мамо, да горит,",
       "lat": "Da gorit, mamo, da gorit,",
       "en": "Let it burn, mother, let it burn,"
      },
      {
       "cyr": "како што срце горит по неа.",
       "lat": "kako što srce gorit po nea.",
       "en": "as my heart burns for her."
      }
     ]
    }
   ]
  }
