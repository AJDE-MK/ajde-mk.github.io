 "versions": [
  {
   "label": "",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Ој ти пиле, славеј пиле,",
       "lat": "Oj ti pile, slavej pile,",
       "en": "Oh, you bird, nightingale,"
      },
      {
       "cyr": "ај запеј ми една песна,",
       "lat": "aj zapej mi edna pesna,",
       "en": "sing me a song,"
      },
      {
       "cyr": "една песна жаловита.",
       "lat": "edna pesna žalovita.",
       "en": "a tragic song."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Нек' се чуе на далеку,",
       "lat": "Nek' se čue na daleku,",
       "en": "May it be heard far away,"
      },
      {
       "cyr": "на далеку преку Вардар,",
       "lat": "na daleku preku Vardar,",
       "en": "far away, across the Vardar"
      },
      {
       "cyr": "преку Вардар до Велешко.",
       "lat": "preku Vardar do Veleško.",
       "en": "across the Vardar to Veles."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од Велешко до Прилепско,",
       "lat": "Od Veleško do Prilepsko,",
       "en": "From Veles to Prilep,"
      },
      {
       "cyr": "од Прилепско до Крушевско,",
       "lat": "od Prilepsko do Kruševsko,",
       "en": "from Prilep to Krushevo,"
      },
      {
       "cyr": "од Крушево - Мечкин Камен.",
       "lat": "od Kruševo - Mečkin Kamen.",
       "en": "from Krushevo to Mechkin Kamen."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Од Крушево - Мечкин Камен,",
       "lat": "Od Kruševo - Mečkin Kamen,",
       "en": "From Krushevo - Mechkin Kamen"
      },
      {
       "cyr": "там' се бије славен јунак,",
       "lat": "tam' se bije slaven junak,",
       "en": "there is fighting a glorious hero,"
      },
      {
       "cyr": "славен јунак Питу Гули,",
       "lat": "slaven junak Pitu Guli,",
       "en": "glorious hero Pitu Guli"
      },
      {
       "cyr": "Питу Гули војводата!",
       "lat": "Pitu Guli vojvodata!",
       "en": "Pitu Guli, partisan commander!"
      }
     ]
    }
   ]
  }
 ],
