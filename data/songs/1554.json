   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Не сакам да плачам",
       "lat": "Ne sakam da plačam",
       "en": "I do not want to cry"
      },
      {
       "cyr": "ако одиш од мене",
       "lat": "ako odiš od mene",
       "en": "if you go away from me"
      },
      {
       "cyr": "и никогаш не ќе молам",
       "lat": "i nikogaš ne ḱe molam",
       "en": "and I will never beg"
      },
      {
       "cyr": "да се вратиш крај мене.",
       "lat": "da se vratiš kraj mene.",
       "en": "you to come back to me."
      },
      {
       "cyr": "А можеби со болка ќе гледам",
       "lat": "A možebi so bolka ḱe gledam",
       "en": "And maybe I will watch with pain"
      },
      {
       "cyr": "сепак оди не враќај се",
       "lat": "sepak odi ne vraḱaj se",
       "en": "but still go, do not come back"
      },
      {
       "cyr": "и не чекај да те следам",
       "lat": "i ne čekaj da te sledam",
       "en": "and do not wait for me to follow you"
      },
      {
       "cyr": "само оди, не се свртувај.",
       "lat": "samo odi, ne se svrtuvaj.",
       "en": "just go, do not turn around."
      }
     ]
    },
    {
