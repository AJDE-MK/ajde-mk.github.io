       "en": "entire winter it laid sick.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога на пролет станала,",
       "lat": "Koga na prolet stanala,",
       "en": "When it got up in the spring,",
       "en_mt": false
      },
      {
       "cyr": "тивко ми ветре поддувна,",
       "lat": "tivko mi vetre podduvna,",
       "en": "a silent breeze started to blow,",
       "en_mt": false
      },
      {
       "cyr": "пролетна песна запеја.",
       "lat": "proletna pesna zapeja.",
       "en": "singing a spring song.",
       "en_mt": false
