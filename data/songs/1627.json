   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Со чиста љубов ве оставам,",
       "lat": "So čista ljubov ve ostavam,",
       "en": "With pure love I leave you,",
       "en_mt": false
      },
      {
       "cyr": "со грутка в' срцето ми",
       "lat": "so grutka v' srceto mi",
       "en": "with a lump in my heart",
       "en_mt": false
      },
      {
       "cyr": "јас ќе патувам.",
       "lat": "jas ḱe patuvam.",
       "en": "I will travel.",
       "en_mt": false
      },
      {
       "cyr": "Без поздрав, драга,",
       "lat": "Bez pozdrav, draga,",
       "en": "Without greetings, dear,",
       "en_mt": false
      },
      {
       "cyr": "со мојот род,",
       "lat": "so mojot rod,",
       "en": "with my family,",
       "en_mt": false
      },
      {
       "cyr": "без нишан, два-три збора",
       "lat": "bez nišan, dva-tri zbora",
       "en": "without aim,",
       "en_mt": false
      },
      {
       "cyr": "да ви запишам.",
       "lat": "da vi zapišam.",
       "en": "to write down two or three words for you.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Немој синко да се срамиш.",
       "lat": "- Nemoj sinko da se sramiš.",
       "en": "- Don't be ashamed, son.",
       "en_mt": false
      },
      {
       "cyr": "- Немој мајко да ме колнеш.",
       "lat": "- Nemoj majko da me kolneš.",
       "en": "- Don't curse me, mother.",
       "en_mt": false
      },
      {
       "cyr": "Немој песно не,",
       "lat": "Nemoj pesno ne,",
       "en": "Don't you sing, my song,",
       "en_mt": false
      },
      {
       "cyr": "твој сум секогаш.",
       "lat": "tvoj sum sekogaš.",
       "en": "I am always yours.",
       "en_mt": false
      },
      {
       "cyr": "Може неправда е тешка,",
       "lat": "Može nepravda e teška,",
       "en": "Maybe it's injustice,",
       "en_mt": false
      },
      {
       "cyr": "може родот да е грешка,",
       "lat": "može rodot da e greška,",
       "en": "maybe the lineage is wrong,",
       "en_mt": false
      },
      {
       "cyr": "друго племе дај,",
       "lat": "drugo pleme daj,",
       "en": "give me another tribe,",
       "en_mt": false
      },
      {
       "cyr": "сал македонско.",
       "lat": "sal makedonsko.",
       "en": "just as long as it's Macedonian.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Чувај ги, чувај нашите ангели,",
       "lat": "Čuvaj gi, čuvaj našite angeli,",
       "en": "Guard them, guard our angels,",
       "en_mt": false
      },
      {
       "cyr": "со верба дека Господ",
       "lat": "so verba deka Gospod",
       "en": "with faith that God",
       "en_mt": false
      },
      {
       "cyr": "ќе се смилува.",
       "lat": "ḱe se smiluva.",
       "en": "will have mercy.",
       "en_mt": false
      },
      {
       "cyr": "И камо сонце да ме огрее,",
       "lat": "I kamo sonce da me ogree,",
       "en": "And I wish the sun warms me,",
       "en_mt": false
      },
      {
       "cyr": "за прв пат зракот нежно",
       "lat": "za prv pat zrakot nežno",
       "en": "for the first time, the ray",
       "en_mt": false
      },
      {
       "cyr": "да ме погали.",
       "lat": "da me pogali.",
       "en": "gently caresses me.",
       "en_mt": false
      }
