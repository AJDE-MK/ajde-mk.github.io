   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Крстано бела црвена,",
       "lat": "- Krstano bela crvena,",
       "en": "- Krstana, fair and rosy (beautiful),"
      },
      {
       "cyr": "што рано цвеќе цутило,",
       "lat": "što rano cveḱe cutilo,",
       "en": "oh how the early flowers have bloomed,"
      },
      {
       "cyr": "што не го бериш да носиш,",
       "lat": "što ne go beriš da nosiš,",
       "en": "won’t you gather some and wear them"
      },
      {
       "cyr": "да ти заличит лицето,",
       "lat": "da ti zaličit liceto,",
       "en": "to brighten your face,"
      },
      {
       "cyr": "да ти заличит ставата.",
       "lat": "da ti zaličit stavata.",
       "en": "to illuminate your body."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Дегиди лудо и младо,",
       "lat": "- Degidi ludo i mlado,",
       "en": "- Listen you foolish lad,"
      },
      {
       "cyr": "што да го берам да носам,",
       "lat": "što da go beram da nosam,",
       "en": "why should I gather them to wear them,"
      },
      {
       "cyr": "што аро гледам пред мене,",
       "lat": "što aro gledam pred mene,",
       "en": "when all I see ahead is bad luck,"
      },
      {
       "cyr": "дегиди лудо и младо,",
       "lat": "degidi ludo i mlado,",
       "en": "listen you foolish lad,"
      },
      {
       "cyr": "не бери гајле за мене.",
       "lat": "ne beri gajle za mene.",
       "en": "don’t concern yourself with me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Крстано бела црвена,",
       "lat": "- Krstano bela crvena,",
       "en": "- Krstana, fair and rosy,"
      },
      {
       "cyr": "мажи се дури си млада,",
       "lat": "maži se duri si mlada,",
       "en": "get married while you’re still young,"
      },
      {
       "cyr": "дури си млада, убава,",
       "lat": "duri si mlada, ubava,",
       "en": "while you’re young and beautiful,"
      },
      {
       "cyr": "дури си танка, висока,",
       "lat": "duri si tanka, visoka,",
       "en": "while you’re slim and tall,"
      },
      {
       "cyr": "дури ти играт срцето.",
       "lat": "duri ti igrat srceto.",
       "en": "while your heart is dancing."
      }
     ]
