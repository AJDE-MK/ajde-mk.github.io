   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Море сокол пие вода на Вардарот",
       "lat": "More sokol pie voda na Vardarot",
       "en": "A hawk drinks water from Vardar."
      },
      {
       "cyr": "Јане, Јане ле бело грло,",
       "lat": "Jane, Jane le belo grlo,",
       "en": "Jane, Jane white throat,"
      },
      {
       "cyr": "Јане, Јане ле кротко јагне.",
       "lat": "Jane, Jane le krotko jagne.",
       "en": "Jane, Jane gentle lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Море ој соколе, ти јуначко пиле",
       "lat": "- More oj sokole, ti junačko pile",
       "en": "Hey hawk, you brave bird."
      },
      {
       "cyr": "Јане, Јане ле бело грло,",
       "lat": "Jane, Jane le belo grlo,",
       "en": "Jane, Jane white throat,"
      },
      {
       "cyr": "Јане, Јане ле кротко јагне.",
       "lat": "Jane, Jane le krotko jagne.",
       "en": "Jane, Jane gentle lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Море нели виде јунак да премине",
       "lat": "More neli vide junak da premine",
       "en": "Did you see a hero passing by,"
      },
      {
       "cyr": "јунак да премине с' девет лути рани?",
       "lat": "junak da premine s' devet luti rani?",
       "en": "a hero passing by, with nine deep wounds?"
      },
      {
       "cyr": "Јане, Јане ле бело грло,",
       "lat": "Jane, Jane le belo grlo,",
       "en": "Jane, Jane white throat,"
      },
      {
       "cyr": "Јане, Јане ле кротко јагне.",
       "lat": "Jane, Jane le krotko jagne.",
       "en": "Jane, Jane gentle lamb."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Девет лути рани, сите куршумлии",
       "lat": "Devet luti rani, site kuršumlii",
       "en": "Nine deep wounds, all made by bullets,"
      },
      {
       "cyr": "а десетта рана с' нож е прободена.",
       "lat": "a desetta rana s' nož e probodena.",
       "en": "and the tenth wound made by knife?"
      },
      {
       "cyr": "Јане, Јане ле бело грло,",
       "lat": "Jane, Jane le belo grlo,",
       "en": "Jane, Jane white throat,"
      },
      {
       "cyr": "Јане, Јане ле кротко јагне.",
       "lat": "Jane, Jane le krotko jagne.",
       "en": "Jane, Jane gentle lamb."
      }
     ]
    }
   ]
