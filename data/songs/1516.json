   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Шо ми се забави Тино",
       "lat": "- Šo mi se zabavi Tino",
       "en": "- What kept my Tino so long"
      },
      {
       "cyr": "на Дунав, за вода?",
       "lat": "na Dunav, za voda?",
       "en": "at the Danube, fetching water?"
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Пошчо ме опитваш, мајко,",
       "lat": "- Poščo me opitvaš, majko,",
       "en": "- Why do you question me, mother,"
      },
      {
       "cyr": "право ќе ти кажам.",
       "lat": "pravo ḱe ti kažam.",
       "en": "I will tell you straight."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Право ќе ти кажам, мајко,",
       "lat": "Pravo ḱe ti kažam, majko,",
       "en": "I will tell you straight, mother,"
      },
      {
       "cyr": "без да те излажам.",
       "lat": "bez da te izlažam.",
       "en": "without lying to you."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Таму поминаје мајко",
       "lat": "Tamu pominaje majko",
       "en": "There passed, mother,"
      },
      {
       "cyr": "три табури аскер.",
       "lat": "tri taburi asker.",
       "en": "three battalions of soldiers."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Напред ми тргаше, мајко,",
       "lat": "Napred mi trgaše, majko,",
       "en": "In front rode, mother,"
      },
      {
       "cyr": "једно Македонче.",
       "lat": "jedno Makedonče.",
       "en": "one young Macedonian."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ка ме виде мене мајко",
       "lat": "Ka me vide mene majko",
       "en": "When he saw me, mother,"
      },
      {
       "cyr": "од коњо се фрли.",
       "lat": "od konjo se frli.",
       "en": "he leapt from his horse."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "За р'ка ме фати мајко",
       "lat": "Za r'ka me fati majko",
       "en": "He took me by the hand, mother,"
      },
      {
       "cyr": "леле шо ми даде.",
       "lat": "lele šo mi dade.",
       "en": "oh, what he gave me."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Леле шо ми даде мајко",
       "lat": "Lele šo mi dade majko",
       "en": "Oh, what he gave me, mother,"
      },
      {
       "cyr": "три бели меџиди.",
       "lat": "tri beli medžidi.",
       "en": "three white silver coins."
      }
     ]
