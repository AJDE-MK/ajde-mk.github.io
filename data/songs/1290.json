   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Камбани бијат сред Баница,",
       "lat": "Kambani bijat sred Banica,",
       "en": "Bells are ringing in the middle of Banica,"
      },
      {
       "cyr": "народот да се собере",
       "lat": "narodot da se sobere",
       "en": "for the people to gather"
      },
      {
       "cyr": "во црква Свети Димитрија.",
       "lat": "vo crkva Sveti Dimitrija.",
       "en": "at the church of Saint Demetrius."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Делба ми прават душмани,",
       "lat": "Delba mi pravat dušmani,",
       "en": "Enemies are making a division of us,"
      },
      {
       "cyr": "татковци, браќа, синови,",
       "lat": "tatkovci, braḱa, sinovi,",
       "en": "fathers, brothers, sons,"
      },
      {
       "cyr": "во пусти острови ги праќаат.",
       "lat": "vo pusti ostrovi gi praḱaat.",
       "en": "they send them to barren islands."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Мајки, невести, мали дечиња,",
       "lat": "Majki, nevesti, mali dečinja,",
       "en": "Mothers, brides, small children,"
      },
      {
       "cyr": "сите в' планина ги отераа,",
       "lat": "site v' planina gi oteraa,",
       "en": "they drove them all into the mountain,"
      },
      {
       "cyr": "в' планина, село Невеска.",
       "lat": "v' planina, selo Neveska.",
       "en": "into the mountain, to the village of Neveska."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Вас не држи село Невеска",
       "lat": "Vas ne drži selo Neveska",
       "en": "Neveska village does not hold you,"
      },
      {
       "cyr": "враќајте се, еј Баничани,",
       "lat": "vraḱajte se, ej Baničani,",
       "en": "return, hey people of Banica,"
      },
      {
       "cyr": "враќајте се во село убаво.",
       "lat": "vraḱajte se vo selo ubavo.",
       "en": "return to your beautiful village."
      }
     ]
    }
