   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Во песни те опеавме",
       "lat": "Vo pesni te opeavme",
       "en": "In songs we sang of you,"
      },
      {
       "cyr": "љубов и среќа посеавме,",
       "lat": "ljubov i sreḱa poseavme,",
       "en": "we sowed love and happiness,"
      },
      {
       "cyr": "за тебе мајко стара,",
       "lat": "za tebe majko stara,",
       "en": "for you, old mother,"
      },
      {
       "cyr": "за тебе земјо најубава.",
       "lat": "za tebe zemjo najubava.",
       "en": "for you, most beautiful land."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Еј да живееш, вечна да си,",
       "lat": "Ej da živeeš, večna da si,",
       "en": "Hey, may you live, be eternal,"
      },
      {
       "cyr": "никој по патот да не те плаши,",
       "lat": "nikoj po patot da ne te plaši,",
       "en": "may no one frighten you on the road,"
      },
      {
       "cyr": "чекор по чекор",
       "lat": "čekor po čekor",
       "en": "step by step"
      },
      {
       "cyr": "среќна да си, Македонијо!",
       "lat": "sreḱna da si, Makedonijo!",
       "en": "may you be happy, Macedonia!"
      }
     ]
    },
    {
     "lines": [
