   "en_source": "mixed",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Твојте очи Лено мори",
       "lat": "Tvojte oči Leno mori",
       "en": "Your eyes, Lena,",
       "en_mt": false
      },
      {
       "cyr": "воденски череши се,",
       "lat": "vodenski čereši se,",
       "en": "are like cherries from Voden.",
       "en_mt": false
      },
      {
       "cyr": "дај ми ги на мене,",
       "lat": "daj mi gi na mene,",
       "en": "Give them to me,",
       "en_mt": false
      },
      {
       "cyr": "јаска да ги изедам.",
       "lat": "jaska da gi izedam.",
       "en": "so I can eat them up.",
       "en_mt": false
      },
      {
       "cyr": "Мерак, Лено мори,",
       "lat": "Merak, Leno mori,",
       "en": "Desire, Lena,",
       "en_mt": true
      },
      {
       "cyr": "мерак да ми помини,",
       "lat": "merak da mi pomini,",
       "en": "So that my desire goes away,",
       "en_mt": false
      },
      {
       "cyr": "севда, севда моја,",
       "lat": "sevda, sevda moja,",
       "en": "my passion, my passion,",
       "en_mt": true
      },
      {
       "cyr": "севда да ми излези.",
       "lat": "sevda da mi izlezi.",
       "en": "So my passion for you can get out of me.",
       "en_mt": false
      }
     ]
    },
