 "versions": [
  {
   "label": "",
   "en_source": "mt",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Гена ми појде на чешма",
       "lat": "Gena mi pojde na češma",
       "en": "Gena went to the fountain"
      },
      {
       "cyr": "стомните да си наполни,",
       "lat": "stomnite da si napolni,",
       "en": "to fill her water jugs,"
      },
      {
       "cyr": "јунак од гора да лади,",
       "lat": "junak od gora da ladi,",
       "en": "to cool a hero from the forest,"
      },
      {
       "cyr": "раните да му исцели.",
       "lat": "ranite da mu isceli.",
       "en": "to heal his wounds."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Оф, Гено, Гено убава,",
       "lat": "Of, Geno, Geno ubava,",
       "en": "Oh, Gena, Gena the beautiful,"
      },
      {
       "cyr": "донеси вода студена.",
       "lat": "donesi voda studena.",
       "en": "bring cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Наполни Гена стомните,",
       "lat": "Napolni Gena stomnite,",
       "en": "Gena filled the jugs,"
      },
      {
       "cyr": "накачи патот кон дома,",
       "lat": "nakači patot kon doma,",
       "en": "she took the path home,"
      },
      {
       "cyr": "отвори порте капиџик,",
       "lat": "otvori porte kapidžik,",
       "en": "opened the gate, the little door,"
      },
      {
       "cyr": "подаде стомне на јунак.",
       "lat": "podade stomne na junak.",
       "en": "handed the jug to the hero."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ах, Гена, Гена убава,",
       "lat": "Ah, Gena, Gena ubava,",
       "en": "Ah, Gena, Gena the beautiful,"
      },
      {
       "cyr": "донесе вода студена.",
       "lat": "donese voda studena.",
       "en": "she brought cold water."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Дигна ми јунак стомнето,",
       "lat": "Digna mi junak stomneto,",
       "en": "The hero raised the jug,"
      },
      {
       "cyr": "разлади грло јуначко,",
       "lat": "razladi grlo junačko,",
       "en": "cooled his heroic throat,"
      },
      {
       "cyr": "поврати снага ајдучка,",
       "lat": "povrati snaga ajdučka,",
       "en": "regained his outlaw's strength,"
      },
      {
       "cyr": "однесе Гена во гора.",
       "lat": "odnese Gena vo gora.",
       "en": "and carried Gena off to the forest."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ах Гена, Гена убава",
       "lat": "Ah Gena, Gena ubava",
       "en": "Ah Gena, Gena the beautiful"
      },
      {
       "cyr": "однесе јунак во гора.",
       "lat": "odnese junak vo gora.",
       "en": "the hero carried off to the forest."
      }
     ]
    }
   ]
  }
