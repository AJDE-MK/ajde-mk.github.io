   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Пофали се шеинче терзиче,",
       "lat": "Pofali se šeinče terziče,",
       "en": "The handsome little tailor boasted,"
      },
      {
       "cyr": "пофали се доле у меана,",
       "lat": "pofali se dole u meana,",
       "en": "he boasted down in the tavern,"
      },
      {
       "cyr": "у меана, пред триес' дружина:",
       "lat": "u meana, pred tries' družina:",
       "en": "in the tavern, before thirty companions:"
      },
      {
       "cyr": "- Јас си имам убава невеста.",
       "lat": "- Jas si imam ubava nevesta.",
       "en": "- I have a beautiful bride."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Снага има - пушка арнаутска,",
       "lat": "Snaga ima - puška arnautska,",
       "en": "Her figure is an Arnaut rifle,"
      },
      {
       "cyr": "руке има - стамболски диреци,",
       "lat": "ruke ima - stambolski direci,",
       "en": "her arms are Istanbul pillars,"
      },
      {
       "cyr": "лице има - симит на чаршија,",
       "lat": "lice ima - simit na čaršija,",
       "en": "her face is a simit in the market,"
      },
      {
       "cyr": "уста има - калајна кутија.",
       "lat": "usta ima - kalajna kutija.",
       "en": "her mouth is a tin box."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Зуби има - бисер за низање,",
       "lat": "Zubi ima - biser za nizanje,",
       "en": "Her teeth are pearls for stringing,"
      },
      {
       "cyr": "очи има - беглерски вилџани,",
       "lat": "oči ima - beglerski vildžani,",
       "en": "her eyes are the beys' porcelain cups,"
      },
      {
       "cyr": "трепке има - ластавички крилја,",
       "lat": "trepke ima - lastavički krilja,",
       "en": "her lashes are swallow wings,"
      },
      {
       "cyr": "веѓи има - морске пијавице.",
       "lat": "veǵi ima - morske pijavice.",
       "en": "her eyebrows are sea leeches."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Коса има - свила немерена.",
       "lat": "Kosa ima - svila nemerena.",
       "en": "Her hair is unmeasured silk."
      },
      {
       "cyr": "Узвикнаја триесе дружина:",
       "lat": "Uzviknaja triese družina:",
       "en": "The thirty companions cried out:"
      },
      {
       "cyr": "- Не се фали шеинче терзиче,",
       "lat": "- Ne se fali šeinče terziče,",
       "en": "- Do not boast, little tailor,"
      },
      {
       "cyr": "искочија Мусо Кесаџија.",
       "lat": "iskočija Muso Kesadžija.",
       "en": "Muso the Kesadzhija leapt up."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Искочија широка планина,",
       "lat": "Iskočija široka planina,",
       "en": "He set out for the wide mountain,"
      },
      {
       "cyr": "у планина куде ретке буке,",
       "lat": "u planina kude retke buke,",
       "en": "in the mountain where beech trees are sparse,"
      },
      {
       "cyr": "показаја његовата сила,",
       "lat": "pokazaja njegovata sila,",
       "en": "he showed his strength,"
      },
      {
       "cyr": "на шеинче невеста земаја.",
       "lat": "na šeinče nevesta zemaja.",
       "en": "and took the little tailor's bride."
      }
     ]
    }
   ]
  }
