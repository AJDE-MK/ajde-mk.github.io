   "stanzas": [
    {
     "lines": [
      {
       "cyr": "- Бреј Ѓурчин Стојне убаво, ле",
       "lat": "- Brej Ǵurčin Stojne ubavo, le",
       "en": "- Hey, beautiful Gurchin Stojna, oh,"
      },
      {
       "cyr": "ти беше сношти на вода",
       "lat": "ti beše snošti na voda",
       "en": "last night you were at the water,"
      },
      {
       "cyr": "на погорното кладенче,",
       "lat": "na pogornoto kladenče,",
       "en": "at the upper little well,"
      },
      {
       "cyr": "на подолното изворче.",
       "lat": "na podolnoto izvorče.",
       "en": "at the lower little spring."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога одеше пееше,",
       "lat": "Koga odeše peeše,",
       "en": "When you walked you sang,"
      },
      {
       "cyr": "кај што стоеше, грееше,",
       "lat": "kaj što stoeše, greeše,",
       "en": "where you stood you glowed,"
      },
      {
       "cyr": "како јасна Месечина,",
       "lat": "kako jasna Mesečina,",
       "en": "like the bright Moon,"
      },
      {
       "cyr": "како факли на борина.",
       "lat": "kako fakli na borina.",
       "en": "like pine torches."
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "- Отидов малку погоре, ле",
