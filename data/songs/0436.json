 "versions": [
  {
   "label": "Version 1",
   "en_source": "pesna",
   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Земјо Македонска, уважавам те,",
       "lat": "Zemjo Makedonska, uvažavam te,",
       "en": "Macedonian land, I respect you,",
       "en_mt": false
      },
      {
       "cyr": "земјо Македонска,",
       "lat": "zemjo Makedonska,",
       "en": "Macedonian land,",
       "en_mt": false
      },
      {
       "cyr": "земјо турско-ропска Македонијо",
       "lat": "zemjo tursko-ropska Makedonijo",
       "en": "Ottoman-enslaved land Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "уважавам те.",
       "lat": "uvažavam te.",
       "en": "I respect you.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Уважавам твојте Македонијо",
       "lat": "Uvažavam tvojte Makedonijo",
       "en": "I respect your, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "гори високи,",
       "lat": "gori visoki,",
       "en": "high forests,",
       "en_mt": false
      },
      {
       "cyr": "горите, висојте",
       "lat": "gorite, visojte",
       "en": "your forests, your mountains,",
       "en_mt": false
      },
      {
       "cyr": "и во теб' херојте Македонијо",
       "lat": "i vo teb' herojte Makedonijo",
       "en": "and the heroes, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "што ги раѓаш ти.",
       "lat": "što gi raǵaš ti.",
       "en": "that you give birth to.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "По теб' се белеат Македонијо,",
       "lat": "Po teb' se beleat Makedonijo,",
       "en": "Across you there are white, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "безбројни стада,",
       "lat": "bezbrojni stada,",
       "en": "endless herds,",
       "en_mt": false
      },
      {
       "cyr": "стадата белеат",
       "lat": "stadata beleat",
       "en": "the herds are white,",
       "en_mt": false
      },
      {
       "cyr": "а гроздови зрејат Македонијо,",
       "lat": "a grozdovi zrejat Makedonijo,",
       "en": "and the grapes are maturing, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "по твој ридови.",
       "lat": "po tvoj ridovi.",
       "en": "across your hills.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Ништо не те плаши Македонијо,",
       "lat": "Ništo ne te plaši Makedonijo,",
       "en": "You are afraid of nothing, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "на овој бели свет,",
       "lat": "na ovoj beli svet,",
       "en": "in the entire world,",
       "en_mt": false
      },
      {
       "cyr": "кој душман ќе влезе",
       "lat": "koj dušman ḱe vleze",
       "en": "any foe that enters",
       "en_mt": false
      },
      {
       "cyr": "жив нема да излезе Македонијо,",
       "lat": "živ nema da izleze Makedonijo,",
       "en": "will not come out alive, Macedonia,",
       "en_mt": false
      },
      {
       "cyr": "ти го ставаш в гроб.",
       "lat": "ti go stavaš v grob.",
       "en": "you put him to his grave.",
       "en_mt": false
      }
     ]
    }
   ]
