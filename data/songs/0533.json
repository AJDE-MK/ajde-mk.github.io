    {
     "lines": [
      {
       "cyr": "Охрид, Охрид убав мил,",
       "lat": "Ohrid, Ohrid ubav mil,",
       "en": "Ohrid, Ohrid, dear and beautiful,",
       "en_mt": false
      },
      {
       "cyr": "ти за мене рај си бил.",
       "lat": "ti za mene raj si bil.",
       "en": "you have been a paradise to me.",
       "en_mt": false
      },
      {
       "cyr": "Јас ќе одам далеку",
       "lat": "Jas ḱe odam daleku",
       "en": "I am going far away,",
       "en_mt": false
      },
      {
       "cyr": "не знам дал' ќе се вратам пак.",
       "lat": "ne znam dal' ḱe se vratam pak.",
       "en": "I know not if I shall return again.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Езерото ми убаво,",
       "lat": "Ezeroto mi ubavo,",
       "en": "My beautiful lake,",
       "en_mt": false
      },
      {
       "cyr": "јас со солзи го оставив.",
       "lat": "jas so solzi go ostaviv.",
       "en": "I left it in tears.",
       "en_mt": false
      },
      {
       "cyr": "Со кајчето од Вистера",
       "lat": "So kajčeto od Vistera",
       "en": "In Vister's little boat,",
       "en_mt": false
      },
      {
       "cyr": "во Албанија се најдов јас.",
       "lat": "vo Albanija se najdov jas.",
       "en": "I found myself in Albania.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
