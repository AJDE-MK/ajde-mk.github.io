   "stanzas": [
    {
     "lines": [
      {
       "cyr": "Оригинално писмо:",
       "lat": "Originalno pismo:",
       "en": "Original script:",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во Ἰѻрдáнѣ крещáющусѧ тебѣ̀, Гóсподи,",
       "lat": "Vo Ἰѻrdánѣ kreщáющusѧ tebѣ̀, Góspodi,",
       "en": "When Thou, oh Lord, were baptized in the Jordan,",
       "en_mt": false
      },
      {
       "cyr": "трóическое ѩ̉ви́сѧ поклонéнїе:",
       "lat": "tróičeskoe ѩ̉vísѧ poklonénїe:",
       "en": "the worship of the Holy Trinity appeared.",
       "en_mt": false
      },
      {
       "cyr": "роди́телевъ бо глáсъ свидѣ́тельствоваше тебѣ̀,",
       "lat": "rodítelevъ bo glásъ svidѣ́telьstvovaše tebѣ̀,",
       "en": "The Father’s voice testified for you,",
       "en_mt": false
      },
      {
       "cyr": "возлю́бленнаго тѧ̀ Сына и̉мену́ѧ,",
       "lat": "vozlю́blennago tѧ̀ Sыna ỉmenúѧ,",
       "en": "calling Thee His beloved Son",
       "en_mt": false
      },
      {
       "cyr": "и̉ Ду́хъ въ ви́дѣ голуби́нѣ,",
       "lat": "ỉ Dúhъ vъ vídѣ golubínѣ,",
       "en": "and the Spirit, in the form of a dove,",
       "en_mt": false
      },
      {
       "cyr": "и̉звѣ́ствоваше словесѐ оу̔тверждéнїе.",
       "lat": "ỉzvѣ́stvovaše slovesè ou̔tverždénїe.",
       "en": "confirmed the truth of these words.",
       "en_mt": false
      },
      {
       "cyr": "҆Ѩвлéйсѧ Хрїстѐ Бóже,",
       "lat": "҆Ѩvléйsѧ Hrїstè Bóže,",
       "en": "Christ oh Lord, who has come",
       "en_mt": false
      },
      {
       "cyr": "и̉ мíръ просвѣщéй, слáва тебѣ̀.",
       "lat": "ỉ mírъ prosvѣщéй, sláva tebѣ̀.",
       "en": "and enlightened the world, glory to Thee.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Изговарање:",
       "lat": "Izgovaranje:",
       "en": "Pronunciation:",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Во Јордане крештајуштусја тебе, Господи,",
       "lat": "Vo Jordane kreštajuštusja tebe, Gospodi,",
       "en": "When Thou, oh Lord, were baptized in the Jordan,",
       "en_mt": false
      },
      {
       "cyr": "троическое јависја поклонение.",
       "lat": "troičeskoe javisja poklonenie.",
       "en": "the worship of the Holy Trinity appeared.",
       "en_mt": false
      },
      {
       "cyr": "Родителев бо глас свидетелствоваше тебе,",
       "lat": "Roditelev bo glas svidetelstvovaše tebe,",
       "en": "The Father’s voice testified for you,",
       "en_mt": false
      },
      {
       "cyr": "возљубленаго тја Сина именуја,",
       "lat": "vozljublenago tja Sina imenuja,",
       "en": "calling Thee His beloved Son",
       "en_mt": false
      },
      {
       "cyr": "и Дух во виде голубине,",
       "lat": "i Duh vo vide golubine,",
       "en": "and the Spirit, in the form of a dove,",
       "en_mt": false
      },
      {
       "cyr": "извествоваше словесе утверждение.",
       "lat": "izvestvovaše slovese utverždenie.",
       "en": "confirmed the truth of these words.",
       "en_mt": false
      },
      {
       "cyr": "Јавлејсја Христе Боже,",
       "lat": "Javlejsja Hriste Bože,",
       "en": "Christ oh Lord, who has come",
       "en_mt": false
      },
      {
       "cyr": "и мир просвештеи, слава тебе.",
       "lat": "i mir prosveštei, slava tebe.",
       "en": "and enlightened the world, glory to Thee.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Транскрипција:",
       "lat": "Transkripcija:",
       "en": "Transcription:",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Vo Iordane kreshtayushtusya tebe, Gospodi,",
       "lat": "Vo Iordane kreshtayushtusya tebe, Gospodi,",
       "en": "When Thou, oh Lord, were baptized in the Jordan,",
       "en_mt": false
      },
      {
       "cyr": "troicheskoe yavisya poklonenie.",
       "lat": "troicheskoe yavisya poklonenie.",
       "en": "the worship of the Holy Trinity appeared.",
       "en_mt": false
      },
      {
       "cyr": "Roditelev' bo glas' svidetel'stvovashe tebe,",
       "lat": "Roditelev' bo glas' svidetel'stvovashe tebe,",
       "en": "The Father’s voice testified for you,",
       "en_mt": false
      },
      {
       "cyr": "vozlyublenago tya Sina imenuya,",
       "lat": "vozlyublenago tya Sina imenuya,",
       "en": "calling Thee His beloved Son",
       "en_mt": false
      },
      {
       "cyr": "i Duh' vo vide golubine,",
       "lat": "i Duh' vo vide golubine,",
       "en": "and the Spirit, in the form of a dove,",
       "en_mt": false
      },
      {
       "cyr": "izvestvovashe slovese utverzhdenie.",
       "lat": "izvestvovashe slovese utverzhdenie.",
       "en": "confirmed the truth of these words.",
       "en_mt": false
      },
      {
       "cyr": "Yavleysya Hriste Bozhe,",
       "lat": "Yavleysya Hriste Bozhe,",
       "en": "Christ oh Lord, who has come",
       "en_mt": false
      },
      {
       "cyr": "i mir' prosveshtey, slava tebe.",
       "lat": "i mir' prosveshtey, slava tebe.",
       "en": "and enlightened the world, glory to Thee.",
       "en_mt": false
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Превод на македонски:",
       "lat": "Prevod na makedonski:",
       "en": "Translation into Macedonian:",
       "en_mt": true
      }
     ]
    },
    {
     "lines": [
      {
       "cyr": "Кога во Јордан се крштеваше, Господи,",
       "lat": "Koga vo Jordan se krštevaše, Gospodi,",
       "en": "When Thou, oh Lord, were baptized in the Jordan,",
       "en_mt": false
      },
      {
       "cyr": "се јави поклонувањето на Света Троица.",
       "lat": "se javi poklonuvanjeto na Sveta Troica.",
       "en": "the worship of the Holy Trinity appeared.",
       "en_mt": false
      },
      {
       "cyr": "Гласот на Родителот сведочеше за Тебе,",
       "lat": "Glasot na Roditelot svedočeše za Tebe,",
       "en": "The Father’s voice testified for you,",
       "en_mt": false
      },
      {
       "cyr": "нарекувајќи Те Свој возљубен Син",
       "lat": "narekuvajḱi Te Svoj vozljuben Sin",
       "en": "calling Thee His beloved Son",
       "en_mt": false
      },
      {
       "cyr": "и Духот, во вид на гулаб,",
       "lat": "i Duhot, vo vid na gulab,",
       "en": "and the Spirit, in the form of a dove,",
       "en_mt": false
      },
      {
       "cyr": "го објавуваше потврдувањето на тие зборови.",
       "lat": "go objavuvaše potvrduvanjeto na tie zborovi.",
       "en": "confirmed the truth of these words.",
       "en_mt": false
      },
      {
       "cyr": "Христе Боже, Кој се јави",
       "lat": "Hriste Bože, Koj se javi",
       "en": "Christ oh Lord, who has come",
       "en_mt": false
      },
      {
       "cyr": "и светот го просвети, слава Ти.",
       "lat": "i svetot go prosveti, slava Ti.",
       "en": "and enlightened the world, glory to Thee.",
       "en_mt": false
      }
     ]
    }
   ]
  }
